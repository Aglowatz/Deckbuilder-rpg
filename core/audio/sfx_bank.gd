class_name SfxBank
extends RefCounted
## The sound-effect bank (docs/audio/sound_direction.md): every event the game can play and the sets of files behind its layers, read from
## `data/audio/sfx_bank.json` (generated by `node tools/sfx_build.js` from `data/source/sfx_events.csv` and `sfx_sources.csv`).
##
## An event: `bus` (World / Battle / UI / Voice / Ambience), `layers` (each a `set`, a `delay` in seconds, a `gain` in dB and an optional `pitch`
## multiplier: an attack transient + a body + a tail play as one sound), `volume` (dB), `pitch` (random pitch range, 0.04 = +-4 %), `vol_jitter` (dB),
## `priority` (0-100: who keeps a voice when too many sounds play at once), `max` (instances of this event at once), `cooldown` (seconds between two
## starts), `spatial` (a 3D world sound with distance falloff), `range` (metres it carries) and `duck` (dB the music and ambience dip under it).

const PATH: String = "res://data/audio/sfx_bank.json"

var events: Dictionary = {}
var sets: Dictionary = {}
var loops: Array = []


static func load_from(path: String = PATH) -> SfxBank:
	var bank: SfxBank = SfxBank.new()
	if not FileAccess.file_exists(path):
		return bank
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
	if parsed is Dictionary:
		var data: Dictionary = parsed as Dictionary
		bank.events = data.get("events", {}) as Dictionary
		bank.sets = data.get("sets", {}) as Dictionary
		bank.loops = data.get("loops", []) as Array
	return bank


func has_event(event_name: String) -> bool:
	return events.has(event_name)


func event(event_name: String) -> Dictionary:
	return events.get(event_name, {}) as Dictionary


## The files (res:// paths) of a set; empty when it has none yet.
func files(set_name: String) -> Array:
	return sets.get(set_name, []) as Array


func is_loop(set_name: String) -> bool:
	return loops.has(set_name)


## The sets an event's layers name.
func layer_sets(event_name: String) -> Array[String]:
	var result: Array[String] = []
	for layer: Variant in event(event_name).get("layers", []) as Array:
		result.append(str((layer as Dictionary).get("set", "")))
	return result


## True when at least one of the event's layers has a file (the event makes a sound).
func is_playable(event_name: String) -> bool:
	for set_name: String in layer_sets(event_name):
		if not files(set_name).is_empty():
			return true
	return false


## Events with no playable layer (the verify pass lists them in docs/audio/sfx_inventory.md).
func silent_events() -> Array[String]:
	var result: Array[String] = []
	for event_name: Variant in events.keys():
		if not is_playable(str(event_name)):
			result.append(str(event_name))
	result.sort()
	return result
