class_name AudioRegistry
extends RefCounted
## The music/sting registry (docs/audio/music_integration.md): stable ID (MUS-TITLE, STG-VICTORY) -> file, loop on/off, bus and base volume.
## `data/audio/audio_registry.json` is GENERATED by `tools/import_audio.sh` from `data/source/music_list.csv` (the designer's catalogue), the
## Drive folder in art_config.cfg (`audio_dir`, copy-only) and `data/source/audio_levels.csv` (loudness, `tools/audio_analyze.js`).
## Replacing a track later means swapping `assets/audio/music/<ID>.ogg` (or `stings/<ID>.wav`) and re-running the importer.
## A compatibility alias (MUS-TUT-BOSS -> MUS-TUT-BATTLE) plays the file of the ID it points at.

const LIST_PATH: String = "res://data/source/music_list.csv"
const REGISTRY_PATH: String = "res://data/audio/audio_registry.json"
const EXTRAS_PATH: String = "res://data/audio/audio_extras.json"
const LEVELS_PATH: String = "res://data/source/audio_levels.csv"
const MANIFEST_PATH: String = "res://data/source/audio_import_manifest.csv"
const MUSIC_DIR: String = "res://assets/audio/music"
const STING_DIR: String = "res://assets/audio/stings"
const CONFIG_PATH: String = "res://data/source/art_config.cfg"
const BUS_MUSIC: StringName = &"Music"
## Loudness targets (LUFS integrated): loops and story cues sit together, stings a little above them. Peaks never pass PEAK_CEILING.
const TARGET_LOOP_LUFS: float = -20.0
const TARGET_STING_LUFS: float = -17.0
const PEAK_CEILING_DB: float = -1.5

enum Kind { LOOP, STORY, STING, MOTIF }


class Entry:
	extends RefCounted
	var id: String = ""
	var cue_name: String = ""
	var kind: Kind = Kind.LOOP
	## res:// path of the file this ID plays (an alias carries its target's file here); "" = no file imported.
	var file: String = ""
	var loop: bool = false
	var bus: StringName = BUS_MUSIC
	var volume_db: float = 0.0
	var alias_of: String = ""
	var zone: String = ""
	var category: String = ""
	var use: String = ""
	var duration: float = 0.0
	## Composition references (MUS-LULLABY, MUS-PRIMM-MOTIF) are never triggered by gameplay.
	var gameplay: bool = true


class Result:
	extends RefCounted
	var with_file: Array[String] = []
	var missing: Array[String] = []
	var unknown: Array[String] = []
	var converted: Array[String] = []
	var aliases: Array[String] = []
	var errors: Array[String] = []
	var copied: int = 0
	var unchanged: int = 0


static var _entries: Dictionary = {}
static var _loaded: bool = false
static var _streams: Dictionary = {}


# ---- Runtime ----------------------------------------------------------------------------------


static func ensure_loaded() -> void:
	if _loaded:
		return
	_loaded = true
	_entries.clear()
	if not FileAccess.file_exists(REGISTRY_PATH):
		return
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(REGISTRY_PATH))
	if not (parsed is Dictionary):
		return
	var rows: Dictionary = ((parsed as Dictionary).get("entries", {}) as Dictionary).duplicate()
	# Overnight Oct 17, Part 12: cues the game makes itself (the boss-victory stings cut by tools/cut_stings.js) live in their own file,
	# so "import audio" never drops them.
	if FileAccess.file_exists(EXTRAS_PATH):
		var extras: Variant = JSON.parse_string(FileAccess.get_file_as_string(EXTRAS_PATH))
		if extras is Dictionary:
			rows.merge((extras as Dictionary).get("entries", {}) as Dictionary, false)
	for id: Variant in rows.keys():
		var row: Dictionary = rows[id] as Dictionary
		var entry: Entry = Entry.new()
		entry.id = str(id)
		entry.cue_name = str(row.get("name", ""))
		entry.kind = _kind_from_name(str(row.get("kind", "loop")))
		entry.file = str(row.get("file", ""))
		entry.loop = bool(row.get("loop", false))
		entry.bus = StringName(str(row.get("bus", "Music")))
		entry.volume_db = float(row.get("volume_db", 0.0))
		entry.alias_of = str(row.get("alias_of", ""))
		entry.zone = str(row.get("zone", ""))
		entry.category = str(row.get("category", ""))
		entry.use = str(row.get("use", ""))
		entry.duration = float(row.get("duration", 0.0))
		entry.gameplay = bool(row.get("gameplay", true))
		_entries[entry.id] = entry


static func reload() -> void:
	_loaded = false
	_streams.clear()
	ensure_loaded()


static func ids() -> Array[String]:
	ensure_loaded()
	var result: Array[String] = []
	for id: Variant in _entries.keys():
		result.append(str(id))
	result.sort()
	return result


static func has_id(id: String) -> bool:
	ensure_loaded()
	return _entries.has(id)


## The entry of `id` (null for an unknown ID).
static func entry(id: String) -> Entry:
	ensure_loaded()
	return _entries.get(id) as Entry


## The file `id` plays: its own, or the file of the ID it is a compatibility alias of. "" when there is none.
static func file_for(id: String) -> String:
	var found: Entry = entry(id)
	if found == null:
		return ""
	return found.file


## Whether `id` is a known cue with a file that can actually be loaded.
static func is_playable(id: String) -> bool:
	var path: String = file_for(id)
	return not path.is_empty() and ResourceLoader.exists(path)


## The stream of `id`, loop flag applied (loops loop the whole file: the delivered OGG files are full-file loops). null when not playable.
static func stream(id: String) -> AudioStream:
	if _streams.has(id):
		return _streams[id] as AudioStream
	var found: Entry = entry(id)
	var result: AudioStream = null
	if found != null and is_playable(id):
		var loaded: AudioStream = load(found.file) as AudioStream
		if loaded is AudioStreamOggVorbis:
			var ogg: AudioStreamOggVorbis = (loaded as AudioStreamOggVorbis).duplicate() as AudioStreamOggVorbis
			ogg.loop = found.loop
			ogg.loop_offset = 0.0
			result = ogg
		elif loaded is AudioStreamWAV:
			var wav: AudioStreamWAV = (loaded as AudioStreamWAV).duplicate() as AudioStreamWAV
			wav.loop_mode = AudioStreamWAV.LOOP_FORWARD if found.loop else AudioStreamWAV.LOOP_DISABLED
			if found.loop:
				wav.loop_begin = 0
				wav.loop_end = wav.data.size() / (4 if wav.stereo else 2) / (2 if wav.format == AudioStreamWAV.FORMAT_16_BITS else 1)
			result = wav
		else:
			result = loaded
	_streams[id] = result
	return result


static func _kind_from_name(name: String) -> Kind:
	match name:
		"story":
			return Kind.STORY
		"sting":
			return Kind.STING
		"motif":
			return Kind.MOTIF
	return Kind.LOOP


static func kind_name(kind: Kind) -> String:
	match kind:
		Kind.STORY:
			return "story"
		Kind.STING:
			return "sting"
		Kind.MOTIF:
			return "motif"
	return "loop"


# ---- Catalogue (the designer's CSV) -----------------------------------------------------------


## Every music row: {ID -> {name, zone, category, use, playback, related, notes, status}} in sheet order (`order` holds the IDs).
static func catalogue() -> Dictionary:
	var rows: Dictionary = {}
	var order: Array[String] = []
	if not FileAccess.file_exists(LIST_PATH):
		return {"rows": rows, "order": order}
	var file: FileAccess = FileAccess.open(LIST_PATH, FileAccess.READ)
	while not file.eof_reached():
		var row: PackedStringArray = file.get_csv_line()
		if row.size() < 12:
			continue
		var id: String = row[0].strip_edges()
		if not (id.begins_with("MUS-") or id.begins_with("STG-")):
			continue
		rows[id] = {
			"name": row[1].strip_edges(), "zone": row[2].strip_edges(), "category": row[3].strip_edges(), "use": row[4].strip_edges(),
			"playback": row[9].strip_edges(), "related": row[10].strip_edges(), "notes": row[11].strip_edges(),
			"status": row[12].strip_edges() if row.size() > 12 else "",
		}
		order.append(id)
	return {"rows": rows, "order": order}


## The ID a "Compatibility alias" row points at ("" for an ordinary row). The notes name it ("use MUS-TUT-BATTLE", "reuses MUS-OMAKASE-BATTLE");
## otherwise the first related cue.
static func alias_target(row: Dictionary) -> String:
	var notes: String = str(row.get("notes", ""))
	if not notes.to_lower().contains("compatibility alias") and not notes.to_lower().contains("reuses mus-"):
		return ""
	var matcher: RegEx = RegEx.new()
	matcher.compile("(?:use|reuses|—|-)\\s+(MUS-[A-Z0-9-]+)")
	var found: RegExMatch = matcher.search(notes)
	if found != null:
		return found.get_string(1)
	var related: String = str(row.get("related", ""))
	return related.split(";")[0].strip_edges()


static func _levels() -> Dictionary:
	var result: Dictionary = {}
	if not FileAccess.file_exists(LEVELS_PATH):
		return result
	var file: FileAccess = FileAccess.open(LEVELS_PATH, FileAccess.READ)
	file.get_csv_line()
	while not file.eof_reached():
		var row: PackedStringArray = file.get_csv_line()
		if row.size() >= 14:
			result[row[0]] = {"lufs": row[5].to_float(), "peak": row[6].to_float(), "frames": row[3].to_int(), "flags": row[13].strip_edges()}
	return result


## Base volume (dB) that brings a file to its kind's loudness target without passing the peak ceiling.
static func base_volume_db(kind: Kind, lufs: float, peak: float) -> float:
	var target: float = TARGET_STING_LUFS if kind == Kind.STING else TARGET_LOOP_LUFS
	var volume: float = target - lufs
	volume = minf(volume, PEAK_CEILING_DB - peak)
	return snappedf(clampf(volume, -12.0, 9.0), 0.1)


# ---- Import -----------------------------------------------------------------------------------


## The configured Drive folder (env AUDIO_SOURCE_DIR wins), "" when unset.
static func source_dir() -> String:
	var dir: String = OS.get_environment("AUDIO_SOURCE_DIR")
	if dir.is_empty():
		var config: ConfigFile = ConfigFile.new()
		if config.load(CONFIG_PATH) == OK:
			dir = str(config.get_value("art", "audio_dir", ""))
	return dir.replace("\\", "/").rstrip("/")


static func ffmpeg_path() -> String:
	var path: String = OS.get_environment("FFMPEG")
	if path.is_empty():
		var config: ConfigFile = ConfigFile.new()
		if config.load(CONFIG_PATH) == OK:
			path = str(config.get_value("art", "ffmpeg_path", ""))
	return path


static func _real(path: String) -> String:
	return ProjectSettings.globalize_path(path)


## Picks the source file of `id` in `files` (a name list): ID.ogg for a loop, ID.wav for a sting/one-shot, else the latest ID_vNN of either.
static func pick_source(id: String, files: Array[String], want_ogg: bool) -> String:
	var preferred: String = "%s.%s" % [id, "ogg" if want_ogg else "wav"]
	if files.has(preferred):
		return preferred
	var other: String = "%s.%s" % [id, "wav" if want_ogg else "ogg"]
	if files.has(other):
		return other
	var best: String = ""
	var best_version: int = -1
	var matcher: RegEx = RegEx.new()
	matcher.compile("^%s_v(\\d+)\\.(ogg|wav)$" % id)
	for file_name: String in files:
		var found: RegExMatch = matcher.search(file_name)
		if found == null:
			continue
		var version: int = found.get_string(1).to_int()
		if version > best_version or (version == best_version and file_name.ends_with(".ogg") and want_ogg):
			best_version = version
			best = file_name
	return best


## Copies the Drive files named by ID into assets/audio/music (loops, story cues, motif masters) and assets/audio/stings, converts a loop or story cue
## that only has a WAV master to OGG (needs ffmpeg), and writes the registry JSON and the manifest. Nothing in `source` is moved, renamed or deleted.
static func import_from_source(source: String) -> Result:
	var result: Result = Result.new()
	var sheet: Dictionary = catalogue()
	var rows: Dictionary = sheet["rows"] as Dictionary
	var order: Array = sheet["order"] as Array
	var levels: Dictionary = _levels()
	var files: Array[String] = []
	for file_name: String in DirAccess.get_files_at(source):
		var extension: String = file_name.get_extension().to_lower()
		if extension == "ogg" or extension == "wav":
			files.append(file_name)
	files.sort()
	DirAccess.make_dir_recursive_absolute(_real(MUSIC_DIR))
	DirAccess.make_dir_recursive_absolute(_real(STING_DIR))
	var used: Dictionary = {}
	var entries: Dictionary = {}
	var manifest: Array[PackedStringArray] = []
	for id_variant: Variant in order:
		var id: String = str(id_variant)
		var row: Dictionary = rows[id] as Dictionary
		var category: String = str(row["category"])
		var playback: String = str(row["playback"])
		var kind: Kind = Kind.LOOP
		if category == "Sting":
			kind = Kind.STING
		elif category == "Motif":
			kind = Kind.MOTIF
		elif playback != "Loop":
			kind = Kind.STORY
		var is_loop: bool = kind == Kind.LOOP
		# Everything long (loops, story cues, motif masters) is delivered as OGG (a WAV master is converted: 24 story WAVs alone are ~560 MB); stings stay WAV.
		var want_ogg: bool = kind != Kind.STING
		var source_name: String = pick_source(id, files, want_ogg)
		var target_dir: String = STING_DIR if kind == Kind.STING else MUSIC_DIR
		var record: Dictionary = {
			"name": row["name"], "kind": kind_name(kind), "loop": is_loop, "bus": str(BUS_MUSIC), "zone": row["zone"], "category": category,
			"use": row["use"], "gameplay": kind != Kind.MOTIF, "file": "", "volume_db": 0.0, "alias_of": "",
		}
		var target_alias: String = alias_target(row)
		if not target_alias.is_empty():
			record["alias_of"] = target_alias
			result.aliases.append("%s -> %s" % [id, target_alias])
		if source_name.is_empty():
			result.missing.append(id)
			entries[id] = record
			continue
		used[source_name] = true
		var source_path: String = source.path_join(source_name)
		var extension: String = source_name.get_extension().to_lower()
		var convert: bool = want_ogg and extension != "ogg"
		var target_ext: String = "ogg" if (want_ogg or extension == "ogg") else "wav"
		var target_path: String = target_dir.path_join("%s.%s" % [id, target_ext])
		# A delivery format that changed (a story WAV now delivered as OGG) leaves no stale copy behind.
		var stale_ext: String = "wav" if target_ext == "ogg" else "ogg"
		for suffix: String in ["", ".import"]:
			var stale: String = _real(target_dir.path_join("%s.%s%s" % [id, stale_ext, suffix]))
			if FileAccess.file_exists(stale):
				DirAccess.remove_absolute(stale)
		var hash: String = FileAccess.get_md5(source_path)
		var manifest_hash: String = _read_manifest().get(id, "") as String
		var present: bool = FileAccess.file_exists(_real(target_path))
		if present and manifest_hash == hash:
			result.unchanged += 1
		elif convert:
			var tool: String = ffmpeg_path()
			var output: Array = []
			var code: int = -1
			if not tool.is_empty():
				code = OS.execute(tool, ["-y", "-v", "error", "-i", source_path, "-ar", "48000", "-ac", "2", "-c:a", "libvorbis", "-q:a", "7", _real(target_path)], output, true)
			if code != 0:
				result.errors.append("%s: only %s exists and it could not be converted to OGG (set ffmpeg_path in art_config.cfg or FFMPEG)" % [id, source_name])
				result.missing.append(id)
				entries[id] = record
				continue
			result.converted.append(id)
			result.copied += 1
		else:
			var data: PackedByteArray = FileAccess.get_file_as_bytes(source_path)
			var out: FileAccess = FileAccess.open(_real(target_path), FileAccess.WRITE)
			if out == null or data.is_empty():
				result.errors.append("%s: could not copy %s" % [id, source_name])
				result.missing.append(id)
				entries[id] = record
				continue
			out.store_buffer(data)
			out.close()
			result.copied += 1
		manifest.append(PackedStringArray([id, source_name, str(FileAccess.get_file_as_bytes(source_path).size()), hash]))
		record["file"] = target_path
		var level: Dictionary = levels.get(id, {}) as Dictionary
		if not level.is_empty():
			record["volume_db"] = base_volume_db(kind, float(level["lufs"]), float(level["peak"]))
			record["duration"] = snappedf(float(level["frames"]) / 48000.0, 0.01)
			record["analysis"] = str(level["flags"])
		entries[id] = record
		result.with_file.append(id)
	# An alias plays the file of the ID it points at (its own copy is kept so the slot can be given its own music later).
	for id: Variant in entries.keys():
		var record: Dictionary = entries[id] as Dictionary
		var target: String = str(record["alias_of"])
		if target.is_empty() or not entries.has(target):
			continue
		var target_record: Dictionary = entries[target] as Dictionary
		if not str(target_record["file"]).is_empty():
			record["own_file"] = record["file"]
			record["file"] = target_record["file"]
			record["volume_db"] = target_record["volume_db"]
			record["duration"] = target_record.get("duration", 0.0)
			record["analysis"] = target_record.get("analysis", "")
	for file_name: String in files:
		if not used.has(file_name):
			result.unknown.append(file_name)
	var document: Dictionary = {
		"_about": "GENERATED by tools/import_audio.sh from data/source/music_list.csv + the Drive folder (audio_dir in art_config.cfg) + data/source/audio_levels.csv. Do not edit by hand: replace assets/audio/music/<ID>.ogg (or stings/<ID>.wav) and re-run the importer. `alias_of` = compatibility alias (plays the target's file); `gameplay: false` = composition reference, never triggered.",
		"entries": entries,
	}
	var json: FileAccess = FileAccess.open(_real(REGISTRY_PATH), FileAccess.WRITE)
	json.store_string(JSON.stringify(document, "\t", true))
	json.close()
	_write_manifest(manifest)
	reload()
	return result


static func _read_manifest() -> Dictionary:
	var result: Dictionary = {}
	var path: String = _real(MANIFEST_PATH)
	if not FileAccess.file_exists(path):
		return result
	var file: FileAccess = FileAccess.open(path, FileAccess.READ)
	file.get_csv_line()
	while not file.eof_reached():
		var row: PackedStringArray = file.get_csv_line()
		if row.size() >= 4:
			result[row[0]] = row[3]
	return result


static func _write_manifest(rows: Array[PackedStringArray]) -> void:
	var file: FileAccess = FileAccess.open(_real(MANIFEST_PATH), FileAccess.WRITE)
	file.store_csv_line(PackedStringArray(["Audio ID", "Source file", "Bytes", "MD5"]))
	for row: PackedStringArray in rows:
		file.store_csv_line(row)
	file.close()


## Overnight Oct 16 (Block 5b): starts loading the files of `ids` on background threads, so the first switch to one of them (the Capital's
## district music) does not stall a frame. Returns how many loads it started.
static func prewarm(ids: Array[String]) -> int:
	var started: int = 0
	for id: String in ids:
		if _streams.has(id) or not is_playable(id):
			continue
		var path: String = file_for(id)
		if ResourceLoader.has_cached(path):
			continue
		if ResourceLoader.load_threaded_request(path) == OK:
			started += 1
	return started
