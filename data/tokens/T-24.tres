script = ExtResource("2_510po")
id = "T-24"
display_name = "Elowen Vey, Defector"
attack = 3
defense = 5
keywords = Array[int]([10, 12])
rules_text = "Starts on the player's field during the Path-ology Lab boss fight if the player rescued her in that dungeon run.

Elusive. Unbreakable.

Inside Knowledge: At the start of your turn, choose one of the Chief Path-ologist's Protocols. It has no effect until your next turn.

Sabotage: Failed Experiment tokens your opponent creates enter exhausted."
flavor_text = "I learned everything I know from him. Including how to break it."
is_token = true
not_in_packs = true
script_text = "kw elusive,unbreakable"
