[gd_resource type="Resource" script_class="ZoneStoryText" format=3]

[ext_resource type="Script" path="res://core/data/zone_story_text.gd" id="1_dna"]

[resource]
script = ExtResource("1_dna")
zone_id = "necrocrat"
lines = {
"enemy.courier": ["Urgent delivery! A signature is required, and if one is not given, one will be taken.", "Delivering a Notice of Compliance, in triplicate. Please hold still for all three."],
"enemy.intern": ["Unpaid, undead and eager to impress the new management. At last, some hands-on experience!", "It doesn't know that the new management is wrong; it only knows that the paperwork is valid."],
"enemy.manager": ["He has wanted a quick sync with you since 1994. Now he enforces the new regulations with great, unenthusiastic precision."],
"fx.chest": ["You find supplies filed under Miscellaneous and, for once, you meet the requirements."],
"fx.coffee_bad": ["The machine screams, then the coffee screams, and you drink it anyway. -1 HP."],
"fx.coffee_gold": ["A coin rolls out of the dispenser instead of coffee, and the machine shows no remorse at all. +gold."],
"fx.coffee_good": ["The coffee is almost drinkable. Someone in the breakroom may be disciplined for this. (+HP)"],
"fx.coffee_great": ["A perfect brew. The machine gives a proud little hum, and you feel fully restored."],
"fx.heal_already": ["You are already as rested as the dead get, and the dead get very rested."],
"fx.heal_couch": ["You sink into the Breakroom Couch, which is somehow both ice cold and slightly damp. HP restored."],
"fx.hit": ["Delivery! Signature taken. (-2 HP)"],
"fx.main_dungeon": ["The Executive Floor's great doors stand open a crack, and beyond them are endless desks under green lamps, where the stamps thump like heartbeats.", "A voice from the dark says: PLEASE TAKE A NUMBER."],
"fx.printer_ok": ["The printer hands you a card, still warm, and you take it before it can ask for a reference."],
"fx.printer_poor": ["PAPER JAM. The printer regrets to inform you that your fee is non-refundable."],
"fx.punch_again": ["Your shift is already recorded. Please do not punch twice; the clock has suffered enough."],
"fx.punch_in": ["You punch in, the clock says 'Welcome back, Pending', and a small buff glimmers on you."],
"fx.suggestion": ["You post a suggestion and something drops back out of the box, which seems to mean you have been assigned the follow-up."],
"fx.suggestion_empty": ["The suggestion box is empty. The committee read your suggestion and did not implement it, but they did laminate it."],
"fx.wake": ["You wake on a Lobby couch with a 15-minute limit. A form has already been filled out in your name.", "It says you are 'Pending' and, underneath in the same neat hand, 'Valid'."],
"hud.objective": ["The D.N.A.: the Lobby and Breakroom are safe (pending approval). HP does not come back after battles - rest on the Breakroom Couch, or ride up to town.", "Every door in the building requires a form. The authorization is valid."],
"match.first": ["first clear! here's a bonus for you. it's been sitting in my desk drawer since '09 waiting for the right occasion, and i think this is finally it.", "it's a memory game in a building full of people who are mostly memories, which i thought was pretty clever when i made it. Agnes didn't laugh, but she did read the rules all the way through."],
"match.intro": ["so: flip two cards at a time and find all 8 pairs in 14 moves or fewer. fewer moves means more stars. easy-ish."],
"match.lose": ["aw, you're out of moves. that's okay, you still lasted longer than my virtual pet ever does, and i feed him and everything. want another go?"],
"match.pairs": ["Dial-Up Modem", "Top 8 Friends", "Late Fee Receipt", "Virtual Pet (Deceased)", "Flip Phone Text", "Burned Mix CD", "Away Message", "Mix Tape"],
"match.win": ["nice flipping! that puts you at number one in my top 8, which used to be me, so... sorry, me. we had a good run, and number two is still pretty good."],
"memo.coffee": ["MEMO: THE COFFEE MACHINE", "For living staff only. Undead staff, please use the Decaf Crypt.", "This is the fourth memo."],
"memo.cubicle_coffin": ["MEMO: CUBICLE 12-C", "Whoever put a coffin in 12-C: you may keep it.", "Please stop billing it as 'ergonomic seating'."],
"memo.fun_day": ["MEMO: MANDATORY FUN DAY", "Reminder: Mandatory Fun Day is mandatory.", "Fun that is not mandatory will not be counted as fun."],
"memo.hr": ["HR REMINDER", "Nothing is filed on a Tuesday (Rule 1). Tuesdays are for rest and the rec room. 'Rest in Peace' is still not an approved out-of-office message."],
"memo.lunch": ["BREAKROOM REMINDER", "Labelled lunches are not safe. Unlabelled lunches are not safe. Lunches are not safe."],
"memo.motto": ["ALL-HANDS REMINDER", "Our motto is \"Your Death, Our Priority.\" Please stop saying \"Your Death, Our Problem.\""],
"memo.parking": ["FACILITIES", "Beefcake couriers: throwing a parcel through the window is not 'delivery'. Neither is throwing the courier."],
"memo.records": ["RECORDS NOTICE", "To access the Records Basement, bring Form 13-B.", "Form 13-B is available from Form 13-A. Form 13-A is available from nobody."],
"memo.reorg": ["REORG NOTICE", "Due to a restructuring, you will now report to the person who reports to you.", "Both of you have been dead since Tuesday. Both of you report to {villain}."],
"npc.barnaby.intro": ["Oh! A customer! Sorry, hello. I'm Gerald, the breakroom barista, and I'm also Number 4,000,212. They're on 3, so I brought a book. Well, several. All of them, actually.", "Most of my customers are ghosts and can't taste a thing, so nobody's ever sent a cup back, which is a great comfort to me. Do go gently with the machine in the corner, though. It's very old, and it sulks."],
"npc.barnaby.return": ["I'm so sorry, we're out of cream, and out of sugar, and if I'm honest we've been out of hope for a while as well. I did put in an order for more, and they say 2090, so I'm trying to be patient.", "They're still on 3. I checked this morning, and then I checked again in case I'd been rude about it the first time. I write it down in a folder every day, so that I'll know the minute it changes."],
"npc.dolores.intro": ["Welcome to the Department of Necrotic Affairs, dear. I'm Agnes Overdue, and I look after the front desk. I died at this desk forty years ago, and I've been employee of the month ever since, because nobody else applied.", "Here's your number, dear: 4,000,213. We're serving 3, I'm sorry to say. Ten years ago {villain}'s people filed some paperwork, and they filed it properly, and ever since then the whole Department has worked for him.", "Every one of us knows it's wrong, but the authorization is valid. Irregular things I can fight, dear. Valid things just sit there and smile at you."],
"npc.dolores.return": ["Back again, dear? It does me good to see somebody come and go. Not one soul in this building has passed on since the transfer, you see, and I'm afraid that includes me.", "If you're wondering about the Records Basement elevator, it wants Form 13-B, and nobody has one. I did apply for one, dear, but it turns out the application form is a 13-B.", "I'd do more for you if I could, dear, truly I would. I'd need a permit to help you, though, and I have it on good authority that I shan't be getting one.", "Ten years ago I stamped the royal funeral forms myself, dear: one for the king and one for the queen. My hand shook on both of them.", "There was a third form, for the little prince, and I never filed it: no remains, no certificate. ...You've gone very still, dear. People only do that when the form is about them."],
"npc.matching.intro": ["krrrshhh... beep-boop... sorry, that's my dial-up greeting. it takes about forty seconds to get all the way through, and around here that counts as an outburst.", "i'm Kyle, deceased since '09. i was runner-up for employee of the month in 2009 too, but Agnes won it, because Agnes always wins it, and honestly she probably should.", "fun fact: ten years ago i filed the big transfer form. the peacock drafted it and handed it to me on my way to the rec room, so... a tuesday. didn't read it, though. who reads forms?", "...oh. right. we're Necrocrats, and reading forms is kind of our whole thing. i think about that a lot more than i let on, mostly when it's quiet in here, and it's always quiet in here.", "so, um, do you wanna play something? you flip two cards at a time and try to match up the pairs. i made all the cards myself, so please be nice about the drawings."],
"npc.matching.return": ["my virtual pet died again, which makes seven times this week, and i'm starting to think it might be me. i'll hatch another one anyway. it's a little egg, but it's a big commitment.", "wanna play another round while it hatches? i shuffled the cards and everything, and i only dropped them twice."],
"npc.matching.return.freed": ["the queue moved. it actually moved! agnes called my number at 3am and i was away from my desk, so she just... called it again. nobody's ever called me twice before.","wanna play one more round before i pass on? i'm kidding, probably. i burned you a mix cd just in case, though, and track four is mostly me saying sorry about a tuesday."],
"npc.pip.intro": ["This is Requisitions, and I am Clerk Ledgerbone, junior clerk, third class. Cards are issued here in triplicate, and every one of them is Necrocrat-issue: authorized, stamped and slightly haunted.", "For the record, it is the stamp that is haunted, and not the cards. It applied to the new management for a raise, the application was denied, and it has taken the matter very personally ever since.", "I must inform you that there are no returns and no exchanges. An exception may be requested on Form 13-B, which I gather you have already heard about."],
"npc.pip.return": ["You are welcome to requisition something, or simply to stand near the desk. A visitor makes me look busy, which I have noted in your favour, and I would be obliged if you stayed a while."],
"npc.quiz.intro": ["Ah, a candidate for re-certification. I am Director Ectomund, Compliance Examiner, and since examining is all I have done for three hundred years, I have begun to suspect that it is also all I am.", "The exam has not changed in that time: four questions on the Necrocrats, and every answer is somewhere on the premises, in the signs, the memos or the staff, for any candidate who troubles to look.", "The new management asked me to remove the questions on ethics. They are not in the exam. They are also, I notice, not in the building.", "Answer correctly and you will be rewarded; answer incorrectly and you will be rewarded rather less. I am not a monster, you understand, merely an examiner, though I grant you the distinction is a fine one."],
"npc.quiz.return": ["You are back, I see. Statistically you have failed already, as most candidates have, and I confess that I am rather looking forward to making it official."],
"npc.quiz.return.freed": ["Back again, I see. You may be glad to hear that the ethics questions have been returned to the building, though not yet to the exam, for I believe in one reform at a time.","Statistically, you will still fail a question, and statistically I will still enjoy it. That is not corruption. That is personality."],
"poster.hang_in_there": ["HANG IN THERE!", "(The poster is a skeleton on a branch. It has been there since 1650.)"],
"poster.performance": ["ETERNAL PERFORMANCE REVIEWS", "Review 1 of 4,000,000. Self-assessment due yesterday."],
"poster.safety": ["SAFETY FIRST", "You are already dead. Please do not make it worse."],
"poster.synergy": ["SYNERGY", "Together Everyone Achieves More. Eventually. Posthumously."],
"poster.wellness": ["WELLNESS WEDNESDAY", "Breathe in. Breathe out. (Optional for you.)"],
"puzzle.already": ["The tubes hum contentedly to themselves, and there is nothing left to route."],
"puzzle.bins": ["Harvest", "Accounts Payable", "Reaping", "Limbo", "Complaints", "Records", "Haunting", "Pest Control"],
"puzzle.hint": ["Every junction flips after a capsule passes. The first capsule only cares about the three junctions on its own path - set those first, then work out the next."],
"puzzle.intro": ["A wall of pneumatic tubes hums and hisses. Eight capsules wait in the intake, each stamped with its destination department.", "Seven junctions sit in the lines. Every junction flips after a capsule passes through it. Set the starting position of each, then send them down."],
"puzzle.solved": ["Every soul lands in the right department. The tubes cough politely and drop a small, heavy parcel in the tray."],
"puzzle.souls": ["Mr. Hargrove", "Dame Wilhelmina", "Little Timmy B.", "A Very Tired Clerk", "The Mayor (acting)", "Gertrude, 3rd Floor", "Sir Reginald Pent", "Unknown (Please Hold)"],
"quest.dna_audit.active": ["Two items remain outstanding: pass Director Ectomund's quiz, and find one hidden stash in the filing mazes. The stashes are kept in corners that nobody visits, which in this building describes most corners."],
"quest.dna_audit.done": ["The audit is closed, and the auditors have gone home, which for them means going back to their desks. Your part in it is on file, and I have filed it somewhere I shall be able to find it again."],
"quest.dna_audit.offer": ["Compliance is conducting an audit, and I am required to supply a fresh pair of hands for two items. Item one is to pass Director Ectomund's re-certification quiz. Item two is to find a hidden stash in the filing mazes.", "I would go myself, but policy forbids me to leave the desk, and in any case my legs are on loan to Accounts. I filed for their return some time ago, and I have not yet had a reply."],
"quest.dna_audit.ready": ["The quiz is passed and a stash is found, so both boxes may be ticked, and I shall tick them in ink. ...Oh. Oh, that is lovely. I had quite forgotten what it is like to finish something.", "Please accept this commendation on behalf of Requisitions. I would advise you not to try to cash it, as Accounts would enjoy the attempt a good deal more than you would."],
"quest.dna_backlog.active": ["It's three of the roaming staff, dear, and you'll find them wandering on any floor. Do see that they're processed and not promoted, won't you? I mixed the two up once, and he's been my supervisor ever since."],
"quest.dna_backlog.done": ["The backlog's clear, dear, and I expect it'll be full again by Thursday, but that's Thursday's business. It's nice to have a quiet moment at the desk. I don't get many of them."],
"quest.dna_backlog.offer": ["Oh, good, somebody with a pulse. I've a backlog to clear, dear, and I'm sorry to say this one walks about: three staff went feral over a deadline from the new management, and now they wander the floors.", "Would you process three of them for me, dear? By duel, I mean, and any floor will do. We aren't allowed to raise a hand to a colleague, you see, and you aren't one, because you never filled out the form."],
"quest.dna_backlog.ready": ["That's three, dear, and it clears the backlog. I couldn't tell you how many forms that closes, because I stopped counting in 1987, but it's a weight off this desk and I'm grateful. Here's your bonus."],
"quest.dna_onboarding.active": ["Punch in at the time clock by the front desk, and pour a cup at the coffee machine here. You can do them in either order, if that helps. HR isn't fussy about which comes first; it only likes to watch."],
"quest.dna_onboarding.done": ["You're officially one of us now, which I hope is all right. I wouldn't read the contract, though, if I were you. I read mine all the way through, once, and I've been in line ever since."],
"quest.dna_onboarding.offer": ["You're new to the floor, aren't you? Then I'm ever so sorry, but there's mandatory onboarding. You punch in at the time clock by the front desk, and you pour yourself a cup from the breakroom machine, just here.", "Please don't skip it, if you don't mind my asking. HR lives in the walls here, and these days HR reports to him, so I try not to lean on anything. It feels a bit like telling them things."],
"quest.dna_onboarding.ready": ["Oh, you've punched in, and you've had your coffee, and nobody's been written up for anything! That's your onboarding done, so here's your welcome kit.", "The welcome is really the main part of the kit, so: welcome. I hope that came out warmly. I've had years in the queue to practise it, and I've never had anybody to say it to until now."],
"quiz.not_passed": ["That is not a pass. Study the signs and come back; there is no limit on attempts, and I will be here. I am always here."],
"quiz.repeat": ["Re-certified again. For the paperwork, the Department pays you a small processing fee. It has never paid in that direction before."],
"quiz.result.0": ["Zero. That is impressive in its own way, but it earns you nothing.", "Try again. The signs aren't going anywhere. Since the transfer, neither is anyone here."],
"quiz.result.1": ["One correct, which earns you a token. I have noted your potential in the margin, in very small writing."],
"quiz.result.2": ["Two. Half-credit, and half-credit is the highest honour a Necrocrat can hope for."],
"quiz.result.3": ["Three correct, one shy of perfect. Take your reward; a perfect score would have made me suspicious."],
"quiz.result.4": ["Four correct. Perfect! I have recorded my joy in triplicate, and I must ask you not to make me demonstrate it.", "You are now Certified Deceased, Class A. The reward is real; the title is honorary."],
"sign.coffee": ["COFFEE MACHINE", "For living staff only. Undead: use the Decaf Crypt."],
"sign.cubicle_farm_a": ["CUBICLE FARM A", "Please do not personalize your cubicle. Yes, haunting counts."],
"sign.cubicle_farm_b": ["CUBICLE FARM B", "Hot-desking is permitted. Hot-desking has been banned. See memo."],
"sign.elevator_bank": ["ELEVATOR BANK", "Floors served: Lobby, Records, Quarterly Reviews, Under Renovation."],
"sign.elevator_rule": ["RECORDS BASEMENT ELEVATOR", "Form 13-B required. No form, no floor."],
"sign.executive": ["EXECUTIVE FLOOR", "Staff beyond this point are dead. Executives were dead before it was fashionable."],
"sign.exit": ["THE CHECKPOINT ROAD","To {town}. Permit stamped in triplicate by Prudence Pallor. Sunlight not guaranteed. Mind the potholes."],
"sign.filing_maze": ["FILING DEPARTMENT", "If you are lost, you are in the correct place."],
"sign.fun_day": ["MANDATORY FUN DAY - THIS FRIDAY", "Attendance is compulsory for all staff, including the undead.", "Cake provided. Cake will not be eaten."],
"sign.heal_couch": ["BREAKROOM COUCH", "Eternal rest, 15 minute limit."],
"sign.lobby_main": ["DEPARTMENT OF NECROTIC AFFAIRS", "A Division of Afterlife Services and Labor", "Under New Management (Authorization Valid)"],
"sign.mailroom": ["MAIL ROOM", "All souls routed by pneumatic tube. Souls routed incorrectly will be re-routed. Eventually."],
"sign.main_dungeon": ["THE HALL OF FINAL APPROVALS", "Where all things are authorized: life, death, resurrection and the afterlife.", "Appointment required. Estimated wait: 400 years. Waiting room not included."],
"sign.matching": ["THE REC ROOM", "Open Tuesdays, when nothing may be filed (Rule 1). Please do not feed the Top 8."],
"sign.mini_dungeon": ["SUB-BASEMENT 3: QUARTERLY REVIEWS", "Three meetings. Mandatory. No snacks."],
"sign.motto": ["OUR MOTTO:", "\"Your Death, Our Priority.\""],
"sign.now_serving": ["NOW SERVING:", "THREE (since 1291)", "(Estimated wait for number four: 400 years. The Department of Necrotic Affairs appreciates your patience.)"],
"sign.printer": ["PRINTER", "Out of toner. Out of body. Contact IT (deceased). Please specify which problem."],
"sign.puzzle": ["PNEUMATIC SOUL ROUTING", "Set every junction. Send the souls. Do not send them to Accounts Payable."],
"sign.quiz": ["COMPLIANCE TESTING", "Annual re-certification: 4 questions. Failure is not an option. It is a form."],
"sign.records": ["RECORDS BASEMENT", "Every life, filed under 'Pending'."],
"sign.filed_complaint": ["FILED COMPLAINT", "A complaint, filed in 1873, about the filing system. It is filed under C, for Complaint, and also under F, for Filing, and also under P, for Pending.", "The response is filed under R. The response is blank."],
"shrine.used": ["The stamp has been used and the form is complete. Nothing else will be approved today, or any other day."],
"sign.requisitions": ["REQUISITIONS", "Cards, in triplicate. Souls, in quadruplicate."],
"sign.suggestion_box": ["SUGGESTIONS", "All suggestions are read by a committee that has been dead since 1979."],
"sign.take_number": ["DECEASED?", "TAKE A NUMBER.", "Your assigned number is a number. Requests for a better answer require a new number."],
"sign.time_clock": ["PUNCH IN. PUNCH OUT.", "(Punching other employees is not covered by your plan.)"],
"ui.exit.body": ["Leaving the D.N.A. ends this visit. Town heals you fully; defeated staff will be back next time. Exit permit 12-X has been auto-approved. This time."],
"ui.exit.title": ["Walk back to town?"],
"ui.mini.body": ["Three meetings in a row. Your HP carries from one to the next and nothing heals in between. Win all three for a unique Necrocrat card."],
"ui.mini.body_cleared": ["You have already earned the unique card here. You can still sit through the meetings for gold and XP. HP carries over; nothing heals in between."],
"ui.mini.button": ["Go down"],
"hud.objective.freed": ["The D.N.A., liberated on a technicality: the Lobby and Breakroom are safe. HP does not come back after battles - rest on the Breakroom Couch, or ride up to town."],
"ui.exit.body.freed": ["Leaving the D.N.A. ends this visit. Town heals you fully, and you no longer need an exit permit. Nobody does, though we're all still a little scared of the pen."],
"sign.lobby_main.freed": ["DEPARTMENT OF NECROTIC AFFAIRS", "A Division of Afterlife Services and Labor", "Authority Restored (Authorization Revoked on a Technicality)"],
"sign.authorization": ["NOTICE OF TRANSFER OF AUTHORITY", "Form 1-A, submitted, reviewed, approved, notarized and filed. Authority over all Necrocrat government is hereby transferred to {villain}.", "This transfer is valid. If you disagree, please submit Form 1-B. Form 1-B is available from the person who wrote the transfer."],
"sign.authorization.freed": ["NOTICE OF REVOCATION", "Form 1-A has been found to be filed on a Tuesday. Tuesday is not a business day in this building.", "The transfer is void. Thank you for your patience. Please ignore the previous notice, the notice before that, and the notice about the notices."],
"sign.new_management": ["NEW MANAGEMENT", "By order of {villain}, all personnel are required to follow all rules, permits and procedures, including the new ones.", "This is not oppression. This is policy."],
"sign.new_management.freed": ["OLD MANAGEMENT", "Back from retirement, and delighted to be here. Rules and procedures have been reduced from 40,000 to a more reasonable 39,000."],
"sign.permit_to_stand": ["PERMIT TO STAND", "Standing in a hallway for more than 30 seconds requires a Permit to Stand (Form 7-S).", "Form 7-S requires a Permit to Fill in Forms (Form 7-F). Form 7-F requires a signature. The signature requires you to stand still."],
"sign.permit_to_stand.freed": ["STAND WHERE YOU LIKE", "Standing, sitting and lying down are now permitted. Please choose for yourself. We realise this may take practice."],
"sign.now_serving.freed": ["NOW SERVING:", "EVERYONE (since this morning)", "(The number machine has been switched off. Please just come in.)"],
"sign.main_dungeon.freed": ["THE HALL OF FINAL APPROVALS", "Formerly where all things were authorized. The doors are now open, and the form is optional.", "Estimated wait: some minutes. Waiting room included, with magazines."],
"npc.dolores.intro.freed": ["I'm head of the whole Department now, dear, and you'll notice I'm still at the front desk. They did give me a big office, but nobody waits in a big office. They wait out here, so this is where I'll be.", "Mortimer's in the Waiting Room as number 4,000,214, learning to wait. He isn't very good at it yet, dear, but he is trying, and Gerald has been ever so kind to him.", "And that form I never filed, dear, the third one. I've kept it in my drawer for ten years, just in case, and I think I'll keep it there a little longer. Something tells me it won't be needed."],
"npc.dolores.return.freed": ["The authorization is still valid, dear, but there's a rule above it now: everyone who comes through that door is treated as a person.", "Prudence is my deputy now, dear, and she's taken to it beautifully. She's a good deal gentler than she used to be, and I'm told that the same is true of me."],
"npc.barnaby.intro.freed": ["Oh, it's you! It's Gerald, the barista, and as of this morning it's Number 4,000,212: CALLED. I'm sorry, I'm still a bit wobbly. I didn't know what to do with my hands, so I made coffee.", "Agnes switched the queue machines off and called every number herself, one by one, and she thanked each of us for waiting. It took her all night, and she never once sat down.", "Please, have a cup. It's free. The machine is feeling generous today, and for once so am I."],
"npc.barnaby.return.freed": ["There's still no cream and no sugar, I'm afraid, and I am sorry about that. But hope's back in stock, and I'm trying not to use it all at once.", "My number's been called, you know, really and truly called. I asked Hob if I might make one more pot before I go, and he told me to take my time, so I'm making it last.","Mortimer's Number 4,000,214 now, and you were 4,000,213, so you'd have stood right between us. I wouldn't mention it to him, though, if that's all right. He goes very quiet when it comes up."],
"npc.pip.intro.freed": ["Clerk Ledgerbone, Requisitions. I am pleased to report that the stamp has stopped haunting the premises, now that it has been given its raise.", "It does not know what to do with itself, and I must admit that neither do I. In the meantime the cards are issued in triplicate, as they always have been."],
"npc.pip.return.freed": ["I am informed that I am now allowed to be unbusy. I keep reaching for the stamp to certify it, and then remembering that nobody has asked me to.", "I have been practising, however. Just now I stood here for one whole minute and filed nothing at all, and I do not mind telling you that it was exhilarating."],
"memo.new_rules": ["NEW RULES: EFFECTIVE IMMEDIATELY", "Rule 40,001: All rules must be followed.", "Rule 40,002: All rules include this rule.", "Rule 40,003: See rule 40,002."],
"memo.new_rules.freed": ["REVISED RULES", "Rules 40,001 through 40,003 have been repealed. Please allow a moment for the notices to catch up."],
"poster.compliance": ["COMPLIANCE IS FREEDOM", "(Freedom is subject to approval.)"],
"poster.compliance.freed": ["COMPLIANCE IS FINE", "(Freedom is also fine. Choose what you like.)"],
"effect.buff.name": ["Approved Procedure"],
"effect.buff.flavor": ["Every Necrocrat here is properly stamped, countersigned and notarized. It makes them very hard to argue with."],
"effect.debuff.name": ["Unauthorized Activity"],
"effect.debuff.flavor": ["Beefcakes do things on the spot, which here requires a permit, in triplicate, and a fee. The fee is also a form."],
"freed_npc.agnes": ["Agnes Overdue, head of the D.N.A. Yes, dear, me. The office goes to the senior-most applicant, and I filed more appeals than anyone. I have never been so annoyed to win anything.", "I only ever wanted to leave, and I will, soon enough. But I'm putting this place right first, so that nobody else has to wait as long as I did.", "Everyone in that queue was somebody, dear, and the dead deserve to be treated as people. No order outranks that, not his and not anyone's.", "And you, dear. You were a number in somebody's file once, weren't you? I can see it in the way you hold your shoulders.", "Never let anyone file you under 'subject' again."],
"ruler.statue": ["STATUE OF MORTIMER GRIMSBY, CE-No", "Statue pending approval. Do not look at it until it has been approved."],
"ruler.statue.freed": ["FORMER STATUE OF MORTIMER GRIMSBY", "(Authorization revoked. The statue has been asked to leave. It has taken a number.)"],
"ui.main.title": ["The Hall of Final Approvals"],
"ui.main.body": ["The Hall of Final Approvals governs life, death, resurrection and the afterlife. Its authority controls the Necrocrats. HP carries in from the zone; only the waiting room heals. Beat Mortimer Grimsby, CE-No, to free the D.N.A."],
"ui.main.body_cleared": ["The Hall of Final Approvals is open and, somehow, more efficient. You can still walk the departments for gold and XP. HP carries in from the zone; nothing heals except in the waiting room."],
"ui.main.button": ["Take a number and go in"],
"dungeon.ha_lobby.title": ["The Lobby of Final Approvals"],
"dungeon.ha_lobby.blurb": ["A cavernous reception hall under a single sign: ALL THINGS REQUIRE AUTHORIZATION. THIS INCLUDES THE SIGN."],
"dungeon.ha_lobby.before": ["You step through the doors and a small grey machine hands you a ticket: 4,000,213. The display above the desk says NOW SERVING: 3.", "A clerk looks up, sighs, and says, in a voice like a filing cabinet closing: \"The authorization is valid. Please wait.\""],
"dungeon.ha_number.title": ["Take a Number"],
"dungeon.ha_number.blurb": ["You are number 4,000,213 and they're serving number 3. It's a very long queue, and it's the only way forward."],
"dungeon.ha_intake.title": ["The Department of Intake"],
"dungeon.ha_intake.blurb": ["An intake clerk demands to see your paperwork, and the inspection turns out to be mostly a fight."],
"dungeon.ha_forms.title": ["Forms About Forms"],
"dungeon.ha_forms.blurb": ["A counter with a very long sign: FORM 13-B REQUIRES FORM 13-A. FORM 13-A REQUIRES FORM 13-B. PLEASE SEE A CLERK."],
"dungeon.ha_duplicates.title": ["The Department of Duplicate Forms"],
"dungeon.ha_duplicates.blurb": ["Every form here has a twin, and every twin has a twin of its own. The clerks are undead and, understandably, a bit short."],
"dungeon.ha_waiting.title": ["The Waiting Room"],
"dungeon.ha_waiting.blurb": ["A very comfortable waiting room, whose magazines are 600 years old. Restore HP."],
"dungeon.ha_waiting.after": ["You wait until your legs ache, and when you look up at the clock above the door it tells you that four minutes have passed.", "The clock is lying, and from the look of it, somebody ordered it to."],
"dungeon.ha_audit.title": ["The Audit"],
"dungeon.ha_audit.blurb": ["An auditor examines your deck for compliance. Three cards will be weighed on the Scale of Approved Expenditures."],
"dungeon.ha_mailroom.title": ["The Mailroom of Lost Souls"],
"dungeon.ha_mailroom.blurb": ["Souls arrive here by pneumatic tube when nobody knows where else to put them. They are not happy about it."],
"dungeon.ha_lost.title": ["Lost and Found (Souls Edition)"],
"dungeon.ha_lost.blurb": ["A counter piled high with misfiled belongings, under a sign: IF YOU FIND SOMETHING, YOU MAY KEEP IT. IF YOU LOSE SOMETHING, SEE A CLERK."],
"dungeon.ha_compliance.title": ["Compliance Enforcement"],
"dungeon.ha_compliance.blurb": ["The department that enforces the rules that enforce the rules. Their officer is perfectly polite. (Elite)"],
"dungeon.ha_compliance.after": ["The officer folds his clipboard and, with a courteous nod, points you toward the Appeals Department.", "\"You may appeal,\" he says. \"You will lose, but you may appeal, and I would not want you to leave here thinking otherwise.\""],
"dungeon.ha_appeals.title": ["The Department of Appeals"],
"dungeon.ha_appeals.blurb": ["A judge in an old powdered wig weighs your case on a pair of scales made of paperwork."],
"dungeon.ha_notary.title": ["The Notary's Counter"],
"dungeon.ha_notary.blurb": ["Every important document in the Hall is stamped, signed and witnessed here, the transfer of authority included. The notary is still finding blue-green feathers."],
"dungeon.ha_clerk.title": ["The Appeals Court"],
"dungeon.ha_clerk.blurb": ["The Appeals Court's Undersecretary Vellum, Mortimer's deputy, defends the transfer of authority to the last paragraph. He has never once been thanked. (Elite)"],
"dungeon.ha_boss.title": ["The Office of Final Approval"],
"dungeon.ha_boss.blurb": ["A vast office with a single desk, a single stamp, and one very patient authority."],
"dungeon.ha_boss.before": ["Mortimer Grimsby, CE-No, looks up from an endless pile of paperwork, his face as smooth as a blank form and his stamp the size of a tombstone.", "\"You do not have an appointment. That is irregular. However, the authorization is valid, and under it every visitor is entitled to a hearing.\"", "\"The answer is no. The question is irrelevant, but you may state your case anyway.\"", "\"You have, according to the clock, four hundred years.\""],
"dungeon.ha_boss.after": ["The stamp falls from Mortimer's hand, and the paperwork goes still.", "At the very bottom of the pile, under every form, every stamp and every signature, is a small note in a junior clerk's handwriting: FILED ON A TUESDAY. SORRY. - K.", "\"...Oh,\" says Mortimer. \"Oh, no. Tuesday is not a business day in this building.\"", "\"The authorization was valid, and it was always valid. But the office is now vacant, and policy is policy.\""],
"challenge.ha_audit.title": ["The Audit"],
"challenge.ha_audit.text": ["The auditor lays three cards on the Scale of Approved Expenditures. A reasonable total will be stamped, and an unreasonable one will be fined."],
"event.ha_take_a_number.title": ["Take a Number"],
"event.ha_take_a_number.body": ["You hold ticket 4,000,213, and the display says NOW SERVING: 3. The queue snakes through the lobby, up the stairs and out of a window.", "A clerk offers you a form, a coffee and a pitying look."],
"event.ha_take_a_number.choice.0": ["Wait your turn (it will be a while)"],
"event.ha_take_a_number.choice.1": ["Pay the Expedite Fee (30 gold)"],
"event.ha_take_a_number.choice.2": ["Cut in line"],
"event.ha_take_a_number.result.0": ["You wait for a very long time, until a clerk takes pity and the polite ghost ahead of you shares a biscuit, apologising that it's stale.", "You are called in, eventually, rested and a little richer. Waiting, in the Hall, is a kind of work."],
"event.ha_take_a_number.result.1": ["The Expedite Fee is an official fee with an official receipt. A tiny clerk stamps your ticket, a door opens, and you feel oddly refreshed."],
"event.ha_take_a_number.result.2": ["You cut in line, and forty thousand undead clerks turn to glare. You're processed immediately, and a little roughly."],
"event.ha_form_a.title": ["Form 13-B"],
"event.ha_form_a.body": ["To pass the counter you need Form 13-B. The clerk says Form 13-B requires a Form 13-A, which she will gladly give you, once you have submitted Form 13-B."],
"event.ha_form_a.choice.0": ["Ask for Form 13-A"],
"event.ha_form_a.choice.1": ["Pay the clerk 25 gold to look the other way"],
"event.ha_form_a.result.0": ["\"Form 13-A,\" she says. \"Certainly. It requires a Form 12-F, which requires a strong cup of tea.\""],
"event.ha_form_a.result.1": ["She doesn't look the other way. She looks at the gold, and the gold is accepted.", "She stamps something you cannot read, and the way ahead opens."],
"event.ha_form_b.title": ["Form 12-F"],
"event.ha_form_b.body": ["Form 12-F is available at the Counter of Form 12-F. The Counter of Form 12-F is closed until Form 13-B has been filed."],
"event.ha_form_b.choice.0": ["Ask for Form 11-D"],
"event.ha_form_b.choice.1": ["Argue"],
"event.ha_form_b.result.0": ["\"Form 11-D,\" she says. \"A simple form. It requires only your signature, in blood.\"", "\"Please don't worry, the blood is optional. The signature is not.\""],
"event.ha_form_b.result.1": ["You argue until a tiny stamp appears from nowhere and hits you, which hurts a little.", "The clerk says: \"That was a warning. The authorization is valid.\""],
"event.ha_form_c.title": ["Form 11-D"],
"event.ha_form_c.body": ["Form 11-D is the last form in the chain. It is one line long: \"I, the undersigned, request Form 13-B.\" You sign.", "A stamp thunders. Forms 13-B, 13-A and 12-F all appear at once, in perfect order."],
"event.ha_form_c.choice.0": ["Submit all the forms and claim the reward"],
"event.ha_form_c.choice.1": ["Rest in the clerk's break room instead"],
"event.ha_form_c.result.0": ["Every form passes. A bureaucrat's tear of joy lands on the ink. You receive a stamped Form 13-B, a small refund and a commendation you cannot read."],
"event.ha_form_c.result.1": ["The clerk's break room is the most efficient room in the Hall. You are given a cup of tea, a biscuit and a lovely, quiet chair. You feel ready for the next department."],
"event.ha_notary.title": ["The Notary's Counter"],
"event.ha_notary.body": ["A very old notary sits behind a very high counter, a seal in one hand and a very large quill in the other. \"Everything in the Hall,\" he says, \"must be notarized.\"", "\"That includes visitors,\" he adds, and he looks you over as though deciding where the seal ought to go."],
"event.ha_notary.choice.0": ["Get your credentials notarized (50 gold)"],
"event.ha_notary.choice.1": ["Lie down in the notary's cot"],
"event.ha_notary.choice.2": ["Sell the notary a spare seal"],
"event.ha_notary.result.0": ["The seal comes down with a THUMP. You are, officially, a person. Your units feel more legitimate, and hit a little harder for it."],
"event.ha_notary.result.1": ["The cot is small, hard and incredibly comfortable. You sleep for a very official ten minutes, and wake refreshed, with the notary's seal printed on one cheek."],
"event.ha_notary.result.2": ["He pays in cash, takes no receipt, and tells you he never saw you. You have never felt more notarized."],
"dungeon.ha_number.before": ["A small silvery ghost is already in the queue, hugging an enormous stack of appeals tied with three kinds of ribbon. \"Number 4,000,213? There you are, dear. I've been keeping an eye out for you.\"", "\"Gerald in the breakroom is 4,000,212, so you two will be neighbours. He's a lovely man, and he's been waiting a very long while.\"", "\"I'm Agnes Overdue. I work the front desk, and on my lunch hours I appeal against the transfer. That's forty thousand appeals, dear, and every one denied, though lately they've started decorating the stamps.\"", "\"Come along with me, dear, because I know where the departments hide. And don't let anybody tell you the paperwork is forged. The authorization is valid, and that's what makes it so terrible.\""],
"dungeon.ha_number.before.met": ["A small silvery ghost waves from the queue, the ribboned stack of appeals under one arm. \"Number 4,000,213. I saved your place, dear, though I don't suppose anybody would have taken it.\"", "\"Gerald in the breakroom is 4,000,212, so you two will be neighbours. He's a lovely man, and he's been waiting a very long while.\"", "\"I spent my lunch hour on appeal forty thousand and one, and it came back denied with a very nice stamp. I do try not to take it personally, but they've had a great many chances.\"", "\"Come along with me, because I know where the departments hide. And do remember, whatever they tell you up there, that the authorization is valid. That's what makes it so terrible.\""],
"dungeon.ha_forms.before": ["Two aisles over, Agnes is filling in a form with a very stubby pencil. \"This is Form 27-C, dear, and my third attempt at it. It needs a 27-B attached, and the 27-B needs a 27-C.\"", "\"They keep stamping it DENIED and writing Irregular in the margin, but don't you mind me, dear. I've filed worse than this in my time, and I kept the receipts for all of it.\""],
"dungeon.ha_records.before": ["The Records Labyrinth is a canyon of filing cabinets that goes down further than it goes up. At its heart, under glass, lies the original transfer: the Necrocrat Path, signed over to {villain}.", "It's flawless: submitted, reviewed, approved, notarized and filed, without a single box left empty.", "Agnes reads over your shoulder and stops at one clause. Under HEIR OF THE FORMER SOVEREIGN it says: \"Deceased (presumed). Remains: not on file.\"", "\"Irregular,\" says Agnes, very quietly, and looks at it for a long time. \"A presumed death with no remains on file is an incomplete form.\"", "\"Someone should look into it, dear, because this form doesn't tell us what happened to the boy.\" You realise you have been holding your breath."],
"dungeon.ha_clerk.before": ["Undersecretary Vellum squares his papers and does not look up. \"Noted. You wish to challenge the transfer of authority.\"", "\"The authorization remains valid, having been submitted, reviewed, approved, notarized and filed. You may appeal in triplicate, and the appeal will also be noted.\"", "\"Mr. Grimsby has asked me to hold the Court until his schedule opens, and I intend to hold it very well indeed. Noted.\""],
"dungeon.ha_clerk.after": ["Vellum squares his papers with great care. \"Noted,\" he says, very quietly. \"The authorization remains valid.\"", "For the first time, it sounds like a question."],
"cutscene.vacancy.1.speaker": ["Mortimer Grimsby"],
"cutscene.vacancy.1": ["The CE-No has been removed from office, and by policy the vacancy passes to the senior-most applicant on file. If you will allow me one moment, I will look it up.", "...The senior-most applicant on file is a ghost, with forty thousand appeals to her name and every one of them correctly submitted. For the record, Ms. Overdue, it is you."],
"cutscene.vacancy.2.speaker": ["Agnes Overdue"],
"cutscene.vacancy.2": ["Me? Oh, for pity's sake. I filed more appeals than anybody, living or dead, and this is what they give me for it?", "I only ever wanted to leave."],
"cutscene.vacancy.3.speaker": ["Mortimer Grimsby"],
"cutscene.vacancy.3": ["The procedure is clear, Ms. Overdue, and the office passes to you. I must advise you not to appeal it, because I would be obliged to deny you, and I find that I do not want to deny you anything more."],
"cutscene.vacancy.4.speaker": ["Agnes Overdue"],
"cutscene.vacancy.4": ["...Then I'll stay, Mortimer, though I'm not doing it for you. I'll stay until nobody has to wait as long as I did.", "Everyone in that queue was somebody, and the dead deserve to be treated as people. Helping the lost is the whole of the job. It always was.", "No order outranks that, Mortimer. Not his, and not yours. From today, everyone who comes to us is treated with respect."],
"cutscene.vacancy.5.speaker": ["Mortimer Grimsby"],
"cutscene.vacancy.5": ["...That is not in the handbook. I find myself wondering why it never was."],
"cutscene.vacancy.6.speaker": ["Agnes Overdue"],
"cutscene.vacancy.6": ["Then we'll write a new one. Take a number and wait with the others, Mortimer. You're right behind Gerald, and he'll show you how it's done."],
"freed_npc.prudence": ["Prudence Pallor, Deputy Head of the Department. For ten years I stamped DENIED on everything, because the paperwork was valid and I was too tired to ask whether it was right. I am sorry for it.", "{villain} did not need to corrupt us, you know, because our own rules did the work for him. These days I read a thing properly first, and I stamp APPROVED on whatever deserves it.", "The stamp is a good deal lighter than I remembered. I don't suppose you have anything with you that I could approve?"],
"freed_npc.mortimer": ["Mortimer Grimsby, formerly CE-No, currently number 4,000,214 in the Waiting Room of Eternity. Gerald was 4,000,212, and he has been very patient with me.", "You held 4,000,213, and you did not wait for it to be called. I find that I keep returning to that.", "I made others wait a great deal longer than you did, and every one of them was a person. I did not know that then, and it is considerably worse to know it now.", "The authorization was valid. I have begun to wonder whether that was ever the right question."],
}
quiz_questions = Array[Dictionary]([{
"a": ["Department of Necrotic Affairs", "Division of Nocturnal Accounting", "Directorate of Newly Arrived", "Department of Neglected Alumni"],
"correct": 0,
"q": "What does the D.N.A. stand for?",
"where": "sign.lobby_main, Lobby reception wall"
}, {
"a": ["\"Rest in Pieces\"", "\"Your Death, Our Priority.\"", "\"We Never Forget (Your Paperwork)\"", "\"Ask Again Tomorrow\""],
"correct": 1,
"q": "What is the Necrocrats' official motto?",
"where": "sign.motto in the Lobby; memo.motto on the Cubicle Farm B board"
}, {
"a": ["Form 7-Q", "Form 13-B", "Form 99-Z", "Form 1-A"],
"correct": 1,
"q": "Which form is required to ride the elevator to the Records Basement?",
"where": "sign.elevator_rule at the Elevator Bank; memo.records; Agnes Overdue's return dialogue"
}, {
"a": ["Mandatory Fun Day", "Mandatory Silence Hour", "Quarterly Haunting", "Casual Friday (Formal)"],
"correct": 0,
"q": "Which mandatory event is held every Friday?",
"where": "sign.fun_day in the Lobby; memo.fun_day in Cubicle Farm A"
}])
