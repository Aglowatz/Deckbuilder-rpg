[gd_resource type="Resource" script_class="ZoneStoryText" format=3]

[ext_resource type="Script" path="res://core/data/zone_story_text.gd" id="1_dna"]

[resource]
script = ExtResource("1_dna")
zone_id = "necrocrat"
lines = {
"enemy.courier": ["Urgent delivery. Signature required. Signature will be taken. Delivering a Notice of Compliance, in triplicate."],
"enemy.intern": ["Unpaid. Undead. Eager to make a good impression on the new management. It does not know the new management is evil. It knows it is valid."],
"enemy.manager": ["Wants a quick sync. It has wanted one since 1994. Currently enforcing the new regime's regulations with great, unenthusiastic precision."],
"fx.chest": ["A hidden stash!"],
"fx.coffee_bad": ["The machine screams. The coffee screams. You drink it anyway. -1 life."],
"fx.coffee_gold": ["A coin rolls out of the dispenser. The machine regrets nothing. +gold."],
"fx.coffee_good": ["The coffee machine gurgles and produces something almost drinkable. +life."],
"fx.coffee_great": ["Perfect brew! The machine seems proud of itself. Full recovery of... something."],
"fx.heal_already": ["You are already as rested as the dead get."],
"fx.heal_couch": ["You sink into the Breakroom Couch. Somehow it is both ice cold and slightly damp. Life restored."],
"fx.hit": ["Delivery! Signature taken. (-2 life)"],
"fx.main_dungeon": ["The Executive Floor's great doors hang open, just a crack. Beyond them is a hall of endless desks, glowing lamps and stamps that thump like heartbeats. A voice from the dark says: PLEASE TAKE A NUMBER."],
"fx.printer_ok": ["The printer shudders, whines, and hands you a card, still warm. Lawfully yours."],
"fx.printer_poor": ["PAPER JAM. The printer regrets to inform you that your fee is non-refundable."],
"fx.punch_again": ["You're already punched in. The clock refuses to double-count your suffering."],
"fx.punch_in": ["You punch in. The clock says 'Welcome back, Pending.' A small buff glimmers on you."],
"fx.suggestion": ["You drop a suggestion into the box. A moment later something is dropped back out."],
"fx.suggestion_empty": ["The suggestion box is empty now. The committee has read your suggestion. It wasn't implemented."],
"fx.wake": ["You wake up in the Lobby, on a couch with a 15-minute limit.", "A form is already filled out in your name. It says you are 'Pending'. It also says 'Valid'."],
"hud.objective": ["The D.N.A.: the Lobby and Breakroom are safe (pending approval). Life does not come back after battles - rest on the Breakroom Couch, or ride up to town. Every door in the building requires a form. The authorization is valid."],
"match.first": ["First time clearing it? Here's a bonus. It's not much. It's a memory. Literally, it's a memory game."],
"match.intro": ["Flip two cards at a time. Find all 8 pairs in 14 moves or fewer. Fewer moves, better stars."],
"match.lose": ["Out of moves. That's fine. My virtual pet lasted longer than that, and it died in an hour."],
"match.pairs": ["Dial-Up Modem", "Top 8 Friends", "Late Fee Receipt", "Virtual Pet (Deceased)", "Flip Phone Text", "Burned Mix CD", "Away Message", "Mix Tape"],
"match.win": ["Nice flipping! You're a natural. Better than the Top 8. Much better."],
"memo.coffee": ["MEMO: THE COFFEE MACHINE", "For living staff only. Undead staff, please use the Decaf Crypt.", "This is the fourth memo."],
"memo.cubicle_coffin": ["MEMO: CUBICLE 12-C", "Whoever put a coffin in 12-C: you may keep it.", "Please stop billing it as 'ergonomic seating'."],
"memo.fun_day": ["MEMO: MANDATORY FUN DAY", "Reminder: Mandatory Fun Day is mandatory.", "Fun that is not mandatory will not be counted as fun."],
"memo.hr": ["HR REMINDER", "'Rest in Peace' is not an approved out-of-office message."],
"memo.lunch": ["BREAKROOM REMINDER", "Labelled lunches are not safe. Unlabelled lunches are not safe. Lunches are not safe."],
"memo.motto": ["ALL-HANDS REMINDER", "Our motto is \"Your Death, Our Priority.\" Please stop saying \"Your Death, Our Problem.\""],
"memo.parking": ["FACILITIES", "Parking Lot D has been renamed Parking Lot Dead. Please stop asking why."],
"memo.records": ["RECORDS NOTICE", "To access the Records Basement, bring Form 13-B.", "Form 13-B is available from Form 13-A. Form 13-A is available from nobody."],
"memo.reorg": ["REORG NOTICE", "Due to a restructuring, you will now report to the person who reports to you.", "Both of you have been dead since Tuesday. Both of you report to Malvane."],
"npc.barnaby.intro": ["Oh! A customer! Barnaby, breakroom barista. I make coffee for people who can't taste it. It's very freeing.", "The machine in the corner is temperamental. Half the time it's a miracle. The other half, it's a different kind of miracle.", "New hires always have to do onboarding. Punch the clock, grab a cup. Easy. Compulsory. Same thing. Under the new management, a lot of things are compulsory. The coffee is one of the few things we're still allowed to enjoy. Quietly."],
"npc.barnaby.return": ["Cream? I have none. Sugar? None. Hope? Out of stock, but we're expecting a shipment in 2090."],
"npc.dolores.intro": ["Welcome to the Department of Necrotic Affairs. Name? ...Doesn't matter, you're in the system as 'Pending'.", "I'm Dolores, front desk. Deceased since 1987, employee of the month since 1987. Nobody else qualified.", "Take a number. We're serving number one. Have been for seven hundred years. He's very thorough.", "Look, I'll be honest. Ten years ago, the Usurper's people submitted some paperwork. It was reviewed, approved, notarized and filed. Properly. Now the whole department works for him. I know he's evil. We all know. But the authorization is valid."],
"npc.dolores.return": ["Back again? You know, loyalty is rewarded here. Not with money. With more work.", "Records Basement needs Form 13-B for the elevator. I don't have one. Nobody does. It builds character. I'd like to help you more, but I would need a permit to help you, and I have it on good authority that I won't get one."],
"npc.matching.intro": ["*krrrshhh... beep-boop-BEEEEEE-krrrrrshhh...* Sorry. That's my greeting. It's how I say hello. It takes forty seconds. Dial-up, baby.", "I'm Skylar. Last employee of the month of 2003. My away message still says 'brb, getting a snack'. That was my snack. In 2003. I have been here through the transfer. I filed the paperwork myself. I did not read it.", "I've got a top 8 of friends. It's me, me, a guy I met in a chatroom, and five ghosts. The algorithm moved me to number nine.", "I owe the video store a fine. Eleven dollars for a movie I returned in 2001. They're still mad. They're also closed.", "Wanna play? Flip two cards, match the pair. I burned the cards myself. A mix CD with forty minutes of the same song. It's fine."],
"npc.matching.return": ["My virtual pet died again. That's seven times this week. It's okay. I'll hatch another one. I always do.", "Flip-phone texting, nine presses for one letter, and I still sent you a good message. Anyway: wanna play?"],
"npc.pip.intro": ["Requisitions! Pip, junior clerk, third class, third time dying. Cards, in triplicate.", "Everything here is Necrocrat-issue: authorized, stamped, haunted. The stamp is haunted. The stamp wants a raise. The stamp has a new boss, and he is a lot less fun.", "No returns. No exchanges. No refunds. Exceptions require Form 13-B, which, well. You've heard about 13-B."],
"npc.pip.return": ["Requisition something! Or at least stand near the desk. It makes me look busy."],
"npc.quiz.intro": ["Ah. A candidate for re-certification. Lethe, Compliance Examiner. I examine. It's all I do. It's all I am.", "Four questions about the Necrocrats of Afterlife Services and Labor. All answers are on the premises: signs, memos, the staff. The new management asked me to remove the questions about ethics. They are not in the exam. They are also not in the building.", "Answer correctly and you'll be rewarded. Answer incorrectly and you'll be rewarded less. I'm not a monster. I'm an examiner."],
"npc.quiz.return": ["Back to improve your score? Admirable. Statistically, it means you failed. Statistically, I enjoy it."],
"poster.hang_in_there": ["HANG IN THERE!", "(The poster is a skeleton on a branch. It has been there since 1650.)"],
"poster.performance": ["ETERNAL PERFORMANCE REVIEWS", "Review 1 of 4,000,000. Self-assessment due yesterday."],
"poster.safety": ["SAFETY FIRST", "You are already dead. Please do not make it worse."],
"poster.synergy": ["SYNERGY", "Together Everyone Achieves More. Eventually. Posthumously."],
"poster.wellness": ["WELLNESS WEDNESDAY", "Breathe in. Breathe out. (Optional for you.)"],
"puzzle.already": ["The tubes hum contentedly. Nothing left to route."],
"puzzle.bins": ["Harvest", "Accounts Payable", "Reaping", "Limbo", "Complaints", "Records", "Haunting", "Pest Control"],
"puzzle.hint": ["Every junction flips after a capsule passes. The first capsule only cares about the three junctions on its own path - set those first, then work out the next."],
"puzzle.intro": ["A wall of pneumatic tubes hums and hisses. Eight capsules are queued in the intake, each stamped with its destination department.", "Seven junctions sit in the lines. Every junction flips after a capsule passes through it. Set the starting position of each, then send them down."],
"puzzle.solved": ["Every soul lands in the right department. The tubes cough politely and drop a small, heavy parcel in the tray."],
"puzzle.souls": ["Mr. Hargrove", "Dame Odalys", "Little Timmy B.", "A Very Tired Clerk", "The Mayor (acting)", "Gertrude, 3rd Floor", "Sir Reginald Pent", "Unknown (Please Hold)"],
"quest.dna_audit.active": ["The quiz, and a stash. The stashes are in the corners nobody visits. So, basically, everywhere."],
"quest.dna_audit.done": ["Audit closed. The auditors went home. They live here, but they went to their desks."],
"quest.dna_audit.offer": ["Compliance is auditing. They need two things from a fresh pair of hands: pass the re-certification quiz, and find one of the hidden stashes in the filing mazes.", "I can't leave the desk. Policy. Also, I can't stand. Policy and anatomy. Whatever the audit is for, it is not for us."],
"quest.dna_audit.ready": ["You passed the quiz AND found a stash? You're basically middle management. Here's your commendation. Please don't cash it."],
"quest.dna_backlog.active": ["Three of them, remember. Processed, not promoted. Don't confuse the two."],
"quest.dna_backlog.done": ["The backlog is clear. It will be full again by Thursday. It's nice to have a moment."],
"quest.dna_backlog.offer": ["Oh good, a pulse. Well, a presence. I have a backlog. A literal one - it's wandering the floors.", "Three of the staff have gone feral over a missed deadline from the new management. Would you... process three of them? Gently? Or not? We're not allowed to hurt colleagues. You aren't a colleague. You haven't filled out the form."],
"quest.dna_backlog.ready": ["Three? That clears the backlog! Do you know how many forms that closes? Neither do I. Here - your bonus."],
"quest.dna_onboarding.active": ["Time clock, coffee machine. In that order or the other order. HR isn't picky."],
"quest.dna_onboarding.done": ["Onboarding complete. You're one of us now. Please don't read the contract."],
"quest.dna_onboarding.offer": ["New to the floor? Then it's mandatory onboarding. Punch in at the time clock, and have a cup from the machine.", "Don't skip it. HR will know. HR always knows. HR is in the walls. HR reports to him now."],
"quest.dna_onboarding.ready": ["Punched in, caffeinated, and compliant. Onboarding complete! Here's your welcome kit. The kit is a welcome."],
"quiz.not_passed": ["Not a pass. Study the signs and come back; there is no limit on attempts."],
"quiz.repeat": ["Re-certified again. The Department pays a small processing fee for the paperwork."],
"quiz.result.0": ["Zero. Impressive in its own way. Nothing for you. Try again; the signs aren't going anywhere."],
"quiz.result.1": ["One correct. A pulse of competence. Here's a small token of the Department's disinterest."],
"quiz.result.2": ["Two. Half-credit. Half-credit is the highest honor of the Necrocrats."],
"quiz.result.3": ["Three! One shy of perfect. Perfect would make me suspicious. Take your reward."],
"quiz.result.4": ["FOUR. Flawless. You are now Certified Deceased, Class A. The reward is real; the title is imaginary."],
"sign.coffee": ["COFFEE MACHINE", "For living staff only. Undead: use the Decaf Crypt."],
"sign.cubicle_farm_a": ["CUBICLE FARM A", "Please do not personalize your cubicle. Yes, haunting counts."],
"sign.cubicle_farm_b": ["CUBICLE FARM B", "Hot-desking is permitted. Hot-desking has been banned. See memo."],
"sign.elevator_bank": ["ELEVATOR BANK", "Floors served: Lobby, Records, Quarterly Reviews, Under Renovation."],
"sign.elevator_rule": ["RECORDS BASEMENT ELEVATOR", "Form 13-B required. No form, no floor."],
"sign.executive": ["EXECUTIVE FLOOR", "Staff beyond this point are dead. Executives were dead before it was fashionable."],
"sign.exit": ["ELEVATOR TO SURFACE", "(Town. Sunlight not guaranteed.)"],
"sign.filing_maze": ["FILING DEPARTMENT", "If you are lost, you are in the correct place."],
"sign.fun_day": ["MANDATORY FUN DAY - THIS FRIDAY", "Attendance is compulsory for all staff, including the undead.", "Cake provided. Cake will not be eaten."],
"sign.heal_couch": ["BREAKROOM COUCH", "Eternal rest, 15 minute limit."],
"sign.lobby_main": ["DEPARTMENT OF NECROTIC AFFAIRS", "A Division of Afterlife Services and Labor", "Under New Management (Authorization Valid)"],
"sign.mailroom": ["MAIL ROOM", "All souls routed by pneumatic tube. Souls routed incorrectly will be re-routed. Eventually."],
"sign.main_dungeon": ["THE HALL OF FINAL APPROVALS", "Where all things are authorized: life, death, resurrection and the afterlife.", "Appointment required. Estimated wait: 400 years. Waiting room not included."],
"sign.matching": ["THE REC ROOM", "Please do not feed the Top 8."],
"sign.mini_dungeon": ["SUB-BASEMENT 3: QUARTERLY REVIEWS", "Three meetings. Mandatory. No snacks."],
"sign.motto": ["OUR MOTTO:", "\"Your Death, Our Priority.\""],
"sign.now_serving": ["NOW SERVING:", "ONE (since 1291)", "(Estimated wait for number two: 400 years. The Regime of Final Approvals appreciates your patience.)"],
"sign.printer": ["PRINTER", "Out of toner. Out of body. Please contact IT (deceased)."],
"sign.puzzle": ["PNEUMATIC SOUL ROUTING", "Set every junction. Send the souls. Do not send them to Accounts Payable."],
"sign.quiz": ["COMPLIANCE TESTING", "Annual re-certification: 4 questions. Failure is not an option. It is a form."],
"sign.records": ["RECORDS BASEMENT", "Every life, filed under 'Pending'."],
"sign.requisitions": ["REQUISITIONS", "Cards, in triplicate. Souls, in quadruplicate."],
"sign.suggestion_box": ["SUGGESTIONS", "All suggestions are read by a committee that has been dead since 1979."],
"sign.take_number": ["DECEASED?", "TAKE A NUMBER.", "(You have been assigned a number. Your number is also a number.)"],
"sign.time_clock": ["PUNCH IN. PUNCH OUT.", "(Punching other employees is not covered by your plan.)"],
"ui.exit.body": ["Leaving the D.N.A. ends this visit. Town heals you fully; defeated staff will be back next time. Exit permit 12-X has been auto-approved. This time."],
"ui.exit.title": ["Ride up to town?"],
"ui.mini.body": ["Three meetings in a row. Your life carries from one to the next and nothing heals in between. Win all three for a unique Necrocrat card."],
"ui.mini.body_cleared": ["You have already earned the unique card here. You can still sit through the meetings for gold and XP. Life carries over; nothing heals in between."],
"ui.mini.button": ["Go down"],
"hud.objective.freed": ["The D.N.A., liberated on a technicality: the Lobby and Breakroom are safe. Life does not come back after battles - rest on the Breakroom Couch, or ride up to town."],
"ui.exit.body.freed": ["Leaving the D.N.A. ends this visit. Town heals you fully. You no longer need an exit permit. Nobody does. We are still a little scared of the pen."],
"sign.lobby_main.freed": ["DEPARTMENT OF NECROTIC AFFAIRS", "A Division of Afterlife Services and Labor", "Authority Restored (Authorization Revoked on a Technicality)"],
"sign.authorization": ["NOTICE OF TRANSFER OF AUTHORITY", "Form 1-A, submitted, reviewed, approved, notarized and filed. Authority over all Necrocrat government is hereby transferred to Malvane the Usurper.", "This transfer is valid. If you disagree, please submit Form 1-B. Form 1-B is available from the person who wrote the transfer."],
"sign.authorization.freed": ["NOTICE OF REVOCATION", "Form 1-A has been found to be filed on a Tuesday. Tuesday is not a business day in this building.", "The transfer is void. Thank you for your patience. Please ignore the previous notice, the notice before that, and the notice about the notices."],
"sign.new_management": ["NEW MANAGEMENT", "By order of Malvane the Usurper, all personnel are required to follow all rules, permits and procedures, including the new ones.", "This is not oppression. This is policy."],
"sign.new_management.freed": ["OLD MANAGEMENT", "Back from retirement, and delighted to be here. Rules and procedures have been reduced from 40,000 to a more reasonable 39,000."],
"sign.permit_to_stand": ["PERMIT TO STAND", "Standing in a hallway for more than 30 seconds requires a Permit to Stand (Form 7-S).", "Form 7-S requires a Permit to Fill in Forms (Form 7-F). Form 7-F requires a signature. The signature requires you to stand still."],
"sign.permit_to_stand.freed": ["STAND WHERE YOU LIKE", "The Permit to Stand has been abolished. You may stand, sit, or lie down. Lying down is a little on-the-nose, but permitted."],
"sign.now_serving.freed": ["NOW SERVING:", "EVERYONE (since this morning)", "(The number machine has been switched off. Please just come in.)"],
"sign.main_dungeon.freed": ["THE HALL OF FINAL APPROVALS", "Formerly where all things were authorized. The doors are now open, and the form is optional.", "Estimated wait: some minutes. Waiting room included, with magazines."],
"npc.dolores.intro.freed": ["They revoked it! A TECHNICALITY! Form 1-A was filed on a Tuesday! I have been working here for thirty-eight years and I did not know Tuesday was a loophole! I'm Dolores, front desk, and I would like to hug you, but I need a hugging permit. Oh, forget it. Come here."],
"npc.dolores.return.freed": ["The authorization has been revoked and the Department belongs to itself again. Take a number. Or don't. Honestly. It's a little scary. I like it."],
"npc.barnaby.intro.freed": ["Barnaby, barista, free! I made a whole pot to celebrate. It's decaf. It's also free. The machine is feeling generous. Probably a bad omen."],
"npc.barnaby.return.freed": ["Cream? I have none. Sugar? None. Hope? Back in stock, and we're expecting a larger shipment any day now."],
"npc.pip.intro.freed": ["Requisitions! Pip, junior clerk, third class, third time dying. The stamp has stopped haunting. It's just a stamp. It looks so sad. Cards, in triplicate, as always."],
"npc.pip.return.freed": ["Requisition something! Or at least stand near the desk. It makes me look busy. It's fine now. I am allowed to look un-busy."],
"memo.new_rules": ["NEW RULES: EFFECTIVE IMMEDIATELY", "Rule 40,001: All rules must be followed.", "Rule 40,002: All rules include this rule.", "Rule 40,003: See rule 40,002."],
"memo.new_rules.freed": ["RULES: REDUCED", "Rules 40,001 through 40,003 have been repealed on grounds of being a joke."],
"poster.compliance": ["COMPLIANCE IS FREEDOM", "(Freedom is subject to approval.)"],
"poster.compliance.freed": ["COMPLIANCE IS FINE", "(Freedom is also fine. Choose what you like.)"],
"effect.buff.name": ["Approved Procedure"],
"effect.buff.flavor": ["Every Necrocrat here is properly stamped, countersigned and notarized. It makes them very hard to argue with."],
"effect.debuff.name": ["Unauthorized Activity"],
"effect.debuff.flavor": ["Beefcakes do things on the spot, which here requires a permit, in triplicate, and a fee. The fee is also a form."],
}
quiz_questions = Array[Dictionary]([{
"a": ["Department of Necrotic Affairs", "Division of Nocturnal Accounting", "Directorate of Newly Arrived", "Department of Neglected Alumni"],
"correct": 0,
"q": "What does the D.N.A. stand for?",
"where": "sign.lobby_main, Lobby reception wall"
}, {
"a": ["\"Rest in Pieces\"", "\"Your Death, Our Priority.\"", "\"We Never Forget (Your Paperwork)\"", "\"Ask Again Tomorrow\""],
"correct": 1,
"q": "What is the Necrocrats' official motto?",
"where": "sign.motto in the Lobby; memo.motto on the Cubicle Farm B board"
}, {
"a": ["Form 7-Q", "Form 13-B", "Form 99-Z", "Form 1-A"],
"correct": 1,
"q": "Which form is required to ride the elevator to the Records Basement?",
"where": "sign.elevator_rule at the Elevator Bank; memo.records; Dolores' return dialogue"
}, {
"a": ["Mandatory Fun Day", "Mandatory Silence Hour", "Quarterly Haunting", "Casual Friday (Formal)"],
"correct": 0,
"q": "Which mandatory event is held every Friday?",
"where": "sign.fun_day in the Lobby; memo.fun_day in Cubicle Farm A"
}])
