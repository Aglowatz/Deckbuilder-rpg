[gd_resource type="Resource" script_class="ZoneStoryText" format=3]

[ext_resource type="Script" path="res://core/data/zone_story_text.gd" id="1_dna"]

[resource]
script = ExtResource("1_dna")
zone_id = "necrocrat"
lines = {
"enemy.courier": ["Urgent delivery. Signature required. Signature will be taken. Delivering a Notice of Compliance, in triplicate."],
"enemy.intern": ["Unpaid. Undead. Eager to make a good impression on the new management. It does not know the new management is evil. It knows it is valid."],
"enemy.manager": ["Wants a quick sync. It has wanted one since 1994. Currently enforcing the new regime's regulations with great, unenthusiastic precision."],
"fx.chest": ["A hidden stash!"],
"fx.coffee_bad": ["The machine screams. The coffee screams. You drink it anyway. -1 HP."],
"fx.coffee_gold": ["A coin rolls out of the dispenser. The machine regrets nothing. +gold."],
"fx.coffee_good": ["The coffee machine gurgles and produces something almost drinkable. +HP."],
"fx.coffee_great": ["Perfect brew! The machine seems proud of itself. Full recovery of... something."],
"fx.heal_already": ["You are already as rested as the dead get."],
"fx.heal_couch": ["You sink into the Breakroom Couch. Somehow it is both ice cold and slightly damp. HP restored."],
"fx.hit": ["Delivery! Signature taken. (-2 HP)"],
"fx.main_dungeon": ["The Executive Floor's great doors hang open, just a crack. Beyond them is a hall of endless desks, glowing lamps and stamps that thump like heartbeats. A voice from the dark says: PLEASE TAKE A NUMBER."],
"fx.printer_ok": ["The printer shudders, whines, and hands you a card, still warm. Lawfully yours."],
"fx.printer_poor": ["PAPER JAM. The printer regrets to inform you that your fee is non-refundable."],
"fx.punch_again": ["You're already punched in. The clock refuses to double-count your suffering."],
"fx.punch_in": ["You punch in. The clock says 'Welcome back, Pending.' A small buff glimmers on you."],
"fx.suggestion": ["You drop a suggestion into the box. A moment later something is dropped back out."],
"fx.suggestion_empty": ["The suggestion box is empty now. The committee has read your suggestion. It wasn't implemented."],
"fx.wake": ["You wake up in the Lobby, on a couch with a 15-minute limit.", "A form is already filled out in your name. It says you are 'Pending'. It also says 'Valid'."],
"hud.objective": ["The D.N.A.: the Lobby and Breakroom are safe (pending approval). HP does not come back after battles - rest on the Breakroom Couch, or ride up to town. Every door in the building requires a form. The authorization is valid."],
"match.first": ["First time clearing it? Here's a bonus. It's not much. It's a memory. Literally, it's a memory game."],
"match.intro": ["Flip two cards at a time. Find all 8 pairs in 14 moves or fewer. Fewer moves, better stars."],
"match.lose": ["Out of moves. That's fine. My virtual pet lasted longer than that, and it died in an hour."],
"match.pairs": ["Dial-Up Modem", "Top 8 Friends", "Late Fee Receipt", "Virtual Pet (Deceased)", "Flip Phone Text", "Burned Mix CD", "Away Message", "Mix Tape"],
"match.win": ["Nice flipping! You're a natural. Better than the Top 8. Much better."],
"memo.coffee": ["MEMO: THE COFFEE MACHINE", "For living staff only. Undead staff, please use the Decaf Crypt.", "This is the fourth memo."],
"memo.cubicle_coffin": ["MEMO: CUBICLE 12-C", "Whoever put a coffin in 12-C: you may keep it.", "Please stop billing it as 'ergonomic seating'."],
"memo.fun_day": ["MEMO: MANDATORY FUN DAY", "Reminder: Mandatory Fun Day is mandatory.", "Fun that is not mandatory will not be counted as fun."],
"memo.hr": ["HR REMINDER", "'Rest in Peace' is not an approved out-of-office message."],
"memo.lunch": ["BREAKROOM REMINDER", "Labelled lunches are not safe. Unlabelled lunches are not safe. Lunches are not safe."],
"memo.motto": ["ALL-HANDS REMINDER", "Our motto is \"Your Death, Our Priority.\" Please stop saying \"Your Death, Our Problem.\""],
"memo.parking": ["FACILITIES", "Parking Lot D has been renamed Parking Lot Dead. Please stop asking why."],
"memo.records": ["RECORDS NOTICE", "To access the Records Basement, bring Form 13-B.", "Form 13-B is available from Form 13-A. Form 13-A is available from nobody."],
"memo.reorg": ["REORG NOTICE", "Due to a restructuring, you will now report to the person who reports to you.", "Both of you have been dead since Tuesday. Both of you report to {villain}."],
"npc.barnaby.intro": ["Oh! A customer! Gerald, breakroom barista. I make coffee for people who can't taste it. It's very freeing.", "The machine in the corner is temperamental. Half the time it's a miracle. The other half, it's a different kind of miracle.", "New hires always have to do onboarding. Punch the clock, grab a cup. Easy. Compulsory. Same thing. Under the new management, a lot of things are compulsory. The coffee is one of the few things we're still allowed to enjoy. Quietly."],
"npc.barnaby.return": ["Cream? I have none. Sugar? None. Hope? Out of stock, but we're expecting a shipment in 2090."],
"npc.dolores.intro": ["Welcome to the Department of Necrotic Affairs. Name? ...Doesn't matter, you're in the system as 'Pending'.", "I'm Agnes Overdue, front desk. Deceased since 1987, employee of the month since 1987. Nobody else qualified.", "Take a number. We're serving number one. Have been for seven hundred years. He's very thorough.", "Look, I'll be honest. Ten years ago, {villain}'s people submitted some paperwork. It was reviewed, approved, notarized and filed. Properly. Now the whole department works for him. I know he's evil. We all know. But the authorization is valid."],
"npc.dolores.return": ["Back again? You know, loyalty is rewarded here. Not with money. With more work.", "Records Basement needs Form 13-B for the elevator. I don't have one. Nobody does. It builds character. I'd like to help you more, but I would need a permit to help you, and I have it on good authority that I won't get one."],
"npc.matching.intro": ["*krrrshhh... beep-boop-BEEEEEE-krrrrrshhh...* Sorry. That's my greeting. It's how I say hello. It takes forty seconds. Dial-up, baby.", "I'm Kyle. Last employee of the month of 2003. My away message still says 'brb, getting a snack'. That was my snack. In 2003. I have been here through the transfer. I filed the paperwork myself. I did not read it.", "I've got a top 8 of friends. It's me, me, a guy I met in a chatroom, and five ghosts. The algorithm moved me to number nine.", "I owe the video store a fine. Eleven dollars for a movie I returned in 2001. They're still mad. They're also closed.", "Wanna play? Flip two cards, match the pair. I burned the cards myself. A mix CD with forty minutes of the same song. It's fine."],
"npc.matching.return": ["My virtual pet died again. That's seven times this week. It's okay. I'll hatch another one. I always do.", "Flip-phone texting, nine presses for one letter, and I still sent you a good message. Anyway: wanna play?"],
"npc.pip.intro": ["Requisitions! Clerk Ledgerbone, junior clerk, third class, third time dying. Cards, in triplicate.", "Everything here is Necrocrat-issue: authorized, stamped, haunted. The stamp is haunted. The stamp wants a raise. The stamp has a new boss, and he is a lot less fun.", "No returns. No exchanges. No refunds. Exceptions require Form 13-B, which, well. You've heard about 13-B."],
"npc.pip.return": ["Requisition something! Or at least stand near the desk. It makes me look busy."],
"npc.quiz.intro": ["Ah. A candidate for re-certification. Director Ectomund, Compliance Examiner. I examine. It's all I do. It's all I am.", "Four questions about the Necrocrats of Afterlife Services and Labor. All answers are on the premises: signs, memos, the staff. The new management asked me to remove the questions about ethics. They are not in the exam. They are also not in the building.", "Answer correctly and you'll be rewarded. Answer incorrectly and you'll be rewarded less. I'm not a monster. I'm an examiner."],
"npc.quiz.return": ["Back to improve your score? Admirable. Statistically, it means you failed. Statistically, I enjoy it."],
"poster.hang_in_there": ["HANG IN THERE!", "(The poster is a skeleton on a branch. It has been there since 1650.)"],
"poster.performance": ["ETERNAL PERFORMANCE REVIEWS", "Review 1 of 4,000,000. Self-assessment due yesterday."],
"poster.safety": ["SAFETY FIRST", "You are already dead. Please do not make it worse."],
"poster.synergy": ["SYNERGY", "Together Everyone Achieves More. Eventually. Posthumously."],
"poster.wellness": ["WELLNESS WEDNESDAY", "Breathe in. Breathe out. (Optional for you.)"],
"puzzle.already": ["The tubes hum contentedly. Nothing left to route."],
"puzzle.bins": ["Harvest", "Accounts Payable", "Reaping", "Limbo", "Complaints", "Records", "Haunting", "Pest Control"],
"puzzle.hint": ["Every junction flips after a capsule passes. The first capsule only cares about the three junctions on its own path - set those first, then work out the next."],
"puzzle.intro": ["A wall of pneumatic tubes hums and hisses. Eight capsules are queued in the intake, each stamped with its destination department.", "Seven junctions sit in the lines. Every junction flips after a capsule passes through it. Set the starting position of each, then send them down."],
"puzzle.solved": ["Every soul lands in the right department. The tubes cough politely and drop a small, heavy parcel in the tray."],
"puzzle.souls": ["Mr. Hargrove", "Dame Basil", "Little Timmy B.", "A Very Tired Clerk", "The Mayor (acting)", "Gertrude, 3rd Floor", "Sir Reginald Pent", "Unknown (Please Hold)"],
"quest.dna_audit.active": ["The quiz, and a stash. The stashes are in the corners nobody visits. So, basically, everywhere."],
"quest.dna_audit.done": ["Audit closed. The auditors went home. They live here, but they went to their desks."],
"quest.dna_audit.offer": ["Compliance is auditing. They need two things from a fresh pair of hands: pass the re-certification quiz, and find one of the hidden stashes in the filing mazes.", "I can't leave the desk. Policy. Also, I can't stand. Policy and anatomy. Whatever the audit is for, it is not for us."],
"quest.dna_audit.ready": ["You passed the quiz AND found a stash? You're basically middle management. Here's your commendation. Please don't cash it."],
"quest.dna_backlog.active": ["Three of them, remember. Processed, not promoted. Don't confuse the two."],
"quest.dna_backlog.done": ["The backlog is clear. It will be full again by Thursday. It's nice to have a moment."],
"quest.dna_backlog.offer": ["Oh good, a pulse. Well, a presence. I have a backlog. A literal one - it's wandering the floors.", "Three of the staff have gone feral over a missed deadline from the new management. Would you... process three of them? Gently? Or not? We're not allowed to hurt colleagues. You aren't a colleague. You haven't filled out the form."],
"quest.dna_backlog.ready": ["Three? That clears the backlog! Do you know how many forms that closes? Neither do I. Here - your bonus."],
"quest.dna_onboarding.active": ["Time clock, coffee machine. In that order or the other order. HR isn't picky."],
"quest.dna_onboarding.done": ["Onboarding complete. You're one of us now. Please don't read the contract."],
"quest.dna_onboarding.offer": ["New to the floor? Then it's mandatory onboarding. Punch in at the time clock, and have a cup from the machine.", "Don't skip it. HR will know. HR always knows. HR is in the walls. HR reports to him now."],
"quest.dna_onboarding.ready": ["Punched in, caffeinated, and compliant. Onboarding complete! Here's your welcome kit. The kit is a welcome."],
"quiz.not_passed": ["Not a pass. Study the signs and come back; there is no limit on attempts."],
"quiz.repeat": ["Re-certified again. The Department pays a small processing fee for the paperwork."],
"quiz.result.0": ["Zero. Impressive in its own way. Nothing for you. Try again; the signs aren't going anywhere."],
"quiz.result.1": ["One correct. A pulse of competence. Here's a small token of the Department's disinterest."],
"quiz.result.2": ["Two. Half-credit. Half-credit is the highest honor of the Necrocrats."],
"quiz.result.3": ["Three! One shy of perfect. Perfect would make me suspicious. Take your reward."],
"quiz.result.4": ["FOUR. Flawless. You are now Certified Deceased, Class A. The reward is real; the title is imaginary."],
"sign.coffee": ["COFFEE MACHINE", "For living staff only. Undead: use the Decaf Crypt."],
"sign.cubicle_farm_a": ["CUBICLE FARM A", "Please do not personalize your cubicle. Yes, haunting counts."],
"sign.cubicle_farm_b": ["CUBICLE FARM B", "Hot-desking is permitted. Hot-desking has been banned. See memo."],
"sign.elevator_bank": ["ELEVATOR BANK", "Floors served: Lobby, Records, Quarterly Reviews, Under Renovation."],
"sign.elevator_rule": ["RECORDS BASEMENT ELEVATOR", "Form 13-B required. No form, no floor."],
"sign.executive": ["EXECUTIVE FLOOR", "Staff beyond this point are dead. Executives were dead before it was fashionable."],
"sign.exit": ["ELEVATOR TO SURFACE", "(Town. Sunlight not guaranteed.)"],
"sign.filing_maze": ["FILING DEPARTMENT", "If you are lost, you are in the correct place."],
"sign.fun_day": ["MANDATORY FUN DAY - THIS FRIDAY", "Attendance is compulsory for all staff, including the undead.", "Cake provided. Cake will not be eaten."],
"sign.heal_couch": ["BREAKROOM COUCH", "Eternal rest, 15 minute limit."],
"sign.lobby_main": ["DEPARTMENT OF NECROTIC AFFAIRS", "A Division of Afterlife Services and Labor", "Under New Management (Authorization Valid)"],
"sign.mailroom": ["MAIL ROOM", "All souls routed by pneumatic tube. Souls routed incorrectly will be re-routed. Eventually."],
"sign.main_dungeon": ["THE HALL OF FINAL APPROVALS", "Where all things are authorized: life, death, resurrection and the afterlife.", "Appointment required. Estimated wait: 400 years. Waiting room not included."],
"sign.matching": ["THE REC ROOM", "Please do not feed the Top 8."],
"sign.mini_dungeon": ["SUB-BASEMENT 3: QUARTERLY REVIEWS", "Three meetings. Mandatory. No snacks."],
"sign.motto": ["OUR MOTTO:", "\"Your Death, Our Priority.\""],
"sign.now_serving": ["NOW SERVING:", "ONE (since 1291)", "(Estimated wait for number two: 400 years. The Regime of Final Approvals appreciates your patience.)"],
"sign.printer": ["PRINTER", "Out of toner. Out of body. Please contact IT (deceased)."],
"sign.puzzle": ["PNEUMATIC SOUL ROUTING", "Set every junction. Send the souls. Do not send them to Accounts Payable."],
"sign.quiz": ["COMPLIANCE TESTING", "Annual re-certification: 4 questions. Failure is not an option. It is a form."],
"sign.records": ["RECORDS BASEMENT", "Every life, filed under 'Pending'."],
"sign.requisitions": ["REQUISITIONS", "Cards, in triplicate. Souls, in quadruplicate."],
"sign.suggestion_box": ["SUGGESTIONS", "All suggestions are read by a committee that has been dead since 1979."],
"sign.take_number": ["DECEASED?", "TAKE A NUMBER.", "(You have been assigned a number. Your number is also a number.)"],
"sign.time_clock": ["PUNCH IN. PUNCH OUT.", "(Punching other employees is not covered by your plan.)"],
"ui.exit.body": ["Leaving the D.N.A. ends this visit. Town heals you fully; defeated staff will be back next time. Exit permit 12-X has been auto-approved. This time."],
"ui.exit.title": ["Ride up to town?"],
"ui.mini.body": ["Three meetings in a row. Your HP carries from one to the next and nothing heals in between. Win all three for a unique Necrocrat card."],
"ui.mini.body_cleared": ["You have already earned the unique card here. You can still sit through the meetings for gold and XP. HP carries over; nothing heals in between."],
"ui.mini.button": ["Go down"],
"hud.objective.freed": ["The D.N.A., liberated on a technicality: the Lobby and Breakroom are safe. HP does not come back after battles - rest on the Breakroom Couch, or ride up to town."],
"ui.exit.body.freed": ["Leaving the D.N.A. ends this visit. Town heals you fully. You no longer need an exit permit. Nobody does. We are still a little scared of the pen."],
"sign.lobby_main.freed": ["DEPARTMENT OF NECROTIC AFFAIRS", "A Division of Afterlife Services and Labor", "Authority Restored (Authorization Revoked on a Technicality)"],
"sign.authorization": ["NOTICE OF TRANSFER OF AUTHORITY", "Form 1-A, submitted, reviewed, approved, notarized and filed. Authority over all Necrocrat government is hereby transferred to {villain}.", "This transfer is valid. If you disagree, please submit Form 1-B. Form 1-B is available from the person who wrote the transfer."],
"sign.authorization.freed": ["NOTICE OF REVOCATION", "Form 1-A has been found to be filed on a Tuesday. Tuesday is not a business day in this building.", "The transfer is void. Thank you for your patience. Please ignore the previous notice, the notice before that, and the notice about the notices."],
"sign.new_management": ["NEW MANAGEMENT", "By order of {villain}, all personnel are required to follow all rules, permits and procedures, including the new ones.", "This is not oppression. This is policy."],
"sign.new_management.freed": ["OLD MANAGEMENT", "Back from retirement, and delighted to be here. Rules and procedures have been reduced from 40,000 to a more reasonable 39,000."],
"sign.permit_to_stand": ["PERMIT TO STAND", "Standing in a hallway for more than 30 seconds requires a Permit to Stand (Form 7-S).", "Form 7-S requires a Permit to Fill in Forms (Form 7-F). Form 7-F requires a signature. The signature requires you to stand still."],
"sign.permit_to_stand.freed": ["STAND WHERE YOU LIKE", "The Permit to Stand has been abolished. You may stand, sit, or lie down. Lying down is a little on-the-nose, but permitted."],
"sign.now_serving.freed": ["NOW SERVING:", "EVERYONE (since this morning)", "(The number machine has been switched off. Please just come in.)"],
"sign.main_dungeon.freed": ["THE HALL OF FINAL APPROVALS", "Formerly where all things were authorized. The doors are now open, and the form is optional.", "Estimated wait: some minutes. Waiting room included, with magazines."],
"npc.dolores.intro.freed": ["Head of the whole Department, and I still man the front desk. Do not ask me how. It is a temporal budget thing; ghosts have never been good at being in one place. Old habits, dear. Old habits.", "Mortimer is in the Waiting Room, right behind Gerald. He is learning to wait. It is going about as well as you would expect."],
"npc.dolores.return.freed": ["The authorization is still valid, but the rule above it now is: help people. Prudence is my deputy. She is much nicer than she used to be, and so, I hear, am I."],
"npc.barnaby.intro.freed": ["Oh! It is you! Gerald, barista, and also, as of ten minutes ago, Number 4,000,212 CALLED. They called my number! I did not know what to do with my hands.", "The queue machines are off. Agnes called every number, one by one, herself. I am going to make a whole pot of decaf to celebrate. It is free. The machine is feeling generous."],
"npc.barnaby.return.freed": ["Cream? I have none. Sugar? None. Hope? Back in stock, and my number has been called, so I am only here because I like the coffee. Mortimer is the one behind me. Do not mention it. He gets quiet."],
"npc.pip.intro.freed": ["Requisitions! Clerk Ledgerbone, junior clerk, third class, third time dying. The stamp has stopped haunting. It's just a stamp. It looks so sad. Cards, in triplicate, as always."],
"npc.pip.return.freed": ["Requisition something! Or at least stand near the desk. It makes me look busy. It's fine now. I am allowed to look un-busy."],
"memo.new_rules": ["NEW RULES: EFFECTIVE IMMEDIATELY", "Rule 40,001: All rules must be followed.", "Rule 40,002: All rules include this rule.", "Rule 40,003: See rule 40,002."],
"memo.new_rules.freed": ["RULES: REDUCED", "Rules 40,001 through 40,003 have been repealed on grounds of being a joke."],
"poster.compliance": ["COMPLIANCE IS FREEDOM", "(Freedom is subject to approval.)"],
"poster.compliance.freed": ["COMPLIANCE IS FINE", "(Freedom is also fine. Choose what you like.)"],
"effect.buff.name": ["Approved Procedure"],
"effect.buff.flavor": ["Every Necrocrat here is properly stamped, countersigned and notarized. It makes them very hard to argue with."],
"effect.debuff.name": ["Unauthorized Activity"],
"effect.debuff.flavor": ["Beefcakes do things on the spot, which here requires a permit, in triplicate, and a fee. The fee is also a form."],
"freed_npc.agnes": ["Agnes Overdue, head of the D.N.A. Yes, me. Apparently I filed more appeals than anyone alive or dead, and the rules say the office goes to the senior-most applicant. I have never been so annoyed to win.", "I only wanted to leave. I will. Soon. But first I am fixing this place so nobody else waits as long as I did. Even the dead deserve humanity. Our job is to help the lost souls. Following orders be damned: we treat everyone with respect.", "Prudence will see you now, and she is much nicer than she used to be. She is my deputy. She stamps APPROVED, with a flourish.", "And you, dear. You were a number in a file once, weren't you? I can see it in how you hold your shoulders. Never let anyone file you under 'subject' again."],
"ruler.statue": ["STATUE OF MORTIMER GRIMSBY, CE-No", "Statue pending approval. Do not look at it until it has been approved."],
"ruler.statue.freed": ["FORMER STATUE OF MORTIMER GRIMSBY", "(Authorization revoked. The statue has been asked to leave. It has not left.)"],
"ui.main.title": ["The Hall of Final Approvals"],
"ui.main.body": ["The Hall of Final Approvals is a vast government complex where every aspect of life, death, resurrection and the afterlife requires authorization. Somewhere inside is the authority that now controls the Necrocrats. Please take a number. Your HP carries in from the zone and nothing heals except in the waiting room. Beat Mortimer Grimsby, CE-No, to free the D.N.A."],
"ui.main.body_cleared": ["The Hall of Final Approvals is open and, somehow, more efficient. You can still walk the departments for gold and XP. HP carries in from the zone; nothing heals except in the waiting room."],
"ui.main.button": ["Take a number and go in"],
"dungeon.ha_lobby.title": ["The Lobby of Final Approvals"],
"dungeon.ha_lobby.blurb": ["A cavernous reception. A single sign reads: ALL THINGS REQUIRE AUTHORIZATION. THIS INCLUDES THE SIGN."],
"dungeon.ha_lobby.before": ["You step through the doors and a small, grey machine hands you a ticket. It says 40,001. The display above the desk says NOW SERVING: 3.", "A clerk looks up, sighs, and says, in a voice like a filing cabinet closing: \"The authorization is valid. Please wait.\""],
"dungeon.ha_number.title": ["Take a Number"],
"dungeon.ha_number.blurb": ["You are number 40,001. They are serving number 3. It is a very long queue, and it is the only way forward."],
"dungeon.ha_intake.title": ["The Department of Intake"],
"dungeon.ha_intake.blurb": ["An intake clerk demands to see your paperwork. It is also a fight. It is mostly a fight."],
"dungeon.ha_forms.title": ["Forms About Forms"],
"dungeon.ha_forms.blurb": ["A counter with a very long sign: FORM 13-B REQUIRES FORM 13-A. FORM 13-A REQUIRES FORM 13-B. PLEASE SEE A CLERK."],
"dungeon.ha_duplicates.title": ["The Department of Duplicate Forms"],
"dungeon.ha_duplicates.blurb": ["Every form here has a twin. Every twin has a twin. The clerks are undead and, understandably, a bit short."],
"dungeon.ha_waiting.title": ["The Waiting Room"],
"dungeon.ha_waiting.blurb": ["A very comfortable waiting room. The magazines are 600 years old. Restore HP."],
"dungeon.ha_waiting.after": ["You have been waiting for what seems like a very long time. A tiny clock above the door says it has been four minutes. The clock is lying. The clock was told to."],
"dungeon.ha_audit.title": ["The Audit"],
"dungeon.ha_audit.blurb": ["An auditor examines your deck for compliance. Three cards will be weighed on the Scale of Approved Expenditures."],
"dungeon.ha_mailroom.title": ["The Mailroom of Lost Souls"],
"dungeon.ha_mailroom.blurb": ["Souls arrive here by pneumatic tube when nobody knows where else to put them. They are not happy about it."],
"dungeon.ha_lost.title": ["Lost and Found (Souls Edition)"],
"dungeon.ha_lost.blurb": ["A counter piled high with misfiled belongings. A sign: IF YOU FIND SOMETHING, YOU MAY KEEP IT. IF YOU LOSE SOMETHING, SEE A CLERK."],
"dungeon.ha_compliance.title": ["Compliance Enforcement"],
"dungeon.ha_compliance.blurb": ["The department that enforces the rules that enforce the rules. Their officer is perfectly polite. (Elite)"],
"dungeon.ha_compliance.after": ["The officer folds his clipboard and, with a courteous nod, points you toward the Appeals Department. \"You may appeal,\" he says. \"You will lose. But you may appeal.\""],
"dungeon.ha_appeals.title": ["The Department of Appeals"],
"dungeon.ha_appeals.blurb": ["A judge in an old powdered wig weighs your case. The scales are made of paperwork."],
"dungeon.ha_notary.title": ["The Notary's Counter"],
"dungeon.ha_notary.blurb": ["Every important document in the Hall passes through here. It must be stamped, signed and witnessed by a notary."],
"dungeon.ha_clerk.title": ["The Appeals Court"],
"dungeon.ha_clerk.blurb": ["The Appeals Court's Undersecretary Vellum, Mortimer's deputy, defends the transfer of authority to the last paragraph. He has never once been thanked. (Elite)"],
"dungeon.ha_boss.title": ["The Office of Final Approval"],
"dungeon.ha_boss.blurb": ["A vast office with a single desk, a single stamp, and one very patient authority."],
"dungeon.ha_boss.before": ["Mortimer Grimsby, CE-No, looks up from an infinite pile of paperwork. His face is perfectly smooth, like a blank form. He holds a stamp the size of a tombstone.", "\"You do not have an appointment. That is irregular. However, the authorization is valid, and under the authorization, every visitor is entitled to a hearing. The answer is no. The question is irrelevant. Please state your case anyway. You have, according to the clock, four hundred years.\""],
"dungeon.ha_boss.after": ["The stamp falls from Mortimer's hand, and the paperwork goes still. At the very bottom of the pile, under every form, every stamp, every signature, there is a small note in a trembling hand: FILED ON A TUESDAY.", "\"...Oh,\" says Mortimer. \"Oh no. The authorization is valid. It was always valid. But the office is vacant, and policy is policy.\""],
"challenge.ha_audit.title": ["The Audit"],
"challenge.ha_audit.text": ["The auditor lays three cards on the Scale of Approved Expenditures. A reasonable total will be stamped. An unreasonable one will be fined."],
"event.ha_take_a_number.title": ["Take a Number"],
"event.ha_take_a_number.body": ["You hold ticket 40,001. The display says NOW SERVING: 3. The queue snakes through the lobby, up the stairs and out of a window. A clerk offers you a form, a coffee and a pitying look."],
"event.ha_take_a_number.choice.0": ["Wait your turn (it will be a while)"],
"event.ha_take_a_number.choice.1": ["Pay the Expedite Fee (30 gold)"],
"event.ha_take_a_number.choice.2": ["Cut in line"],
"event.ha_take_a_number.result.0": ["You wait. And wait. A clerk takes pity, and a stranger shares a biscuit. You are called in, eventually, rested and a little richer. Waiting, in the Hall, is a kind of work."],
"event.ha_take_a_number.result.1": ["The Expedite Fee is an official fee, with an official receipt. A tiny clerk stamps your ticket and a door opens. You feel oddly refreshed."],
"event.ha_take_a_number.result.2": ["You cut in line. Forty thousand undead clerks turn and glare. You are processed immediately, and a little roughly."],
"event.ha_form_a.title": ["Form 13-B"],
"event.ha_form_a.body": ["To pass the counter you need Form 13-B. The clerk says Form 13-B requires a Form 13-A, which she will gladly give you, once you have submitted Form 13-B."],
"event.ha_form_a.choice.0": ["Ask for Form 13-A"],
"event.ha_form_a.choice.1": ["Pay the clerk 25 gold to look the other way"],
"event.ha_form_a.result.0": ["\"Form 13-A,\" she says. \"Certainly. It requires a Form 12-F.\""],
"event.ha_form_a.result.1": ["She does not look the other way. She looks at the gold. The gold is accepted. She stamps something you cannot read, and the way ahead opens."],
"event.ha_form_b.title": ["Form 12-F"],
"event.ha_form_b.body": ["Form 12-F is available at the Counter of Form 12-F. The Counter of Form 12-F is closed until Form 13-B has been filed."],
"event.ha_form_b.choice.0": ["Ask for Form 11-D"],
"event.ha_form_b.choice.1": ["Argue"],
"event.ha_form_b.result.0": ["\"Form 11-D,\" she says. \"A simple form. It requires only your signature, in blood. Please do not worry. Blood is optional. The signature is not.\""],
"event.ha_form_b.result.1": ["You argue. A tiny stamp appears from nowhere and hits you. It hurts a little. The clerk says: \"That was a warning. The authorization is valid.\""],
"event.ha_form_c.title": ["Form 11-D"],
"event.ha_form_c.body": ["Form 11-D is the last form in the chain. It is one line long: \"I, the undersigned, request Form 13-B.\" You sign. A stamp thunders. Forms 13-B, 13-A and 12-F all appear at once, in perfect order."],
"event.ha_form_c.choice.0": ["Submit all the forms and claim the reward"],
"event.ha_form_c.choice.1": ["Rest in the clerk's break room instead"],
"event.ha_form_c.result.0": ["Every form passes. A bureaucrat's tear of joy lands on the ink. You receive a stamped Form 13-B, a small refund and a commendation you cannot read."],
"event.ha_form_c.result.1": ["The clerk's break room is the most efficient room in the Hall. You are given a cup of tea, a biscuit and a lovely, quiet chair. You feel ready for the next department."],
"event.ha_notary.title": ["The Notary's Counter"],
"event.ha_notary.body": ["A very old notary sits behind a very high counter, a seal in one hand and a very large quill in the other. \"Everything in the Hall,\" he says, \"must be notarized. Even you. Especially you.\""],
"event.ha_notary.choice.0": ["Get your credentials notarized (50 gold)"],
"event.ha_notary.choice.1": ["Lie down in the notary's cot"],
"event.ha_notary.choice.2": ["Sell the notary a spare seal"],
"event.ha_notary.result.0": ["The seal comes down with a THUMP. You are, officially, a person. Your units feel more legitimate, and hit a little harder for it."],
"event.ha_notary.result.1": ["The cot is small, hard and incredibly comfortable. You sleep for a very official ten minutes. You wake up refreshed, and a little bruised from the notary's guestbook."],
"event.ha_notary.result.2": ["He pays in cash, takes no receipt, and tells you he never saw you. You have never felt more notarized."],
"dungeon.ha_number.before": ["A small, silvery ghost is already in the queue ahead of you, clutching an enormous stack of paper tied with three kinds of ribbon. \"Number 4,000,213? You are new. I am Agnes. I have been filing appeals for... oh, I stopped counting. Every one denied. Follow me; I know where the departments hide.\"", "\"And a word of advice, dear. The authorization is valid. That is what makes it so terrible.\""],
"dungeon.ha_forms.before": ["Two aisles over, Agnes is filling in a form with a very stubby pencil. \"Form 27-C. Third time. They keep calling it 'irregular' and then they stamp it DENIED. Do not mind me. I have filed worse.\""],
"dungeon.ha_records.before": ["The Records Labyrinth is a canyon of filing cabinets that goes down further than it goes up. At its center, under glass, lies the original transfer of authority: the Necrocrat Path, signed over to Primm. It is flawless. Submitted, reviewed, approved, notarized, filed.", "Agnes reads over your shoulder, and stops at one clause. Under HEIR OF THE FORMER SOVEREIGN it says: \"Deceased (presumed). Remains: not on file.\"", "\"Irregular,\" says Agnes, and frowns at it for a long moment. \"A presumed death with no remains on file is an incomplete form. Somebody should look into that. Not me. I am only a ghost with a pencil.\""],
"dungeon.ha_clerk.before": ["Undersecretary Vellum adjusts his spectacles and does not look up. \"Noted. You wish to challenge the transfer of authority. The authorization remains valid. It was submitted, reviewed, approved, notarized and filed. Please appeal in triplicate.\"", "\"Mr. Grimsby has asked me to hold the Court until his schedule opens. I will hold it very, very well.\""],
"dungeon.ha_clerk.after": ["Vellum squares his papers with great care. \"Noted,\" he says, very quietly. \"The authorization remains valid.\" It sounds, for the first time, like a question."],
"cutscene.vacancy.1.speaker": ["Mortimer Grimsby"],
"cutscene.vacancy.1": ["The CE-No is removed from office. By policy, the vacancy passes to the senior-most applicant on file. I will look it up. ...It is a ghost. It is, for the record, you."],
"cutscene.vacancy.2.speaker": ["Agnes Overdue"],
"cutscene.vacancy.2": ["Me? Oh, for pity's sake. I filed more appeals than anyone alive or dead, and this is how they reward it? I only ever wanted to leave."],
"cutscene.vacancy.3.speaker": ["Mortimer Grimsby"],
"cutscene.vacancy.3": ["The procedure is clear. The office passes to you, and I am afraid you cannot appeal it."],
"cutscene.vacancy.4.speaker": ["Agnes Overdue"],
"cutscene.vacancy.4": ["...Then I will stay, Mortimer. Not for you. I will stay long enough that nobody else waits as long as I did. Even the dead deserve humanity. Our job is to help the lost souls. We have an obligation to help. Following orders be damned. We treat everyone with respect."],
"cutscene.vacancy.5.speaker": ["Mortimer Grimsby"],
"cutscene.vacancy.5": ["...That is not in the handbook."],
"cutscene.vacancy.6.speaker": ["Agnes Overdue"],
"cutscene.vacancy.6": ["Then we write a new one. Take a number, Mortimer. You are right behind Gerald."],
"freed_npc.prudence": ["Prudence Pallor, Deputy Head of the Department. Yes, I used to stamp DENIED on everything. I was tired, and the paperwork was valid, and I am sorry.", "Now I stamp APPROVED on things that deserve it. It is a lot more fun than it sounds, and the stamp is lighter than I remembered."],
"freed_npc.mortimer": ["Mortimer Grimsby. Formerly CE-No. Currently number 4,000,214 in the Waiting Room of Eternity, right behind Gerald.", "I am told this is called 'learning to wait.' I was very good at making others wait. I find I am much worse at it myself.", "The authorization was valid. I have been thinking about whether that was ever the right question."],
}
