[gd_resource type="Resource" script_class="ZoneStoryText" format=3]

[ext_resource type="Script" path="res://core/data/zone_story_text.gd" id="1_gain"]

[resource]
script = ExtResource("1_gain")
zone_id = "beefcake"
lines = {
"hud.objective": ["The Gainlands: the Swole Station is safe, mostly because the regime forgets it exists. HP doesn't come back after battles, so soak in the Cooldown Hot Tub or walk down to town. The House of Gains is on Leg Day Ridge."],
"ui.mini.body": ["Three sets in a row. Your HP carries from one set to the next and nothing heals in between. Finish all three for a unique Beefcake card."],
"ui.mini.body_cleared": ["You already took the unique card from here. You can still lift for gold and XP. HP carries over; nothing heals in between."],
"ui.mini.button": ["Chalk up"],
"ui.exit.title": ["Walk back down to town?"],
"ui.exit.body": ["Leaving the Gainlands ends this visit. Town heals you fully; the regime's roaming brutes, golems and sprites will be back next time."],
"fx.main_dungeon": ["The House of Gains looms over you, all bare stone and floodlights. Above it the regime's flag snaps in the wind: a barbell with a red line through it."],
"fx.heal_couch": ["You sink into hot water that smells of eucalyptus and, underneath it, unmistakably of gym sock. HP restored, though your nose has its doubts."],
"fx.heal_already": ["You're already as rested as a Beefcake ever gets, and the tub has done all it can for you."],
"fx.hit": ["ZAP! A regime sprite hits you right in the quads. (-2 HP)"],
"fx.wake": ["You wake up in the Cooldown Hot Tub at the Swole Station. Old Man Mountain is holding a clipboard and a very small towel.", "\"You passed out mid-rep, lad. Happens to the best of us. Happened to me in the spring of... the spring of... well, it was a spring. Towel's on the house.\"", "\"Just don't tell the regime you had a lie-down. They fine people for resting, and I've only got the one towel.\""],
"fx.chest": ["Behind a rock you find a hidden stash, wrapped in an old gym towel so the regime wouldn't spot it."],
"fx.thrown": ["COURTESY CHUCK!"],
"fx.landed": ["You come down in a heap, and the ground takes most of the credit for the landing."],
"fx.portal": ["RRRRRIIIIIP! Someone has torn a portal open in the air with nothing but their bare hands."],
"fx.fall": ["You slip off the edge and come round at your last safe spot, bruised. Gravity has never spotted anyone in its life. (-1 HP)"],
"fx.fall_log": ["Fell off %s - respawned at the last safe spot, 1 damage to zone HP."],
"fx.locked": ["Not yet. Come back when you've done a few more reps."],
"travel.throw.ask": ["Courtesy Chuck to %s: free, fast, no legroom required. Ready to be thrown?"],
"travel.portal.ask": ["Portal service: torn open by hand, no refunds. Step through to %s?"],
"travel.dest.arrive_pec": ["Pec Perch"],
"travel.dest.arrive_delt": ["Delt Deck"],
"travel.dest.land_west": ["the far west meadow"],
"travel.dest.land_east": ["the far east meadow"],
"travel.dest.land_pec": ["the Meadow Road"],
"travel.dest.arrive_calf": ["Calf Cove"],
"travel.dest.land_delt": ["the Ridge Road"],
"travel.dest.arrive_glute": ["Glute Garden"],
"travel.dest.land_glute": ["the east wheel yard"],
"travel.dest.land_calf": ["the west meadow"],
"travel.thrower_pec.intro": ["Brock cracks every knuckle he owns, then a few he borrowed. \"Pec Perch, is it? Lovely spot, and you'll have the best view in the Gainlands on your way up to it.\"", "\"The landing's a bit rough, mind, so tuck your elbows in and enjoy the scenery while you've still got it.\""],
"travel.thrower_pec.locked": ["Brock is always ready, and so is his throwing arm."],
"travel.ripper_delt.intro": ["Rita flexes both hands like she's about to open a very stubborn jar. \"Delt Deck? That's an easy one. I rip the portal open, and all you have to do is walk through it.\"", "\"There aren't any tools or spells in it, just my bare hands and a great deal of back, so please keep your arms inside the hole.\""],
"travel.ripper_delt.locked": ["Rita shakes her head. \"I can't rip a thing while the grid's this dry, I'm sorry to say. Portals run on power, the same as everything else up here.\"", "\"Somebody has to run the big hamster wheel up the hill. Get it spinning for me, then come back and I'll have you through in no time.\""],
"travel.thrower_east.intro": ["Tobias hefts you like a sack of oats. \"West meadow, cross-country. It's a long way, so I'm putting everything I've got into this one.\"", "\"You can tell me how it was once your thoughts have caught up with you, which usually takes them a minute or two.\""],
"travel.thrower_east.locked": ["Tobias squints at you. \"Cross-country chucks are for Gainers only, I'm afraid. Show me a Gym Rat card and I'll send you clear across the Gainlands. Coach Brutus Benchley sells them.\""],
"travel.thrower_west.intro": ["Wanda is already warming up. \"East meadow? That's an easy one. I could throw it in my sleep, and my husband says I have.\"", "\"Now say 'courtesy' for me, because it's company policy. A bit louder than that, please. COURTESY!\""],
"travel.thrower_west.locked": ["Wanda is always ready."],
"travel.thrower_pec_back.intro": ["Bonnie waves a foam finger. \"Heading back down, are you? Right you are, I'll have you on the ground before you've finished your sentence.\"", "\"Bend your knees as you come in, and with any luck it'll look like you planned the whole thing.\""],
"travel.thrower_pec_back.locked": ["Bonnie is always ready."],
"travel.ripper_calf.intro": ["Shredna rolls her shoulders. \"Calf Cove. Did the old yeti say hello to me? ...No, don't tell me, I don't care in the slightest. Did he, though?\"", "\"Old Man Mountain vouches for you, so Calf Cove's open. Do mind the edges out there, because the view drops off very suddenly.\""],
"travel.ripper_calf.locked": ["Shredna crosses her arms. \"Calf Cove stays shut until Old Man Mountain trusts you, and that's his rule, not mine. Do his 'Spot Me!' favour, then come back and I'll rip it open.\""],
"travel.ripper_delt_back.intro": ["Ripley is already shaking out her hands. \"Back down to the Ridge? Sure, just give me a moment to find the seam.\"", "\"I don't open doors, you understand. I take a very personal interest in a wall until it gives up.\""],
"travel.ripper_delt_back.locked": ["Ripley is always ready."],
"travel.thrower_glute.intro": ["Dmitri cracks his neck slowly, one way and then the other. \"Glute Garden is a long throw. I have measured it myself, and it is a very long throw.\"", "\"I need you aerodynamic for this one, so try not to think about it on the way. Thinking adds drag.\""],
"travel.thrower_glute.locked": ["Dmitri shakes his head slowly. \"Long-haul throws are for Beefcakes who can handle the wilds. Beat two roaming enemies out there, and then come and see me.\""],
"travel.thrower_glute_back.intro": ["Greta checks her watch. \"Down to the east wheel yard? Say 'ready' on three, and we'll keep to the timetable.\"", "\"One, two... actually, I'm already throwing, so you can say it on the way down.\""],
"travel.thrower_glute_back.locked": ["Greta is always ready."],
"travel.ripper_calf_back.intro": ["Raelynn tears a seam in the air with one grunt. \"Heading home? Home's always open, so through you go. Mind the gap on your way, though, because it bites.\""],
"travel.ripper_calf_back.locked": ["Raelynn is always ready."],
"sign.hub_main": ["THE SWOLE STATION", "Hub of the Gainlands. Heal here. Brag here. Do NOT skip leg day here.", "(Regime notice: all gatherings must be pre-approved cardio.)"],
"sign.hub_power": ["POWERED BY BEEFCAKES", "Every light in the Gainlands runs on giant mills and colossal hamster wheels.", "100% muscle. 0% coal. 110% quota, by order of the regime."],
"sign.exit": ["THE GORGE BRIDGE","To {town}. Mind the gap; it has a very low opinion of shortcuts.","(Bridge lowered courtesy of Brick Bronson. He would like you to know he stretched first.)"],
"sign.heal_tub": ["COOLDOWN HOT TUB", "Soak. Stretch. Do not drink the water. (Foreman Gus drank the water.)"],
"sign.protein_stand": ["PROTEIN SHAKE STAND", "10 gold. Flavour: surprise.", "Results may vary. Please let the shake settle before you drink it, and your stomach settle after."],
"sign.flex_mirror": ["FLEX MIRROR", "Check your form, your friend's form and the mirror's form. Someone here needs constructive reflection."],
"sign.vendor": ["BENCHLEY'S PROTEIN & PASTEBOARD","Protein, powder and cards, but mostly cards. The protein is optional; the yelling is not."],
"sign.mills": ["MILL MEADOW", "These giant mills grind everything: grain, tension, deadlines.", "Pushed by hand, by Beefcakes, since forever. (The D.N.A. once asked for exact start times. We said \"morning-ish\".)"],
"sign.quiz": ["THE LECTURE LOG", "Professor Pump asks 4 questions on Beefcake knowledge. Every answer is written on a sign somewhere in the Gainlands, so read as you go."],
"sign.studio": ["STUDIO 3 AM", "Now taping: 'Pump It Up Past Midnight!'", "Wear your legwarmers. Fashion may have moved on, but our calves have not."],
"sign.puzzle": ["POWER GRID CONTROL PANEL", "Six hamster wheels, three machines. Each wheel feeds two machines (or naps).", "Only five wheels may run at once. They get tired."],
"sign.wheel": ["COLOSSAL HAMSTER WHEEL", "Run it to power the grid. There are no actual hamsters inside; the hamsters get breaks."],
"sign.gym": ["THE BOULDER GYM", "Equipment: boulders, logs and more boulders. A rock-solid selection.", "Please re-rack your boulders."],
"sign.record_board": ["THE RECORD BOARD", "Every record set on this field, promptly crossed out by the next one. Personal bests are temporary; chalk is forever.", "At the bottom, in chalk: DAY 1 OF NEVER SKIPPING. Day 1 has been crossed out forty times."],
"shrine.used": ["The Pump Shrine is spent. It flexes anyway, out of habit."],
"sign.spot_me": ["SPOTTER WANTED", "Gary is under there. Gary has been under there since lunch."],
"sign.thrower_rule": ["COURTESY CHUCKS", "FREE.", "Spotter mandatory. Landing not guaranteed. Dignity sold separately."],
"sign.ripper_rule": ["PORTALS: TORN, NOT CAST", "Bare hands only. No spells, no tools.", "Warranty void if stretched."],
"sign.thrower_east": ["CROSS-COUNTRY CHUCKS", "East to west. A courtesy chuck, the long way. Gym Rat card required; Coach Benchley sells them."],
"sign.thrower_west": ["CROSS-COUNTRY CHUCKS", "West to east. A courtesy chuck, the long way. Free. Aim is a rumour."],
"sign.mini_dungeon": ["THE IRON CAVE", "Leg day. Every day. Bring chalk.", "(Chalk sold at Benchley's, at a price he calls motivational.)"],
"sign.main_dungeon": ["THE HOUSE OF GAINS", "The regime's stronghold. Authorized personnel only. Authorization takes exactly thirty seconds, and someone inside is timing you.", "Leg Day is mandatory. It never ends."],
"sign.leg_day_note": ["NOTE FROM THE REGIME", "The House of Gains is closed to the public. Visitors will be given a pamphlet, a towel and a very long set of squats.", "Weights are not available. Leg Day, however, is."],
"sign.energy_poster": ["GOT ENERGY? (THE REGIME DOES.)", "Ask any Beefcake: they've got loads of it, and the regime takes most of it."],
"sign.beefcake_poster": ["BEEFCAKES: BUILT DIFFERENT", "Energy, by wheel and mill.", "Transportation, by throw and portal.", "Currently operating under new management. Nobody asked."],
"sign.pec_perch": ["PEC PERCH", "Population: one mirror. Please mind the edge; looking down on yourself is enough."],
"sign.delt_deck": ["DELT DECK", "Mind the edge. Delts are not wings."],
"sign.glute_garden": ["GLUTE GARDEN", "Bend at the knees. Always bend at the knees."],
"sign.calf_cove": ["CALF COVE", "Quiet. Remote. Excellent calves."],
"sign.edge_warning": ["CAUTION: EDGE", "There is no railing. There is no spotter. There is only gravity."],
"sign.hamster_fact": ["FUN FACT","A hamster does not know it is the engine of a civilization.","The Beefcakes bring snacks. Civilization rests on the hamsters not finding out what a salary is."],
"enemy.brute": ["You see a regime enforcer flexing at nobody. He has held the pose since breakfast, because nobody has told him he can stop."],
"enemy.golem": ["A walking tub of confiscated protein powder rattles past, and it does not like the look of you."],
"enemy.sprite": ["A sprite of pure mandatory pre-workout buzzes past, vibrating so hard it goes straight through a wall."],
"npc.brenda.intro": ["Shh, keep it down, the regime has big ears up here. Welcome to the Gainlands. They call me Old Man Mountain, and we Beefcakes keep the kingdom's lights on and its people moving, and if you're in a hurry, we throw you.", "Ten years back, {villain}'s people put Chancellor Clench in charge, and he was Grandmaster Flex's own star pupil, if you can believe it. They locked Flex under the House of Gains and took every weight, to the last plate.", "We're tired, but we haven't crumbled, and if you fall I'll catch you. That's rule one, never lift alone. Rule two, never skip leg day. Rule three is... I've forgotten rule three. Two's plenty.", "Now, where was I? The gate, that's it. The one up on the overlook, past the ridge, won't budge for anybody. It opens when the kingdom is whole again, and not a day before. I asked it nicely, twice."],
"npc.brenda.return": ["Back again? Good, good, come and stand where I can see you. I always say the only bad rep is the one nobody was there to spot.", "You beat the regime and I'll buy the first round of shakes, even the illegal flavour. Especially the illegal flavour, come to think of it... ah, I can nearly taste it.", "The old king came up for the Lifting Festival every summer, and he brought his boy. The little fella tried my dumbbell once and sat down very hard on his royal behind.", "He laughed about it, too, sitting there on the mat with his little crown over one eye. Lovely boy. I wonder sometimes... no, never mind me. Old man talk. Where was I?", "That gate up on the overlook is still sealed. It opens when the kingdom is whole again, and not a day before. I check on it most mornings, just in case."],
"npc.gus.intro": ["I'm Foreman Gus. I keep the wheels turning and the grid humming, and I keep the hamsters fed - the volunteers, I'm meant to call them. The regime puts pre-workout in the water, and so far I'm mostly feeling the water.", "The regime wants a hundred and ten percent out of us, and the wheels only go to a hundred. The extra ten comes out of the crew, and nobody writes down where it went.", "The crews on the city wheels up in the Capital have it worse than we do. They're told it's cardio, and that it's for their own good, and it isn't either one."],
"npc.gus.return": ["Grid's still humming. If it ever goes quiet, it means somebody sat down, and the regime takes that very personally."],
"npc.tony.intro": ["LET'S GO! A NEW RECRUIT! I'm Coach Brutus Benchley, retired champion and full-time motivator, and I sell cards on the side, because a deck needs its SUPPLEMENTS the same as you do!", "IT'S ALL REGIME-APPROVED MERCHANDISE! Well, nobody actually approved it, champ, but these old cards have a GREAT ATTITUDE, and I'd put any one of them in my starting line-up!", "*whispering* Mind the loose floorboard behind the counter, would you? There's nothing under it. Only a bit of iron, and officially that doesn't exist."],
"npc.tony.return": ["LET'S GO, RETURNING CUSTOMER! The cards are warmed up and stretched, champ, and my whistle's been SAVING ITS BREATH for you all day!", "*whispering* Nobody's mentioned the floorboard. I'd like to keep our relationship on that footing."],
"npc.quiz.intro": ["Aha, a student! Do stand up straight, it's better for the posture. I am Professor Pump, Beefcake scholar, and I lecture from this very log. I've written seventeen books, you know.", "Fifteen of them concern the biceps. The other two were a history of the Lifting Festival, and when the regime burned those I wrote them out again from memory, because nobody can confiscate a well-trained brain-cep.", "I have four questions for you on the Beefcakes, their energy and their transport, and every answer is on a sign, a poster or a Beefcake's lips somewhere in the Gainlands.", "Answer well and there is gold and glory in it. Answer poorly and you will receive a mild, scholarly sigh, which I have practised for many years and which I am told is quite devastating."],
"npc.quiz.return": ["Back for another set of questions? Splendid! The wonderful thing about knowledge gains, my young scholar, is that they stay with you even on your rest days."],
"quiz.result.0": ["Zero, I'm afraid, and no reward this time. Still, it's a clean baseline, and all research has to begin somewhere.","Do read the signs before your next attempt. Let your eyes do the heavy lifting for once."],
"quiz.result.1": ["One. A twitch of knowledge, at least. Take this small pat on the back."],
"quiz.result.2": ["Two. Half-credit, graded on a bicep curve. In the Gainlands half a rep still counts, just not for very much."],
"quiz.result.3": ["Three! One shy of a clean sweep. Take your reward and flex responsibly."],
"quiz.result.4": ["FOUR! A perfect set! You may now call yourself a Certified Gainer, Class A. The reward is real; the certificate, sadly, is imaginary."],
"quiz.repeat": ["Another lap! The Gainlands pay a little less for repeat attendance. The regime calls it a 'processing fee', which sounds suspiciously like the D.N.A. to me."],
"quiz.not_passed": ["Not a pass yet, I'm afraid. Read the signs around the Gainlands and come back. We're training recall here, not regret."],
"npc.minigame.intro": ["*cue synthesizer* Welcome, welcome, WELCOME to PUMP IT UP PAST MIDNIGHT! I'm your host, Chet Thunderabs, and it is always 3 A.M. somewhere, friends, which is exactly where I live!", "You've seen the late-night tapes, and you've shouted 'Feel the burn!' at your own front room, but WAIT, there's MORE! My lovely assistant is a legwarmer, and my producer is ALSO a legwarmer!", "The regime banned my show for 'unauthorized fun', but these cameras are STILL ROLLING, because you cannot confiscate a man's ENTHUSIASM! They tried, and it came back in a brighter colour!", "Today on the show it's REP COUNTER! That's eight reps to one beat, and if you hit that beat I will personally hand you a shiny medallion of pure encouragement!", "You get rewards for performance, plus a one-time bonus on your very first set! Is it three easy payments of gold? NO, it's FREE! Operators are standing by, so here we go, and one, and two..."],
"npc.minigame.return": [
"You're back! My fans, ladies and gentlemen, both of them, right here in the studio! Do you hear that? That is the sound of Spandex applauding.",
"Now remember, the beat is your friend, and the beat does not judge you. Well, it is judging you a little, but it has the good manners to do it quietly."
],
"reps.intro": ["Eight reps. Watch the ring: press SPACE (or click) the moment it closes on the bar. Perfect, Good, OK or Miss.", "The beat speeds up. Fewer misses, more stars."],
"reps.shouts": ["And ONE!", "And TWO!", "Feel the burn!", "Squeeze it!", "Don't stop now!", "Almost there!", "One more!", "FINISH IT!"],
"reps.win": ["THAT'S THE WAY! The camera LOVES you, and so do the legwarmers, although they've been angling for a solo shot ALL NIGHT!"],
"reps.first": ["That was your first set on the show, so here's your Pump Medallion as a bonus, absolutely free and with no obligation! Operators are still standing by."],
"reps.lose": ["That wasn't quite a set, champ, but WAIT, don't you dare call it a failure! Here in the studio we call that a FREE TRIAL!","So REHYDRATE AND TRY AGAIN! The beat is standing by, the legwarmers are standing by, and I am STANDING BY, with calves that have never been more ready!"],
"npc.gary.intro": ["Mmmph! Oh, thank goodness, a spotter! Hi, I'm Gary, it's lovely to meet you, and I'm so sorry I can't get up to shake hands.", "I've been under this barbell since lunch, or possibly since the regime took over, it's hard to tell from down here. There's no rush at all. Well, there's a bit of a rush.", "It's the last barbell they didn't confiscate, you see, so I got excited and loaded one more plate than I had the confidence for.", "It's fine, honestly, it's FINE. Could you possibly give it a little push, though? Whenever you're ready, I don't want to be a bother. Now would be good."],
"ambient.gym_attendant": ["Gym's open! The weights aren't. The scales stayed, though - standard measures, sent up from the Capital. Say what you like about the Minister, those scales never lie.", "Towels are ten gold now, I'm sorry to say, because Clench has started taxing sweat.", "House rule one is still to re-rack your weights, and I do keep saying it, though we haven't had a weight in here for ten years."],
"ambient.gym_attendant.freed": ["The weights are back! I cried, then I did a set, and then I cried all over again.", "Free towels! Flex says a gym is for people, not quotas.", "Re-rack your weights! We HAVE weights! Re-rack them!"],
"npc.gary.return": ["Oh, it's my spotter! You're a hero, you really are. One of these days this barbell and I are going to rise to the occasion, and I'd be very grateful if you were standing nearby when we try."],
"fx.spot_done": ["You grab the bar and heave, and Gary slides out from under it, gasping.", "\"Oh, thank you, and I'm so sorry about the bother. Please take this - I borrowed it from the gym.\"", "\"It isn't mine, so I suppose it's yours now. I think that's how borrowing works.\""],
"fx.spot_again": ["You find Gary under a different, lighter barbell. He has lowered the bar in every sense except the useful one."],
"fx.wheel_run": ["You jump into the Colossal Hamster Wheel and run until your legs burn. The grid hums, lights brighten across the Gainlands, and somewhere a portal ripper rolls up her sleeves."],
"fx.wheel_again": ["The wheel's still spinning happily on its own. Let it coast; you've earned a snack."],
"fx.shake_good": ["It's a banana-berry shake, smooth and sweet and suspiciously good for you. +HP."],
"fx.shake_great": ["It's the legendary chocolate-peanut-butter shake, and even your muscles want the recipe. Big recovery!"],
"fx.shake_bad": ["It's chalky and lumpy, and you appear to be drinking an unfinished wall.", "You drink it anyway. -1 HP."],
"fx.shake_gold": ["There's a coin at the bottom of the cup, so the shake was only ever a front. +gold."],
"fx.shake_empty": ["You receive an empty cup. Flavour: surprise."],
"fx.shake_broke": ["The stand wants 10 gold. You have enthusiasm, which it does not accept."],
"fx.flex_1": ["You flex, the mirror flexes back, and the two of you nod at each other. +1 HP."],
"fx.flex_2": ["You hit a double biceps, and you and the mirror gasp at the same moment. +1 HP."],
"fx.flex_3": ["You hit the most-muscular pose, and the mirror breaks into applause. +1 HP."],
"fx.flex_limit": ["Your pump has peaked for this visit; come back next time. Even your reflection needs a cooldown."],
"fx.flex_full": ["You flex, the mirror flexes back, and there's nothing left to heal. You look great regardless."],
"quest.side_s_beef.offer": ["You beat {villain}, and the kingdom's whole again, which means that gate up on the overlook can finally open... Mount Swolympus, lad. I never thought I'd live long enough to see it.","Only the worthy reach the top, mind, and in my experience the worthy bring water, or a protein shake. ...Where was I? Yes, a shake. Fetch me one from the stand and the gate's yours."],
"quest.side_s_beef.active": ["A shake from the stand in the Station, and any flavour will do me. Not the illegal one, though. ...Oh, go on, then, the illegal one. I've missed it something terrible."],
"quest.side_s_beef.ready": ["Ahh, now that's worthy, that is. Very worthy. It's a bit lumpy, but then so am I, and nobody's ever held it against me.","The gate's open and the ridge path is mended, mostly. Climb to the top and say hello to the Ancient Spotter for me - he's held that bar for a thousand years, so do ask him about his back."],
"quest.side_s_beef.done": ["The Spotter's waiting for you at the summit, and he's had a long enough wait already. Don't keep him another thousand years, lad."],
"quest.gain_power.offer": ["The lights keep flickering because the regime pipes every watt we make up to the House of Gains. If you'd run the Colossal Hamster Wheel up the hill for me, we could keep a little down here. Call it quiet resistance.", "After that, buy yourself a shake at the protein stand in the Swole Station. It's for crew morale, and I'll be honest with you, mostly mine."],
"quest.gain_power.active": ["Run the Colossal Hamster Wheel up the hill, then buy a shake at the protein stand in the Swole Station, and come and find me when you've done both."],
"quest.gain_power.ready": ["The Swole Station's lights are back on and the grid's humming. I'd make a speech about it, but all my energy went into the lights, so here, take your reward instead.", "And don't let the hamsters hear you call them 'volunteers'. They're sensitive about it."],
"quest.gain_power.done": ["The grid's running smooth, and some of the power's even staying here for once. I'd hug you, but I'm a foreman, so you get a nod. ...That was a big nod, for me."],
"quest.gain_spot_me.offer": ["Which brings me back to rule one. Gary's stuck under a barbell again, so follow the groaning and give him a spot, then check your form at a Flex Mirror. The regime tried confiscating reflections once, and it didn't take.", "Do both and I'll have Shredna rip you a portal out to Calf Cove. Nobody's been out there in months, and the calves... well, you'll see for yourself."],
"quest.gain_spot_me.active": ["Spot Gary at his barbell, then flex at a Flex Mirror, either the one at the Station or the one up on Pec Perch. Spot first and flex second, that's the order, and you can brag to me about it afterwards."],
"quest.gain_spot_me.ready": ["You spotted Gary and you checked your form? Beautiful, that's just how it's meant to be done. Here, have a Pre-Workout Jitters, on the house.", "And Calf Cove's open to you now. Say hello to Shredna for me when you go through, would you? She'll pretend she hasn't missed me, she always does."],
"quest.gain_spot_me.done": ["Calf Cove's yours now. Mind the edge out there, though, always mind the edge. I didn't, once, back in the spring of... oh, never mind, it was a long time ago and I bounced."],
"quest.gain_lanes.offer": ["Regime brutes, golems and sprites keep EATING my deliveries, champ! I need you to beat any three roaming enemies in the Gainlands in card duels! THOSE SHAKES HAD MY NAME ON THEM! I WRITE IT ON EVERY LID!", "And I'll pay you in cards, STRONG cards! *whispering* Heavy ones, the kind the regime hasn't found yet."],
"quest.gain_lanes.active": ["That's three roaming enemies out in the Gainlands, champ, any three you fancy! The brutes flex at you and the golems rattle!", "And the sprites buzz, which is the worst of the lot if you ask me! So pick your poison and GET OUT THERE!"],
"quest.gain_lanes.ready": ["THREE DOWN, and my deliveries are BACK ON SCHEDULE! Here, take a Leg Day for your trouble, and do NOT skip it, champ! I'm telling you that as a coach AND as a card dealer!"],
"quest.gain_lanes.done": ["The lanes are clear, champ! They'll stay clear for about an hour, and then the regime will fill them right back up again, BUT WHAT AN HOUR!"],
"wheel.intro": [
"A control panel hums beside the wheels: six hamster wheels, three machines (the Lift, the Gate and the Mill), a switch for every wheel.",
"Each wheel is piped to TWO of the machines; its switch sends the power to one of them, or leaves it napping. Every machine needs its exact wattage. Only five wheels may run at once."
],
"wheel.solved": ["Every machine settles at exactly the right wattage, and the Lift, the Gate and the Mill all hum together.", "Somewhere a hamster sighs with relief, and a small, heavy parcel drops into the tray."],
"wheel.already": ["The grid purrs along contentedly, and there is nothing left for you to route."],
"wheel.hint": ["Start from the machine with the fewest options. The Mill needs 9, and only the wheels piped to it can supply it. Work out which wheel MUST feed the Gate."],
"wheel.machines": ["The Lift", "The Gate", "The Mill"],
"wheel.wheel_names": ["Hammy", "Nugget", "Princess Nibbles", "Sir Squeaks", "Biscuit", "Big Lou"],
"hud.objective.freed": ["The Gainlands, free at last: the Swole Station is open to everyone. HP does not come back after battles - soak in the Cooldown Hot Tub, or walk back down to town."],
"ui.exit.body.freed": ["Leaving the Gainlands ends this visit. Town heals you fully. The brutes, golems and sprites are off-duty now, but they still enjoy a scrap."],
"sign.hub_main.freed": ["THE SWOLE STATION", "Hub of the Gainlands. Heal here. Brag here. Do NOT skip leg day here.", "(Gatherings are now welcome. Mandatory cardio has been abolished. Gary is thrilled.)"],
"sign.hub_power.freed": ["POWERED BY BEEFCAKES", "Every light in the Gainlands runs on giant mills and colossal hamster wheels.", "100% muscle. 0% coal. Quotas abolished: run at whatever pace feels good."],
"sign.energy_poster.freed": ["GOT ENERGY? (WE DO!)", "Ask any Beefcake. They have loads of it, and now they get to keep some."],
"sign.beefcake_poster.freed": ["BEEFCAKES: BUILT DIFFERENT", "Energy, by wheel and mill.", "Transportation, by throw and portal.", "Back under the old management. The old management can still bench a hay cart."],
"sign.regime_rules": ["BY ORDER OF CHANCELLOR CLENCH", "1. Weights are confiscated for your safety.", "2. Protein is a privilege, not a right.", "3. Mandatory Cardio Compliance, 5 AM sharp. Lateness is punished with more cardio."],
"sign.regime_rules.freed": ["THE NEW HOUSE RULES", "1. Weights are back. Lift responsibly.", "2. Protein is a right. Also, a shake.", "3. Cardio is optional. Leg day is not."],
"sign.regime_poster": ["CHANCELLOR CLENCH SAYS: \"A BEEFCAKE WITHOUT IRON IS JUST A CAKE.\"", "(Printed on iron-free paper, naturally.)"],
"sign.regime_poster.freed": ["GRANDMASTER FLEX SAYS: \"STRENGTH IS IN THE HEART AND THE MIND.\"","(He would also like you to drink some water.)"],
"sign.missing_leader": ["MISSING: OUR LEADER", "Grandmaster Flex. Ten years gone, dragged off to the House of Gains.", "If found, do not lift him. He is probably tired.", "- the Spotters"],
"sign.missing_leader.freed": ["FOUND: OUR LEADER", "Grandmaster Flex is back, and he is doing yoga on the roof of the House of Gains.", "Wave, and he will wave back. After the pose. The pose may take a while."],
"sign.exit.freed": ["THE BEEFCAKE PATH", "(To town. The cardio checkpoint is a snack bar now. Snacks are mandatory.)"],
"sign.main_dungeon.freed": ["THE HOUSE OF GAINS", "Formerly the regime's stronghold. Open to all Beefcakes.", "Leg Day is still mandatory. Some things are sacred."],
"sign.leg_day_note.freed": ["NOTE FROM THE LEADER", "The doors are open. Come in, stretch, breathe.", "Leg Day is still Leg Day."],
"npc.brenda.intro.freed": ["You did it! Flex is out and Clench is down, and I got to watch the whole thing from the good bench. Best day since... oh, since the last best day, whenever that was. I'm spotting you from now on, like it or not.", "The weights are back in the gym, and there's Gary over there, lifting with a proper spotter at last. Beautiful. Now, before you go... that boy I told you about, the old king's son, up at the Festival...", "When you heaved that last regime brute off his feet, you made the same face he made on my dumbbell. The very same face. Funny, the things you remember."],
"npc.brenda.return.freed": ["We're free and strong and properly spotted, every one of us, and that's your doing, friend. I climbed Swolympus once, you know, back when my knees and I were on speaking terms, and these ten years were steeper.", "That gate up on the overlook is still sealed, mind. It opens when the kingdom is whole again, and not a day before. I asked it nicely again this morning, which makes three times."],
"npc.gus.intro.freed": ["Foreman Gus, still on the wheels. But listen to them now. They're turning, and there isn't a single whistle blowing over them.", "The grid's at a hundred percent and nobody's asking for ten more. Turns out a hundred was all of it, the whole time.", "I might even take a day off. I've no idea how it's done, but I'm told you start by sitting down."],
"npc.gus.return.freed": ["The wheels turn when the crew feels like turning them, and somehow we've never had more power. I'd report it to the regime, but there isn't one."],
"npc.tony.intro.freed": ["LET'S GO! The iron came out from under the floorboard and went STRAIGHT onto a rack where everybody can see it! Benchley's is open to EVERYONE, champ, and that's the best line-up I've ever fielded!", "ALL THE REGIME MERCHANDISE IS IN THE CLEARANCE BIN! Nobody wants any of it, and I have never been so proud of not making a sale!"],
"npc.tony.return.freed": ["CARDS ON THE SHELVES AND IRON ON THE RACKS! And I don't have to whisper about the floorboard any more, which is just as well, because I WAS NEVER ANY GOOD AT IT!"],
"effect.buff.name": ["Pump It Up"],
"effect.buff.flavor": ["The whole zone is on a permanent pump. Beefcakes feel it in their quads."],
"effect.debuff.name": ["Out of Breath"],
"effect.debuff.flavor": ["Everyone up here runs everywhere. A Necrocrat who tries to keep pace arrives winded and needs a minute to find the right form."],
"freed_npc.heartlift": ["Welcome, son, welcome. Grandmaster Flex, at your service, and it is good to say so in daylight. After ten years in the dark, the first thing I wanted was a window, and the second was a good long stretch.", "They took my plates and my protein and everything I had ever lifted. So I breathed: in, and hold, and out again. I did that for ten years, and it turned out to be enough.", "I counted my own heartbeats until they turned into songs. They believed they were breaking me down there, son, and all the while they were teaching me.", "Clench is learning to lift again from zero, and the strongest ones always take the longest. Yesterday he spotted Gary without being asked. The gym is open to everyone now, so come by whenever you like.", "Lift what you can. Carry what you must. Put down what was never yours.", "And you, son: whatever they took from you, it was not the part that matters."],
"ruler.statue": ["STATUE OF CHANCELLOR CLENCH", "\"A Beefcake without iron is just a cake.\""],
"ruler.statue.freed": ["FORMER STATUE OF CHANCELLOR CLENCH", "(Toppled by public demand. Please do not stand on it. Gary did, once.)"],
"ui.main.title": ["The House of Gains"],
"ui.main.body": ["The regime's stronghold. Far below it, in the Iron-less Prison, the true leader has been held for ten years. HP carries in from the zone; only the shrines heal. Beat Chancellor Clench to free the Gainlands."],
"ui.main.body_cleared": ["The House of Gains is quiet, and the doors are open. You can still run the halls for gold and XP. HP carries in from the zone; nothing heals except at the shrines."],
"ui.main.button": ["Enter the House of Gains"],
"prop.leg_day_gate": ["THE HOUSE OF GAINS"],
"dungeon.hg_gates.title": ["The Gates of Gains"],
"dungeon.hg_gates.blurb": ["Bare steel and floodlights under a banner reading MANDATORY CARDIO. Iron is banned here, and nobody has ever left through these gates."],
"dungeon.hg_gates.before": ["The gates swing open on a hall papered with posters of Chancellor Clench, and there isn't a single weight anywhere in it, not even a dumbbell.", "Every rack along the walls stands empty, right down to the little pegs where the decorative plates used to hang.", "Somewhere far beneath your feet, something is breathing, slow and even, as if it has been counting every breath for a very long time."],
"dungeon.hg_checkpoint.title": ["The Regime Checkpoint"],
"dungeon.hg_checkpoint.blurb": ["An enforcer searches your bag for weights while a clerk times him with a stopwatch. Minister Quota wants every search done in thirty seconds, and he's already at forty."],
"dungeon.hg_descent.title": ["The Descent"],
"dungeon.hg_descent.blurb": ["A long stone stairway leads down into the Iron-less Prison."],
"dungeon.hg_cells.title": ["The Cell Block"],
"dungeon.hg_cells.blurb": ["The prisoners keep very quiet and the guards are very loud, and it doesn't take long to work out which of them is afraid."],
"dungeon.hg_calisthenics.title": ["The Calisthenics Check"],
"dungeon.hg_calisthenics.blurb": ["With no iron to lift, the prison tests bodies instead, and a guard steps up and demands to see your form."],
"dungeon.hg_warden.title": ["The Iron-less Warden"],
"dungeon.hg_warden.blurb": ["The warden has never lifted a weight in his life, has never needed to, and is furious with everyone who has. (Elite)"],
"dungeon.hg_warden.after": ["The warden's keyring clatters to the floor. At the end of the corridor, behind a door with no handle, someone is doing a push-up so slow and controlled it seems to take a full minute."],
"dungeon.hg_rescue.title": ["The Last Cell"],
"dungeon.hg_rescue.blurb": ["At the very bottom of the prison there is a single cell, and from inside it comes one long, slow breath."],
"dungeon.hg_stretch.title": ["The Cell Stretch"],
"dungeon.hg_stretch.blurb": ["Grandmaster Flex leads a quiet round of stretching and breathing. Restore HP."],
"dungeon.hg_stretch.after": ["\"Breathe in slowly and hold it. Now let it all go,\" says Grandmaster Flex, breathing along with you.", "\"There. You have been holding that breath since long before you came down my stairs, son, and you needn't. The climb will still be here when you have let it out.\""],
"dungeon.hg_barracks.title": ["The Barracks Gauntlet"],
"dungeon.hg_barracks.blurb": ["You hear the recruits drilling before you see them. They make up in volume what they lack in coordination."],
"dungeon.hg_locker.title": ["The Confiscated Gear Locker"],
"dungeon.hg_locker.blurb": ["Every weight the regime ever took, stacked behind one locker door. Each plate still has its owner's name chalked on the back."],
"dungeon.hg_guard.title": ["The Honor Guard"],
"dungeon.hg_guard.blurb": ["You face Chancellor Clench's personal guard, whose uniforms are pressed to perfection and whose technique is mostly shouting. (Elite)"],
"dungeon.hg_trophy.title": ["The Trophy Hall"],
"dungeon.hg_trophy.blurb": ["The regime keeps a trophy for every leader it ever overthrew, and one pedestal stands empty, waiting for Grandmaster Flex."],
"dungeon.hg_boss.title": ["Chancellor Clench's Gym"],
"dungeon.hg_boss.blurb": ["The regime's throne room is a gym with one throne-shaped bench press in it, the only barbell left in the House."],
"dungeon.hg_boss.before": ["Chancellor Clench stands in front of an enormous bench press, the only weight left in the whole House of Gains, and he guards it like a throne.", "\"Master.\" The word sticks in his throat. \"I was your best, you know. Your star pupil. You said so yourself.\"", "\"You told me I would go further than you ever did. And then you started on about strength living in the heart and the head, and I knew better than that.\"", "\"So I took your iron, and your protein, and your followers, and here you are, climbing back up my stairs with nothing at all.\"", "\"Look how far I went, Master. What exactly do you imagine you can do about it now?\""],
"dungeon.hg_boss.after": ["Chancellor Clench falls, bench and all. The regime's banners come down one by one, and in the great hall the Beefcakes begin to cheer, quietly, then very loudly.", "Flex doesn't gloat. He kneels beside his fallen pupil and holds out a hand. \"You hated yourself for needing the iron, my boy.\"", "\"I never once hated you for it. Come back to the gym. We'll start from zero, the way everyone does.\"", "Clench has lost his title, his medals and the thing he thought strength was. He stares at the hand a long time. He does not take it yet, but he does not pull away.", "Then Flex turns to you, and his voice is gentle. \"Whatever they took from you, son, it was not the part that matters.\""],
"challenge.hg_calisthenics.title": ["The Calisthenics Check"],
"challenge.hg_calisthenics.text": ["There is no iron in the prison, so the guards test what you can do with your own body, and your first unit must be strong enough to count."],
"event.hg_descent.title": ["The Descent"],
"event.hg_descent.body": ["The stairway to the Iron-less Prison is steep, dark and damp. On the third landing a guard fills the whole stair, arms folded, muscles folded on top of the arms.","\"Nobody goes down,\" he says. Then, after a long and meaningful pause: \"Unless...\""],
"event.hg_descent.choice.0": ["Bribe the guard"],
"event.hg_descent.choice.1": ["Overpower the guard"],
"event.hg_descent.choice.2": ["Distract the guard"],
"event.hg_descent.result.0": ["He counts the coins twice, bites one for good measure and steps aside. \"I saw nothing, and I didn't buy anything either, so off you go before I remember what I'm paid for.\""],
"event.hg_descent.result.1": ["You win the wrestle, though he wins the first three rounds of it. The way down is open, and so is your lip."],
"event.hg_descent.result.2": ["You fling {card} down the far stairwell, and the guard bounds after it like a puppy after a ball.","He'll guard it with his life until you leave the House, and then it's yours again."],
"event.hg_rescue.title": ["The Rescue"],
"event.hg_rescue.body": ["In the last cell, a gaunt old man sits cross-legged in the dark, perfectly still. Ten years of breath and calisthenics have worn him down to wire and will.", "He opens one eye and looks at you. \"You are not a guard.\"", "There's no bar or bench in the cell, only stone worn smooth by ten years of training. Something about the bare walls tightens your chest, and you couldn't say why."],
"event.hg_rescue.choice.0": ["Pick the lock and free him"],
"event.hg_rescue.result.0": ["The lock gives. Grandmaster Flex rises slowly, a little unsteady on his feet, and bows to you. He is so thin you could count his ribs.", "He moves with a stillness that is somehow the opposite of weakness. \"When you face Clench,\" he says, \"I will be beside you.\""],
"event.hg_trophy_hall.title": ["The Trophy Hall"],
"event.hg_trophy_hall.body": ["Trophies of every defeated Beefcake line the walls: belts, medals, the left shoe of a champion.","The plate on the empty pedestal reads GRANDMASTER FLEX (PENDING), and someone has dusted it very recently."],
"event.hg_trophy_hall.choice.0": ["Take the medals (they are very shiny)"],
"event.hg_trophy_hall.choice.1": ["Polish the empty pedestal"],
"event.hg_trophy_hall.choice.2": ["Leave everything as it is"],
"event.hg_trophy_hall.result.0": ["The medals jingle as you scoop them up, and Grandmaster Flex winces. \"They are not ours to take, son.\"", "\"Still, the regime owes this house a great deal, and gold settles debts.\" You feel a little guilty, and a little richer."],
"event.hg_trophy_hall.result.1": ["You polish it until it gleams, and as Grandmaster Flex watches you work, something old and heavy seems to lift off his shoulders. You feel stronger."],
"event.hg_trophy_hall.result.2": ["You leave the hall exactly as you found it, and Grandmaster Flex gives you one slow nod of approval."],
"cutscene.rescue.1.speaker": ["Grandmaster Flex"],
"cutscene.rescue.1": ["Quietly, son. The guards time their rounds by counting their own squats, and sooner or later every one of them loses count.", "So the rounds come whenever they come. Listen for knees cracking on the stairs, and you'll hear them in plenty of time."],
"cutscene.rescue.2.speaker": ["You"],
"cutscene.rescue.2": ["You're Grandmaster Flex? Everyone up there talks about you as though you were twice this size."],
"cutscene.rescue.3.speaker": ["Grandmaster Flex"],
"cutscene.rescue.3": ["Ten years in the dark will do that to a man. They took my plates and my protein and every bar I ever lifted, and they left me down here with nothing at all.", "And nothing, it turns out, is a fine place to start from. I still had my breath, my body and my mind, so I trained those, every day.", "Come along, son, and we'll climb out of here together. I'd like a word with Clench on the way. He was the best student I ever had, you know. He still is."],
"cutscene.flex.1.speaker": ["Chancellor Clench"],
"cutscene.flex.1": ["You brought that... that stick of a man into MY house? Look at you, Master. Ten years on bread and water, and you still won't stay down.", "A Beefcake without iron is just a CAKE!"],
"cutscene.flex.2.speaker": ["Grandmaster Flex"],
"cutscene.flex.2": ["Stand back a little, son, if you would. It has been a long time, and I should like some room."],
"cutscene.flex.3.speaker": ["Grandmaster Flex"],
"cutscene.flex.3": ["They took my weights, Clench. They forgot to take me.", "You only ever wanted the weight, my boy. I was trying to teach you the heart, and you stopped listening long before I ever got to the mind."],
"cutscene.flex.4.speaker": ["Chancellor Clench"],
"cutscene.flex.4": ["...How? Ten years in a hole with nothing. Where were you HIDING all of that?"],
"cutscene.flex.5.speaker": ["Grandmaster Flex"],
"cutscene.flex.5": ["Strength was never a matter of how heavy a thing is, Clench. It lives in the heart and the mind, and nobody can lock those in a cell.", "The heavy things were only ever practice, my boy. Now, shall we begin?"],
"dungeon.hg_boss.before_alone": ["Chancellor Clench stands in front of an enormous bench press, the only weight left in the whole House of Gains, and he guards it like a throne.", "\"A stranger in my house, and you didn't even bring the old man up with you. They tell me Flex is still down there in the dark, doing push-ups for nobody.\"", "\"They say he trained a hundred pupils and that I was the best of them. Well, look where being the best got me, and then look where teaching got him.\"", "\"Step up to the bench, then, stranger, and let me show you what iron is for.\""],
"dungeon.hg_boss.after_alone": ["Chancellor Clench falls, bench and all. The regime's banners come down one by one, and in the great hall the Beefcakes begin to cheer, quietly, then very loudly.", "You hear slow, controlled footsteps on the stairs. Grandmaster Flex emerges from the Iron-less Prison alone, in thin grey robes.", "\"I heard the cheering, and I thought it was time I came up,\" he says. \"Lovely day for it.\" Then he looks at his fallen pupil, and his face softens.", "\"Up you get, my boy. We'll start again from zero, the way everyone does.\"", "He glances at you. \"Whatever they took from you, son, it was not the part that matters.\""],
}
quiz_questions = Array[Dictionary]([{
"a": ["Giant mills and colossal hamster wheels", "Solar panels the size of a bench", "One extremely motivated battery", "Coal, mostly, and spite"],
"correct": 0,
"q": "What do the Beefcakes use to keep the lights on across the Gainlands?",
"where": "sign.hub_power at the Swole Station; sign.mills; sign.energy_poster; sign.beefcake_poster"
}, {
"a": ["A cursed zipper", "Bare hands only", "A strongly worded letter", "A very sharp spreadsheet"],
"correct": 1,
"q": "How does a Beefcake Portal Ripper open a portal?",
"where": "sign.ripper_rule beside Rita (Ridge Road); sign.beefcake_poster; Rita's intro line"
}, {
"a": ["A Gentle Lob", "A Sky Hug", "A Courtesy Chuck", "A Rental Yeet"],
"correct": 2,
"q": "What do Beefcakes call a free trip through the air from one of their throwers?",
"where": "sign.thrower_rule beside Brock (Meadow Road); sign.thrower_east / sign.thrower_west; fx.thrown"
}, {
"a": ["Arm Day", "Rest Day", "Cheat Day", "Leg Day"],
"correct": 3,
"q": "Which day must no Beefcake ever skip?",
"where": "sign.main_dungeon (the gate on Leg Day Ridge); Old Man Mountain's intro line; sign.leg_day_note"
}])
