[gd_resource type="Resource" script_class="ZoneStoryText" format=3]

[ext_resource type="Script" path="res://core/data/zone_story_text.gd" id="1_gain"]

[resource]
script = ExtResource("1_gain")
zone_id = "beefcake"
lines = {
"hud.objective": ["The Gainlands: the Swole Station is safe, mostly because the regime forgets it exists. HP does not come back after battles - soak in the Cooldown Hot Tub or walk down to town. The House of Gains is on Leg Day Ridge."],
"ui.mini.body": ["Three sets in a row. Your HP carries from one set to the next and nothing heals in between. Finish all three for a unique Beefcake card."],
"ui.mini.body_cleared": ["You already took the unique card from here. You can still lift for gold and XP. HP carries over; nothing heals in between."],
"ui.mini.button": ["Chalk up"],
"ui.exit.title": ["Walk back down to town?"],
"ui.exit.body": ["Leaving the Gainlands ends this visit. Town heals you fully; the regime's roaming brutes, golems and sprites will be back next time."],
"fx.main_dungeon": ["The House of Gains looms over you, all iron-less steel and floodlights. The regime's flag snaps in the wind: a barbell with a red line through it."],
"fx.heal_couch": ["You sink into eucalyptus-scented water with an unmistakable base note of gym sock. HP restored; nose unconvinced."],
"fx.heal_already": ["You are already as recovered as a Beefcake gets. Go lift something. Preferably not Gary."],
"fx.hit": ["ZAP! A regime sprite hits you right in the quads. (-2 HP)"],
"fx.wake": ["You wake up in the Cooldown Hot Tub at the Swole Station. Old Man Mountain is holding a clipboard and a very small towel.", "\"Passed out mid-rep. Happens to the best of us. Happened to me in the spring of... well. The tab's on you.", "Don't tell the regime. They'd only fine you for resting.\""],
"fx.chest": ["You find a hidden stash. Excellent spotting technique, terrible lifting posture."],
"fx.thrown": ["COURTESY CHUCK!"],
"fx.landed": ["Nailed the landing. Mostly, the ground nailed you."],
"fx.portal": ["RRRRRIIIIIP! A portal, torn open by hand."],
"fx.fall": ["You fall off the island and respawn at your last safe spot. Gravity declines your request for a spotter. (-1 HP)"],
"fx.fall_log": ["Fell off %s - respawned at the last safe spot, 1 damage to zone HP."],
"fx.locked": ["Not yet. Come back when you've done a few more reps."],
"travel.throw.ask": ["Courtesy Chuck to %s: free, fast, no legroom required. Ready to be thrown?"],
"travel.portal.ask": ["Portal service: torn open by hand, no refunds. Step through to %s?"],
"travel.dest.arrive_pec": ["Pec Perch"],
"travel.dest.arrive_delt": ["Delt Deck"],
"travel.dest.land_west": ["the far west meadow"],
"travel.dest.land_east": ["the far east meadow"],
"travel.dest.land_pec": ["the Meadow Road"],
"travel.dest.arrive_calf": ["Calf Cove"],
"travel.dest.land_delt": ["the Ridge Road"],
"travel.dest.arrive_glute": ["Glute Garden"],
"travel.dest.land_glute": ["the east wheel yard"],
"travel.dest.land_calf": ["the west meadow"],
"travel.thrower_pec.intro": ["Brock cracks every knuckle he owns, then a few he borrowed. \"Pec Perch? Great view.", "Terrible landing, though. Hold still; the view is the comfortable part.\""],
"travel.thrower_pec.locked": ["Brock is out of stock on locks. This one is always open."],
"travel.ripper_delt.intro": ["Rita flexes both hands like she is about to open a very stubborn jar. \"Delt Deck? Wild ride. I rip the portal, you walk in.", "No tools, no spells. Bare hands. Just lats.\""],
"travel.ripper_delt.locked": ["Rita shakes her head. \"No juice, no rip. Ripping takes power, and the grid is bone dry.", "Somebody needs to run the big hamster wheel up the hill. Do that, then come back.\""],
"travel.thrower_east.intro": ["Tobias hefts you like a sack of oats. \"Cross-country to the west meadow. Long way.", "I'll put everything into the throw. You can tell me what you thought of it when your thoughts catch up.\""],
"travel.thrower_east.locked": ["Tobias squints at you. \"Cross-country is for Gainers only. Show me a Gym Rat card and I'll chuck you clear across the map. Coach Brutus Benchley sells them.\""],
"travel.thrower_west.intro": ["Wanda is already warming up. \"East meadow? Easy.", "Say 'courtesy' for me. Louder. COURTESY!\""],
"travel.thrower_west.locked": ["Wanda is always ready."],
"travel.thrower_pec_back.intro": ["Bonnie waves a foam finger. \"Heading down? Right.", "Bend your knees on the way down. It'll look like you planned this.\""],
"travel.thrower_pec_back.locked": ["Bonnie is always ready."],
"travel.ripper_calf.intro": ["Shredna rolls her shoulders. \"Calf Cove. Nobody's been out there in months.", "Old Man Mountain vouches for you, so Calf Cove's open. Mind the edges; the view really drops off.\""],
"travel.ripper_calf.locked": ["Shredna crosses her arms. \"Calf Cove stays shut till Old Man Mountain trusts you. Do his 'Spot Me!' favour, then come back and I'll rip it open.\""],
"travel.ripper_delt_back.intro": ["Ripley is already shaking out her hands. \"Back down to the Ridge? Sure.", "No tools, just lats. I open doors by taking a very personal interest in the wall.\""],
"travel.ripper_delt_back.locked": ["Ripley is always ready."],
"travel.thrower_glute.intro": ["Dmitri cracks his neck, slowly, both ways. \"Glute Garden is a long throw. Very long.", "I need you to be aerodynamic. Try not to think about it. Thinking adds drag.\""],
"travel.thrower_glute.locked": ["Dmitri shakes his head slowly. \"Long-haul throws are for Beefcakes who can handle the wilds. Beat two roaming enemies out there, then come see me.\""],
"travel.thrower_glute_back.intro": ["Greta checks her watch. \"Down to the east wheel yard? Say 'ready' on three.", "One. Two. Actually, I'm already throwing.\""],
"travel.thrower_glute_back.locked": ["Greta is always ready."],
"travel.ripper_calf_back.intro": ["Raelynn tears a seam in the air with one grunt. \"Home? Home is always an option. Mind the gap. It bites.\""],
"travel.ripper_calf_back.locked": ["Raelynn is always ready."],
"sign.hub_main": ["THE SWOLE STATION", "Hub of the Gainlands. Heal here. Brag here. Do NOT skip leg day here.", "(Regime notice: all gatherings must be pre-approved cardio.)"],
"sign.hub_power": ["POWERED BY BEEFCAKES", "Every light in the Gainlands runs on giant mills and colossal hamster wheels.", "100% muscle. 0% coal. 110% quota, by order of the regime."],
"sign.exit": ["THE GORGE BRIDGE","To {town}. Mind the gap; it has a very low opinion of shortcuts.","(Bridge lowered courtesy of Brick Bronson. He would like you to know he stretched first.)"],
"sign.heal_tub": ["COOLDOWN HOT TUB", "Soak. Stretch. Do not drink the water. (Foreman Gus drank the water.)"],
"sign.protein_stand": ["PROTEIN SHAKE STAND", "10 gold. Flavour: surprise.", "Results may vary. Please wait for the shake to settle before deciding whether you have."],
"sign.flex_mirror": ["FLEX MIRROR", "Check your form, your friend's form and the mirror's form. Someone here needs constructive reflection."],
"sign.vendor": ["BENCHLEY'S PROTEIN & PASTEBOARD","Protein, powder and cards. Mostly cards. The protein is optional. The yelling is not."],
"sign.mills": ["MILL MEADOW", "These giant mills grind everything: grain, tension, deadlines.", "Pushed by hand, by Beefcakes, since forever."],
"sign.quiz": ["THE LECTURE LOG", "Professor Pump teaches: 4 questions on Beefcake knowledge. Bring your own notes. Notes are on the signs."],
"sign.studio": ["STUDIO 3 AM", "Now taping: 'Pump It Up Past Midnight!'", "Wear your legwarmers. Fashion may have moved on, but our calves have not."],
"sign.puzzle": ["POWER GRID CONTROL PANEL", "Six hamster wheels, three machines. Each wheel feeds two machines (or naps).", "Only five wheels may run at once. They get tired."],
"sign.wheel": ["COLOSSAL HAMSTER WHEEL", "Run it to power the grid. No actual hamsters. Hamsters are on break."],
"sign.gym": ["THE BOULDER GYM", "Equipment: boulders, logs and more boulders. A rock-solid selection.", "Please re-rack your boulders."],
"sign.record_board": ["THE RECORD BOARD", "Every record set on this field, promptly crossed out by the next one. Personal bests are temporary; chalk is forever.", "At the bottom, in chalk: DAY 1 OF NEVER SKIPPING. Day 1 has been crossed out forty times."],
"shrine.used": ["The Pump Shrine is spent. It flexes anyway, out of habit."],
"sign.spot_me": ["SPOTTER WANTED", "Gary is under there. Gary has been under there since lunch."],
"sign.thrower_rule": ["COURTESY CHUCKS", "FREE.", "Spotter mandatory. Landing not guaranteed. Dignity sold separately."],
"sign.ripper_rule": ["PORTALS: TORN, NOT CAST", "Bare hands only. No spells, no tools.", "Warranty void if stretched."],
"sign.thrower_east": ["CROSS-COUNTRY CHUCKS", "East to west. A courtesy chuck, the long way. Gym Rat card required for the long way."],
"sign.thrower_west": ["CROSS-COUNTRY CHUCKS", "West to east. A courtesy chuck, the long way. Free. Aim is a rumour."],
"sign.mini_dungeon": ["THE IRON CAVE", "Leg day. Every day. Bring chalk.", "(Chalk sold at Benchley's. Chalk is a lie.)"],
"sign.main_dungeon": ["THE HOUSE OF GAINS", "The regime's stronghold. Authorized personnel only.", "Leg Day is mandatory. It never ends."],
"sign.leg_day_note": ["NOTE FROM THE REGIME", "The House of Gains is closed to the public. Visitors will be given a pamphlet, a towel and a very long set of squats.", "Weights are not available. Leg Day, however, is."],
"sign.energy_poster": ["GOT ENERGY? (THE REGIME DOES.)", "Ask a Beefcake. They have loads. The regime takes most of it."],
"sign.beefcake_poster": ["BEEFCAKES: BUILT DIFFERENT", "Energy, by wheel and mill.", "Transportation, by throw and portal.", "Currently operating under new management. Nobody asked."],
"sign.pec_perch": ["PEC PERCH", "Population: one mirror. Please mind the edge; looking down on yourself is enough."],
"sign.delt_deck": ["DELT DECK", "Mind the edge. Delts are not wings."],
"sign.glute_garden": ["GLUTE GARDEN", "Bend at the knees. Always bend at the knees."],
"sign.calf_cove": ["CALF COVE", "Quiet. Remote. Excellent calves."],
"sign.edge_warning": ["CAUTION: EDGE", "There is no railing. There is no spotter. There is only gravity."],
"sign.hamster_fact": ["FUN FACT","A hamster does not know it is the engine of a civilization.","The Beefcakes bring snacks. Civilization rests on the hamsters not finding out what a salary is."],
"enemy.brute": ["You see a regime enforcer flexing at nobody. Since breakfast, apparently; even his audience is exhausted."],
"enemy.golem": ["You hear confiscated protein powder rattle inside a walking tub. Whey out of line."],
"enemy.sprite": ["Pure mandatory pre-workout. Zero chill. Vibrates through walls."],
"npc.brenda.intro": ["Shh. Welcome to the Gainlands. The regime has ears. Big ones. I'm Old Man Mountain. We Beefcakes power the kingdom on mills and hamster wheels, and move folks by throw and by portal.", "Ten years back, {villain}'s people put Chancellor Clench in charge. Grandmaster Flex's own star pupil. They locked Flex under the House of Gains and took every weight. Every... every plate.", "We haven't crumbled. Tired, mind. If you fall, I catch you. Rule one: never lift alone. Rule two: never skip leg day. Rule three... I forget. Two is plenty."],
"npc.brenda.return": ["Back for more? Good. The only bad rep is the one nobody spotted.", "Beat the regime and I'll buy the first round of shakes. The illegal flavour... ah, that's the one worth remembering.", "The old king used to come up for the Lifting Festival every summer, with his boy. Little fella tried my dumbbell and sat down hard on his royal behind.", "Laughed about it, too. Four colours in his hands, plain as day. You've got a look about you... never mind. Old man talk. Where was I."],
"npc.gus.intro": ["Foreman Gus: wheels turning, grid humming, hamsters... *volunteers*... fed. Pre-workout's in the water, but so far I'm only feeling the water.", "The regime wants a hundred and ten percent. The wheels go to a hundred. The extra ten is me, crying quietly.", "They want the same out of the city wheels up in the Capital. Those crews get told it's cardio. It isn't."],
"npc.gus.return": ["Grid still humming? If it goes quiet, somebody's resting, and the regime writes that down as a personal insult."],
"npc.tony.intro": ["LET'S GO! NEW RECRUIT! Coach Brutus Benchley! Retired champion, current motivator, part-time merchant! Protein, powder, pasteboard! Supplements for your DECK!", "REGIME-APPROVED MERCHANDISE! Not actually approved, but these old cards have a GREAT ATTITUDE!", "*whispering* Mind the loose floorboard behind the counter. Nothing under it... just iron, which officially isn't anything."],
"npc.tony.return": ["LET'S GO, RETURNING CUSTOMER! The cards are pumped and my whistle has been SAVING ITS BREATH!", "*whispering* Nobody's mentioned the floorboard. I'd like to keep our relationship on that footing."],
"npc.quiz.intro": ["Aha, a student! Professor Pump, Beefcake scholar, lecturing from this very log. I have written seventeen books.", "Fifteen concern biceps; the regime burned the other two, so I rewrote them from memory. You cannot confiscate a well-trained brain-cep.", "Four questions on the Beefcakes, their energy and their transport. Every answer is on a sign, a poster or a Beefcake's lips somewhere in the Gainlands.", "Answer well for gold and glory. Answer poorly and receive a mild, scholarly sigh. Today, we train the brain-ceps."],
"npc.quiz.return": ["Back for another set of questions? Splendid - knowledge gains are retained even when you stop flexing."],
"quiz.result.0": ["Zero, with no reward this time. A clean baseline; research begins somewhere.","Consult the signs before your next attempt. Your eyes may do the heavy reading."],
"quiz.result.1": ["One. A muscle twitch of knowledge. Take this pat on the back. It's a small one."],
"quiz.result.2": ["Two. Half-credit, graded on a bicep curve. In the Gainlands half a rep still counts. Just not for much."],
"quiz.result.3": ["Three! One shy of a clean sweep. Take your reward and flex responsibly."],
"quiz.result.4": ["FOUR! A perfect set! You may now call yourself a Certified Gainer, Class A. The reward is real. The certificate is imaginary."],
"quiz.repeat": ["Another lap! The Gainlands pay a small processing fee for repeat attendance."],
"quiz.not_passed": ["Not a pass yet; read the signs around the Gainlands and return. We are training recall, not regret."],
"npc.minigame.intro": ["*cue synthesizer* Welcome, welcome, WELCOME to PUMP IT UP PAST MIDNIGHT! I'm your host, Chet Thunderabs, and it is 3 A.M. somewhere, which is where I live!", "You've seen the late-night tapes! 'Feel the burn!' But WAIT, there's MORE! My assistant is a legwarmer. My producer is ALSO a legwarmer.", "The regime banned my show for 'unauthorized fun'! These cameras are STILL ROLLING - you can't spell resistance without... well, SPANDEX HELPS!", "Today's show: REP COUNTER! Eight reps, one beat. Hit the beat and I give you a shiny medallion of pure encouragement!", "Rewards for performance, plus a one-time bonus on your very first set! Three easy payments of gold? NO! FREE! Operators are standing by! And one, and two..."],
"npc.minigame.return": [
"Back again! My fans! Both of you! Hear that? That's the sound of Spandex, applauding.",
"Remember: the beat is your friend. The beat does not judge. The beat is judging, but quietly."
],
"reps.intro": ["Eight reps. Watch the ring: press SPACE (or click) the moment it closes on the bar. Perfect, Good, OK or Miss.", "The beat speeds up. Fewer misses, more stars."],
"reps.shouts": ["And ONE!", "And TWO!", "Feel the burn!", "Squeeze it!", "Don't stop now!", "Almost there!", "One more!", "FINISH IT!"],
"reps.win": ["THAT'S THE WAY - THE CAMERA LOVES YOU! And the legwarmers, but they've been trying to get a solo shot ALL NIGHT!"],
"reps.first": ["Your first set on the show! Here's your Pump Medallion: a bonus, free, no obligation. Operators are still standing by."],
"reps.lose": ["Not quite a set, champ. That's fine. Take a breath.","REHYDRATE AND TRY AGAIN! The beat and the legwarmers are standing by - only one of those has legs!"],
"npc.gary.intro": ["Mmmph! Oh good, a spotter! Hi. Gary. Lovely to meet you.", "I've been under this barbell since lunch... possibly since the regime took over. No rush, but I would like to become a standing appointment.", "It's the last barbell they didn't confiscate. I loaded one more plate than my confidence.", "It's fine. It's FINE. Could you give it a little push? Bit of a rush, actually."],
"npc.gary.return": ["Spotter, you're a hero! One day this barbell and I will rise to the occasion... with you watching, please."],
"fx.spot_done": ["You grab the bar and heave. Gary slides out, gasping.", "\"You're a hero! Take this. I borrowed it from the gym.", "It's not mine. It's yours now. That's how borrowing works, I think.\""],
"fx.spot_again": ["You find Gary under a different, lighter barbell. He has lowered the bar in every sense except the useful one."],
"fx.wheel_run": ["You jump into the Colossal Hamster Wheel and run. And run. The grid hums, the lights across the Gainlands brighten, and somewhere a portal ripper rolls up her sleeves."],
"fx.wheel_again": ["The wheel is already spinning happily. Let it coast. You deserve a snack."],
"fx.shake_good": ["A banana-berry shake. Smooth, sweet, suspiciously good for you. +HP."],
"fx.shake_great": ["You taste a legendary chocolate-peanut-butter shake. Even your muscles want the recipe - big recovery!"],
"fx.shake_bad": ["Chalky, lumpy... you appear to be drinking an unfinished wall.", "You drink it anyway. -1 HP."],
"fx.shake_gold": ["The cup has a coin at the bottom. The shake was just a front. +gold."],
"fx.shake_empty": ["You receive an empty cup. The stand has mistaken protein for a serving suggestion."],
"fx.shake_broke": ["The stand wants 10 gold. You have enthusiasm, which it does not accept."],
"fx.flex_1": ["You flex. The mirror flexes back. You both nod. +1 HP."],
"fx.flex_2": ["You hit a double biceps. The mirror gasps. You gasp. +1 HP."],
"fx.flex_3": ["You hit the most-muscular pose. The mirror applauds. +1 HP."],
"fx.flex_limit": ["Your pump has peaked; come back after your next visit. Even your reflection needs a cooldown."],
"fx.flex_full": ["You flex, the mirror flexes back, nothing to heal. Looking great regardless."],
"quest.gain_power.offer": ["Lights flicker while the regime pipes every watt to the House of Gains. Run the Colossal Hamster Wheel up the hill for us - a little resistance.", "Then buy a shake at the protein stand in the Swole Station for crew morale. Quiet gains - the revolution comes with a straw."],
"quest.gain_power.active": ["Run the Colossal Hamster Wheel up the hill, then buy a shake at the protein stand in the Swole Station. Quiet gains - tell me when you're done."],
"quest.gain_power.ready": ["The Swole Station's lights are back on, and the grid's HUMMING. Take your reward before I turn this into a pep talk.", "Don't let the hamsters hear you call them 'volunteers'. They're sensitive."],
"quest.gain_power.done": ["The grid's running smooth, and some of it's even staying here. I'd hug you, but I'm a foreman. We nod. ...That was a big nod."],
"quest.gain_spot_me.offer": ["Which brings me to rule one. Gary's under a barbell again. Go and spot him; follow the groaning. Then check your form at a Flex Mirror. The regime can't confiscate a reflection. They tried.", "Do both and I'll have Shredna rip you a portal to Calf Cove. Nobody's been out there in months. The calves are... unreal."],
"quest.gain_spot_me.active": ["Spot Gary at his barbell, then flex at a Flex Mirror: the one at the Station or the one up on Pec Perch. Spot first, flex second, brag third."],
"quest.gain_spot_me.ready": ["You spotted Gary AND checked your form? Beautiful. Here, a Pre-Workout Jitters. On the house.", "Calf Cove's open to you now. Tell Shredna I said hello. She'll pretend she didn't miss me."],
"quest.gain_spot_me.done": ["Calf Cove is yours. Mind the edge. Always mind the edge. I didn't, once, back in... never mind."],
"quest.gain_lanes.offer": ["Regime brutes, golems and sprites keep eating my deliveries! Beat any three roaming enemies in the Gainlands in card duels - END THE BULKING ORDERS!", "I'll pay you in cards! STRONG cards! *whispering* Heavy ones. The kind the regime hasn't found yet."],
"quest.gain_lanes.active": ["Three roaming enemies out in the Gainlands, champ! The brutes flex! The golems rattle!", "The sprites buzz! Pick your poison and GET OUT THERE!"],
"quest.gain_lanes.ready": ["THREE DOWN! Deliveries back on schedule! Here's a Leg Day for your trouble. Do NOT skip it. That's not a joke. That's the card."],
"quest.gain_lanes.done": ["The lanes are clear! For about an hour! Then the regime fills them up again! BUT WHAT AN HOUR!"],
"wheel.intro": [
"A control panel hums beside the wheels: six hamster wheels, three machines (the Lift, the Gate and the Mill), a switch for every wheel.",
"Each wheel is piped to TWO of the machines; its switch sends the power to one of them, or leaves it napping. Every machine needs its exact wattage. Only five wheels may run at once."
],
"wheel.solved": ["Every machine hums at exactly the right wattage. The lift hums. The gate hums.", "The mill hums. Somewhere, a hamster sighs in relief. A small, heavy parcel drops into the tray."],
"wheel.already": ["The grid purrs. Nothing left to route."],
"wheel.hint": ["Start from the machine with the fewest options. The Mill needs 9, and only the wheels piped to it can supply it. Work out which wheel MUST feed the Gate."],
"wheel.machines": ["The Lift", "The Gate", "The Mill"],
"wheel.wheel_names": ["Hammy", "Gerald", "Princess Nibbles", "Sir Squeaks", "Biscuit", "The Colonel"],
"hud.objective.freed": ["The Gainlands, free at last: the Swole Station is open to everyone. HP does not come back after battles - soak in the Cooldown Hot Tub, or walk back down to town."],
"ui.exit.body.freed": ["Leaving the Gainlands ends this visit. Town heals you fully. The brutes, golems and sprites are off-duty now, but they still enjoy a scrap."],
"sign.hub_main.freed": ["THE SWOLE STATION", "Hub of the Gainlands. Heal here. Brag here. Do NOT skip leg day here.", "(Gatherings are now welcome. Mandatory cardio has been abolished. Gary is thrilled.)"],
"sign.hub_power.freed": ["POWERED BY BEEFCAKES", "Every light in the Gainlands runs on giant mills and colossal hamster wheels.", "100% muscle. 0% coal. Quotas abolished: run at whatever pace feels good."],
"sign.energy_poster.freed": ["GOT ENERGY? (WE DO!)", "Ask a Beefcake. They have loads. And now they keep it."],
"sign.beefcake_poster.freed": ["BEEFCAKES: BUILT DIFFERENT", "Energy, by wheel and mill.", "Transportation, by throw and portal.", "Back under the old management. The old management is still jacked."],
"sign.regime_rules": ["BY ORDER OF CHANCELLOR CLENCH", "1. Weights are confiscated for your safety.", "2. Protein is a privilege, not a right.", "3. Mandatory Cardio Compliance, 5 AM sharp. Lateness is punished with more cardio."],
"sign.regime_rules.freed": ["THE NEW HOUSE RULES", "1. Weights are back. Lift responsibly.", "2. Protein is a right. Also, a shake.", "3. Cardio is optional. Leg day is not."],
"sign.regime_poster": ["CHANCELLOR CLENCH SAYS: \"A BEEFCAKE WITHOUT IRON IS JUST A CAKE.\"", "(Printed on iron-free paper, naturally.)"],
"sign.regime_poster.freed": ["GRANDMASTER FLEX SAYS: \"STRENGTH IS IN THE HEART AND THE MIND.\"","(He would also like you to drink some water.)"],
"sign.missing_leader": ["MISSING: OUR LEADER", "Grandmaster Flex. Ten years gone, dragged off to the House of Gains.", "If found, do not lift him. He is probably tired.", "- the Spotters"],
"sign.missing_leader.freed": ["FOUND: OUR LEADER", "Grandmaster Flex is back, and he is doing yoga on the roof of the House of Gains.", "No spotter needed on the roof. He is holding that pose for himself."],
"sign.exit.freed": ["THE BEEFCAKE PATH", "(Town. Stairs sold separately. The cardio checkpoint has been repurposed as a snack bar.)"],
"sign.main_dungeon.freed": ["THE HOUSE OF GAINS", "Formerly the regime's stronghold. Open to all Beefcakes.", "Leg Day is still mandatory. Some things are sacred."],
"sign.leg_day_note.freed": ["NOTE FROM THE LEADER", "The doors are open. Come in, stretch, breathe.", "Leg Day is still Leg Day."],
"npc.brenda.intro.freed": ["YOU DID IT. Flex is out, Clench is down, and I got to watch. Best day since... since the last best day. I'll be spotting you for the rest of your HP, like it or not.", "The weights are back in the gym. There's Gary, lifting. With a spotter. Beautiful. Before you go... that boy I told you about, the old king's son, at the Festival.", "When you lifted that last regime brute, you made the same face he did. Exactly the same face."],
"npc.brenda.return.freed": ["Free, strong and spotted. Thank you, friend. I climbed Swolympus once, you know. These ten years were steeper."],
"npc.gus.intro.freed": ["Foreman Gus. Still on the wheels. Listen to that.", "The grid's at a hundred percent, and nobody wants ten more. Turns out a hundred was all of it.", "I might cry into the wheel for energy. Voluntarily, for once."],
"npc.gus.return.freed": ["The wheels turn when they feel like it, and somehow we've never had more power. I'd tell the regime, but there isn't one."],
"npc.tony.intro.freed": ["LET'S GO! The iron came out from under the floorboard and went STRAIGHT onto a rack! Benchley's is open to EVERYONE!", "REGIME MERCHANDISE IN THE CLEARANCE BIN! Nobody wants it - my proudest day of not making a sale!"],
"npc.tony.return.freed": ["CARDS ON SHELVES, IRON ON RACKS! I can finally shout about the floorboard, and I'VE FORGOTTEN HOW!"],
"effect.buff.name": ["Pump It Up"],
"effect.buff.flavor": ["The whole zone is on a permanent pump. Beefcakes feel it in their quads."],
"effect.debuff.name": ["Processing Time"],
"effect.debuff.flavor": ["\"Your request is being processed.\" Necrocrats are used to forms and queues. Beefcakes just show up there-ish, on-time-ish, and the paperwork never catches up."],
"freed_npc.heartlift": ["Welcome, friend. Grandmaster Flex. Ten years in the dark, and the first thing I wanted was a window. The second was a stretch.", "They took my plates, my protein, my pre-workout. So I breathed. Breathe in. Hold. ...That is what I did for ten years.", "I counted my own heartbeats until they became songs. They thought they were breaking me. They were teaching me.", "Clench is learning to lift from zero. The strongest take the longest. The gym is open to everyone now. Come whenever you like.", "Lift what you can. Carry what you must. Put down what was never yours.", "And you, son: whatever they took from you, it was not the part that matters."],
"ruler.statue": ["STATUE OF CHANCELLOR CLENCH", "\"A Beefcake without iron is just a cake.\""],
"ruler.statue.freed": ["FORMER STATUE OF CHANCELLOR CLENCH", "(Toppled by public demand. Please do not stand on it. Gary did, once.)"],
"ui.main.title": ["The House of Gains"],
"ui.main.body": ["The regime's stronghold. Far below it, in the Iron-less Prison, the true leader has been held for ten years. HP carries in from the zone; only the shrines heal. Beat Chancellor Clench to free the Gainlands."],
"ui.main.body_cleared": ["The House of Gains is quiet, and the doors are open. You can still run the halls for gold and XP. HP carries in from the zone; nothing heals except at the shrines."],
"ui.main.button": ["Enter the House of Gains"],
"prop.leg_day_gate": ["THE HOUSE OF GAINS"],
"dungeon.hg_gates.title": ["The Gates of Gains"],
"dungeon.hg_gates.blurb": ["Iron-less steel, floodlights, and a banner reading MANDATORY CARDIO. Nobody has ever left through here."],
"dungeon.hg_gates.before": ["The gates swing open on a hall lined with posters of Chancellor Clench. There are no weights anywhere. Not a dumbbell.", "Not a kettlebell. Not a single decorative plate.", "Somewhere beneath your feet, something is not quite silent. It is breathing. Slowly. On purpose."],
"dungeon.hg_checkpoint.title": ["The Regime Checkpoint"],
"dungeon.hg_checkpoint.blurb": ["An enforcer searches your bag for weights while a clerk clicks a stopwatch. Minister Quota wants every search done in thirty seconds. He is at forty."],
"dungeon.hg_descent.title": ["The Descent"],
"dungeon.hg_descent.blurb": ["A long stone stairway leads down into the Iron-less Prison."],
"dungeon.hg_cells.title": ["The Cell Block"],
"dungeon.hg_cells.blurb": ["The prisoners are very quiet. The guards are very loud. Only one of these is a problem."],
"dungeon.hg_calisthenics.title": ["The Calisthenics Check"],
"dungeon.hg_calisthenics.blurb": ["The prison has no iron, so it tests bodies. A guard demands to see your form."],
"dungeon.hg_warden.title": ["The Iron-less Warden"],
"dungeon.hg_warden.blurb": ["The warden has never once lifted a weight. He has never needed to. He is very, very angry. (Elite)"],
"dungeon.hg_warden.after": ["The warden drops his keyring. At the end of the corridor, behind a door with no handle, someone is doing a very slow, very controlled push-up."],
"dungeon.hg_rescue.title": ["The Last Cell"],
"dungeon.hg_rescue.blurb": ["At the bottom of the prison: one cell, one prisoner, one very long breath."],
"dungeon.hg_stretch.title": ["The Cell Stretch"],
"dungeon.hg_stretch.blurb": ["Grandmaster Flex leads a quiet round of stretching and breathing. Restore HP."],
"dungeon.hg_stretch.after": ["\"Breathe in. Hold. Breathe out,\" says Grandmaster Flex.", "\"You carry the whole kingdom in your lungs, son. Try not to drop it.\""],
"dungeon.hg_barracks.title": ["The Barracks Gauntlet"],
"dungeon.hg_barracks.blurb": ["You hear the recruits drilling before you see them. They make up in volume what they lack in coordination."],
"dungeon.hg_locker.title": ["The Confiscated Gear Locker"],
"dungeon.hg_locker.blurb": ["Every weight the regime ever took. Behind a locker door, and behind a very sad sign."],
"dungeon.hg_guard.title": ["The Honor Guard"],
"dungeon.hg_guard.blurb": ["You face Chancellor Clench's personal guard. Their uniforms are pressed; their technique could use ironing out. (Elite)"],
"dungeon.hg_trophy.title": ["The Trophy Hall"],
"dungeon.hg_trophy.blurb": ["Trophies of every leader the regime ever overthrew. There is an empty one for Grandmaster Flex."],
"dungeon.hg_boss.title": ["Chancellor Clench's Gym"],
"dungeon.hg_boss.blurb": ["The regime's throne room is a gym with a single throne-shaped bench press. It is the only barbell in the House."],
"dungeon.hg_boss.before": ["Chancellor Clench stands before an enormous bench press, the only weight left in the whole House of Gains. It is his.", "\"Master.\" The word sticks in his throat. \"I was your best, you know. Your star pupil.\"", "\"You said I would go further than you ever did. Then you said strength lived in the heart and the head. I knew better.\"", "\"I took your iron, your protein, your followers. You have come back with nothing, Master.\"", "\"Look how far I went, Master. What do you think you can do?\""],
"dungeon.hg_boss.after": ["Chancellor Clench falls, bench and all. The regime's banners come down one by one, and in the great hall the Beefcakes begin to cheer, quietly, then very loudly.", "Flex does not gloat. He kneels beside his fallen pupil and offers a hand. \"You hated yourself for needing the iron, my boy.", "I never hated you for it. Come back to the gym. We start from zero. Everyone does.\"", "Clench has lost his title, his medals and the thing he thought strength was. He stares at the hand a long time. He does not take it yet, but he does not pull away.", "Then Flex turns to you, and his voice is gentle. \"Whatever they took from you, son, it was not the part that matters.\""],
"challenge.hg_calisthenics.title": ["The Calisthenics Check"],
"challenge.hg_calisthenics.text": ["No iron in the prison, so the guards test what you can do with your own body. Your first unit must be strong enough to count."],
"event.hg_descent.title": ["The Descent"],
"event.hg_descent.body": ["The stairway to the Iron-less Prison is steep, dark, and damp. A guard is dozing on the third landing, with a ring of keys on his belt and a bag of confiscated protein bars at his feet."],
"event.hg_descent.choice.0": ["Sneak past the guard"],
"event.hg_descent.choice.1": ["Take the bars and the keys (and a bruise)"],
"event.hg_descent.choice.2": ["Do some calming stretches on the stair"],
"event.hg_descent.result.0": ["You step lightly. The guard snores on. A heavy door closes behind you, and the cold, iron-less air of the prison settles over you."],
"event.hg_descent.result.1": ["The guard wakes long enough to swing. You leave with the bars, the keys and a very hands-on reprimand."],
"event.hg_descent.result.2": ["Quad stretch, hamstring stretch, shoulder roll. The guard sleeps on. You feel better for it.", "Somebody in the dark chuckles approvingly."],
"event.hg_rescue.title": ["The Rescue"],
"event.hg_rescue.body": ["In the last cell, a gaunt old man sits cross-legged in the dark, perfectly still. Ten years of breath and calisthenics have worn him down to wire and will.", "He opens one eye and looks at you. \"You are not a guard.\"", "You see no bar or bench, only stone worn smooth by ten years of training. Your chest tightens at the sight of the cell; you do not know why."],
"event.hg_rescue.choice.0": ["Pick the lock and free him"],
"event.hg_rescue.result.0": ["The lock gives. Grandmaster Flex rises, slowly, unsteadily, and bows. He is so thin you could count his ribs.", "He moves with a stillness that is somehow the opposite of weakness. From now on, he fights beside you."],
"event.hg_trophy_hall.title": ["The Trophy Hall"],
"event.hg_trophy_hall.body": ["Trophies of every defeated Beefcake line the walls: belts, medals, the left shoe of a champion.","You read the plate on the empty pedestal: GRANDMASTER FLEX (PENDING). The space above it remains empty."],
"event.hg_trophy_hall.choice.0": ["Take the medals (they are very shiny)"],
"event.hg_trophy_hall.choice.1": ["Polish the empty pedestal"],
"event.hg_trophy_hall.choice.2": ["Leave everything as it is"],
"event.hg_trophy_hall.result.0": ["Medals jingle. Grandmaster Flex winces. \"They are not ours to take.", "Still. The regime owes this house a debt, and gold settles debts.\" You feel a little guilty, and a little richer."],
"event.hg_trophy_hall.result.1": ["You polish it until it gleams. Grandmaster Flex watches, and something old and heavy lifts off him. You feel stronger."],
"event.hg_trophy_hall.result.2": ["Some things are not for taking. Grandmaster Flex nods once, slowly, in approval."],
"cutscene.rescue.1.speaker": ["Grandmaster Flex"],
"cutscene.rescue.1": ["Careful, son. The guards time their rounds by their squats.", "The rounds are irregular. Listen for them on the stairs."],
"cutscene.rescue.2.speaker": ["You"],
"cutscene.rescue.2": ["You're Grandmaster Flex? You're... smaller than the posters."],
"cutscene.rescue.3.speaker": ["Grandmaster Flex"],
"cutscene.rescue.3": ["Ten years in the dark does that. They took the plates, the protein, the pump. I had nothing.", "So I had everything. My breath. My body. My mind.", "Come, son. We will climb out together. And I would like a word with Clench. He was the best student I ever had."],
"cutscene.flex.1.speaker": ["Chancellor Clench"],
"cutscene.flex.1": ["You bring that... that stick of a man into my house? Look at him, Master. Ten years on bread and water.", "A Beefcake without iron is just a CAKE!"],
"cutscene.flex.2.speaker": ["Grandmaster Flex"],
"cutscene.flex.2": ["Hold my coat."],
"cutscene.flex.3.speaker": ["Grandmaster Flex"],
"cutscene.flex.3": ["They took my weights, Clench. They forgot to take me.", "You only ever took the weight. I taught you the heart, and you stopped listening before I got to the mind."],
"cutscene.flex.4.speaker": ["Chancellor Clench"],
"cutscene.flex.4": ["...What. How. Where were you HIDING all of that?"],
"cutscene.flex.5.speaker": ["Grandmaster Flex"],
"cutscene.flex.5": ["True strength is not the ability to lift heavy things. It comes from the heart, and from the mind.", "The heavy things were only ever practice. Now, my boy. Shall we?"],
"dungeon.hg_boss.before_alone": ["Chancellor Clench stands before an enormous bench press, the only weight left in the whole House of Gains. It is his.", "\"A stranger in my house, and no old man at your side. They say Flex is still down in the dark, doing push-ups for nobody.\"", "\"They say he trained a hundred pupils and I was the best of them. Look where that got me. Look where it got him.\"", "\"Come, then. Let me show you what iron is for.\""],
"dungeon.hg_boss.after_alone": ["Chancellor Clench falls, bench and all. The regime's banners come down one by one, and in the great hall the Beefcakes begin to cheer, quietly, then very loudly.", "You hear slow, controlled footsteps on the stairs. Grandmaster Flex emerges from the Iron-less Prison alone, in thin grey robes.", "\"I was going to leave eventually,\" he says. \"Lovely day for it.\" Then he looks at his fallen pupil, and his face softens.", "\"Get up, my boy. We start from zero. Everyone does.\"", "He glances at you. \"Whatever they took from you, son, it was not the part that matters.\""],
}
