[gd_resource type="Resource" script_class="ZoneStoryText" format=3]

[ext_resource type="Script" path="res://core/data/zone_story_text.gd" id="1_gain"]

[resource]
script = ExtResource("1_gain")
zone_id = "beefcake"
lines = {
"hud.objective": ["The Gainlands: the Swole Station is safe, mostly because the regime keeps forgetting it exists. Life does not come back after battles - soak in the Cooldown Hot Tub, or walk back down the Beefcake Path. The House of Gains, where the regime sits, is on Leg Day Ridge."],
"ui.mini.body": ["Three sets in a row. Your life carries from one set to the next and nothing heals in between. Finish all three for a unique Beefcake card."],
"ui.mini.body_cleared": ["You already took the unique card from here. You can still lift for gold and XP. Life carries over; nothing heals in between."],
"ui.mini.button": ["Chalk up"],
"ui.exit.title": ["Walk back down the Beefcake Path?"],
"ui.exit.body": ["Leaving the Gainlands ends this visit. Town heals you fully; the regime's roaming brutes, golems and sprites will be back next time."],
"fx.main_dungeon": ["The House of Gains looms over you, all iron-less steel and floodlights. The regime's flag snaps in the wind: a barbell with a red line through it."],
"fx.heal_couch": ["You sink into the Cooldown Hot Tub. It smells of eucalyptus and old gym socks. Life restored."],
"fx.heal_already": ["You are already as recovered as a Beefcake gets. Go lift something."],
"fx.hit": ["ZAP! A regime sprite hits you right in the quads. (-2 life)"],
"fx.wake": ["You wake up in the hot tub at the Swole Station. Coach Brenda is holding a clipboard and a tiny towel.", "\"Passed out mid-rep. Happens to the best of us. The tab is on you. Don't tell the regime. Quiet is the new loud.\""],
"fx.chest": ["A hidden stash! Nobody spotted that one."],
"fx.thrown": ["COURTESY CHUCK!"],
"fx.landed": ["Nailed the landing. Mostly, the ground nailed you."],
"fx.portal": ["RRRRRIIIIIP! A portal, torn open by hand."],
"fx.fall": ["You fell off the island! You respawn at your last safe spot. (-1 life)"],
"fx.fall_log": ["Fell off %s - respawned at the last safe spot, 1 damage to zone life."],
"fx.locked": ["Not yet."],
"travel.throw.ask": ["Courtesy Chuck: free, fast, and only mildly terrifying. Ready to be thrown to %s?"],
"travel.portal.ask": ["Portal service: torn open by hand, no refunds. Step through to %s?"],
"travel.dest.arrive_pec": ["Pec Perch"],
"travel.dest.arrive_delt": ["Delt Deck"],
"travel.dest.land_west": ["the far west meadow"],
"travel.dest.land_east": ["the far east meadow"],
"travel.dest.land_pec": ["the Meadow Road"],
"travel.dest.arrive_calf": ["Calf Cove"],
"travel.dest.land_delt": ["the Ridge Road"],
"travel.dest.arrive_glute": ["Glute Garden"],
"travel.dest.land_glute": ["the east wheel yard"],
"travel.dest.land_calf": ["the west meadow"],
"travel.thrower_pec.intro": ["Brock cracks every knuckle he owns. \"Pec Perch? Great view. Terrible landing. Hold still, this only hurts the first time.\""],
"travel.thrower_pec.locked": ["Brock is out of stock on locks. This one is always open."],
"travel.ripper_delt.intro": ["Rita flexes both hands like she is about to open a jar. \"Delt Deck is a wild ride. I rip the portal, you walk in. No tools, no spells. Just lats.\""],
"travel.ripper_delt.locked": ["Rita shakes her head. \"No juice, no rip. The ripping needs power and the grid is dry. Somebody run that big hamster wheel up the hill, then come back.\""],
"travel.thrower_east.intro": ["Tobias hefts you like a sack of oats. \"Cross-country, west meadow. It's a long way. I'll give it everything. Not you, I'll give it to the wind.\""],
"travel.thrower_east.locked": ["Tobias squints at you. \"Cross-country is for Gainers only. Show me a Gym Rat card and I'll chuck you clear across the map. Tiny Tony sells them.\""],
"travel.thrower_west.intro": ["Wanda is already warming up. \"East meadow? Easy. Say 'courtesy' for me. Louder. COURTESY!\""],
"travel.thrower_west.locked": ["Wanda is always ready."],
"travel.thrower_pec_back.intro": ["Bonnie waves a foam finger. \"Heading down? Right. Bend your knees on the way. I mean all your knees.\""],
"travel.thrower_pec_back.locked": ["Bonnie is always ready."],
"travel.ripper_calf.intro": ["Rhonda rolls her shoulders. \"Calf Cove. Nobody's been in months. Brenda's orders. I'll tear it open. Mind the edges, they're sharp. Like my sense of humor.\""],
"travel.ripper_calf.locked": ["Rhonda crosses her arms. \"Calf Cove's closed to anybody who hasn't earned Coach Brenda's trust. Finish her 'Spot Me!' quest and I'll rip it open for you.\""],
"travel.ripper_delt_back.intro": ["Ripley is already shaking out her hands. \"Back down to the Ridge? Sure. Portals are like abs: they only open if you try.\""],
"travel.ripper_delt_back.locked": ["Ripley is always ready."],
"travel.thrower_glute.intro": ["Dmitri cracks his neck. \"Glute Garden is a long throw. Very long. I will need you to be aerodynamic. Try not to think about it.\""],
"travel.thrower_glute.locked": ["Dmitri shakes his head slowly. \"Long-haul throws are only for Beefcakes who have proven they can handle the wilds. Beat two roaming enemies, then come see me.\""],
"travel.thrower_glute_back.intro": ["Greta checks her watch. \"Down to the east wheel yard? Say 'ready' on three. One. Two. Actually, I'm already throwing.\""],
"travel.thrower_glute_back.locked": ["Greta is always ready."],
"travel.ripper_calf_back.intro": ["Raelynn tears a seam in the air with a grunt. \"Home? Home is always an option. Mind the gap, it bites.\""],
"travel.ripper_calf_back.locked": ["Raelynn is always ready."],
"sign.hub_main": ["THE SWOLE STATION", "Hub of the Gainlands. Heal here. Brag here. Do NOT skip leg day here.", "(Regime notice: all gatherings must be pre-approved cardio.)"],
"sign.hub_power": ["POWERED BY BEEFCAKES", "Every light in the Gainlands runs on giant mills and colossal hamster wheels.", "100% muscle. 0% coal. 110% quota, by order of the regime."],
"sign.exit": ["THE BEEFCAKE PATH", "(Town. Stairs sold separately. Cardio checkpoint ahead.)"],
"sign.heal_tub": ["COOLDOWN HOT TUB", "Soak. Stretch. Do not drink the water. (Gus drank the water.)"],
"sign.protein_stand": ["PROTEIN SHAKE STAND", "10 gold. Flavor: surprise.", "Results may vary. Results may also vary your stomach."],
"sign.flex_mirror": ["FLEX MIRROR", "Check your form. Check your friend's form. Check the mirror's form."],
"sign.vendor": ["TINY TONY'S PROTEIN & PASTEBOARD", "Protein, powder and cards. Mostly cards. The protein is optional."],
"sign.mills": ["MILL MEADOW", "These giant mills grind everything: grain, tension, deadlines.", "Pushed by hand, by Beefcakes, since forever."],
"sign.quiz": ["THE LECTURE LOG", "Professor Quad teaches: 4 questions on Beefcake knowledge. Bring your own notes. Notes are on the signs."],
"sign.studio": ["STUDIO 3 AM", "Now taping: 'Pump It Up Past Midnight!'", "Wear your legwarmers. We know you own legwarmers."],
"sign.puzzle": ["POWER GRID CONTROL PANEL", "Six hamster wheels, three machines. Each wheel feeds two machines (or naps).", "Only five wheels may run at once. They get tired."],
"sign.wheel": ["COLOSSAL HAMSTER WHEEL", "Run it to power the grid. No actual hamsters. Hamsters are on break."],
"sign.gym": ["THE BOULDER GYM", "Equipment: boulders, logs, more boulders.", "Please re-rack your boulders."],
"sign.spot_me": ["SPOTTER WANTED", "Gary is under there. Gary has been under there since lunch."],
"sign.thrower_rule": ["COURTESY CHUCKS", "FREE.", "Spotter mandatory. Landing not guaranteed. Dignity sold separately."],
"sign.ripper_rule": ["PORTALS: TORN, NOT CAST", "Bare hands only. No spells, no tools.", "Warranty void if stretched."],
"sign.thrower_east": ["CROSS-COUNTRY CHUCKS", "East to west. A courtesy chuck, the long way. Gym Rat card required for the long way."],
"sign.thrower_west": ["CROSS-COUNTRY CHUCKS", "West to east. A courtesy chuck, the long way. Free. Aim is a rumor."],
"sign.mini_dungeon": ["THE IRON CAVERN", "Three sets. Mandatory. Bring chalk.", "(Chalk sold at Tiny Tony's. Chalk is a lie.)"],
"sign.main_dungeon": ["THE HOUSE OF GAINS", "The regime's stronghold. Authorized personnel only.", "Leg Day is mandatory. It never ends."],
"sign.leg_day_note": ["NOTE FROM THE REGIME", "The House of Gains is closed to the public. Visitors will be given a pamphlet, a towel and a very long set of squats.", "Weights are not available. Leg Day, however, is."],
"sign.energy_poster": ["GOT ENERGY? (THE REGIME DOES.)", "Ask a Beefcake. They have loads. The regime takes most of it."],
"sign.beefcake_poster": ["BEEFCAKES: BUILT DIFFERENT", "Energy, by wheel and mill.", "Transportation, by throw and portal.", "Currently operating under new management. Nobody asked."],
"sign.pec_perch": ["PEC PERCH", "Population: one mirror. Please mind the edge."],
"sign.delt_deck": ["DELT DECK", "Mind the edge. Delts are not wings."],
"sign.glute_garden": ["GLUTE GARDEN", "Bend at the knees. Always bend at the knees."],
"sign.calf_cove": ["CALF COVE", "Quiet. Remote. Excellent calves."],
"sign.edge_warning": ["CAUTION: EDGE", "There is no railing. There is no spotter. There is only gravity."],
"sign.hamster_fact": ["FUN FACT", "A hamster does not know it is the engine of a civilization.", "The Beefcakes know. They bring snacks."],
"enemy.brute": ["A regime enforcer, flexing at nobody in particular. Has been since breakfast. It's in the contract."],
"enemy.golem": ["A tub of confiscated protein powder that learned to walk. Rattles. Sorry about the confiscation."],
"enemy.sprite": ["Pure mandatory pre-workout. Zero chill. Vibrates through walls."],
"npc.brenda.intro": ["Welcome to the Gainlands. Keep your voice down, the regime has ears. I'm Coach Brenda, Head Spotter of the Swole Station. If you fall, I catch you. If you quit, I do not.", "We're Beefcakes. We make the kingdom's energy, with mills and giant hamster wheels, and we move folks around: throws and portals. The kingdom ran on us. Then, ten years ago, Malvane's forces took over and put Commander Gristle in charge.", "They overthrew our leader, Grand Champion Heartlift, and locked him away in the House of Gains. They took every weight, every plate, every scoop of protein. A Beefcake without iron, they said, would crumble.", "Rule one: never lift alone. Rule two: never skip leg day. Rule three: there is no rule three, the other two are plenty."],
"npc.brenda.return": ["Back for more? Good. The only bad rep is the one you didn't spot. Beat the regime and I'll buy the first round of shakes. Illegal ones."],
"npc.gus.intro": ["Gus. Foreman of the wheels. I keep the grid humming and the hamsters, uh, the *volunteers*, happy. The regime wants a hundred and ten percent. The wheels only go to a hundred.", "The big wheel up the hill powers half the place. If it's not turning, nothing is. Wouldn't that be a shame. Wouldn't that be, you know, a quiet little act of resistance.", "Pre-workout hasn't hit me yet. They put it in the water. I'll let you know when it does. You'll hear it."],
"npc.gus.return": ["Is the grid humming? It should be humming. If it's quiet, someone's resting, and the regime will hear about it."],
"npc.tony.intro": ["I'm Tiny Tony. Yes, I know. Everything's relative. Protein, powder, pasteboard. Cards, basically. Strong ones.", "Officially I only sell Regime-Approved Merchandise. Unofficially, these are cards from the old days, and there is a loose floorboard behind the counter. Do not ask what is under it. Iron."],
"npc.tony.return": ["Shop's open. The protein is always fresh. The jokes are always a day old. The loose floorboard has not been mentioned."],
"npc.quiz.intro": ["Aha, a student! Professor Quad, Beefcake scholar, lecturer on my log. I have written seventeen books. Fifteen are about biceps. The regime burned two, so I have written them again, from memory.", "Four questions on the Beefcakes, their energy and their transport. Every answer is on a sign, a poster or a Beefcake's mouth, somewhere in the Gainlands.", "Answer well and you'll earn gold and glory. Answer poorly and you'll earn a mild, scholarly sigh."],
"npc.quiz.return": ["Back to improve your score? Splendid. That is the Beefcake way. Same weight, more reps."],
"quiz.result.0": ["Zero. Impressive, in a stubborn way. Nothing for you. The signs are patient. I am less so."],
"quiz.result.1": ["One. A muscle twitch of knowledge. Take this pat on the back. It's a small one."],
"quiz.result.2": ["Two. Half-credit! In the Gainlands, half a rep still counts. Just not for much."],
"quiz.result.3": ["Three! One shy of a clean sweep. Take your reward and flex responsibly."],
"quiz.result.4": ["FOUR! A perfect set! You may now call yourself a Certified Gainer, Class A. The reward is real. The certificate is imaginary."],
"quiz.repeat": ["Another lap! The Gainlands pay a small processing fee for repeat attendance."],
"quiz.not_passed": ["Not a pass. Walk the Gainlands, read the signs, and come back. There is no limit on attempts."],
"npc.minigame.intro": ["*cue synthesizer* Welcome, welcome, WELCOME to PUMP IT UP PAST MIDNIGHT! I'm your host, Jazzy Jules, and it is 3 A.M. somewhere, which is where I live!", "You've seen the late-night tapes! 'Feel the burn!' 'Five-minute abs!' 'But wait, there's MORE!' My assistant is a legwarmer. My producer is also a legwarmer. The regime banned the show for 'unauthorized fun'. I kept the cameras rolling anyway.", "Today's show: REP COUNTER! Eight reps, one beat. You hit the beat, I give you a shiny medallion of pure encouragement. Operators are standing by. Operators have been standing by since 1989.", "Three easy payments of gold? No! Free! It's free! Rewards for performance, and a one-time bonus on your very first set. And one, and two..."],
"npc.minigame.return": [
"Back again! My fans! Both of you! Hear that? That's the sound of Spandex, applauding.",
"Remember: the beat is your friend. The beat does not judge. The beat is judging, but quietly."
],
"reps.intro": ["Eight reps. Watch the ring: press SPACE (or click) the moment it closes on the bar. Perfect, Good, OK or Miss. The beat speeds up. Fewer misses, more stars."],
"reps.shouts": ["And ONE!", "And TWO!", "Feel the burn!", "Squeeze it!", "Don't stop now!", "Almost there!", "One more!", "FINISH IT!"],
"reps.win": ["THAT'S the way! You look incredible. The camera loves you. The camera also loves legwarmers."],
"reps.first": ["Your first set on the show! Here's your Pump Medallion: a bonus, free, no obligation. Operators are still standing by."],
"reps.lose": ["Not quite a set, champ. That's fine. Take a breath. Rehydrate. Try again - the beat is not going anywhere."],
"npc.gary.intro": ["Mmmph! Oh good, a spotter! Gary. I'm under this barbell. I've been under this barbell since lunch. Possibly since the regime took over. It's the last barbell they didn't confiscate.", "I loaded it with one more plate than my confidence. It's fine. It's FINE. Could you give it a little push?"],
"npc.gary.return": ["Spotter! You're a hero. I'm going to lift this barbell for the very first time. Just not today."],
"fx.spot_done": ["You grab the bar and heave. Gary slides out, gasping.", "\"You're a hero! Take this. I borrowed it from the gym. It's not mine. It's yours now.\""],
"fx.spot_again": ["Gary is under a different barbell. It is a lighter barbell. His confidence is also lighter."],
"fx.wheel_run": ["You jump into the Colossal Hamster Wheel and run. And run. The grid hums, the lights across the Gainlands brighten, and somewhere a portal ripper rolls up her sleeves."],
"fx.wheel_again": ["The wheel is already spinning happily. Let it coast. You deserve a snack."],
"fx.shake_good": ["A banana-berry shake. Smooth, sweet, suspiciously good for you. +life."],
"fx.shake_great": ["A legendary chocolate-peanut-butter shake! Your muscles remember a childhood summer. Big recovery!"],
"fx.shake_bad": ["Chalky. Lumpy. Tastes like drywall. You drink it anyway. -1 life."],
"fx.shake_gold": ["The cup has a coin at the bottom. The shake was just a front. +gold."],
"fx.shake_empty": ["An empty cup. Somebody drank your protein. It was the stand. It is always the stand."],
"fx.shake_broke": ["The stand wants 10 gold. You are as broke as a rested hamster."],
"fx.flex_1": ["You flex. The mirror flexes back. You both nod. +1 life."],
"fx.flex_2": ["You hit a double biceps. The mirror gasps. You gasp. +1 life."],
"fx.flex_3": ["You hit the most-muscular pose. The mirror applauds. +1 life."],
"fx.flex_limit": ["Your pump has peaked. The mirror needs a moment. Come back after your next visit."],
"fx.flex_full": ["You flex, the mirror flexes back, nothing to heal. Looking great regardless."],
"quest.gain_power.offer": ["Hey, you! Fresh legs! The Swole Station's lights are flickering and the grid is dry. The regime sends all the energy up to the House of Gains and leaves us the crumbs. Somebody needs to run the Colossal Hamster Wheel up the hill, for us.", "Also: drink something. A protein shake from Tony's stand, or the grid's low on morale. Run the wheel, drink a shake. Easy gains. Quiet gains."],
"quest.gain_power.active": ["The wheel up on the hill, and a shake from Tony's stand. Easy gains. Tell me when you're done."],
"quest.gain_power.ready": ["The lights are back on! The grid is HUMMING. You've earned this. Don't let the hamsters hear you call them 'volunteers'."],
"quest.gain_power.done": ["The grid's running smooth, and some of it is even staying here. Gus would hug you, but Gus is allergic to humility."],
"quest.gain_spot_me.offer": ["Rule one: nobody lifts alone. Gary is under a barbell again. Spot him. And check your form at a Flex Mirror, it's good for the soul, and the regime can't confiscate a reflection.", "Do it right and I'll have Rhonda rip you a portal to Calf Cove. Nobody's been there for months. The calves are unreal."],
"quest.gain_spot_me.active": ["Gary, the barbell. And a Flex Mirror, the hub's or Pec Perch's. Spot first, flex second, brag third."],
"quest.gain_spot_me.ready": ["You spotted Gary AND checked your form? Beautiful. Here's a Pre-Workout Jitters, on the house. Calf Cove is open for you now. Tell Rhonda I said hi."],
"quest.gain_spot_me.done": ["Calf Cove is yours. Mind the edge. Always mind the edge."],
"quest.gain_lanes.offer": ["Regime brutes, golems and sprites keep intercepting our shipments, for 'inspection'. Three of them need a stern talking-to, via duel.", "Beat three roaming enemies out in the Gainlands. I'll pay you in cards. Strong cards. Heavy cards. The kind the regime hasn't found yet."],
"quest.gain_lanes.active": ["Three roaming enemies, remember. The brutes flex. The golems rattle. The sprites buzz. Pick your poison."],
"quest.gain_lanes.ready": ["Three down! The deliveries are back on schedule. Here's a Leg Day for your trouble. Do not skip it."],
"quest.gain_lanes.done": ["The lanes are clear. For about an hour. Then the regime will fill them up again. But what an hour."],
"wheel.intro": [
"A control panel hums beside the wheels: six hamster wheels, three machines (the Lift, the Gate and the Mill), a switch for every wheel.",
"Each wheel is piped to TWO of the machines; its switch sends the power to one of them, or leaves it napping. Every machine needs its exact wattage. Only five wheels may run at once."
],
"wheel.solved": ["Every machine hums at exactly the right wattage. The lift hums. The gate hums. The mill hums. Somewhere, a hamster sighs in relief. A small, heavy parcel drops into the tray."],
"wheel.already": ["The grid purrs. Nothing left to route."],
"wheel.hint": ["Start from the machine with the fewest options. The Mill needs 9, and only the wheels piped to it can supply it. Work out which wheel MUST feed the Gate."],
"wheel.machines": ["The Lift", "The Gate", "The Mill"],
"wheel.wheel_names": ["Hammy", "Gerald", "Princess Nibbles", "Sir Squeaks", "Biscuit", "The Colonel"],
"hud.objective.freed": ["The Gainlands, free at last: the Swole Station is open to everyone. Life does not come back after battles - soak in the Cooldown Hot Tub, or walk back down the Beefcake Path."],
"ui.exit.body.freed": ["Leaving the Gainlands ends this visit. Town heals you fully. The brutes, golems and sprites are off-duty now, but they still enjoy a scrap."],
"sign.hub_main.freed": ["THE SWOLE STATION", "Hub of the Gainlands. Heal here. Brag here. Do NOT skip leg day here.", "(Gatherings are now welcome. Mandatory cardio has been abolished. Gary is thrilled.)"],
"sign.hub_power.freed": ["POWERED BY BEEFCAKES", "Every light in the Gainlands runs on giant mills and colossal hamster wheels.", "100% muscle. 0% coal. Quotas abolished: run at whatever pace feels good."],
"sign.energy_poster.freed": ["GOT ENERGY? (WE DO!)", "Ask a Beefcake. They have loads. And now they keep it."],
"sign.beefcake_poster.freed": ["BEEFCAKES: BUILT DIFFERENT", "Energy, by wheel and mill.", "Transportation, by throw and portal.", "Back under the old management. The old management is still jacked."],
"sign.regime_rules": ["BY ORDER OF COMMANDER GRISTLE", "1. Weights are confiscated for your safety.", "2. Protein is a privilege, not a right.", "3. Mandatory Cardio Compliance, 5 AM sharp. Lateness is punished with more cardio."],
"sign.regime_rules.freed": ["THE NEW HOUSE RULES", "1. Weights are back. Lift responsibly.", "2. Protein is a right. Also, a shake.", "3. Cardio is optional. Leg day is not."],
"sign.regime_poster": ["COMMANDER GRISTLE SAYS: \"A BEEFCAKE WITHOUT IRON IS JUST A CAKE.\"", "(Printed on iron-free paper, naturally.)"],
"sign.regime_poster.freed": ["GRAND CHAMPION HEARTLIFT SAYS: \"STRENGTH IS IN THE HEART AND THE MIND.\"", "(The rest of him is also strong. Look at him.)"],
"sign.missing_leader": ["MISSING: OUR LEADER", "Grand Champion Thaddeus \"Heartlift\" Brawn. Ten years gone, dragged off to the House of Gains.", "If found, do not lift him. He is probably tired.", "- the Spotters"],
"sign.missing_leader.freed": ["FOUND: OUR LEADER", "Grand Champion Thaddeus \"Heartlift\" Brawn is back, and he is doing yoga on the roof of the House of Gains.", "Do not spot him. He does not need it."],
"sign.exit.freed": ["THE BEEFCAKE PATH", "(Town. Stairs sold separately. The cardio checkpoint has been repurposed as a snack bar.)"],
"sign.main_dungeon.freed": ["THE HOUSE OF GAINS", "Formerly the regime's stronghold. Open to all Beefcakes.", "Leg Day is still mandatory. Some things are sacred."],
"sign.leg_day_note.freed": ["NOTE FROM THE LEADER", "The doors are open. Come in, stretch, breathe.", "Leg Day is still Leg Day."],
"npc.brenda.intro.freed": ["YOU DID IT. Heartlift is out, Gristle is gone, and I got to watch. I'm Coach Brenda. I will be spotting you for the rest of your life, whether you like it or not.", "Our zone is ours again. The mills are turning at a sensible pace. The weights are back in the gym. Look, there's Gary, lifting something. With a spotter. It's beautiful."],
"npc.brenda.return.freed": ["Free, strong and spotted. The only bad rep is the one you didn't spot. Thank you, hero."],
"npc.gus.intro.freed": ["Gus, foreman of the wheels. Ahh. Listen to that. The grid is humming at a hundred percent. A HUNDRED. Nobody asking for more. I think I'm going to cry. Into the wheel. For energy."],
"npc.gus.return.freed": ["The wheels turn when they feel like it, and somehow that's more energy than ever. Don't tell the regime. Oh wait, there isn't one."],
"npc.tony.intro.freed": ["Tiny Tony, back in business! The iron came out from under the floorboard and went straight onto a rack. Shop's open to everyone. The regime's merchandise is in the clearance bin."],
"npc.tony.return.freed": ["Everything's on the shelves where it belongs. The jokes are still a day old. Some things are sacred."],
"effect.buff.name": ["Pump It Up"],
"effect.buff.flavor": ["The whole zone is on a permanent pump. Beefcakes feel it in their quads."],
"effect.debuff.name": ["Processing Time"],
"effect.debuff.flavor": ["\"Your request is being processed.\" Necrocrats are used to forms and queues. Beefcakes just show up there-ish, on-time-ish, and the paperwork never catches up."],
"freed_npc.heartlift": ["Welcome, hero. Thaddeus \"Heartlift\" Brawn. Ten years in the dark and I do not feel a day over thirty. Do not look at my legs. Look at my heart.", "They took my plates, my protein, my pre-workout. So I stretched. I breathed. I counted my own heartbeats until they became songs. They thought they were breaking me. They were teaching me.", "True strength is not what you can lift. It is what you can carry, and for how long. Thank you for lifting me. Now: leg day?"],
"ruler.statue": ["STATUE OF COMMANDER GRISTLE", "\"A Beefcake without iron is just a cake.\""],
"ruler.statue.freed": ["FORMER STATUE OF COMMANDER GRISTLE", "(Toppled by public demand. Please do not stand on it. Gary did, once.)"],
"ui.main.title": ["The House of Gains"],
"ui.main.body": ["The House of Gains is the regime's stronghold: iron-less steel, floodlights and a very long staircase. Somewhere beneath it is the Iron-less Prison, where the true leader has been held for ten years. Your life carries in from the zone and nothing heals except at the shrines. Beat Commander Gristle to free the Gainlands."],
"ui.main.body_cleared": ["The House of Gains is quiet, and the doors are open. You can still run the halls for gold and XP. Life carries in from the zone; nothing heals except at the shrines."],
"ui.main.button": ["Enter the House of Gains"],
"prop.leg_day_gate": ["THE HOUSE OF GAINS"],
"dungeon.hg_gates.title": ["The Gates of Gains"],
"dungeon.hg_gates.blurb": ["Iron-less steel, floodlights, and a banner reading MANDATORY CARDIO. Nobody has ever left through here."],
"dungeon.hg_gates.before": ["The gates swing open on a hall lined with posters of Commander Gristle. There are no weights anywhere. Not a dumbbell. Not a kettlebell. Not a single decorative plate.", "Somewhere beneath your feet, something is not quite silent. It is breathing. Slowly. On purpose."],
"dungeon.hg_checkpoint.title": ["The Regime Checkpoint"],
"dungeon.hg_checkpoint.blurb": ["A regime enforcer checks your bag for weights. He will not find any. He will search anyway."],
"dungeon.hg_descent.title": ["The Descent"],
"dungeon.hg_descent.blurb": ["A long stone stairway leads down into the Iron-less Prison."],
"dungeon.hg_cells.title": ["The Cell Block"],
"dungeon.hg_cells.blurb": ["The prisoners are very quiet. The guards are very loud. Only one of these is a problem."],
"dungeon.hg_calisthenics.title": ["The Calisthenics Check"],
"dungeon.hg_calisthenics.blurb": ["The prison has no iron, so it tests bodies. A guard demands to see your form."],
"dungeon.hg_warden.title": ["The Iron-less Warden"],
"dungeon.hg_warden.blurb": ["The warden has never once lifted a weight. He has never needed to. He is very, very angry. (Elite)"],
"dungeon.hg_warden.after": ["The warden drops his keyring. At the end of the corridor, behind a door with no handle, someone is doing a very slow, very controlled push-up."],
"dungeon.hg_rescue.title": ["The Last Cell"],
"dungeon.hg_rescue.blurb": ["At the bottom of the prison: one cell, one prisoner, one very long breath."],
"dungeon.hg_stretch.title": ["The Cell Stretch"],
"dungeon.hg_stretch.blurb": ["Heartlift leads a quiet round of stretching and breathing. Restore life."],
"dungeon.hg_stretch.after": ["\"Breathe in. Hold. Breathe out,\" says Heartlift. \"You carry the whole kingdom in your lungs, friend. Try not to drop it.\""],
"dungeon.hg_barracks.title": ["The Barracks Gauntlet"],
"dungeon.hg_barracks.blurb": ["Regime recruits drill in the barracks. They are not good at it. They are loud about it."],
"dungeon.hg_locker.title": ["The Confiscated Gear Locker"],
"dungeon.hg_locker.blurb": ["Every weight the regime ever took. Behind a locker door, and behind a very sad sign."],
"dungeon.hg_guard.title": ["The Honor Guard"],
"dungeon.hg_guard.blurb": ["Commander Gristle's personal guard. Their uniforms are spotless. Their form is not. (Elite)"],
"dungeon.hg_trophy.title": ["The Trophy Hall"],
"dungeon.hg_trophy.blurb": ["Trophies of every leader the regime ever overthrew. There is an empty one for Heartlift."],
"dungeon.hg_boss.title": ["Commander Gristle's Gym"],
"dungeon.hg_boss.blurb": ["The regime's throne room is a gym with a single throne-shaped bench press. It is the only barbell in the House."],
"dungeon.hg_boss.before": ["Commander Gristle stands before an enormous bench press, the only weight in the whole House of Gains, and it is his.", "\"Heartlift. I took your iron, your protein, your followers. I took everything that makes a Beefcake strong, and you came back weaker than a damp towel. What do you think you can do?\""],
"dungeon.hg_boss.after": ["Commander Gristle falls, bench and all. The regime's banners come down one by one. In the great hall, Beefcakes begin to cheer, quietly at first, then very loudly.", "\"It's over,\" says Heartlift. \"Come. Let me show you what leg day looks like when nobody's watching.\""],
"challenge.hg_calisthenics.title": ["The Calisthenics Check"],
"challenge.hg_calisthenics.text": ["No iron in the prison, so the guards test what you can do with your own body. Your first creature must be strong enough to count."],
"event.hg_descent.title": ["The Descent"],
"event.hg_descent.body": ["The stairway to the Iron-less Prison is steep, dark, and damp. A guard is dozing on the third landing, with a ring of keys on his belt and a bag of confiscated protein bars at his feet."],
"event.hg_descent.choice.0": ["Sneak past the guard"],
"event.hg_descent.choice.1": ["Take the bars and the keys (and a bruise)"],
"event.hg_descent.choice.2": ["Do some calming stretches on the stair"],
"event.hg_descent.result.0": ["You step lightly. The guard snores on. A heavy door closes behind you, and the cold, iron-less air of the prison settles over you."],
"event.hg_descent.result.1": ["The guard wakes just long enough to swing. You leave with the bars, the keys, and a distinct impression of knuckles."],
"event.hg_descent.result.2": ["Quad stretch, hamstring stretch, shoulder roll. The guard sleeps on. You feel better for it. Somebody in the dark chuckles approvingly."],
"event.hg_rescue.title": ["The Rescue"],
"event.hg_rescue.body": ["In the last cell, a gaunt, hollow-cheeked old man sits cross-legged in the dark. He opens one eye. \"You are not a guard,\" he says. \"You are far too nervous.\""],
"event.hg_rescue.choice.0": ["Pick the lock and free him"],
"event.hg_rescue.result.0": ["The lock gives way. Heartlift rises, slowly, unsteadily, and bows. He is so thin that you could count his ribs. He moves with a stillness that is, somehow, the opposite of weakness. From now on he fights beside you."],
"event.hg_trophy_hall.title": ["The Trophy Hall"],
"event.hg_trophy_hall.body": ["Trophies of every defeated Beefcake line the walls: belts, medals, the left shoe of a champion. A single pedestal sits empty, with a plate reading HEARTLIFT (PENDING)."],
"event.hg_trophy_hall.choice.0": ["Take the medals (they are very shiny)"],
"event.hg_trophy_hall.choice.1": ["Polish the empty pedestal"],
"event.hg_trophy_hall.choice.2": ["Leave everything as it is"],
"event.hg_trophy_hall.result.0": ["Medals jingle. Heartlift winces. \"They are not ours to take. But the regime does owe us a debt, and gold is a debt's currency.\" You feel a little guilty, and a little richer."],
"event.hg_trophy_hall.result.1": ["You polish it until it gleams. Heartlift watches, and some old weight lifts off his heart. You feel stronger."],
"event.hg_trophy_hall.result.2": ["Some things are not for taking. Heartlift nods once, slowly, in approval."],
"cutscene.rescue.1.speaker": ["Heartlift"],
"cutscene.rescue.1": ["Careful. The guards come by at the hour. Not the hour of the day. The hour of the squat. It's irregular. Once an hour, whether or not it is an hour."],
"cutscene.rescue.2.speaker": ["You"],
"cutscene.rescue.2": ["You are Grand Champion Thaddeus \"Heartlift\" Brawn? You are... smaller than the posters."],
"cutscene.rescue.3.speaker": ["Heartlift"],
"cutscene.rescue.3": ["Ten years in the dark does that. They took the plates, the protein, the pump. I had nothing. So I had everything: my breath, my body, my mind. Stand with me, friend, and I will carry you the rest of the way."],
"cutscene.flex.1.speaker": ["Commander Gristle"],
"cutscene.flex.1": ["You dare come into my house with that ... that stick of a man? Look at him! A Beefcake without iron is a cake without sugar!"],
"cutscene.flex.2.speaker": ["Heartlift"],
"cutscene.flex.2": ["Hold my coat."],
"cutscene.flex.3.speaker": ["Heartlift"],
"cutscene.flex.3": ["You took my plates, my protein, my pump. You thought you had taken my strength. But you only took the weight. You left me my heart, and my mind."],
"cutscene.flex.4.speaker": ["Commander Gristle"],
"cutscene.flex.4": ["...What. How. Where did you hide all of THAT?"],
"cutscene.flex.5.speaker": ["Heartlift"],
"cutscene.flex.5": ["True strength is not the ability to lift heavy things. It comes from the heart, and from the mind. The heavy things were only ever the training. Now, Commander: shall we?"],
}
