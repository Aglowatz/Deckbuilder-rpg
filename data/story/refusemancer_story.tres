"correct": 0,
"q": "What is the Refusemancers' motto about waste?",
"where": "sign.hub_main; sign.oath; sign.hub_motto; sign.junk_menu"
}, {
"a": ["The crops", "Moustaches", "Opinions", "Debts"],
"correct": 0,
"q": "What do Refusemancers use their magic to help grow?",
