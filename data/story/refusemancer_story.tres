[gd_resource type="Resource" script_class="ZoneStoryText" format=3]

[ext_resource type="Script" path="res://core/data/zone_story_text.gd" id="1_heap"]

[resource]
script = ExtResource("1_heap")
zone_id = "refusemancer"
lines = {
"hud.objective": ["The Verdant Dump: the Compost Grange is safe, though the vines keep trying the door. HP does not come back after battles - sit down to a fresh harvest meal, or walk back down to town. The Rotheart festers somewhere to the north."],
"ui.mini.body": ["Three levels down, one after another. Your HP carries from one level to the next and nothing heals in between. Reach the bottom for a unique Refusemancer card."],
"ui.mini.body_cleared": ["You already took the unique card from the landfill. You can still dig for gold and XP. HP carries over; nothing heals in between."],
"ui.mini.button": ["Climb in"],
"ui.exit.title": ["Walk back down to town?"],
"ui.exit.body": ["Leaving the Verdant Dump ends this visit. Town heals you fully; the roaming golems, scarecrows and gulls (all a little too alive) will be back next time, and so will the garbage."],
"fx.main_dungeon": ["The way to the Rotheart runs through a tunnel of living roots, and the air down here is warm, wet and humming.", "Somewhere underneath you, something very large is breathing slowly, the way a sleeper does when the dream is a bad one."],
"fx.heal_couch": ["You eat roast roots and a pie with a crust like a fence post, washed down with a mug that's mostly apple, while a goat watches every bite. HP restored."],
"fx.heal_already": ["Your HP is already full, but Granny Gristle offers you a third helping anyway: one very small turnip."],
"fx.hit": ["SCREEEE! A mutant junk gull dive-bombs you and steals your dignity. (-2 HP)"],
"fx.wake": ["You wake face-down in a haybale at the Compost Grange. Granny Gristle is leaning on a pitchfork, chewing a stalk of something.", "\"Went down in the muck, dearie, so we rolled you out. Mucking-out fee is yours, mind. I call it a soil charge. Heh!", "The haybale was free, though it's started growing, so best get up before you put down roots.\""],
"fx.chest": ["You find a treasure chest among the rubbish. For once, sorting pays."],
"fx.pickup": ["Found:"],
"fx.pickup_again": ["You already took the one lying here. Come back next visit; these days the Dump restocks itself overnight, whether anyone asks it to or not."],
"fx.compost_done": ["The bin burps, steams and hands you a warm Compost Cocktail that smells faintly of promise, and you feel sturdier. (+1 max HP this visit)"],
"fx.compost_missing": ["The Compost Bin needs two piles of good junk, and you have fewer than two. It sits there, patient and faintly steaming."],
"fx.compost_limit": ["The bin has given all the cocktails it can for this visit. Come back next time, once it has had a chance to ferment."],
"fx.shrine_blessing": ["You kneel, and a seed in the shrine splits and blooms. A druid's voice, soft as moss, says: \"Grow.\"", "You feel taller. (+1 max HP this visit, and a little healing)"],
"fx.shrine_again": ["The shrine has blessed you this visit. Give the seed a chance to enjoy being a flower."],
"fx.trough_done": ["The animals fall on the junk, chew it thoughtfully, and spit out a coin. Gold!"],
"fx.trough_missing": ["The trough is empty and every animal in the pen is staring at you. Bring them a pile of good junk."],
"fx.trough_limit": ["The animals are full, and one goat is lying on its back to prove it. Come back next visit."],
"fx.crop_no_fertilizer": ["You need a sack of fertilizer to plant a crop. The soil has standards. Low, fragrant standards."],
"fx.crop_planted": ["You plant a crop and pat the soil, which wriggles a little under your hand. Come back in a while and it will be ready."],
"fx.crop_growing": ["The crop is still growing. A sprout waves at you, and you leave it to get on with things."],
"fx.crop_harvest": ["A ripe harvest! Pumpkins, melons, one suspicious turnip."],
"fx.herd_1": ["The goat looks at you, looks at the pen, looks at the sign it was eating, and trots home. Round one: you."],
"fx.herd_2": ["The pig is exactly where you expected, in the only puddle. A little shoving and it waddles home, offended."],
"fx.herd_3": ["The raccoon walks to the pen on its hind legs, tin can held like a briefcase. You appear to be its next appointment."],
"fx.herd_again": ["That one is already back in the pen, sulking. It will get over it eventually."],
"fx.bridge_done": ["The vine bridge sways and creaks cheerfully under you, held together by vines, goodwill and a great deal of compost."],
"fx.grow": ["The seed cracks. The soil heaves. Green shoots race into the air, twisting and knotting..."],
"fx.grown": ["It has grown! Already you can't quite picture the spot without it, and the druids look very pleased with themselves."],
"fx.climb_up": ["You climb the beanstalk, hand over hand. The leaves are big enough to sit on. Do not sit on them."],
"fx.climb_down": ["You slide down the beanstalk. Leaf, leaf, leaf, ground. It is faster than the chute and much less dignified."],
"fx.mounted": ["You swing up onto the saddle. Faster, and it can smash junk barricades. Press Q to dismount."],
"fx.dismounted": ["You hop off and the animal trots back to its stable, snorting."],
"fx.dismount_scree": ["You can't dismount out here; the scree would eat your boots. Find a flat spot first."],
"fx.barricade_hint": ["This barricade of junk is far too heavy to push on foot, but something fast and stubborn could charge straight through it."],
"fx.smash_gate": ["KA-RASH! Tyres fly, doors fly, and a very surprised hubcap lands in the pen. The way is open."],
"fx.smash_dam": ["KA-SPLOOSH! The dam bursts and the recycling stream flows free, along with half a mattress."],
"fx.slide": ["WHEEEEE!"],
"fx.slid": ["You land in a pile of leaves. You decide not to examine the softer bits."],
"fx.hazard_fall": ["You fall in! Someone fishes you out with a pitchfork and leaves you dripping on dry ground. (-1 HP)"],
"fx.hazard_fall_log": ["Fell into %s - fished out at the last safe spot, 1 damage to zone HP."],
"bark.worker_1": ["Mind the edge. The river's lovely to look at and a nightmare to climb out of.", "Compost doesn't sort itself. Well, lately it tries, and that's the whole problem.", "If a raccoon in a crown asks for your lunch, say no. He'll cry. Still no."],
"bark.worker_1.freed": ["River's still lovely, and still a nightmare to climb out of. Healing only goes so far.","Compost's rotting down the normal way again - slowly, with help, the way it should.","The raccoon in the crown says thank you. He'd also like your lunch. I've told him no."],
"bark.worker_2": ["Built these stairs last week, and they've grown two more steps overnight. Same climb, only longer.", "The Buffet calls us garbage eaters. Half our garbage is their souffle, barely touched.", "The beans came up purple again. I've stopped asking the beans."],
"bark.worker_2.freed": ["Same climb as ever, but the view's worth stopping for now.","Every terrace is a little greener now, and the top one most of all.","Archdruid's back on her rounds. Waters the weeds too - says they've had a hard ten years."],
"bark.worker_3": ["Those purple trees were green last spring. Nobody's talking about it.", "Stall's open! Patched awnings, patched prices. The holes are free.", "Mind the vine ladders in the wind. They hold. Mostly."],
"bark.worker_3.freed": ["Trees went back to their proper green overnight. Folk keep stopping just to look.","Stall's open! Patched awnings, honest prices, and nothing purple unless you ask for it.","Funny thing - the flowers smell like flowers again. I'd forgotten they had a smell."],
"prop.barn": ["THE GRANGE"],
"prop.swap_shed": ["GRANNY GRISTLE'S SWAP SHED"],
"prop.shrine": ["THE DRUID SHRINE"],
"prop.arch": ["THE PATH OF THE REFUSEMANCER"],
"prop.crop_plot": ["PLOT"],
"prop.fair": ["COUNTY FAIR - SORT IT OUT!"],
"prop.landfill": ["THE LANDFILL DEPTHS"],
"prop.composting": ["THE ROTHEART"],
"prop.barricade": ["KEEP OUT. JUNK."],
"grow.bridge_center.pass": ["Moss Mulligan hops up from the bank. \"You got Billie's herd home? The goat, the pig AND the raccoon? Then the stream owes you a bridge.\"", "She plants her staff in the bank, whispers to it, and the vines begin to climb."],
"grow.bridge_center.need": ["Moss Mulligan tucks her hands behind her back. \"Sorry! I only grow bridges for people who have helped the herd, and Billie Muckfoot's animals have got out again.", "Round them up for Billie, then come back to me, and I will grow you a way across. No thorns. Promise.\""],
"grow.bridge_west.plant": ["A sprout mound, freshly turned. You press a Magic Bean into the soil and step back."],
"grow.bridge_west.need": ["A sprout mound with a sign: PLANT A MAGIC BEAN HERE. You don't have one, but beans lie around the Dump, one per field each visit."],
"grow.bridge_east.plant": ["Another sprout mound. You press a Magic Bean into the soil and step back."],
"grow.bridge_east.need": ["A sprout mound with a sign: PLANT A MAGIC BEAN HERE. You do not have a bean."],
"grow.ladder_a.plant": ["A sprout mound at the foot of Mount Scrapmore. You plant a Magic Bean. Something deep in the junk begins to rumble."],
"grow.ladder_a.need": ["A sprout mound at the foot of the junk mountain. It wants a Magic Bean, and you are fresh out."],
"grow.ladder_b.plant": ["A sprout mound at the foot of Rust Peak. You plant a Magic Bean and wait, and somewhere above you a hubcap starts to spin."],
"grow.ladder_b.need": ["A sprout mound at the foot of Rust Peak. It wants a Magic Bean. Beans are the currency of the Dump."],
"sign.hub_main": ["THE COMPOST GRANGE", "Hub of the Verdant Dump. The Refusemancers handle waste removal and agriculture.", "Nothing goes to waste. Everything, lately, goes to the Rot. Please keep the doors shut."],
"sign.hub_motto": ["TODAY'S COMPOST", "- Waste removal (by goat)", "- Agriculture (by magic)", "- Nothing goes to waste. Not even the menu.", "- Do not water anything. It is already awake."],
"sign.exit": ["THE FOREST PATH","To {town}, past Moss Mulligan's thorn wall. Sort your boots. Check for vines; they will claim to be laces."],
"sign.heal_table": ["THE HARVEST MEAL", "Sit. Eat. Do not ask where the carrots were last Tuesday."],
"sign.swap_shed": ["GRANNY GRISTLE'S SWAP SHED", "One person's trash is another person's starting hand. Please shuffle outdoors."],
"sign.compost_bin": ["THE COMPOST BIN", "Two piles of good junk make one Compost Cocktail.", "Do not drink the compost. Do drink the Cocktail."],
"sign.shrine": ["THE DRUID SHRINE", "Kneel. Be blessed. Do not step on the seedlings. They are listening."],
"sign.trough": ["FEEDING TROUGH", "Please do not feed the goats (they will eat the sign).", "A pile of good junk, however, is welcome."],
"sign.stable_1": ["BORIS THE GIANT BOAR", "Fast, loyal and entirely unbothered by fences. They bother him once, briefly.", "Ride him. Dismount with Q."],
"sign.oath": ["THE REFUSEMANCER'S OATH", "We are the Refusemancers, druids of the kingdom.", "We summon animals to eat its garbage and turn it into fertilizer.", "We use our magic to help the crops grow. Nothing goes to waste."],
"sign.fields": ["THE PATCHWORK FIELDS", "Every patch grows something different. Every patch is fertilized by the same goat."],
"sign.crops": ["PLANT A CROP", "A sack of fertilizer and a little time make a harvest, ready before you leave. It grows faster if nobody stares at it."],
"sign.grove": ["THE APPLIANCE GROVE", "A druid circle of old fridges and washing machines. The spirits of dishwashers are strong here.", "Druid Thistlewick keeps the Dump's questions."],
"sign.fair": ["THE COUNTY FAIR GROUNDS", "Blue ribbons for the best pumpkin, the best pie and the best pile.", "Judge: Recycle Rhonda. Do not argue with the judge."],
"sign.fair_stage": ["SORT IT OUT! - TODAY ONLY", "Compost, metal, glass or paper. Twenty pieces, one conveyor.", "The belt does not slow down for anyone. It has been asked."],
"sign.scrapmore": ["MOUNT SCRAPMORE", "A junk mountain, overgrown with moss and ambition.", "Plant a bean at the mound to climb. Slide down the chute to leave."],
"sign.beanstalk_rule": ["BEANSTALK RULES", "1. Plant bean.", "2. Wait.", "3. Climb. Do not look down, do not look up, do not look at the cow."],
"sign.stream": ["THE RECYCLING STREAM", "Everything the kingdom threw away ends up here, rinsed.", "Crossing: vine bridges only."],
"sign.stream_warning": ["WARNING: STREAM", "Do not swim, wade or ask what is in it.", "If you fall in, somebody will fish you out. It costs 1 HP."],
"sign.bridge_west": ["WEST BRIDGE", "Not grown yet? Plant a Magic Bean at the mound beside it."],
"sign.bridge_center": ["CENTRE BRIDGE", "Moss Mulligan grows this one for anyone who helps Billie Muckfoot round up the herd."],
"sign.bridge_east": ["EAST BRIDGE", "Not grown yet? Plant a Magic Bean at the mound beside it."],
"sign.bank": ["THE NORTH BANK", "Welcome to the far side. The wall of tyres ahead has three gaps. One has been plugged with junk."],
"sign.dam": ["THE JUNK DAM", "Somebody has dumped half a landfill across the feeder channel.", "Needs a charging mount. Brother Bramble will pay."],
"sign.stable_2": ["GIDEON THE GIANT GOAT", "Eats anything. Climbs anything. Rams anything.", "Do not feed him the sign."],
"sign.barricade": ["JUNK BARRICADE", "A pile of tyres, doors and one very stubborn wardrobe across the gap.", "The Landfill Depths are beyond. Bring something that charges."],
"sign.rust": ["RUST PEAK YARDS", "The finest rust in the kingdom. Small batch. Very slow finish."],
"sign.landfill": ["THE LANDFILL DEPTHS", "Three levels. Mandatory. Bring a nose peg.", "Do not dig deeper than the raccoons. They will consider it competitive."],
"sign.main_dungeon": ["THE ROTHEART", "The source of the sickness. Do not enter. Do not breathe deeply. Do not lick anything.", "The deeper you go, the more it grows."],
"sign.inspector_note": ["NOTE FROM A DRUID", "The door is warm because something behind it is thriving, very hard, and lately it seems to be thriving in our direction. Please don't open it."],
"sign.seed_shrine": ["THE SEED SHRINE", "Plant a seed in a plot and it flips that plot and its four neighbours.", "Bring every plot into bloom to wake the great beanstalk."],
"sign.scree": ["THE SCREE FIELDS", "Loose rubble, jagged tin and thistles. Impassable on foot.", "Mounts only. Boots are not covered."],
"sign.scree_rule": ["SCREE RULES", "No walking. No dismounting. No dropping your lunch.", "The scree will find it."],
"sign.junk_menu": ["TODAY'S JUNK", "Tyres, fridges, one (1) piano.", "Nothing goes to waste. Everything goes to the Dump."],
"sign.log_note": ["NOTE", "Good stuff in the hollow log. If you can read this, kindly take one step back from my retirement.", "- a raccoon"],
"enemy.golem": ["A trash golem towers over you, moss coating its fridge body and shoots sprouting from its ears. Inside, the little light is still on."],
"enemy.scarecrow": ["A scarecrow druid faces you with a cabbage growing where its heart should be. There isn't a crow in sight; the garden has bigger problems now."],
"enemy.gulls": ["Four junk gulls guard a stolen can, shrieking over its crop of mushrooms. You have interrupted a very small turf war."],
"npc.marigold.intro": ["Welcome to the Compost Grange. I'm Brother Bramble, Warden of the Stream. Would you close the door behind you, and lock it, and maybe check the window? The vines keep trying it.", "We're the Refusemancers, druids of waste removal and agriculture: our animals turn the kingdom's garbage into fertilizer for its crops. The Buffet calls us garbage eaters, and then they eat our carrots.", "Our magic runs through nature itself, and {villain} turned it against us. Our Archdruid, Compostella, went down to tend the deep roots and never came back up, and nothing has been right since.", "Now nothing rots, so nothing feeds the soil. Everything is too alive and the whole Dump is sick with growing, and on top of all that, SOMEBODY has eaten the compost AGAIN."],
"npc.marigold.return": ["Back at the Grange? Do sort your boots at the door - compost, metal, glass, paper - and check them for tendrils. We have quite enough houseplants already.", "The Archdruid planted a tree for every royal birthday, and there's a row of them past the stream. Eleven trees, and then nothing.", "I water the twelfth spot anyway. I couldn't tell you why, except that it feels as if somebody is still coming.", "Not long ago, somebody carried a sleeping young man through these woods in the dead of night. He was glowing faintly, in four colours. I've never seen anything like it.", "The raccoons saw it too. Raccoons see everything; they just won't tell you about it."],
"npc.hob.intro": ["Granny Gristle, junk-trader! Born in a haybale, raised in a barn and retired to a shed, and this is the shed. It's started growing, mind. There's a window in the back I never put in. Heh!", "Everything here's Refusemancer-issue: grown, composted and well rinsed. Found, not stolen, dearie. The raccoon found it, and I just held on to it very tightly.", "Cards grown strong and rinsed clean, with a faint smell of earth. Hear them humming? Well, I never promised you a silent auction. Heh!"],
"npc.hob.return": ["Back again, dearie! Turnips are a day old. A lovely vintage, if you're a turnip.", "The turnips are looking at me again. I like a root vegetable that minds its own business, I do. Heh!"],
"npc.wren.intro": ["Oh good, a pair of legs! I'm Billie Muckfoot, animal handler, and I speak fluent goat, which is mostly screaming. Lately the screaming's about the plants: the fields keep trying to eat my herd.", "The boar and goat in the stables will carry you. Ask nicely or ask rudely; they ignore both the same. Good, sensible animals."],
"npc.wren.return": ["Any luck with the herd? Look for the goat first; it'll be eating something it shouldn't. If the something is eating it back, shout for me."],
"quest.heap_herd.offer": ["Three of my animals got out: a goat, a pig and a raccoon with a briefcase. The Rot's in the fields and they're wandering right into it.", "Find each one out in the Dump and get it back to the pen before dark. Don't chase them. Walk up firmly and make eye contact.", "Animals respect eye contact. Raccoons consider it the start of negotiations."],
"quest.heap_herd.active": ["Three escapees, all out in the fields: the goat's eating something, the pig's found a puddle, and the raccoon is probably writing me a strongly worded letter."],
"quest.heap_herd.ready": ["All three home, and the pen's never looked so full! Here, you've earned this.", "A goat card. You can play this one without having to catch it afterwards."],
"quest.heap_herd.done": ["The herd's home and already plotting the next escape. Thank you! Moss Mulligan will grow you a crossing at the centre bridge now. Tell her I sent you."],
"quest.heap_fert.offer": ["Now then, fertilizer. The crops are sulking and the soil's gone strange, and good clean fertilizer is the one thing the Rot can't grow in.", "I need three sacks from around the Dump, lying wherever the animals left them. Don't ask me how they got bagged up, dearie. I never have. Heh!"],
"quest.heap_fert.active": ["Three sacks of fertilizer, dearie. Try the fields, the east edge and the far side of the stream. Follow your nose. Then apologise to it."],
"quest.heap_fert.ready": ["Three whole sacks! The crops'll be singing by morning, and I mean that more than I'd like to.", "Here's your reward. Found, not stolen, and only a little bit damp. Heh!"],
"quest.heap_fert.done": ["The fields are fed, dearie. Plant your own with a sack of fertilizer and a little patience. I'd sell you the patience too, but nobody ever stays long enough to buy it. Heh!"],
"quest.heap_dam.offer": ["Somebody has dumped a dam of junk across the feeder channel on the north bank, and the stream can't breathe. Borrow a mount from the stables and charge it, and my compost boots are yours."],
"quest.heap_dam.active": ["It's the junk dam on the north bank. Take Gideon the goat from the north stable and charge it at full tilt. He's never slowed down for anything, and I'd hate for him to start now."],
"quest.heap_dam.ready": ["The stream's flowing again, practically dancing! Here are the compost boots, still warm. They squelch, but it's a proud sort of squelch."],
"quest.heap_dam.done": ["The stream's clear, for now. The kingdom will have it full again by the end of the week, but that's what we're here for."],
"npc.quiz.intro": ["Ah, a visitor. I am Druid Thistlewick, Keeper of the Dump's Questions, and I have sat in this ring of old appliances for forty years.", "The dishwasher and I have an understanding, though lately it has started talking back. Forty years, and NOW it wants to clear the air.", "Four questions about the Refusemancers, their work and their oath. Every answer is written on a sign somewhere in the Verdant Dump.", "Sort your thoughts as you would your bins: compost, recycling, regret. Answer well and there is gold and seed in it for you; answer poorly and you will receive a gentle, rustling sigh."],
"npc.quiz.return": ["Back to improve your score? Good. A druid is just a student who never left the garden."],
"quiz.result.0": ["Zero. We have found room for growth, rather a lot of it, I'm afraid. No reward this time.", "The signs are patient. I am slightly less so. The dishwasher is not patient at all."],
"quiz.result.1": ["One. A single seed, but every garden starts with one. Plant it, water it, and try again."],
"quiz.result.2": ["Two. Half-grown. Keep tending those thoughts; we are not harvesting excuses."],
"quiz.result.3": ["Three! Nearly in bloom. Take your reward and a sprig of mint."],
"quiz.result.4": ["FOUR! A perfect harvest! You may now call yourself a Certified Refusemancer, First Class.", "Your reward is real. The certificate is compostable. When you tire of showing it off, let it become something humble."],
"quiz.repeat": ["Another round! The Dump pays a small fee for repeat scholarship."],
"quiz.not_passed": ["Not a pass. Walk the Verdant Dump, read the signs, and come back. There is no limit on attempts."],
"npc.minigame.intro": ["Step RIGHT up to the County Fair's own SORT IT OUT! I'm Recycle Rhonda: fair judge, pie inspector, and the finest dumpster-diver in three counties!", "I was the voice of Captain Compost Badger and his Sorting Squad at every harvest puppet show for twenty years! Nobody knew! All that fame went to a badger in a cape!", "The Rot cancelled the pumpkin contest. It can't cancel ME! Today's show: twenty pieces of junk, one conveyor, four bins. Compost, metal, glass or paper!", "Send each piece to the right bin before it falls off the end. Rewards by performance, plus a first-time bonus. Gloves on!"],
"npc.minigame.return": [
"Back for another run, champ? The conveyor's hungry, the bins are ready, and I've got pie for afterwards!",
"Remember: one person's trash is another person's blue ribbon. Sort fast. Sort true. Sort with a smile!"
],
"sort.intro": ["Twenty pieces of junk ride the conveyor. Send the front piece to the right bin (click a bin, or keys 1-4 or the arrow keys) before it reaches the end. A wrong bin or a miss breaks your streak. A long streak scores more."],
"sort.bins": ["Compost", "Metal", "Glass", "Paper"],
"sort.items": ["Banana Peel", "Tin Can", "Pickle Jar", "Newspaper", "Apple Core", "Bent Spoon", "Wine Bottle", "Cereal Box", "Eggshells", "Rusty Bolt", "Jam Jar", "Junk Mail", "Corn Cob", "Bike Bell", "Fishbowl", "Cardboard Tube", "Coffee Grounds", "Soup Can", "Perfume Bottle", "Birthday Card"],
"sort.shouts": ["First pieces, nice and easy!", "Feel the rhythm of the belt!", "Compost left, metal down, glass up, paper right!", "Faster! The belt is hungry!", "No hesitation! Give that rubbish somewhere to be!"],
"sort.win": ["BLUE RIBBON sorting! Reduce! Reuse! Refuse to quit! All three goats in the crowd are cheering. Or hungry."],
"sort.first": ["Your very first run at the fair! Here's your first-timer's bonus, no strings attached: a jar of compost salve!", "Rub it in, champ! The salve, I mean, not the victory. Nobody loves a gloater!"],
"sort.lose": ["Not quite a run, champ. That's fine. The belt isn't going anywhere.", "Unlike the jam jar. The jam jar went everywhere."],
"growth.intro": ["Twenty-five plots of garden sit in a five-by-five square, some bare and some in bloom. Plant a seed in a plot and that plot and its four neighbours flip between bare and bloom. Bring every plot into bloom to wake the great beanstalk."],
"growth.hint": ["Work from the top row down: if the plot above a bare plot is bare, plant right below it. Then fix the last row with the first row. Count your seeds; there are only four solutions."],
"growth.solved": ["Every plot blooms at once. The beanstalk rises, shakes out a seed pouch the size of a satchel, and hands it down with a leaf. It is still warm."],
"growth.already": ["The garden is in full bloom. Nothing left to plant."],
"hud.objective.freed": ["The Verdant Dump, healing: the Compost Grange is safe. HP does not come back after battles - sit down to a fresh harvest meal, or walk back down to town."],
"ui.exit.body.freed": ["Leaving the Verdant Dump ends this visit. Town heals you fully; the roaming golems, scarecrows and gulls have calmed down a lot, and so has the garbage."],
"sign.hub_main.freed": ["THE COMPOST GRANGE", "Hub of the Verdant Dump. The Refusemancers handle waste removal and agriculture.", "Nothing goes to waste. The Rot is gone, and the doors may be opened again."],
"sign.hub_motto.freed": ["TODAY'S COMPOST", "- Waste removal (by goat)", "- Agriculture (by magic)", "- Nothing goes to waste. Not even the menu.", "- Water the plants. They're only plants again, and they like it."],
"sign.rot_warning": ["WARNING: THE ROT", "Plants here are unnaturally alive. Fungi mutate. Roots invade structures, hands, and lunch.", "Do not feed anything. Do not name anything. Do not turn your back on the zucchini."],
"sign.rot_warning.freed": ["THE ROT: CURED", "The plants here are only naturally alive, mostly. The zucchini has been spoken to."],
"sign.rot_source": ["THE CORRUPTION SPREADS FROM THE NORTH", "Whatever our Archdruid has become, it is feeding the whole Dump.", "Follow the dying fields. Then follow the living ones. They are worse."],
"sign.rot_source.freed": ["THE ARCHDRUID IS BACK", "Archdruid Compostella is recovering. She asks that you not call her \"the Rotheart Archdruid\" at breakfast."],
"sign.exit.freed": ["THE FOREST PATH","To {town}. Moss Mulligan's thorn wall is mulch now, and she says sorry again. The vines are just vines, but please still sort your boots."],
"sign.main_dungeon.freed": ["THE ROTHEART", "Source of the sickness, now closed for healing. The vines are only vines (mostly), and visitors are welcome."],
"sign.inspector_note.freed": ["NOTE FROM A DRUID", "The door is warm because the compost is happy. The compost was always happy. We just forgot what that looked like."],
"npc.marigold.intro.freed": ["I never thought I'd get to say it, but the Dump is healing. The vines are only vines, the mushrooms are only mushrooms, and the Archdruid is herself again. She's terribly embarrassed.", "Go on, breathe in. You can breathe deeply down here now, and that smell is HONEST COMPOST. Isn't it wonderful?", "This morning Compostella walked straight to the row of royal trees and planted a twelfth. She didn't say why, and I didn't like to ask.", "She only smiled at you on her way past. I've been wondering about that all morning."],
"npc.marigold.return.freed": ["The stream's clean, the fields are calm and the zucchini has gone back to being a zucchini. We owe you a great deal more than compost.", "Though NOBODY has explained who ate the compost. The raccoons have suddenly become excellent listeners."],
"npc.hob.intro.freed": ["Granny Gristle, junk-trader, back in business! The shed's just a shed again, dearie, and the turnips are only turnips.", "I had a little cry, then I went and planted a whole field. Shop's open, dearie, and every bit of it was thrown out by somebody who was wrong. Heh!"],
"npc.hob.return.freed": ["Day-old turnips, dearie, and not one of them looking at anybody. Finally, produce with manners. Heh!"],
"npc.wren.intro.freed": ["Billie Muckfoot, animal handler! The whole herd's home, and the goat's already eating a sign.", "And the sign isn't eating him back this time. I've never been so happy to watch a goat ruin something."],
"npc.wren.return.freed": ["Every animal's home and not one of them mutated. I could cry, honestly, and I might.", "Into a bucket, though. The plants could use it."],
"effect.buff.name": ["Overgrowth"],
"effect.buff.flavor": ["The Dump is alive in all the wrong ways, but its own druids know how to make the best of it."],
"effect.debuff.name": ["Spoilage"],
"effect.debuff.flavor": ["Everything delicate rots fast in the Dump. Gourmand food does not keep. Gourmand golems keep even less."],
"freed_npc.compostella": ["Archdruid Compostella, child, and yes, I've been told about the barn. I don't remember doing it, but I gather the barn remembers me, so I'll be helping to put it right.", "The Rot sat in my roots for ten years and spoke so quietly. It told me I was needed, and that the whole world was waiting on me to grow.", "It was my own grief all along, dressed up as a seed. Thank you for helping me let it rot.", "The Dump will heal, though the goat may take a little longer to trust me. Plant something, child. Anything at all. It'll be glad of you.", "You're carrying a loss you can't name yet, child. When you find its name, don't shut it away in a jar the way I did. Death is not the end of them.", "Let it be the start of something in you."],
"ruler.statue": ["THE ROT-IDOL", "It looks like the Archdruid, and it's still growing. Please do not water it."],
"ruler.statue.freed": ["A VERY LARGE HARMLESS SHRUB", "This used to be the Rot-Idol. It's only topiary now, but please still do not water it."],
"ui.main.title": ["The Rotheart"],
"ui.main.body": ["At the Rotheart, the Archdruid is joined to the Dump through its corrupted roots. HP carries in from the zone; only clean soil heals you. Beat the Archdruid to free the Verdant Dump."],
"ui.main.body_cleared": ["The Rotheart is silent, and the roots are only roots. You can still wander the tunnels for gold and XP. HP carries in from the zone; nothing heals except on the clean soil."],
"ui.main.button": ["Descend into the Rotheart"],
"dungeon.rh_gate.title": ["The Withered Gate"],
"dungeon.rh_gate.blurb": ["A cracked archway wrapped in black-green vines that tighten a little as you pass beneath them."],
"dungeon.rh_gate.before": ["The vines part for you slowly, and it doesn't feel like being let in. It feels like being drawn deeper.", "Behind you, the gate closes with a soft, wet sound. Somewhere ahead, something very large breathes in, and the whole tunnel breathes with it."],
"dungeon.rh_outskirts.title": ["The Overgrown Outskirts"],
"dungeon.rh_outskirts.blurb": ["Ordinary plants at first glance, only a shade too green, and every leaf turns very slightly to follow you."],
"dungeon.rh_grove.title": ["The Mutant Grove"],
"dungeon.rh_grove.blurb": ["Mushrooms the size of garden sheds crowd the path, and a few of them tilt their caps to watch you go by."],
"dungeon.rh_mushrooms.title": ["The Whispering Mushrooms"],
"dungeon.rh_mushrooms.blurb": ["A ring of pale mushrooms murmurs as you pass. They seem to know your name, though they can't think how."],
"dungeon.rh_soil.title": ["A Patch of Clean Soil"],
"dungeon.rh_soil.blurb": ["One small patch of the ordinary, honest dirt the Refusemancers love. Restore HP."],
"dungeon.rh_soil.after": ["You sit on the clean soil and breathe. A thread of clear water runs through it, the only clean water you have seen down here.", "It smells of rain and old compost, and somewhere beneath you a worm is working through the loose soil. Your shoulders drop for the first time in hours."],
"dungeon.rh_gauntlet.title": ["The Spore Gauntlet"],
"dungeon.rh_gauntlet.blurb": ["A tunnel of drifting spores. A well-built deck walks straight through, but a loose one starts to sprout."],
"dungeon.rh_thicket.title": ["The Strangler Thicket"],
"dungeon.rh_thicket.blurb": ["A tangle of vines that remembers the shape of everything that has ever walked through it."],
"dungeon.rh_vault.title": ["The Seed Vault"],
"dungeon.rh_vault.blurb": ["The Refusemancers' seed bank, long since overrun. Some of the seeds are still good, and some of them have opinions."],
"dungeon.rh_golem.title": ["The Rootbound Golem"],
"dungeon.rh_golem.blurb": ["A golem with a ribcage of roots and a head of moss. The whole tunnel is part of its body. (Elite)"],
"dungeon.rh_golem.after": ["The golem folds back into the floor, and the tunnel ahead turns smoother and warmer, with a pulse running through it.", "You can hear it now: a vast, slow heartbeat, shaking the walls."],
"dungeon.rh_tunnels.title": ["The Root Tunnels"],
"dungeon.rh_tunnels.blurb": ["The roots have grown into the walls, the ceiling, the floor. Whatever lives here has eaten the light."],
"dungeon.rh_wall.title": ["The Pulsing Wall"],
"dungeon.rh_wall.blurb": ["The wall pulses with warm, wet light. It is not entirely a wall."],
"dungeon.rh_treant.title": ["The Heartwood Treant"],
"dungeon.rh_treant.blurb": ["The oldest tree in the Dump, grown into the Rotheart. It doesn't recognize you, or anything else, any more. (Elite)"],
"dungeon.rh_boss.title": ["The Rotheart"],
"dungeon.rh_boss.blurb": ["The corrupted core of the Verdant Dump: a vast, throbbing knot of root and rot, and, at its center, a figure that was once the Archdruid."],
"dungeon.rh_boss.before": ["At the heart of the Rotheart stands Archdruid Compostella, half woman and half tree. Roots run from her arms into the floor and out into every plant in the Dump.", "Her eyes are open, but whatever is looking out of them isn't her.", "\"I... am... THE... DUMP,\" she says in many voices at once, grieving and furious. \"I am WHAT YOU THROW AWAY... I am what GROWS BACK... and I am HUNGRY.\"", "Beneath the many voices, one small one: \"Please. The tree. I could not let her go.\""],
"dungeon.rh_boss.after": ["The Archdruid sinks to her knees. The Rotheart lets out a long, shuddering breath, and across the whole Dump a thousand vines unclench.", "Overhead the vines settle, and for a moment nothing moves beneath your feet.", "\"...What a terrible dream,\" Compostella whispers. \"The seed is still in my roots, child. It won't die, and I can't make it.\""],
"challenge.rh_spore_gauntlet.title": ["The Spore Gauntlet"],
"challenge.rh_spore_gauntlet.text": ["Five cards drift through the spores. If enough of them are infrastructure they'll hold you steady; if not, the spores will settle sweetly in your lungs."],
"event.rh_mushrooms.title": ["The Whispering Mushrooms"],
"event.rh_mushrooms.body": ["A ring of pale mushrooms murmurs as you pass. \"Stay,\" they say in a thousand tiny voices, \"and eat.\"", "\"Listen,\" they add, softer. \"Join us.\""],
"event.rh_mushrooms.choice.0": ["Taste a cap"],
"event.rh_mushrooms.choice.1": ["Listen to what they have to say"],
"event.rh_mushrooms.choice.2": ["Pick a few and sell them"],
"event.rh_mushrooms.result.0": ["It tastes like rain, soil and tiny, tiny regrets. You feel strangely rested, and your tongue is a little bit blue."],
"event.rh_mushrooms.result.1": ["They tell you where the roots run, where the Rot wears thin and where the Archdruid used to walk, and you hold on to as much as you can.", "It helps, though some of what you now know doesn't feel like your own thought."],
"event.rh_mushrooms.result.2": ["The mushrooms scream very quietly as you pick them, and you pretend not to hear. A passing trader is delighted and pays well."],
"event.rh_pulsing_wall.title": ["The Pulsing Wall"],
"event.rh_pulsing_wall.body": ["The wall ahead pulses with a slow, wet heartbeat, and warm light leaks through a seam down its middle.", "A voice inside says: \"Come. Be held.\""],
"event.rh_pulsing_wall.choice.0": ["Press your hands into the wall"],
"event.rh_pulsing_wall.choice.1": ["Wait beside it and breathe"],
"event.rh_pulsing_wall.choice.2": ["Cut a piece of it free"],
"event.rh_pulsing_wall.result.0": ["The wall takes your hands, warm and wet. It hurts for a moment, and then it doesn't.", "Fine roots creep along your arms and then let go, and oddly you feel steadier on your feet than you have in days."],
"event.rh_pulsing_wall.result.1": ["You breathe in time with the wall, and it quiets. A small bit of warmth moves from the roots into you. You feel mended, and a little ashamed."],
"event.rh_pulsing_wall.result.2": ["It bleeds sap and fury, and a glittering stone drops out of the cut. It'll fetch good gold, though it costs you a long scrape down one arm."],
"cutscene.sever.1.speaker": ["Archdruid Compostella"],
"cutscene.sever.1": ["It's the seed, {villain}'s gift - life that never dies. I grew up beneath a great tree, child, and when she fell, I couldn't bear it.", "I planted the seed where she had stood, and it took. It's been feeding on my grief for ten years. Nothing here rots, and that's my doing."],
"cutscene.sever.2.speaker": ["You"],
"cutscene.sever.2": ["Something that can never die isn't a gift. It's a grief that never gets to end. Let it rot."],
"cutscene.sever.3.speaker": ["Archdruid Compostella"],
"cutscene.sever.3": ["Everything I ever loved, I gave back to the soil when its time came. Everything except her.", "...Then we let it die, together. Hold on to me while it goes.", "I have never let go of anything so large."],
"cutscene.sever.4.speaker": ["Archdruid Compostella"],
"cutscene.sever.4": ["...It's rotting. Honest compost, the first in ten years. Oh, I can hear the soil again.", "I can hear the stream. I can hear the goat.", "And I can hear her, a little, in all of it. She did not go away. She went into everything.","To grow, I had to let her go. ...I think she has been waiting ten years for me to say so."],
"dungeon.rh_pool.before": ["Nothing here has rotted in ten years. The pool is full of leaves that stay green, fruit that never softens, and a smell like a held breath.", "Brother Bramble's notes are pinned to a root in a worried hand: 'Nothing rots, so nothing feeds the soil, and the soil is STARVING.'", "Underneath, pressed much harder: 'Everything down here is far TOO alive. And WHO has been eating the COMPOST?'"],
"dungeon.rh_roots.before": ["Every tendril in the Dump runs to this one place. At its center, wrapped in roots and humming, hangs a seed the size of a fist.", "A tag hangs from it in very tidy handwriting: PROPERTY OF THE PATH-OLOGISTS - LIFE THAT NEVER DIES.", "The tendrils feed on the seed, and the seed feeds on grief. Cut them, and the Rotheart will weaken.", "But the seed won't let go of her, and she won't let go of it."],
}
quiz_questions = Array[Dictionary]([{
