[gd_resource type="Resource" script_class="ZoneStoryText" format=3]

[ext_resource type="Script" path="res://core/data/zone_story_text.gd" id="1_heap"]

[resource]
script = ExtResource("1_heap")
zone_id = "refusemancer"
lines = {
"hud.objective": ["The Verdant Dump: the Compost Grange is safe, though the vines keep trying the door. HP does not come back after battles - sit down to a fresh harvest meal, or walk back down to town. The Rotheart festers somewhere to the north."],
"ui.mini.body": ["Three levels down, one after another. Your HP carries from one level to the next and nothing heals in between. Reach the bottom for a unique Refusemancer card."],
"ui.mini.body_cleared": ["You already took the unique card from the landfill. You can still dig for gold and XP. HP carries over; nothing heals in between."],
"ui.mini.button": ["Climb in"],
"ui.exit.title": ["Walk back down to town?"],
"ui.exit.body": ["Leaving the Verdant Dump ends this visit. Town heals you fully; the roaming golems, scarecrows and gulls (all a little too alive) will be back next time, and so will the garbage."],
"fx.main_dungeon": ["The path to the Rotheart is a tunnel of living roots. The air is warm, wet and humming. Something very large is breathing, somewhere underneath, and it is not you."],
"fx.heal_couch": ["You sit down to a fresh harvest meal: roast roots, a pie with a fence post of a crust, and a mug of something that is mostly apple. HP restored."],
"fx.heal_already": ["You are already full of HP. Granny Gristle offers you a third helping anyway. It is a very small turnip."],
"fx.hit": ["SCREEEE! A mutant junk gull dive-bombs you and steals your dignity. (-2 HP)"],
"fx.wake": ["You wake up face-down in a haybale at the Compost Grange. Granny Gristle is leaning on a pitchfork and chewing a stalk of something.", "\"Fell over in the muck, friend. We rolled you out. The mucking-out fee is on you. Don't take it personal. The haybale was free. The haybale is also, I think, growing.\""],
"fx.chest": ["A hidden stash! One person's trash was another's treasure chest."],
"fx.pickup": ["Found:"],
"fx.pickup_again": ["You already took the one lying here. Come back next visit; the Dump restocks itself overnight. It is very good at that."],
"fx.compost_done": ["The bin burps, steams and hands you a warm Compost Cocktail. It smells like a promise. You feel sturdier. (+1 max HP this visit)"],
"fx.compost_missing": ["The Compost Bin needs two piles of good junk. You do not have two piles of good junk. The bin is not judging. It is just waiting."],
"fx.compost_limit": ["The bin is full of cocktails for this visit. Come back next visit. It will have fermented."],
"fx.shrine_blessing": ["You kneel. A seed in the shrine splits and blooms. A druid voice that sounds like moss says: \"Grow.\" You feel taller. (+1 max HP this visit, and a little healing)"],
"fx.shrine_again": ["The shrine has already blessed you this visit. Blessings are not a buffet. Mostly."],
"fx.trough_done": ["The animals fall on the junk, chew it thoughtfully, and spit out a coin. Gold!"],
"fx.trough_missing": ["The trough is empty. The animals are staring at you. Bring a pile of good junk."],
"fx.trough_limit": ["The animals are full. One goat is lying on its back. Come back next visit."],
"fx.crop_no_fertilizer": ["Planting a crop needs a sack of fertilizer. The soil is a snob about it."],
"fx.crop_planted": ["You plant a crop and pat the soil. It wriggles a little. Come back in a bit and it will be ready."],
"fx.crop_growing": ["The crop is still growing. A sprout waves at you. Do not wave back. It gets ideas."],
"fx.crop_harvest": ["A ripe harvest! Pumpkins, melons, one suspicious turnip."],
"fx.herd_1": ["The goat looks at you, looks at the pen, looks at the sign it was eating, and trots home. Round one: you."],
"fx.herd_2": ["The pig is exactly where you expected, in the only puddle. A little shoving and it waddles home, offended."],
"fx.herd_3": ["The raccoon takes one look at you and walks to the pen on its hind legs, holding a tin can like a briefcase. It is already negotiating."],
"fx.herd_again": ["That one is already back in the pen. It is sulking. It will get over it."],
"fx.bridge_done": ["The vine bridge sways and creaks cheerfully. It is made of vines, ambition and a lot of compost."],
"fx.grow": ["The seed cracks. The soil heaves. Green shoots race into the air, twisting and knotting..."],
"fx.grown": ["It has grown! It looks like it was always there, which is what every druid says."],
"fx.climb_up": ["You climb the beanstalk, hand over hand. The leaves are big enough to sit on. Do not sit on them."],
"fx.climb_down": ["You slide down the beanstalk. Leaf, leaf, leaf, ground. It is faster than the chute and much less dignified."],
"fx.mounted": ["You swing up onto the saddle. Faster, and it can smash junk barricades. Press Q to dismount."],
"fx.dismounted": ["You hop off and the animal trots back to its stable, snorting."],
"fx.dismount_scree": ["You cannot dismount out here, the scree will eat your boots. Find a flat spot first."],
"fx.barricade_hint": ["A barricade of junk. Far too heavy to push on foot. Something fast and stubborn could charge through it."],
"fx.smash_gate": ["KA-RASH! Tyres fly, doors fly, and a very surprised hubcap lands in the pen. The way is open."],
"fx.smash_dam": ["KA-SPLOOSH! The dam bursts and the recycling stream flows free, along with half a mattress."],
"fx.slide": ["WHEEEEE!"],
"fx.slid": ["Landed in a pile of leaves, mostly. Some of it was leaves."],
"fx.hazard_fall": ["You fell in! Someone fishes you out with a pitchfork and sets you on dry ground. (-1 HP)"],
"fx.hazard_fall_log": ["Fell into %s - fished out at the last safe spot, 1 damage to zone HP."],
"prop.barn": ["THE GRANGE"],
"prop.swap_shed": ["HOB'S SWAP SHED"],
"prop.shrine": ["THE DRUID SHRINE"],
"prop.arch": ["THE PATH OF THE REFUSEMANCER"],
"prop.crop_plot": ["PLOT"],
"prop.fair": ["COUNTY FAIR - SORT IT OUT!"],
"prop.landfill": ["THE LANDFILL DEPTHS"],
"prop.composting": ["THE ROTHEART"],
"prop.barricade": ["KEEP OUT. JUNK."],
"grow.bridge_center.pass": ["Druid Sorrel clasps her hands. \"You rounded up Wren's herd? The goats are home and the pig is happy. Then the stream owes you a bridge.\"", "She plants a staff in the bank, whispers to it, and the vines begin to climb."],
"grow.bridge_center.need": ["Druid Sorrel shakes her head gently. \"I only grow bridges for people who have helped the herd. Wren Muckfoot's animals escaped again. Round them up, then come back and I will grow you something.\""],
"grow.bridge_west.plant": ["A sprout mound, freshly turned. You press a Magic Bean into the soil and step back."],
"grow.bridge_west.need": ["A sprout mound with a sign: PLANT A MAGIC BEAN HERE. You do not have one. Beans lie around the Dump, one per visit per field."],
"grow.bridge_east.plant": ["Another sprout mound. You press a Magic Bean into the soil and step back."],
"grow.bridge_east.need": ["A sprout mound with a sign: PLANT A MAGIC BEAN HERE. You do not have a bean."],
"grow.ladder_a.plant": ["A sprout mound at the foot of Mount Scrapmore. You plant a Magic Bean. Something deep in the junk begins to rumble."],
"grow.ladder_a.need": ["A sprout mound at the foot of the junk mountain. It wants a Magic Bean, and you are fresh out."],
"grow.ladder_b.plant": ["A sprout mound at the foot of Rust Peak. You plant a Magic Bean and wait. Above, a hubcap spins."],
"grow.ladder_b.need": ["A sprout mound at the foot of Rust Peak. It wants a Magic Bean. Beans are the currency of the Dump."],
"sign.hub_main": ["THE COMPOST GRANGE", "Hub of the Verdant Dump. The Refusemancers handle waste removal and agriculture.", "Nothing goes to waste. Everything, lately, goes to the Rot. Please keep the doors shut."],
"sign.hub_motto": ["TODAY'S COMPOST", "- Waste removal (by goat)", "- Agriculture (by magic)", "- Nothing goes to waste. Not even the menu.", "- Do not water anything. It is already awake."],
"sign.exit": ["THE PATH OF THE REFUSEMANCER", "(Town. Please sort your boots. Please check your boots for vines.)"],
"sign.heal_table": ["THE HARVEST MEAL", "Sit. Eat. Do not ask where the carrots were last Tuesday."],
"sign.swap_shed": ["HOB'S SWAP SHED", "One person's trash is another person's cards. Mostly cards. Some trash."],
"sign.compost_bin": ["THE COMPOST BIN", "Two piles of good junk make one Compost Cocktail.", "Do not drink the compost. Do drink the Cocktail."],
"sign.shrine": ["THE DRUID SHRINE", "Kneel. Be blessed. Do not step on the seedlings. They are listening."],
"sign.trough": ["FEEDING TROUGH", "Please do not feed the goats (they will eat the sign).", "A pile of good junk, however, is welcome."],
"sign.stable_1": ["BORIS THE GIANT BOAR", "Fast, loyal and entirely unbothered by fences.", "Ride him. Dismount with Q."],
"sign.oath": ["THE REFUSEMANCER'S OATH", "We are the Refusemancers, druids of the kingdom.", "We summon animals to eat its garbage and turn it into fertilizer.", "We use our magic to help the crops grow. Nothing goes to waste."],
"sign.fields": ["THE PATCHWORK FIELDS", "Every patch grows something different. Every patch is fertilized by the same goat."],
"sign.crops": ["PLANT A CROP", "A sack of fertilizer plus time makes a harvest. Visit-length time. Do not stare at it."],
"sign.grove": ["THE APPLIANCE GROVE", "A druid circle of old fridges and washing machines. The spirits of dishwashers are strong here.", "Druid Thistlewick keeps the Dump's questions."],
"sign.fair": ["THE COUNTY FAIR GROUNDS", "Blue ribbons for the best pumpkin, the best pie and the best pile.", "Judge: Bev Pettigrew. Do not argue with the judge."],
"sign.fair_stage": ["SORT IT OUT! - TODAY ONLY", "Compost, metal, glass or paper. Twenty pieces, one conveyor.", "The belt does not care how you feel."],
"sign.scrapmore": ["MOUNT SCRAPMORE", "A junk mountain, overgrown with moss and ambition.", "Plant a bean at the mound to climb. Slide down the chute to leave."],
"sign.beanstalk_rule": ["BEANSTALK RULES", "1. Plant bean.", "2. Wait.", "3. Climb. Do not look down, do not look up, do not look at the cow."],
"sign.stream": ["THE RECYCLING STREAM", "Everything the kingdom threw away ends up here, rinsed.", "Crossing: vine bridges only."],
"sign.stream_warning": ["WARNING: STREAM", "Do not swim, wade or ask what is in it.", "If you fall in, somebody will fish you out. It costs 1 HP."],
"sign.bridge_west": ["WEST BRIDGE", "Not grown yet? Plant a Magic Bean at the mound beside it."],
"sign.bridge_center": ["CENTRE BRIDGE", "Druid Sorrel grows this one for anyone who helps Wren with the herd."],
"sign.bridge_east": ["EAST BRIDGE", "Not grown yet? Plant a Magic Bean at the mound beside it."],
"sign.bank": ["THE NORTH BANK", "Welcome to the far side. The wall of tyres ahead has three gaps. One has been plugged with junk."],
"sign.dam": ["THE JUNK DAM", "Somebody has dumped half a landfill across the feeder channel.", "Needs a charging mount. Brother Bramble will pay."],
"sign.stable_2": ["GIDEON THE GIANT GOAT", "Eats anything. Climbs anything. Rams anything.", "Do not feed him the sign."],
"sign.barricade": ["JUNK BARRICADE", "A pile of tyres, doors and ambition across the gap.", "The Landfill Depths are beyond. Bring something that charges."],
"sign.rust": ["RUST PEAK YARDS", "Where the best rust in the kingdom is made. Handmade. Small batch."],
"sign.landfill": ["THE LANDFILL DEPTHS", "Three levels. Mandatory. Bring a nose peg.", "Do not dig deeper than the raccoons."],
"sign.main_dungeon": ["THE ROTHEART", "The source of the sickness. Do not enter. Do not breathe deeply. Do not lick anything.", "The deeper you go, the more it grows."],
"sign.inspector_note": ["NOTE FROM A DRUID", "The door is warm because something in there is thriving. It is thriving very, very hard. It is thriving at us. Please do not open it."],
"sign.seed_shrine": ["THE SEED SHRINE", "Plant a seed in a plot and it flips that plot and its four neighbours.", "Bring every plot into bloom to wake the great beanstalk."],
"sign.scree": ["THE SCREE FIELDS", "Loose rubble, jagged tin and thistles. Impassable on foot.", "Mounts only. Boots are not covered."],
"sign.scree_rule": ["SCREE RULES", "No walking. No dismounting. No dropping your lunch.", "The scree will find it."],
"sign.junk_menu": ["TODAY'S JUNK", "Tyres, fridges, one (1) piano.", "Nothing goes to waste. Everything goes to the Dump."],
"sign.log_note": ["NOTE", "I put the good stuff in the hollow log. If you are reading this, you are standing too close to the good stuff.", "- a raccoon"],
"enemy.golem": ["A trash golem the size of a shed, wearing a coat of moss and a fridge for a body. Something is growing out of its ears. It has stopped having opinions about recycling and started having opinions about you."],
"enemy.scarecrow": ["A scarecrow druid with a wreath, a grudge, and a cabbage growing out of its chest where the heart should be. The crows left. The seeds are still angry."],
"enemy.gulls": ["Four junk gulls in a trench coat, if the trench coat were made of screaming and mutated fungus. They stole a can and they are not sharing. The can is growing mushrooms."],
"npc.marigold.intro": ["Welcome to the Compost Grange. I am Brother Bramble, Warden of the Stream. I am very serious about recycling. Once I made a man cry over a yoghurt pot. He thanked me later. Please close the door behind you. And lock it. And check the window.", "We are the Refusemancers: druids who take the kingdom's garbage and turn it into fertilizer, and use our magic to help the crops grow. Waste removal, agriculture, and plenty of both. Our magic runs through nature itself. That is exactly what {villain} used against us.", "Our Archdruid, Fernwick Loam, was the first to go. Something got into his roots through the living world itself, and now it spreads. The plants are not dying. They are too alive. Fungi mutate. Roots break into barns. The whole Dump is sick with growing.", "The animals still do the heavy lifting. Goats eat what they can. Pigs eat what the goats refuse. Raccoons eat what the pigs are ashamed of. It is a system. It used to be a beautiful one."],
"npc.marigold.return": ["Back at the Grange? Good. Sort your boots on the way in. Compost, metal, glass or paper. Check them for tendrils. We do not have a bin for shame, but we do have a bin for tendrils."],
"npc.hob.intro": ["Hob Tillbury, farmer. Born in a haybale, raised in a barn, retired to a shed. This is the shed. The shed has started growing a little. I am not worried. I am a bit worried.", "I run the Swap Shed. One person's trash is another person's cards, as the saying goes. I mean, I made that saying up. But it has stuck. Like gum. Like roots.", "Everything here is Refusemancer-issue: grown, composted and thoroughly rinsed. Strong cards, solid cards, cards with a faint smell of earth. And a faint hum. Do not ask about the hum."],
"npc.hob.return": ["Shop's open. The cards are fresh. The turnips are a day old, which makes them better. The turnips are also looking at me, which makes them worse."],
"npc.wren.intro": ["Oh good, a pair of legs! Wren Muckfoot, animal handler. I speak fluent goat. It is mostly screaming. Lately it is also mostly screaming about the plants.", "Three of my herd have wandered off into the fields again. They always do. The fields keep trying to eat them, so I need them back before dark. I put up a sign and the goat ate it. Then the sign ate the goat's lunch.", "The boar and the goat in the stables will carry you, if you ask nicely. They will carry you anyway if you ask rudely. They are not picky. They are the only things in the Dump that still are not twisted."],
"npc.wren.return": ["Any luck with the herd? Look for the goat first. It will be eating something it should not. If the thing is eating it back, shout."],
"quest.heap_herd.offer": ["Three of my animals have escaped: a goat, a pig and a raccoon with a briefcase. The Rot is getting at the fields and they are wandering right into it. I need them back in the pen before dark.", "Find each one out in the Dump and shoo it back towards the pen. Do not chase. Walk firmly. Make eye contact. Animals respect eye contact. Raccoons respect cash."],
"quest.heap_herd.active": ["Three escaped animals, remember. The goat is eating something. The pig is in a puddle. The raccoon is composing an email."],
"quest.heap_herd.ready": ["All three home! The pen has never looked so full! Here is your reward. It is a card. It is a goat. It is a goat you can play."],
"quest.heap_herd.done": ["The herd is home and it is plotting. Thank you. Druid Sorrel at the stream owes you a bridge, by the way."],
"quest.heap_fert.offer": ["Fertilizer. Sacks of it. The crops are sulking and the soil has gone strange. The good, clean fertilizer is the only thing the Rot cannot grow in. I need three sacks from around the Dump.", "They are lying where the animals dropped them. I mean, where the animals left them. In sacks. Do not ask how."],
"quest.heap_fert.active": ["Three sacks of fertilizer, remember. Look in the fields, on the east edge and on the far side of the stream."],
"quest.heap_fert.ready": ["Three whole sacks! The crops are going to sing. Not literally. Mostly. Here is your reward."],
"quest.heap_fert.done": ["The fields are fed. Plant your own crops if you like: a sack of fertilizer and a little patience."],
"quest.heap_dam.offer": ["Somebody dumped a dam of junk across the feeder channel on the north bank. The stream cannot breathe, and the Rot is growing in the stagnant water. It is dreadful.", "It needs something big and stubborn to run straight through it. The stables have exactly that. Mount up, charge the junk dam, and I will give you a pair of compost boots I have been keeping warm."],
"quest.heap_dam.active": ["The junk dam on the north bank, remember. Ride the goat from the north stable and charge it. Do not slow down. Dams can smell hesitation."],
"quest.heap_dam.ready": ["The stream is flowing! It is practically dancing! Here: compost boots, still warm. They squelch with pride."],
"quest.heap_dam.done": ["The stream is clear. For now. The kingdom will refill it by Thursday. That is why we are here."],
"npc.quiz.intro": ["Ah, a visitor! Druid Thistlewick, Keeper of the Dump. I have sat in this ring of old appliances for forty years. The dishwasher and I have an understanding. The dishwasher has recently started talking back.", "Four questions about the Refusemancers, their work and their oath. Every answer is written on a sign somewhere in the Verdant Dump.", "Answer well and earn gold, glory and a handful of seeds. Answer poorly and earn a gentle, rustling sigh."],
"npc.quiz.return": ["Back to improve your score? Good. A druid is just a student who never left the garden."],
"quiz.result.0": ["Zero. Remarkable in its way. Nothing for you. The signs are patient. I am slightly less so."],
"quiz.result.1": ["One. A single seed. Plant it, water it, and try again."],
"quiz.result.2": ["Two. Half-grown. A fine place to start. The rest will sprout."],
"quiz.result.3": ["Three! Nearly in bloom. Take your reward and a sprig of mint."],
"quiz.result.4": ["FOUR! A perfect harvest! You may now call yourself a Certified Refusemancer, First Class. The reward is real. The certificate is compostable."],
"quiz.repeat": ["Another round! The Dump pays a small fee for repeat scholarship."],
"quiz.not_passed": ["Not a pass. Walk the Verdant Dump, read the signs, and come back. There is no limit on attempts."],
"npc.minigame.intro": ["Step RIGHT up, folks, to the County Fair's own SORT IT OUT! I'm Recycle Rhonda, fair judge, pie inspector, and the finest dumpster-diver in three counties! The Rot cancelled the pumpkin contest, but it cannot cancel me!", "Back in the nineties I hosted a PSA that aired between cartoons: Captain Compost Badger and his Sorting Squad. I was the voice of the badger. They never found out. The badger had a cape.", "I have won a blue ribbon every year since the county fair began. For pumpkins, for pies and, once, for a particularly gifted pile of junk. Judges said it had range.", "And I am a treasure hunter at heart. I have pulled a working harpsichord out of a skip. It did not stay working. But it stayed beautiful.", "Today's show: SORT IT OUT! Twenty pieces of junk, one conveyor, four bins. Compost, metal, glass or paper. Send each piece to the right bin before it falls off the edge. Rewards by performance, and a first-time bonus. Ready? Gloves on!"],
"npc.minigame.return": [
"Back for another run, champ? The conveyor is hungry. The bins are patient. I have pie.",
"Remember: one person's trash is another person's blue ribbon. Sort fast. Sort true. Sort with a smile."
],
"sort.intro": ["Twenty pieces of junk ride the conveyor. Send the front piece to the right bin (click a bin, or keys 1-4 or the arrow keys) before it reaches the end. A wrong bin or a miss breaks your streak. A long streak scores more."],
"sort.bins": ["Compost", "Metal", "Glass", "Paper"],
"sort.items": ["Banana Peel", "Tin Can", "Pickle Jar", "Newspaper", "Apple Core", "Bent Spoon", "Wine Bottle", "Cereal Box", "Eggshells", "Rusty Bolt", "Jam Jar", "Junk Mail", "Corn Cob", "Bike Bell", "Fishbowl", "Cardboard Tube", "Coffee Grounds", "Soup Can", "Perfume Bottle", "Birthday Card"],
"sort.shouts": ["First pieces, nice and easy!", "Feel the rhythm of the belt!", "Compost left, metal down, glass up, paper right!", "Faster! The belt is hungry!", "Do not hesitate! Sort with confidence!"],
"sort.win": ["BLUE RIBBON sorting! You have the eye of a judge and the hands of a magpie. The crowd, which is three goats, goes wild."],
"sort.first": ["Your very first run at the fair! Here is your bonus, free, no obligation. It is a salve. The salve is made of compost. It works. Do not ask."],
"sort.lose": ["Not quite a run, champ. That is fine. The belt is not going anywhere. Unlike the jam jar. The jam jar went everywhere."],
"growth.intro": ["Twenty-five plots of garden sit in a five-by-five square, some bare and some in bloom. Plant a seed in a plot and that plot and its four neighbours flip between bare and bloom. Bring every plot into bloom to wake the great beanstalk."],
"growth.hint": ["Work from the top row down: if the plot above a bare plot is bare, plant right below it. Then fix the last row with the first row. Count your seeds; there are only four solutions."],
"growth.solved": ["Every plot blooms at once. The beanstalk rises, shakes out a seed pouch the size of a satchel, and hands it down with a leaf. It is still warm."],
"growth.already": ["The garden is in full bloom. Nothing left to plant."],
"hud.objective.freed": ["The Verdant Dump, healing: the Compost Grange is safe. HP does not come back after battles - sit down to a fresh harvest meal, or walk back down to town."],
"ui.exit.body.freed": ["Leaving the Verdant Dump ends this visit. Town heals you fully; the roaming golems, scarecrows and gulls have calmed down a lot, and so has the garbage."],
"sign.hub_main.freed": ["THE COMPOST GRANGE", "Hub of the Verdant Dump. The Refusemancers handle waste removal and agriculture.", "Nothing goes to waste. The Rot has gone. The doors may be opened again."],
"sign.hub_motto.freed": ["TODAY'S COMPOST", "- Waste removal (by goat)", "- Agriculture (by magic)", "- Nothing goes to waste. Not even the menu.", "- Water things. They like it. They are only plants."],
"sign.rot_warning": ["WARNING: THE ROT", "Plants here are unnaturally alive. Fungi mutate. Roots invade structures, hands, and lunch.", "Do not feed anything. Do not name anything. Do not turn your back on the zucchini."],
"sign.rot_warning.freed": ["THE ROT: CURED", "The plants here are only naturally alive, mostly. The zucchini has been spoken to."],
"sign.rot_source": ["THE CORRUPTION SPREADS FROM THE NORTH", "Whatever our Archdruid has become, it is feeding the whole Dump.", "Follow the dying fields. Then follow the living ones. They are worse."],
"sign.rot_source.freed": ["THE ARCHDRUID IS BACK", "Archdruid Fernwick Loam is recovering. He asks that you not call him \"the Rotheart Archdruid\" at breakfast."],
"sign.exit.freed": ["THE PATH OF THE REFUSEMANCER", "(Town. Please sort your boots. The vines have gone back to being vines.)"],
"sign.main_dungeon.freed": ["THE ROTHEART", "Source of the sickness, now closed for healing. The vines are only vines. Mostly. Visitors welcome."],
"sign.inspector_note.freed": ["NOTE FROM A DRUID", "The door is warm because the compost is happy. The compost was always happy. We just forgot what that looked like."],
"npc.marigold.intro.freed": ["I thought I would never say this: the Dump is healing. The vines are only vines, and the fungi have gone back to ordinary mushrooms. Archdruid Fernwick Loam is himself again, and he is mortified.", "Welcome to the Compost Grange, hero. Sort your boots, enjoy the air, and take a deep breath. You may now breathe deeply."],
"npc.marigold.return.freed": ["The stream is clean, the fields are calm and the zucchini has gone back to being a zucchini. Thank you. We owe you more than compost."],
"npc.hob.intro.freed": ["Hob Tillbury, farmer. The shed is just a shed again. The turnips are only turnips. I cried a little, then I planted a field. Shop's open. Welcome back to the sane side of agriculture."],
"npc.hob.return.freed": ["Shop's open. The cards are fresh. The turnips are a day old, and they are not looking at anybody."],
"npc.wren.intro.freed": ["Wren Muckfoot, animal handler! The herd is back. The goat is eating a sign. The sign is not eating back. I have never been so happy to see a goat ruin something."],
"npc.wren.return.freed": ["All animals present and entirely un-mutated. I could cry. I might. Into a bucket. For the plants."],
"effect.buff.name": ["Overgrowth"],
"effect.buff.flavor": ["The Dump is alive in all the wrong ways, but its own druids know how to make the best of it."],
"effect.debuff.name": ["Spoilage"],
"effect.debuff.flavor": ["Everything delicate rots fast in the Dump. Gourmand food does not keep. Gourmand golems keep even less."],
"freed_npc.fernwick": ["Archdruid Fernwick Loam. Please do not look at the barn. I do not remember the barn. The barn does not remember me.", "Ten years of the Rot in my roots. It spoke so quietly. It said I was needed. It said the whole world was waiting to grow. It was not wrong, only terribly, terribly hungry.", "Thank you for cutting it loose. The Dump will heal. The goat will forgive me, eventually. Plant something. Anything. It will be glad of you."],
"ruler.statue": ["THE ROT-IDOL", "It looks like the Archdruid. It is still growing. Please do not water."],
"ruler.statue.freed": ["A VERY LARGE HARMLESS SHRUB", "It used to be the Rot-Idol. Now it is topiary. Please do not water."],
"ui.main.title": ["The Rotheart"],
"ui.main.body": ["The Rotheart lies deep within the corrupted ecosystem, at the source of the infection. The deeper you go, the more warped the Dump's nature becomes. At the core waits the Archdruid, joined to the whole ecosystem through the Rotheart. Your HP carries in from the zone and nothing heals except on the clean soil. Beat the Archdruid to free the Verdant Dump."],
"ui.main.body_cleared": ["The Rotheart is silent, and the roots are only roots. You can still wander the tunnels for gold and XP. HP carries in from the zone; nothing heals except on the clean soil."],
"ui.main.button": ["Descend into the Rotheart"],
"dungeon.rh_gate.title": ["The Withered Gate"],
"dungeon.rh_gate.blurb": ["The entrance is a cracked archway wrapped in black-green vines. They tighten as you pass."],
"dungeon.rh_gate.before": ["The vines part for you, slowly. They do not seem to be letting you in. They seem to be letting you go deeper.", "Behind you, the gate closes with a soft, wet sound. Somewhere ahead, something very large breathes in, and the whole tunnel breathes with it."],
"dungeon.rh_outskirts.title": ["The Overgrown Outskirts"],
"dungeon.rh_outskirts.blurb": ["Normal-looking plants, mostly. They are a little too green. Everything is alive in a way that feels like it is watching you."],
"dungeon.rh_grove.title": ["The Mutant Grove"],
"dungeon.rh_grove.blurb": ["Mushrooms the size of sheds. Some of them are looking at you. Some of them have hats."],
"dungeon.rh_mushrooms.title": ["The Whispering Mushrooms"],
"dungeon.rh_mushrooms.blurb": ["A ring of pale mushrooms murmurs as you pass. They know your name. They are not sure why."],
"dungeon.rh_soil.title": ["A Patch of Clean Soil"],
"dungeon.rh_soil.blurb": ["One small patch of the ordinary, honest dirt the Refusemancers love. Restore HP."],
"dungeon.rh_soil.after": ["You sit on the clean soil and breathe. It smells like rain and old compost. Somewhere underneath, a worm is minding its own business, and for the first time in a while, so are you."],
"dungeon.rh_gauntlet.title": ["The Spore Gauntlet"],
"dungeon.rh_gauntlet.blurb": ["A tunnel full of drifting spores. Whether you can walk through it depends on how well your deck has been built."],
"dungeon.rh_thicket.title": ["The Strangler Thicket"],
"dungeon.rh_thicket.blurb": ["A tangle of vines that remembers the shape of everything that has ever walked through it."],
"dungeon.rh_vault.title": ["The Seed Vault"],
"dungeon.rh_vault.blurb": ["The Refusemancers' seed bank, long since overrun. Some of the seeds are still good. Some of them have opinions."],
"dungeon.rh_golem.title": ["The Rootbound Golem"],
"dungeon.rh_golem.blurb": ["A golem with a ribcage of roots and a head of moss. The whole tunnel is part of its body. (Elite)"],
"dungeon.rh_golem.after": ["The golem folds into the floor. The tunnel ahead is smoother, warmer, and has a pulse. You can hear it now: a vast, slow heartbeat, shaking the walls."],
"dungeon.rh_tunnels.title": ["The Root Tunnels"],
"dungeon.rh_tunnels.blurb": ["The roots have grown into the walls, the ceiling, the floor. Whatever lives here has eaten the light."],
"dungeon.rh_wall.title": ["The Pulsing Wall"],
"dungeon.rh_wall.blurb": ["The wall pulses with warm, wet light. It is not entirely a wall."],
"dungeon.rh_treant.title": ["The Heartwood Treant"],
"dungeon.rh_treant.blurb": ["The oldest tree in the Dump, grown into the Rotheart. It does not recognize you. It does not recognize anything. (Elite)"],
"dungeon.rh_boss.title": ["The Rotheart"],
"dungeon.rh_boss.blurb": ["The corrupted core of the Verdant Dump: a vast, throbbing knot of root and rot, and, at its center, a figure that was once the Archdruid."],
"dungeon.rh_boss.before": ["At the center of the Rotheart stands Archdruid Fernwick Loam, half man and half tree, roots running from his arms into the floor and out into every plant in the Dump. His eyes are open. They are not his.", "\"I... am... THE... DUMP,\" he says, in a voice that comes from the walls. \"I am what you throw away. I am what grows back. I am HUNGRY.\""],
"dungeon.rh_boss.after": ["The Archdruid falls to his knees, and the Rotheart gasps, a long, shuddering, release. Roots go slack across the whole Dump. A thousand vines unclench, and somewhere far above, a goat begins to eat the sign.", "\"...What a terrible dream,\" whispers Fernwick. \"What was I?\""],
"challenge.rh_spore_gauntlet.title": ["The Spore Gauntlet"],
"challenge.rh_spore_gauntlet.text": ["Five cards drift through the spores. If enough of them are infrastructure, they will hold you steady. If not, the spores will sweeten your lungs."],
"event.rh_mushrooms.title": ["The Whispering Mushrooms"],
"event.rh_mushrooms.body": ["A ring of pale mushrooms murmurs as you pass. \"Stay,\" they say, in a thousand tiny voices. \"Eat. Listen. Join.\""],
"event.rh_mushrooms.choice.0": ["Taste a cap"],
"event.rh_mushrooms.choice.1": ["Listen to what they have to say"],
"event.rh_mushrooms.choice.2": ["Pick a few and sell them"],
"event.rh_mushrooms.result.0": ["It tastes like rain, soil and tiny, tiny regrets. You feel strangely rested, and your tongue is a little bit blue."],
"event.rh_mushrooms.result.1": ["They tell you things. Where the roots run, where the Rot is thin, where the Archdruid used to walk. You hold onto what you can. It helps. It is not entirely your own thought."],
"event.rh_mushrooms.result.2": ["The mushrooms scream, very quietly. You pretend not to hear. A passing trader is delighted, and pays well."],
"event.rh_pulsing_wall.title": ["The Pulsing Wall"],
"event.rh_pulsing_wall.body": ["The wall ahead pulses with a slow, wet heartbeat. A seam runs down the middle. Behind it, warm light. A voice inside says: \"Come. Be held.\""],
"event.rh_pulsing_wall.choice.0": ["Press your hands into the wall"],
"event.rh_pulsing_wall.choice.1": ["Wait beside it and breathe"],
"event.rh_pulsing_wall.choice.2": ["Cut a piece of it free"],
"event.rh_pulsing_wall.result.0": ["The wall takes your hands, warm and wet. It hurts. Then it does not. Roots grow along your arms, and, oddly, you feel better rooted in the world."],
"event.rh_pulsing_wall.result.1": ["You breathe in time with the wall, and it quiets. A small bit of warmth moves from the roots into you. You feel mended, and a little ashamed."],
"event.rh_pulsing_wall.result.2": ["It bleeds sap and fury. A glittering stone falls out. It is worth a lot of gold, and a bit of your arm."],
"cutscene.sever.1.speaker": ["Archdruid Fernwick Loam"],
"cutscene.sever.1": ["...Stop. Please. It is in my roots. It has been in my roots for ten years. It speaks in my voice, and I cannot make it stop."],
"cutscene.sever.2.speaker": ["You"],
"cutscene.sever.2": ["Then we cut it out, together. Hold still."],
"cutscene.sever.3.speaker": ["Archdruid Fernwick Loam"],
"cutscene.sever.3": ["The Rotheart is the knot. {villain} pulled it tight. Cut the heart, and the Rot will fall silent. Be quick. I do not know how long I can keep it back."],
"cutscene.sever.4.speaker": ["Archdruid Fernwick Loam"],
"cutscene.sever.4": ["...It is quiet. For the first time in ten years it is truly quiet. I can hear the soil. I can hear the stream. I can hear the goat. Thank you. {villain}'s grip on the living world is broken."],
}
