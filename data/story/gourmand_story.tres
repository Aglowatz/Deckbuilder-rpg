[gd_resource type="Resource" script_class="ZoneStoryText" format=3]

[ext_resource type="Script" path="res://core/data/zone_story_text.gd" id="1_buf"]

[resource]
script = ExtResource("1_buf")
zone_id = "gourmand"
lines = {
"hud.objective": ["The Endless Buffet: the Grand Pantry is safe. Life does not come back after battles - sit down for a hearty meal, or walk back down the Path of the Gourmand. Everything here looks wonderful. Something under the Test Kitchen smells wrong."],
"ui.mini.body": ["Three courses in a row. Your life carries from one course to the next and nothing heals in between. Finish all three for a unique Gourmand card."],
"ui.mini.body_cleared": ["You already took the unique card from this freezer. You can still eat your way through the courses for gold and XP. Life carries over; nothing heals in between."],
"ui.mini.button": ["Open the door"],
"ui.exit.title": ["Walk back down the Path of the Gourmand?"],
"ui.exit.body": ["Leaving the Endless Buffet ends this visit. Town heals you fully; the roaming golems, sentinels and meatballs (prototype batch, unfortunately) will be back next time. The buffet, as the name suggests, is endless."],
"fx.main_dungeon": ["The Test Kitchen sits at the far end of the table: a gleaming glass-and-steel laboratory with a very large, very unfinished cannon sticking out of the roof. A banner reads INNOVATION SEASON."],
"fx.heal_couch": ["You sit down to a hearty meal: roast something, a bowl of soup the size of a bathtub, and a roll that hugs you back. Life restored."],
"fx.heal_already": ["You are already full of life. The chef politely refuses to give you seconds. The chef is lying; there are always seconds."],
"fx.hit": ["BONK! A runaway prototype meatball hits you right in the shins. (-2 life)"],
"fx.wake": ["You wake up face-down in a bowl of mashed potatoes at the Grand Pantry. Head Chef Odalys is holding a ladle and a very long receipt.", "\"You fainted into the gravy, dear. We fished you out. The dish duty fee is on you. Say nothing to the taste testers. Yes, Chef is what you say.\""],
"fx.chest": ["A hidden stash! Nobody tasted that one."],
"fx.bounce": ["BOING!"],
"fx.landed": ["Stuck the landing. In the sense that you are stuck to it a little."],
"fx.soup_fall": ["You fell in the gravy! Somebody fishes you out and sets you on dry ground. (-1 life)"],
"fx.soup_fall_log": ["Fell into the soup at %s - fished out at the last safe spot, 1 damage to zone life."],
"fx.gate_open": ["The golem steps aside. The way is open."],
"fx.pickup": ["Found:"],
"fx.pickup_again": ["You already took the one lying here. Come back on your next visit; the pantry restocks overnight."],
"fx.oven_done": ["Ding! A Hearty Pot Pie, golden and steaming, drops into your bag. The oven looks very proud of itself."],
"fx.oven_missing": ["The Grand Oven rumbles. \"A pie needs honey, basil and a ghost pepper. I am an oven, not a miracle.\""],
"fx.taste_good": ["Smooth, balanced, a touch of citrus. You nod like a professional. +life."],
"fx.taste_great": ["A transcendent sip. A tear rolls down your cheek. A critic somewhere gives it five stars. Big recovery!"],
"fx.taste_buff": ["Your palate sharpens. You can taste what the cheese had for breakfast. A little extra life for the visit."],
"fx.taste_tip": ["The judges are impressed and tip you for the privilege of watching. +gold."],
"fx.taste_spicy": ["Ghost pepper, hidden in the third spoon. Your ears ring. -1 life."],
"fx.taste_bland": ["Boiled water, a hint of ambition. The judges look at their shoes. Nothing happens."],
"fx.taste_broke": ["The station wants 8 gold. Your wallet is as empty as a diner at 4 a.m."],
"fx.fountain_1": ["You ladle some soup. Tomato with a hint of basil. Warm all the way down. +life."],
"fx.fountain_2": ["Second ladle: cream of mushroom, which is a little unfair to the mushroom. +life."],
"fx.fountain_3": ["Third ladle: minestrone, mostly noodles. You feel taller. +life."],
"fx.fountain_full": ["You ladle some soup. Delicious, but you are already stuffed to the brim."],
"fx.fountain_limit": ["The fountain's tank is dry for now. It refills on your next visit. Soup takes time."],
"fx.cookie_broke": ["The dispenser wants 5 gold. Fortune favours the people who bring change."],
"fx.cookie_crack": ["You crack the cookie open. A tiny paper slip falls out. It reads:"],
"fx.mend_done": ["Old Meatloaf is mended! He gets up, stretches, and sizzles a little."],
"prop.arch": ["THE PATH OF THE GOURMAND"],
"prop.dispenser": ["FORTUNE COOKIES"],
"prop.broken_golem": ["OUT OF ORDER"],
"prop.stage": ["DINNER IN A DASH!"],
"prop.freezer": ["THE WALK-IN FREEZER"],
"prop.kitchen": ["THE TEST KITCHEN"],
"prop.stew": ["THE MYSTERY STEW"],
"gate.ingredient.open": ["Brisket nods slowly. \"Go on in. Mind the cheese. It has opinions about being stepped on.\""],
"gate.ingredient.pass": ["Brisket sniffs the air, eyes closing in bliss. \"Saffron. Real saffron. Do you know how long it has been?\" He takes the threads with great tenderness and steps aside.", "\"Go on through. Tell the Cheddar Cliffs I said they are overdue for a good grating.\""],
"gate.ingredient.need": ["Brisket does not look at you. He looks over your head, at the horizon. \"I only open this gate for a pinch of saffron. Real saffron. It grows in the Candy Field. Ask a sous-chef.\"", "He sighs. \"Come back when your pockets are fancier.\""],
"gate.quest.open": ["Sir Loin raises his fork in salute. \"You mended Old Meatloaf, so you are a friend of the Pantry. The town is yours.\""],
"gate.quest.pass": ["Sir Loin inspects you. \"Old Meatloaf has been mended. Head Chef Odalys sends her thanks, and her orders, which are: let you in. Yes, Chef!\"", "He lowers his fork-lance. The gate swings open."],
"gate.quest.need": ["Sir Loin clanks to attention. \"HALT! Nobody enters Layer-Cake Town unless they have mended Old Meatloaf. Quest from Head Chef Odalys. Speak to her at the Grand Pantry. Yes, Chef!\""],
"gate.battle.open": ["Colonel Casserole tips his lid. \"A fair fight, well fought. The Pancake Plateau is open to you. Mind the syrup; it pools.\""],
"gate.battle.intro": ["Colonel Casserole bubbles ominously. \"Halt! This gate is guarded by a Colonel. I do not give passes. I do not take bribes. I take challengers in single combat, with cards.\"", "\"If you win, you pass. If you lose, you do the washing up. Both are honourable.\""],
"gate.battle.ask": ["Defeat Colonel Casserole in a card battle to open the way to the Pancake Plateau. Your life carries over as usual."],
"sign.hub_main": ["THE GRAND PANTRY", "Hub of the Endless Buffet. The Gourmands feed the kingdom and protect it.", "Nobody leaves hungry. (Innovation Season is now in effect. Sample participation is mandatory.)"],
"sign.hub_motto": ["TODAY'S SPECIALS", "- Feed the kingdom", "- Guard the kingdom (with golems)", "- Answer every order with \"Yes, Chef!\"", "- Innovation: please do not ask about the Special Sauce"],
"sign.exit": ["THE PATH OF THE GOURMAND", "(Town. Wipe your feet. We just mopped. Hand over your sample.)"],
"sign.heal_table": ["THE HEARTY MEAL", "Sit. Eat. Do not ask what the gravy is made of."],
"sign.vendor": ["DOLCETTA'S DESSERT & DECKERY", "Cards, cakes and a little something for the golem in your life. Mostly cards."],
"sign.oven": ["THE GRAND OVEN", "Honey, basil and one ghost pepper make one Hearty Pot Pie.", "Do not open the oven door to check. Do not."],
"sign.fountain": ["THE SOUP FOUNTAIN", "Three ladles per customer. The soup of the day is soup."],
"sign.golem_oath": ["THE GOLEM OATH", "We are the Gourmands: chefs of the kingdom.", "We feed the kingdom. We protect the kingdom.", "We cook food golems to guard it. They answer every order with \"Yes, Chef!\""],
"sign.cookie": ["FORTUNE COOKIES - 5 GOLD", "Each one holds a hint about a secret. Handle with care. The secrets are crumbly."],
"sign.old_meatloaf": ["OLD MEATLOAF", "Out of order. Needs sea salt and a black truffle. Please be gentle.", "- Head Chef Odalys"],
"sign.forest": ["THE BROCCOLI FOREST", "Please do not eat the trees.", "The trees say the same about you."],
"sign.quiz": ["THE COOKBOOK GAZEBO", "Lady Brioche asks 4 questions on the Gourmands and their kitchens. The answers are on the signs of the Endless Buffet."],
"sign.truffle_note": ["NOTE", "A black truffle was last seen near this tree.", "The tree was last seen near the truffle. They are inseparable."],
"sign.candy": ["THE CANDY FIELD", "Everything here is edible. Not everything is wise."],
"sign.studio": ["STUDIO 3: DINNER IN A DASH!", "Now taping: three tickets, one stove, zero patience.", "Live studio audience: a bowl of sprouts."],
"sign.taste_test": ["BLIND TASTE TEST - 8 GOLD", "Judges: a spoon, a larger spoon and a very patient cloche.", "Results may vary. So may your stomach."],
"sign.salt": ["THE SALT FLATS", "A pinch here. A pinch there. A pinch of sea salt for your troubles."],
"sign.butte": ["BUTTER BUTTE", "Step on the jelly pad. Mind the ceiling.", "(There is no ceiling. Mind the sky.)"],
"sign.pad_rule": ["JELLY PADS: HOW TO USE", "1. Step on.", "2. Boing.", "3. There is no step 3. There is only boing."],
"sign.river": ["THE GRAVY RIVER", "Thick, hot and entirely made of gravy.", "The only ways across: a crouton raft or the lazy susan."],
"sign.river_warning": ["WARNING: GRAVY", "Do not swim. Do not wade. Do not ask how deep it is.", "If you fall in, somebody will fish you out. It costs 1 life."],
"sign.raft_west": ["CROUTON RAFT FERRY", "Hop on when it docks. Ride. Hop off on the other side.", "Please keep arms and legs inside the croutons."],
"sign.susan": ["THE LAZY SUSAN", "The world's largest serving platter, slowly turning.", "Step on at one side. Step off at the other. Patience is a garnish."],
"sign.raft_east": ["CROUTON RAFT FERRY", "Eastbound and northbound. Please have exact change.", "(There is no change. It is gravy. Everything is gravy.)"],
"sign.bank": ["GRAVY BANK", "Welcome to the far side. The gates ahead are guarded by golems, as is the custom."],
"sign.gate_ingredient": ["THE CHEESE CLIFFS GATE", "Doorman: Brisket.", "Admission: a pinch of saffron."],
"sign.gate_quest": ["THE LAYER-CAKE TOWN GATE", "Warden: Sir Loin.", "Admission: a letter from Head Chef Odalys, proving Old Meatloaf has been mended."],
"sign.gate_battle": ["THE PANCAKE PLATEAU GATE", "Gatekeeper: Colonel Casserole.", "Admission: defeat the Colonel in a card battle."],
"sign.cheddar": ["THE CHEDDAR CLIFFS", "Sharp. Sharper. Do not lean on the walls. Do not lick the walls."],
"sign.cake_town": ["LAYER-CAKE TOWN", "Population: a lot of crumbs.", "Please do not bite the buildings."],
"sign.pancake": ["THE PANCAKE PLATEAU", "Syrup flows downhill. So do tourists."],
"sign.mini_dungeon": ["THE WALK-IN FREEZER", "Three courses. Mandatory. No leftovers.", "Please do not lock yourself in. (Somebody already has.)"],
"sign.main_dungeon": ["THE TEST KITCHEN", "Research & Development. Staff only.", "Please do not ask what the cannon is for. The cannon is for dinner."],
"sign.inspection_note": ["NOTE FROM THE INSPECTOR", "Found: a lab where there was a kitchen, a cannon where there was a stove, and a Grand Chef who is not who he says he is.", "Back at lunch. If I am not back, check the compost."],
"sign.stew": ["THE MYSTERY STEW", "Four ingredients, in the right order, tastes like victory.", "Read the recipe card. Cooking is a science. And a vibe."],
"sign.golem_rule": ["GATE RULES", "Golems stand guard. Golems ask nicely, once.", "Golems answer every order with \"Yes, Chef!\""],
"sign.cake_menu": ["TODAY'S CAKE", "Chocolate, vanilla and structural.", "Nobody leaves hungry. Nobody leaves without a slice, either."],
"sign.cheese_note": ["GROCERY LIST", "Cheese. More cheese. Something to put on the cheese. Different cheese.", "- a sous-chef, 3 weeks ago"],
"enemy.loaf": ["A meatloaf the size of a wardrobe, wearing a ketchup glaze and a frown. A prototype. Has opinions about being a prototype."],
"enemy.jelly": ["A lime gelatin sentinel with a spoon spear and a fruit cocktail soul. Prototype Mk. 2. Wobbles when it thinks, which is rarely, on instructions."],
"enemy.meatball": ["Pure momentum with a side of sauce. A failed prototype that escaped. Nobody knows what it is running from. It is probably the cannon."],
"enemy.casserole": ["A pot-bellied colonel with a lid for a hat and a ladle for a sword. Thirty years of service, forty years of cheese."],
"npc.odalys.intro": ["Welcome to the Grand Pantry! I am Head Chef Odalys. Ladle in one hand, kingdom in the other.", "We are the Gourmands, little one. We feed the kingdom and we protect it. Every plate is a promise. Every golem is a guard. ...Or they were. Ten years ago, the Usurper's people came, and shortly after, the Grand Chef changed.", "He looks the same. Sounds the same. But he does not taste a dish before he sends it out any more. He ordered the Special Sauce into every pot. And the golems answer \"Yes, Chef!\" to a chef who no longer cooks.", "Say it with me, quietly. Yes, Chef. The Endless Buffet runs on three rules: nobody leaves hungry, nobody double-dips, and everyone cleans their own plate. The fourth rule is new: nobody asks about the Test Kitchen."],
"npc.odalys.return": ["Back at my kitchen? Good. A Gourmand never stops stirring. What do we say? Yes, Chef. Quietly. The Grand Chef has very good hearing, for a man who does not eat."],
"npc.tarragon.intro": ["Oh! A customer! A helper! A pair of hands! Sous-Chef Tarragon, the Head Chef's fetcher of things. I fetch. All day. It is a lot of fetching.", "We are always out of something. Basil, honey, ghost pepper... half our ingredients go to the Test Kitchen now and nothing comes back. Please, if you see any lying around, pick them up. I would be so grateful.", "I once fetched a whole pig. It was the wrong pig. It is still angry about it. Do not tell the Grand Chef I said anything. He has very good hearing."],
"npc.tarragon.return": ["Any ingredients? Anything? I will take a single leaf of anything. I am not proud. I am hungry. And a bit scared."],
"npc.dolcetta.intro": ["Dolcetta Crumb, dessert dealer and card shark of the Grand Pantry. Cakes by day. Cards by night. Both by appointment.", "Everything here is Gourmand-issue: baked, bottled and, as of this year, officially inspected by the Test Kitchen. The inspection stamp is on the cake. The cake is, as ever, for decoration.", "I take gold, favours and sprinkles, in that order. Mostly gold. I do not take samples of the Special Sauce. I have been faking it for months."],
"npc.dolcetta.return": ["Shop's open. The cards are fresh. The cake is for decoration. The sauce is for other people."],
"quest.buf_pantry.offer": ["Oh good, you can fetch! Wonderful! I mean, I am not saying I want you to fetch, I am saying fetching is a gift.", "We need three ingredients, quick. The Test Kitchen has been taking our deliveries. They are scattered all over the Endless Buffet: truffles by the broccoli, salt by the river, honey up on the Butte. Pick up three and I will make it worth your while."],
"quest.buf_pantry.active": ["Three ingredients, remember. The pantry is empty and the Head Chef is staring at me. Please hurry."],
"quest.buf_pantry.ready": ["You did it! Three whole ingredients! The Pantry is saved! Here, a little something. It is a card. It is soup. It is soup you can play."],
"quest.buf_pantry.done": ["The pantry is stocked. Until tomorrow. Then we start over. It is a lovely cycle."],
"quest.buf_pie.offer": ["Do me a favour. I have a customer who wants a Hearty Pot Pie, a real one, and the Grand Oven is feeling temperamental. It keeps getting asked to cook prototypes.", "Bring me one, baked fresh. Honey, giant basil and a ghost pepper, straight into the Oven near the arch. Careful with the pepper. The pepper is not a team player."],
"quest.buf_pie.active": ["One Hearty Pot Pie. Honey, basil, ghost pepper, the Grand Oven. I will be here. I have cake."],
"quest.buf_pie.ready": ["A pie! Golden and warm! The customer is going to cry. I am going to cry. Here is your reward. Thank you. Thank you."],
"quest.buf_pie.done": ["That was the best pie we have had in years. The oven wants a word with you, actually. It wants to say thanks."],
"quest.buf_mend.offer": ["A word, if you please. Old Meatloaf, the oldest golem in the Grand Pantry, has stopped working. The Test Kitchen tried to strip him for parts. We got him back in two pieces. He has not said a word since Tuesday.", "Fix him. Sea salt, to season his joints, and a black truffle, for his heart. Both are out there somewhere. Mend him and the Warden of Layer-Cake Town will let you into the cake district. Yes, Chef?"],
"quest.buf_mend.active": ["Old Meatloaf is over by the west wall. Sea salt, a black truffle, and a bit of tenderness."],
"quest.buf_mend.ready": ["He is walking! He is sizzling! Old Meatloaf is back on duty! Here is your reward, and Sir Loin will honour your passage now. Well done, Gourmand. Yes, Chef."],
"quest.buf_mend.done": ["Old Meatloaf is the best golem in the kingdom. Do not tell the others."],
"npc.old_meatloaf.broken": ["Old Meatloaf is slumped on the floor, in two pieces, with crossed-out eyes. A note on his chest reads: SEA SALT AND A BLACK TRUFFLE. PLEASE BE GENTLE."],
"npc.old_meatloaf.fix": ["You season Old Meatloaf's joints with the sea salt and tuck the black truffle where his heart should be. He sits up slowly.", "\"...Chef?\" he says. \"Yes, Chef,\" you say, because it feels right. His eyes uncross."],
"npc.old_meatloaf.mended": ["Old Meatloaf stands guard with great dignity. \"Yes, Chef!\" he whispers. He says it to you. You are not a chef. He does not care. He is just glad nobody wants to turn him into a cannon."],
"npc.quiz.intro": ["Ah, a student! Lady Brioche, Keeper of the Cookbook. I have read every recipe in the kingdom. Twice. The second time was for the footnotes. I have never found a recipe for the Special Sauce. I looked.", "Four questions about the Gourmands: who they are, what they cook, how their golems speak. Every answer is written on a sign somewhere in the Endless Buffet.", "Answer well and earn gold, glory and the respect of a very old book. Answer poorly and earn a gentle, scholarly sigh."],
"npc.quiz.return": ["Back to improve your score? Splendid. Practice makes perfect. Perfect makes me a little smug."],
"quiz.result.0": ["Zero. Remarkable in its way. Nothing for you. The signs are patient. I am slightly less so."],
"quiz.result.1": ["One. A pinch of knowledge, barely seasoned. Here is a small token. It is a thimble of encouragement."],
"quiz.result.2": ["Two. Half-baked. A fine place to start. Half-baked things can still be rescued."],
"quiz.result.3": ["Three! Nearly perfect. Perfect would make me suspicious. Take your reward and a warm roll."],
"quiz.result.4": ["FOUR! A perfectly risen set! You may now call yourself a Certified Gourmand, First Class. The reward is real. The certificate is imaginary."],
"quiz.repeat": ["Another round! The Cookbook pays a small fee for repeat scholarship."],
"quiz.not_passed": ["Not a pass. Walk the Endless Buffet, read the signs, and come back. There is no limit on attempts."],
"npc.minigame.intro": ["*cue brass fanfare and a rimshot* WELCOME, WELCOME, WELCOME to DINNER IN A DASH! I'm your host, Chef Turbo Tartine, and tonight we are LIVE from a field of candy! The Test Kitchen cancelled my show, so I'm doing it in secret.", "You may remember me from the old tapes: nineteen ninety-seven to two-thousand-three, the kitchen that moved faster than the cameraman. My catchphrase was an actual sound effect. A whoosh. People still do the whoosh.", "My arch-rival, Chef Savannah Souffle, stole my signature dish: Spaghetti Surprise. The surprise was more spaghetti. She called it Spaghetti Deluxe. The nerve! Last I heard, she took a job at the Test Kitchen. I wish her well. I wish her well far away.", "I also had a line of kids'-meal toys: the Turbo Tots, tiny plastic spatulas that spun. They were recalled. Not for safety. For spinning too well. That's a different kind of danger.", "Tonight's show: ORDER UP! Six tickets, one counter, no mercy. Stack the dish in the right order before the timer dings. Rewards for performance, and a first-time bonus. The audience is ten sprouts and a very patient cloche. Let's COOK!"],
"npc.minigame.return": [
"Back for another shift, champ? The cameras are always rolling. They are not. They ran out of film in two-thousand-three. Smile anyway.",
"Remember: the ticket is your friend. The ticket does not judge. The ticket is judging, but kindly."
],
"order.intro": ["Six tickets. Press the ingredient stations in the right order (click or keys 1-6) before the timer runs out. A wrong ingredient tosses the plate and costs time. Faster is better."],
"order.stations": ["Bun", "Patty", "Cheese", "Lettuce", "Tomato", "Fries"],
"order.dishes": ["The Plain Jane Burger", "The Cheese Please", "Garden of Eatin'", "Burger & Fries", "The Deluxe Dash", "The Turbo Special"],
"order.shouts": ["Order up! First ticket!", "Second ticket, and I do mean it!", "Garden salad! Light and leafy!", "Burger and fries, hot hot hot!", "The Deluxe! Hands moving!", "TURBO SPECIAL! Whoosh!"],
"order.win": ["THAT'S the way! You cook like you were born in a kitchen. The camera loves you. The camera also loves a clean counter."],
"order.first": ["Your very first shift on the show! Here is your bonus, free, no obligation. It is a scroll. Chef Savannah would call it Scroll Deluxe."],
"order.lose": ["Not quite a shift, champ. That is fine. Breathe. Re-tie the apron. The ticket rail is not going anywhere."],
"recipe.intro": ["A huge pot bubbles on a fire. Beside it hangs the recipe card: seven clues for the Mystery Stew. Choose four of the six ingredients and add them in the right order. Serve it when you are sure; the pot only tells you right or wrong."],
"recipe.ingredients": ["Carrot", "Onion", "Mushroom", "Paprika", "Leek", "Pumpkin"],
"recipe.clue.1": ["Exactly one of the Pumpkin and the Mushroom goes in the stew."],
"recipe.clue.2": ["The Carrot has been banned from the stew. Long story."],
"recipe.clue.3": ["The first ingredient is the Onion or the Carrot."],
"recipe.clue.4": ["The Leek goes in after the Mushroom (not necessarily right after)."],
"recipe.clue.5": ["The Paprika is never second."],
"recipe.clue.6": ["The Leek is never last."],
"recipe.clue.7": ["The Mushroom does not go in first."],
"recipe.hint": ["Start with what is banned and what must be present. Four of the six are in, two are out. Then place them one clue at a time."],
"recipe.solved": ["The stew thickens. The ladle hums. A small, heavy parcel rises out of the steam: the pot has given you its seasoning."],
"recipe.already": ["The stew sits perfectly seasoned. Nothing left to cook."],
"recipe.incomplete": ["The pot needs exactly four different ingredients before you can serve it."],
"recipe.wrong": ["The golem that tastes it gags politely. \"Chef, this is not it.\"", "The stew goes bland. The pot sighs. The pot has seen better cooks.", "A single sad bubble rises. It pops. That was all it had to say.", "\"Chef, with respect: no.\""],
"fortune.hints": ["A stash lies in the shade of the broccoli, in a loaf that has gone hollow.", "On the Butte, behind the butter, someone left a present for the brave.", "Candy is sweeter when it is hidden. Try the big jar in the south-east.", "Between the shakers on the salt flats, something shines.", "Cheddar tastes sharper from above. Take the lime jelly to the top.", "Behind a wheel of cheese, a smaller wheel of gold.", "At the summit of the pancakes, a tip: the syrup hides a treasure.", "In Layer-Cake Town, behind a cake: a cake of another kind."],
"npc.gate.hint": ["The golem stands firm."],
"hud.objective.freed": ["The Endless Buffet, free of the impostor: the Grand Pantry is safe. Life does not come back after battles - sit down for a hearty meal, or walk back down the Path of the Gourmand."],
"ui.exit.body.freed": ["Leaving the Endless Buffet ends this visit. Town heals you fully. The golems are back to guarding plates, not people. The buffet is still endless."],
"sign.hub_main.freed": ["THE GRAND PANTRY", "Hub of the Endless Buffet. The Gourmands feed the kingdom and protect it.", "Nobody leaves hungry. Innovation Season is over. Dinner is back."],
"sign.hub_motto.freed": ["TODAY'S SPECIALS", "- Feed the kingdom", "- Guard the kingdom (with golems)", "- Answer every order with \"Yes, Chef!\"", "- Real food. Real sauce. Real chef."],
"sign.innovation": ["INNOVATION SEASON", "By order of the Grand Chef: every kitchen contributes to Prototype Development.", "Taste-tester shifts are mandatory. Complaints will be seasoned and served."],
"sign.innovation.freed": ["INNOVATION SEASON: CANCELLED", "The Grand Chef has asked us to remember that food is for eating, not for firing.", "Complaints may be submitted in sauce."],
"sign.special_sauce": ["THE SPECIAL SAUCE", "Delicious. Compulsory. Do not ask what is in it.", "It is in everything now. Please enjoy."],
"sign.special_sauce.freed": ["THE SPECIAL SAUCE (RECALLED)", "Contents: a lot of things that were not food. Return all unused sauce to the Pantry."],
"sign.taste_testers": ["TASTE TESTERS WANTED", "Join the elite food-safety force. Free uniform, free meals, no questions.", "(Previous taste testers are available for questions. They are not answering.)"],
"sign.taste_testers.freed": ["TASTE TESTERS: THANK YOU", "The taste testers are free. They like food again. Please give them seconds."],
"sign.exit.freed": ["THE PATH OF THE GOURMAND", "(Town. Wipe your feet. We just mopped. You may keep your sample.)"],
"sign.main_dungeon.freed": ["THE TEST KITCHEN", "Research & Development. Open to the public for tours.", "The cannon has been repurposed. It now fires bread at the pigeons. Politely."],
"sign.inspection_note.freed": ["NOTE FROM THE INSPECTOR", "Found: a kitchen where there was a lab, a stove where there was a cannon, and a Grand Chef who was finally himself.", "Passed inspection, with distinction. And dessert."],
"npc.odalys.intro.freed": ["It was a doppelgänger! A SHAPESHIFTING IMPOSTOR! And you took it down! The real Grand Chef is back in his own kitchen, tasting his own soup, and he cried. We all cried. It was a very salty day.", "Welcome back to the Grand Pantry. Say it with me: Yes, Chef. This time we mean it."],
"npc.odalys.return.freed": ["The Special Sauce is down the drain. The golems guard plates again. Yes, Chef! You may take seconds. You have earned seconds. You have earned thirds."],
"npc.tarragon.intro.freed": ["Tarragon! Sous-Chef! Free! The ingredients are coming back from the Test Kitchen by the cartload. Pigs, even. Not the angry pig. A different one."],
"npc.tarragon.return.freed": ["Fetching is fun again! Everyone waves at me! Nobody asks me to fetch cannonballs!"],
"npc.dolcetta.intro.freed": ["Dolcetta Crumb, dessert dealer, free of the sauce! My taste buds came back last week and wow, wow, the sugar. Cakes by day. Cards by night. Both by appointment, and all by choice."],
"npc.dolcetta.return.freed": ["Shop's open, the cards are fresh, and the cake is for eating now. Sit down. Have a slice."],
"effect.buff.name": ["Well Fed"],
"effect.buff.flavor": ["Nobody leaves hungry, least of all the Gourmands. Full bellies make for strong golems."],
"effect.debuff.name": ["Dress Code Violation"],
"effect.debuff.flavor": ["The Gourmands look down their noses at garbage eaters. Refusemancers here feel very, very underdressed."],
"freed_npc.aurelio": ["Grand Chef Aurelio Saucier, at your service, and at your stove. Forgive the apron. The impostor wore it better, but I wear it with feeling.", "Ten years in the walk-in freezer, and I never once forgot the taste of honest soup. They fed the Gourmands corrupted sauce and called it innovation. They were wrong. Innovation is a pinch of something new in something good.", "Thank you for finding me. Sit. Eat. Let me cook for you. I promise there is no cannon in it."],
"ruler.statue": ["THE GRAND CHEF (OFFICIAL LIKENESS)", "\"Innovation Is Delicious.\""],
"ruler.statue.freed": ["FORMER LIKENESS OF THE FALSE AURELIO", "(It was always a little off. Whose chin is that?)"],
"ui.main.title": ["The Test Kitchen"],
"ui.main.body": ["The Test Kitchen is the Endless Buffet's research and development facility: experimental kitchens, food laboratories and an enormous, unfinished cannon. Somewhere inside, the Grand Chef is not the Grand Chef. Your life carries in from the zone and nothing heals except at the canteen. Beat the boss to free the Buffet."],
"ui.main.body_cleared": ["The Test Kitchen is quiet now, and the real Grand Chef is cooking. You can still run the prototypes for gold and XP. Life carries in from the zone; nothing heals except at the canteen."],
"ui.main.button": ["Enter the Test Kitchen"],
"dungeon.tk_dock.title": ["The Loading Dock"],
"dungeon.tk_dock.blurb": ["Crates of ingredients roll in. Crates of something else roll out, and they are not labelled."],
"dungeon.tk_dock.before": ["A sign over the dock doors reads TASTE-TESTER ENTRANCE. Beneath it, in smaller letters: NO EXIT.", "The air smells of caramel and solder. Somewhere deep inside, a cannon coughs and a dozen chefs say \"Yes, Chef!\" very quietly."],
"dungeon.tk_intake.title": ["Ingredient Intake"],
"dungeon.tk_intake.blurb": ["A corrupted sous-chef guards the conveyor belt. Everything on the belt is a little too shiny."],
"dungeon.tk_panel.title": ["The Taste Panel"],
"dungeon.tk_panel.blurb": ["A panel of grim judges tastes whatever you can serve them. Their verdict is final. So is their silence."],
"dungeon.tk_cold.title": ["Cold Storage Prototypes"],
"dungeon.tk_cold.blurb": ["Frozen failures line the walls. Some of them are still moving."],
"dungeon.tk_canteen.title": ["The Staff Canteen"],
"dungeon.tk_canteen.blurb": ["A hot meal, an honest one. The only unmodified food in the building. Restore life."],
"dungeon.tk_canteen.after": ["The cook behind the counter whispers: \"The Grand Chef stopped tasting his own soup ten years ago. Nobody noticed. Everybody noticed. Nobody said.\""],
"dungeon.tk_construct.title": ["The Food Construct"],
"dungeon.tk_construct.blurb": ["An experimental food construct, stitched together from three kinds of meat and one regret. (Elite)"],
"dungeon.tk_cannon.title": ["The Cannon Bay"],
"dungeon.tk_cannon.blurb": ["The unfinished war machine looms. It is enormous, held together by gravy and willpower."],
"dungeon.tk_armory.title": ["The Armory Pantry"],
"dungeon.tk_armory.blurb": ["Shelves of rations, ladles and ladle-shaped weapons. Take what you can carry."],
"dungeon.tk_vats.title": ["The Special Sauce Vats"],
"dungeon.tk_vats.blurb": ["Great vats of the Special Sauce bubble in the dark. This is where the corruption is made."],
"dungeon.tk_vats.after": ["You pour a vat out. Behind it, a service door opens on the Executive Test Kitchen. The air there smells like a very expensive soup."],
"dungeon.tk_mk9.title": ["The Mk. IX Prototype"],
"dungeon.tk_mk9.blurb": ["The finest war machine the Test Kitchen has ever failed to finish. It is armed, hungry and unseasoned. (Elite)"],
"dungeon.tk_whistle.title": ["The Whistleblower"],
"dungeon.tk_whistle.blurb": ["A sous-chef hiding in the dry goods wants to tell you something about the Grand Chef."],
"dungeon.tk_boss.title": ["The Executive Test Kitchen"],
"dungeon.tk_boss.blurb": ["The Grand Chef's private kitchen. His apron is spotless. His chin is a little off."],
"dungeon.tk_boss.before": ["The Grand Chef turns from the stove. He smiles the exact smile on every portrait in the Pantry. He has been smiling it for ten years.", "\"Ah, a taste tester. Welcome to the future of dining. Do you know what the future tastes like? Obedience.\""],
"dungeon.tk_boss.after": ["The False Aurelio collapses, and the Special Sauce goes with him, down a drain in the floor. Somewhere in the walls, a freezer door swings open. The real Grand Chef Aurelio Saucier has been waiting a decade for someone to open it.", "The golems straighten up. \"Yes, Chef!\" they say, and this time they mean the right one."],
"challenge.tk_taste_panel.title": ["The Taste Panel"],
"challenge.tk_taste_panel.text": ["Four dishes are served to the panel. They want to see that you can field real, living creatures, not just soup."],
"event.tk_cannon_bay.title": ["The Cannon Bay"],
"event.tk_cannon_bay.body": ["The unfinished war machine fills the room: a cannon the size of a barn, fed by a conveyor belt of meatballs. A tired engineer in an apron asks whether you are here for the inspection or for the tour."],
"event.tk_cannon_bay.choice.0": ["Take the blueprints (and a tip)"],
"event.tk_cannon_bay.choice.1": ["Jam the cannon's gravy valve"],
"event.tk_cannon_bay.choice.2": ["Eat one of the test meatballs"],
"event.tk_cannon_bay.result.0": ["The engineer slips you the blueprints and a few coins. \"Please burn these,\" he whispers. \"After you're done selling them.\""],
"event.tk_cannon_bay.result.1": ["You twist the valve. The cannon coughs, sighs, and settles into a sulk. Your creatures feel sturdier in a kitchen that is slightly less likely to fire at them."],
"event.tk_cannon_bay.result.2": ["Surprisingly good. It is a prototype, so it is also a little bit explosive. You feel a lot better, and a little singed."],
"event.tk_whistleblower.title": ["The Whistleblower"],
"event.tk_whistleblower.body": ["A sous-chef is hiding behind the sacks of flour. \"He does not taste the soup,\" he whispers. \"He never tastes the soup. Whoever is in that kitchen is not our Chef.\""],
"event.tk_whistleblower.choice.0": ["Take his notes on the impostor"],
"event.tk_whistleblower.choice.1": ["Share your rations with him"],
"event.tk_whistleblower.choice.2": ["Turn him in for the reward"],
"event.tk_whistleblower.result.0": ["He presses a stained notebook into your hands: weaknesses, habits, a very detailed list of things the False Aurelio will not eat. Your creatures hit harder."],
"event.tk_whistleblower.result.1": ["He eats like a man who has not eaten in a week. \"Thank you,\" he says. \"Be careful. The real Chef is down there somewhere.\" You feel better for it."],
"event.tk_whistleblower.result.2": ["The guards pay well and ask no questions. You feel terrible. Possibly it is the Special Sauce. Possibly it is not."],
"cutscene.reveal.1.speaker": ["The False Aurelio"],
"cutscene.reveal.1": ["Welcome, little taster, to the Executive Test Kitchen. Ten years ago I took this face and this apron, and not one Gourmand noticed. Do you know why? They never looked at their Chef. They looked at the food."],
"cutscene.reveal.2.speaker": ["You"],
"cutscene.reveal.2": ["You never taste your own soup, do you?"],
"cutscene.reveal.3.speaker": ["The False Aurelio"],
"cutscene.reveal.3": ["...Soup is for the weak. The Usurper's orders are for the strong. I have given the Gourmands the Special Sauce, and they have given me an army of golems. It is a very efficient arrangement."],
"cutscene.reveal.4.speaker": ["The False Aurelio"],
"cutscene.reveal.4": ["Fine. If you must see. I always hated this chin."],
"cutscene.reveal.5.speaker": ["The False Aurelio"],
"cutscene.reveal.5": ["THIS is my real face. Behold the true dish of the Usurper: the Doppelgänger. Now. Let me serve you."],
}
quiz_questions = Array[Dictionary]([{
"a": ["Feeding the kingdom and protecting it", "Collecting the kingdom's taxes", "Inspecting the kingdom's dungeons", "Writing the kingdom's restaurant reviews"],
"correct": 0,
