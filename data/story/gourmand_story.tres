[gd_resource type="Resource" script_class="ZoneStoryText" format=3]

[ext_resource type="Script" path="res://core/data/zone_story_text.gd" id="1_buf"]

[resource]
script = ExtResource("1_buf")
zone_id = "gourmand"
lines = {
"hud.objective": ["The Endless Buffet: the Grand Pantry is safe. HP does not come back after battles - sit down for a hearty meal, or walk back down to town. Everything here looks wonderful.", "Something under the Test Kitchen smells wrong."],
"ui.mini.body": ["Three courses in a row. Your HP carries from one course to the next and nothing heals in between. Finish all three for a unique Gourmand card."],
"ui.mini.body_cleared": ["You already took the unique card from this freezer. You can still eat your way through the courses for gold and XP. HP carries over; nothing heals in between."],
"ui.mini.button": ["Open the door"],
"ui.exit.title": ["Walk back down to town?"],
"ui.exit.body": ["Leaving the Endless Buffet ends this visit. Town heals you fully; the roaming golems, sentinels and meatballs (prototype batch, unfortunately) will be back next time. The buffet, as the name suggests, is endless."],
"fx.main_dungeon": ["The Test Kitchen sits at the far end of the table: a gleaming glass-and-steel laboratory with a very large, very unfinished cannon sticking out of the roof. A banner reads INNOVATION SEASON."],
"fx.heal_couch": ["You sit down to a hearty meal: roast something, a bowl of soup the size of a bathtub, and a roll that hugs you back. HP restored."],
"fx.heal_already": ["Your HP is already full, but a chef refills your plate anyway. Around here, being full is treated as a misunderstanding."],
"fx.hit": ["BONK! A runaway prototype meatball hits you right in the shins. (-2 HP)"],
"fx.wake": ["You wake up face-down in a bowl of mashed potatoes at the Grand Pantry. Basil is holding a ladle and a very long receipt.", "\"You fainted into the gravy, so we fished you out. There's meant to be a fishing fee, but I've lost the receipt. Again. Please don't tell Chef.\"", "\"Don't tell the taste testers you fainted. If anyone asks you anything, just say 'Yes, Chef.' It works for everything.\""],
"fx.chest": ["A hidden stash! Unsampled, unsauced and all yours."],
"fx.bounce": ["BOING!"],
"fx.landed": ["You stick the landing. Peeling yourself off it takes longer."],
"fx.soup_fall": ["You fall in the gravy. A passing chef fishes you out with a ladle and checks you for seasoning. (-1 HP)"],
"fx.soup_fall_log": ["Fell into the soup at %s - fished out at the last safe spot, 1 damage to zone HP."],
"fx.gate_open": ["The golem steps aside with the slow dignity of a roast being carved. The way is open."],
"fx.pickup": ["Found:"],
"fx.pickup_again": ["You already took the one lying here. Come back on your next visit; the pantry restocks overnight."],
"fx.oven_done": ["Ding! A Hearty Pot Pie, golden and steaming, drops into your bag. The oven looks very proud of itself."],
"fx.oven_missing": ["The Grand Oven rumbles. \"A pie needs honey, basil and a ghost pepper. I am an oven, not a miracle.\""],
"fx.taste_good": ["Smooth, balanced, a touch of citrus. You nod like a professional. +HP."],
"fx.taste_great": ["You take a sip and blink through a tear. Five stars would feel stingy - big recovery!"],
"fx.taste_buff": ["Your palate sharpens. You can taste what the cheese had for breakfast. A little extra HP for the visit."],
"fx.taste_tip": ["The judges are impressed and tip you for the privilege of watching. +gold."],
"fx.taste_spicy": ["You find the ghost pepper in spoon three. Your ears ring in protest. -1 HP."],
"fx.taste_bland": ["You taste boiled water with a hint of ambition. The judges study their shoes; nothing else happens."],
"fx.taste_broke": ["You need 8 gold for the taste test. The station declines to sample your good intentions."],
"fx.fountain_1": ["You ladle some soup. Tomato with a hint of basil. Warm all the way down. +HP."],
"fx.fountain_2": ["You take a second ladle of cream of mushroom. The fungus has a rich inner life. +HP."],
"fx.fountain_3": ["Third ladle: minestrone, mostly noodles. You feel taller. +HP."],
"fx.fountain_full": ["You ladle some soup, look at it, and pour it back. You are full. The fountain takes it well."],
"fx.fountain_limit": ["The fountain's tank is dry for now. Soup takes time, and it will be full again on your next visit."],
"fx.cookie_broke": ["The dispenser wants 5 gold. Fortune favours the people who bring change."],
"fx.cookie_crack": ["You crack the cookie open. A tiny paper slip falls out. It reads:"],
"fx.mend_done": ["Old Meatloaf is mended! He gets up, stretches, and sizzles a little."],
"prop.arch": ["THE PATH OF THE GOURMAND"],
"prop.dispenser": ["FORTUNE COOKIES"],
"prop.broken_golem": ["OUT OF ORDER"],
"prop.stage": ["DINNER IN A DASH!"],
"prop.freezer": ["THE WALK-IN FREEZER"],
"prop.kitchen": ["THE TEST KITCHEN"],
"prop.stew": ["THE MYSTERY STEW"],
"gate.ingredient.open": ["Brisket nods slowly. \"Go on in. Mind the cheese.\"", "\"The cheese takes trespassing personally. You're walking on its rind.\""],
"gate.ingredient.pass": ["Brisket sniffs the air, and his eyes close in bliss. \"Saffron. Real saffron.\"", "\"Do you know how long it has been?\" He takes the threads with great tenderness and steps aside.", "\"Go on through. Tell the Cheddar Cliffs they are overdue for a good grating. Yes, Chef.\""],
"gate.ingredient.need": ["Brisket does not look at you. He looks over your head, at the horizon. \"This gate opens for one pinch of saffron.\"", "\"Real saffron, mind you, which grows in the Candy Field. Ask a sous-chef if you lose your way.\"", "He sighs at you. \"Bring saffron from the Candy Field; this gate has a very particular taste in visitors.\""],
"gate.quest.open": ["Sir Loin raises his fork in salute. \"You mended Old Meatloaf, so you are a friend of the Pantry. The town is yours.\""],
"gate.quest.pass": ["Sir Loin inspects you. \"Old Meatloaf walks again. Basil sends thanks, and orders, which are: let you in. Yes, Chef!\"", "He lowers his fork-lance. The gate swings open."],
"gate.quest.need": ["Sir Loin clanks to attention. \"HALT! Nobody enters Layer-Cake Town until Old Meatloaf has been mended.\"", "\"It is Basil's request, so speak to Basil: he is in the Grand Pantry's square, east of the Soup Fountain. Yes, Chef!\""],
"gate.quest.mended": ["Sir Loin peers past you toward the Pantry. \"Old Meatloaf is up and clanking about? Then the mending is done, and Basil has not sent word.\"", "\"Tell Basil yourself: the Grand Pantry's square, east of the Soup Fountain. His word opens this gate, and then the town is yours. Yes, Chef!\""],
"gate.quest.active": ["Sir Loin clanks to attention. \"HALT! Old Meatloaf is still in two pieces, and I have Basil's list right here.\"", "\"Sea salt: the Salt Flats, by the river. A black truffle: under the Broccoli Forest's trees, to the south-west. Then mend him at the Pantry's west wall. Yes, Chef!\""],
"gate.battle.open": ["Colonel Casserole tips his lid. \"A fair fight, well fought. The Pancake Plateau is open to you. Mind the syrup; it pools.\""],
"gate.battle.intro": ["Colonel Casserole bubbles ominously. \"Halt! This gate is guarded by a Colonel.\"", "\"No passes, no bribes - challenge me to single combat with cards. I shall defend this gate to the last course.\"", "\"If you win, you pass. If you lose, you do the washing up. Both are honourable.\""],
"gate.battle.ask": ["Defeat Colonel Casserole in a card battle to open the way to the Pancake Plateau. Your HP carries over as usual."],
"sign.hub_main": ["THE GRAND PANTRY", "Hub of the Endless Buffet. The Gourmands feed the kingdom and protect it.", "Nobody leaves hungry. (Innovation Season is now in effect. Sample participation is mandatory.)"],
"sign.hub_motto": ["TODAY'S SPECIALS", "- Feed the kingdom", "- Guard the kingdom (with golems. Defensive golems. Please stop saying the other word.)", "- Answer every order with \"Yes, Chef!\"", "- Innovation: please do not ask about the Special Sauce"],
"sign.exit": ["THE ORCHARD LANE","To {town}, through the great pantry door. Wipe your feet and surrender your sample; we just mopped."],
"sign.heal_table": ["THE HEARTY MEAL", "Sit. Eat. Do not ask what the gravy is made of."],
"sign.vendor": ["MIREPOIX'S DESSERT & DECKERY","Cards and cakes, mostly cards. Reservations recommended; table manners apply even to your deck."],
"sign.oven": ["THE GRAND OVEN", "Honey, basil and one ghost pepper make one Hearty Pot Pie.", "Do not open the oven to check on the pie. It is already working under considerable heat."],
"sign.fountain": ["THE SOUP FOUNTAIN", "Three ladles per customer. The soup of the day is soup."],
"sign.golem_oath": ["THE GOLEM OATH", "We are the Gourmands: chefs of the kingdom.", "We feed the kingdom. We protect the kingdom.", "We cook food golems to guard it. They answer every order with \"Yes, Chef!\""],
"sign.cookie": ["FORTUNE COOKIES - 5 GOLD", "Each one holds a hint about a secret. Handle with care. The secrets are crumbly."],
"sign.old_meatloaf": ["OLD MEATLOAF", "Out of order. Needs sea salt and a black truffle. Please be gentle.", "- Basil"],
"sign.forest": ["THE BROCCOLI FOREST", "Please do not eat the trees.", "The trees say the same about you."],
"sign.quiz": ["THE COOKBOOK GAZEBO", "Professor Pate asks 4 questions on the Gourmands and their kitchens. The answers are on the signs of the Endless Buffet."],
"sign.truffle_note": ["NOTE", "A black truffle was last seen near this tree.", "The tree was last seen near the truffle. They are inseparable."],
"sign.candy": ["THE CANDY FIELD", "Everything here is edible. Not everything is wise."],
"sign.studio": ["STUDIO 3: DINNER IN A DASH!", "Now taping: three tickets, one stove, zero patience.", "Live studio audience: a bowl of sprouts. Please applaud; they cannot."],
"sign.taste_test": ["BLIND TASTE TEST - 8 GOLD", "Judges: a spoon, a larger spoon and a very patient cloche.", "Results may vary. Please distinguish applause from your stomach making a statement."],
"sign.salt": ["THE SALT FLATS", "A pinch here. A pinch there. A pinch of sea salt for your troubles."],
"sign.butte": ["BUTTER BUTTE", "Step on the jelly pad. Mind the ceiling.", "(There is no ceiling. Mind the sky.)"],
"sign.pad_rule": ["JELLY PADS: HOW TO USE", "1. Step on.", "2. Boing.", "3. There is no step 3. There is only boing."],
"sign.river": ["THE GRAVY RIVER", "Thick, hot and entirely made of gravy.", "The only ways across: a crouton raft or the lazy susan."],
"sign.river_warning": ["WARNING: GRAVY", "Do not swim. Do not wade. Do not ask how deep it is.", "If you fall in, somebody will fish you out. It costs 1 HP."],
"sign.raft_west": ["CROUTON RAFT FERRY", "Hop on when it docks and hop off on the other side.", "Keep arms and legs inside the croutons. Passengers are not part of the garnish."],
"sign.susan": ["THE LAZY SUSAN", "The world's largest serving platter, slowly turning.", "Step on at one side and off at the other. Patience is a garnish."],
"sign.raft_east": ["CROUTON RAFT FERRY", "Eastbound and northbound. Please have exact change.", "(There is no change. Everything here is gravy.)"],
"sign.bank": ["GRAVY BANK", "Welcome to the far side. The gates ahead are guarded by golems, as is the custom. One wants saffron, one wants a favour, one wants a fight."],
"sign.gate_ingredient": ["THE CHEESE CLIFFS GATE", "Doorman: Brisket.", "Admission: a pinch of saffron."],
"sign.gate_quest": ["THE LAYER-CAKE TOWN GATE", "Warden: Sir Loin.", "Admission: a letter from Basil, proving Old Meatloaf has been mended."],
"sign.gate_battle": ["THE PANCAKE PLATEAU GATE", "Gatekeeper: Colonel Casserole.", "Admission: defeat the Colonel in a card battle."],
"sign.cheddar": ["THE CHEDDAR CLIFFS", "Sharp cheese ahead. Please do not lean on the walls, and please, please do not lick them."],
"sign.cake_town": ["LAYER-CAKE TOWN", "Population: a lot of crumbs.", "Please do not bite the buildings. The mayor's house is down to two layers, and he knows it was a visitor."],
"sign.pancake": ["THE PANCAKE PLATEAU", "Syrup flows downhill. So do tourists."],
"sign.mini_dungeon": ["THE WALK-IN FREEZER", "Three courses. Mandatory. No leftovers.", "Please do not lock yourself in. (Somebody already has.)"],
"sign.main_dungeon": ["THE TEST KITCHEN", "Research & Development. Staff only.", "Please do not ask what the cannon is for. The cannon is for dinner."],
"sign.inspection_note": ["NOTE FROM THE INSPECTOR", "Found: a lab where there was a kitchen, a cannon where there was a stove, and a Grand Chef who never tastes anything.", "Back at lunch. If I am not back, check the compost."],
"sign.stew": ["THE MYSTERY STEW", "Four ingredients, in the right order. Anything else tastes like a lesson.", "Read the recipe card. Guessing is not one of the four ingredients."],
"sign.golem_rule": ["GATE RULES", "Golems stand guard. Golems ask nicely, once.", "Golems answer every order with \"Yes, Chef!\""],
"sign.cake_menu": ["TODAY'S CAKE", "Chocolate, vanilla and structural.", "Nobody leaves hungry. Nobody leaves without a slice, either."],
"sign.cheese_note": ["GROCERY LIST", "Cheese. More cheese. Something to put on the cheese. Different cheese.", "- a sous-chef, 3 weeks ago"],
"enemy.loaf": ["You face a wardrobe-sized prototype meatloaf in a ketchup glaze. Its frown suggests it would like a second draft."],
"enemy.jelly": ["A lime gelatin sentinel with a spoon spear and a fruit cocktail soul. Prototype Mk. 2.", "You watch it wobble through a thought. Management has discouraged these."],
"enemy.meatball": ["A failed prototype meatball, all momentum and sauce, that escaped the Test Kitchen and hasn't stopped rolling since. Whatever it's running from, it's probably the cannon."],
"enemy.casserole": ["A pot-bellied colonel with a lid for a hat and a ladle for a sword. Thirty years of service, forty years of cheese."],
"npc.odalys.intro": ["Psst. I'm Basil, line cook - ladle in one hand, nerves in the other. We Gourmands feed the kingdom and protect it: the chefs cook and the golems guard. Lately, though, the golems have been... practising.", "Ten years ago {villain}'s people came to the Buffet, and after that the Grand Chef... changed. Chef ALWAYS tastes, and this Chef never does. She just stands there smiling at the soup.", "Then she put the Special Sauce in every pot. The old rules still hold - nobody leaves hungry, nobody double-dips, and we say \"Yes, Chef.\" Quietly. And nobody asks about the Test Kitchen. I'm not asking."],
"npc.odalys.return": ["You came back! Good, good. I've been stirring the same pot for an hour, just to give my hands something to do. A Gourmand never stops stirring.", "What do we say? \"Yes, Chef\" - on the lowest possible heat.", "The Grand Chef has very good hearing, for someone who never tastes a thing.", "The real Chef baked a birthday cake for the little prince once. Four layers, one for each Path. He licked the frosting off all four and left the rest. ...Are you all right? You've gone pale.", "Chef laughed about it for a week. Last month I mentioned that cake to her, and she didn't remember it at all - and Chef remembers every cake she's ever baked."],
"npc.tarragon.intro": ["Sous-Chef Tarragon, fetcher of things - oh, good, more hands! I've been running all day and still haven't caught up with lunch.", "We're always out of something - honey, basil, ghost pepper. Half our deliveries go to the Test Kitchen and nothing comes back. I once fetched them a whole pig. Wrong pig, and he's still cross about it.", "Don't tell the Grand Chef I said anything. Last cook who complained got promoted to taste tester. We haven't seen him since."],
"npc.tarragon.return": ["Ingredients, please, anything? I'm one leaf away from calling this a salad and going home.", "I'm so hungry I looked at a Refusemancer compost heap and thought 'starter'. Don't tell anyone. I'd never live it down."],
"npc.dolcetta.intro": ["Madame Mirepoix, darling: dessert dealer and card shark of the Grand Pantry. Tonight's tasting menu is three cards, lightly foiled, served with a little disdain.", "Every card is Gourmand-issue and, as of this year, inspected by the Test Kitchen. They stamped my decorative cake, darling, right on the rosette, and I have not forgiven them.", "I take gold, favours and sprinkles, in that order. I do not take the Special Sauce. I have been pretending to eat it for months."],
"npc.dolcetta.return": ["Your cards are plated, darling; the cake is decorative. As for the Special Sauce, I recommend the air beside it."],
"quest.buf_pantry.offer": ["You can fetch? Oh, wonderful. Our deliveries keep getting stolen and dropped all over the Buffet: there's truffle by the broccoli, salt by the river and honey up the Butte.", "Bring me any three and I'll make it worth your while. I'm begging with my whole apron here."],
"quest.buf_pantry.active": ["Bring any three ingredients from around the Buffet. The pantry is empty, and I can't keep calling that a minimalist menu."],
"quest.buf_pantry.ready": ["Three whole ingredients! The Pantry is saved - for today, anyway, which is the only day I'm worried about.", "Here, take this for your trouble. It's a card, and somehow it's also a soup. Soup you can play, if you can believe it."],
"quest.buf_pantry.done": ["The pantry's stocked until tomorrow, when we do it all again. I'm not complaining, I'm fetching. From a distance they look very similar."],
"quest.buf_pie.offer": ["A favour, darling. A customer of mine wants a Hearty Pot Pie, a real one, and the Grand Oven is sulking. It keeps being asked to cook prototypes.", "Bake one for me: honey, giant basil and a ghost pepper, into the Grand Oven by the arch, then bring it here. Careful with the pepper. It is not a team player."],
"quest.buf_pie.active": ["One Hearty Pot Pie, darling. Honey, basil and a ghost pepper into the Grand Oven by the arch. I shall wait. I have a cake to look at."],
"quest.buf_pie.ready": ["A pie. A real one, golden and warm. My customer is going to cry.", "And so am I, discreetly. Here is your reward, you scrappy little thing, and thank you."],
"quest.buf_pie.done": ["The best pie this Pantry has seen in years. The oven would like a word with you. I believe it wants to say thank you."],
"quest.buf_mend.offer": ["Um, could I have a word? Quietly? Old Meatloaf, our oldest golem, has stopped working. The Test Kitchen tried to strip him for parts, and we only got him back in two pieces. He hasn't spoken since Tuesday.", "He needs sea salt for his joints, from the Salt Flats by the river, and a black truffle for his heart, from under the Broccoli Forest to the south-west. Mend him and Sir Loin will let you through the Layer-Cake Town gate. Yes, Chef? ...Please?"],
"quest.buf_mend.active": ["Sea salt is out on the Salt Flats, by the river. The black truffle grows under the Broccoli Forest's trees, south-west of here. Both are marked on your map.", "Old Meatloaf is over by the west wall of the Grand Pantry. Sea salt, a black truffle, and a bit of tenderness."],
"quest.buf_mend.ready": ["He's walking, and he's sizzling! Old Meatloaf is back on duty! I'm not crying, I'm just standing near some onions.", "Here's your reward, and Sir Loin will open his gate for you now. Well done. Yes, Chef."],
"quest.buf_mend.done": ["Old Meatloaf is the best golem in the kingdom. Don't tell the others. They know."],
"npc.old_meatloaf.broken": ["Old Meatloaf is slumped on the floor, in two pieces, with crossed-out eyes. A note on his chest reads: SEA SALT AND A BLACK TRUFFLE. PLEASE BE GENTLE."],
"npc.old_meatloaf.fix": ["You season Old Meatloaf's joints with the sea salt and tuck the black truffle where his heart should be. He sits up slowly.", "\"...Chef?\" he says. \"Yes, Chef,\" you say, because it feels right. His eyes uncross."],
"npc.old_meatloaf.mended": ["Old Meatloaf stands guard with great dignity. \"Yes, Chef!\" he whispers.", "He says it to you, though you are not a chef. He doesn't mind.", "He is just glad nobody wants to turn him into a cannon."],
"npc.quiz.intro": ["Professor Pate, Keeper of the Cookbook. I've read every recipe twice; the footnotes have an excellent finish.", "I have never found a recipe for the Special Sauce, and believe me, I looked. I even licked the index.", "Four questions about the Gourmands: who they are, what they cook, how their golems speak. Every answer is written on a sign somewhere in the Endless Buffet.", "Answer well and earn gold, glory and the respect of a very old book. Answer poorly and earn a gentle, scholarly sigh, lightly salted."],
"npc.quiz.return": ["Back for more? Splendid. A footnote, while it simmers: the Capital's school lunches were excellent once. Hot, free, balanced. Then came the paste."],
"quiz.result.0": ["Zero, so no reward this time. We have established that knowledge does not rise on its own.", "Read the signs and let the facts simmer. You cannot rush a well-seasoned answer."],
"quiz.result.1": ["One. A pinch of knowledge, barely seasoned, so here is a small token: a thimble of encouragement."],
"quiz.result.2": ["Two. Half-baked, which is a fine place to start; half-baked things can always be rescued."],
"quiz.result.3": ["Three! Nearly perfect, and perfect would only make me suspicious. Take your reward and a warm roll."],
"quiz.result.4": ["FOUR! A perfectly risen set! You may now call yourself a Certified Gourmand, First Class.", "The reward is real. The certificate is imaginary."],
"quiz.repeat": ["Another round! The Cookbook pays a small fee for repeat scholarship."],
"quiz.not_passed": ["Not a pass, I'm afraid - wrong, but deliciously wrong. Walk the Endless Buffet, read the signs and come back; there's no limit on attempts."],
"npc.minigame.intro": ["*brass fanfare* CHEF FLAMBE FONTAINE, LIVE FROM THE CANDY FIELD: DINNER IN A DASH! The Test Kitchen cancelled us, so this is a SECRET BROADCAST!", "Seven seasons on the air, and people STILL do my WHOOSH in the street! I'd do it for you now, but I save it for the cameras.", "My arch-rival, Chef Savannah Souffle, stole my Spaghetti Surprise. The surprise was more spaghetti. She took a job at the Test Kitchen. I wish her well, very far away.", "Tonight's show: ORDER UP! Six tickets, one counter, no mercy. Stack each dish in the right order before the timer dings. Rewards for performance, and a first-time bonus!", "My Turbo Tots toys were recalled for spinning too well, and tonight's audience is ten sprouts and a very patient cloche. But the show goes on! Let's COOK!"],
"npc.minigame.return": [
"Back for another shift, champ? Smile for the cameras! They ran out of film years ago, but a professional smiles anyway.",
"Remember, the ticket is your friend. It's judging you, of course, but kindly."
],
"order.intro": ["Six tickets. Press the ingredient stations in the right order (click or keys 1-6) before the timer runs out. A wrong ingredient tosses the plate and costs time. Faster is better."],
"order.stations": ["Bun", "Patty", "Cheese", "Lettuce", "Tomato", "Fries"],
"order.dishes": ["The Plain Jane Burger", "The Cheese Please", "Garden of Eatin'", "Burger & Fries", "The Deluxe Dash", "The Turbo Special"],
"order.shouts": ["Order up! First ticket!", "Second ticket, and I do mean it!", "Garden salad! Light and leafy!", "Burger and fries, hot hot hot!", "The Deluxe! Hands moving!", "TURBO SPECIAL! Whoosh!"],
"order.win": ["ORDER UP - THAT COUNTER IS BEAUTIFUL! You cook like someone who knows exactly where the camera is!"],
"order.first": ["Your very first shift on the show! Here's your bonus, free and with no obligation: a scroll!", "Chef Savannah would call it Scroll Deluxe. She could put a garnish on the envelope and call it a course."],
"order.lose": ["Not quite, chef - breathe! Even a souffle gets a second rise in my kitchen!", "Re-tie your apron and try again! Those tickets can wait; this is a cooking show, not a farewell episode!"],
"recipe.intro": ["A huge pot bubbles on a fire. Beside it hangs the recipe card: seven clues for the Mystery Stew. Choose four of the six ingredients and add them in the right order.", "Serve it when you are sure; the pot only tells you right or wrong."],
"recipe.ingredients": ["Carrot", "Onion", "Mushroom", "Paprika", "Leek", "Pumpkin"],
"recipe.clue.1": ["Exactly one of the Pumpkin and the Mushroom goes in the stew."],
"recipe.clue.2": ["The Carrot has been banned from the stew. Long story."],
"recipe.clue.3": ["The first ingredient is the Onion or the Carrot."],
"recipe.clue.4": ["The Leek goes in after the Mushroom (not necessarily right after)."],
"recipe.clue.5": ["The Paprika is never second."],
"recipe.clue.6": ["The Leek is never last."],
"recipe.clue.7": ["The Mushroom does not go in first."],
"recipe.hint": ["Start with what is banned and what must be present. Four of the six are in, two are out. Then place them one clue at a time."],
"recipe.solved": ["The stew thickens. The ladle hums. A small, heavy parcel rises out of the steam: the pot has given you its seasoning."],
"recipe.already": ["The stew sits perfectly seasoned. Nothing left to cook."],
"recipe.incomplete": ["The pot needs exactly four different ingredients before you can serve it."],
"recipe.wrong": ["The golem that tastes it gags politely. \"Chef, this is not it.\"", "You watch the stew go bland. The pot sighs like a recipe being ignored.", "A single sad bubble rises and pops. That was all it had to say.", "\"Chef, with respect: no.\""],
"fortune.hints": ["A stash lies in the shade of the broccoli, in a loaf that has gone hollow.", "On the Butte, behind the butter, someone left a present for the brave.", "Candy is sweeter when it is hidden. Try the big jar in the south-east.", "Between the shakers on the salt flats, something shines.", "Cheddar tastes sharper from above. Take the lime jelly to the top.", "Behind a wheel of cheese, a smaller wheel of gold.", "At the summit of the pancakes, a tip: the syrup hides a treasure.", "In Layer-Cake Town, behind a cake: a cake of another kind."],
"npc.gate.hint": ["The golem stands firm, like an aspic that has made up its mind."],
"hud.objective.freed": ["The Endless Buffet, free of the impostor: the Grand Pantry is safe. HP does not come back after battles - sit down for a hearty meal, or walk back down to town."],
"ui.exit.body.freed": ["Leaving the Endless Buffet ends this visit. Town heals you fully. The golems guard plates again instead of people, and the buffet is as endless as ever."],
"sign.hub_main.freed": ["THE GRAND PANTRY", "Hub of the Endless Buffet. The Gourmands feed the kingdom and protect it.", "Nobody leaves hungry. Innovation Season is over, and dinner is back."],
"sign.hub_motto.freed": ["TODAY'S SPECIALS", "- Feed the kingdom", "- Guard the kingdom (with golems; the cannons are ovens now)", "- Answer every order with \"Yes, Chef!\"", "- Real food. Real sauce. Real chef."],
"sign.innovation": ["INNOVATION SEASON", "By order of the Grand Chef, under the seal of Colonel Crumb, Culinary Defense: every kitchen contributes to Prototype Development, for the war effort.", "Taste-tester shifts are mandatory. Complaints will be seasoned and served."],
"sign.innovation.freed": ["INNOVATION SEASON: CANCELLED", "The Grand Chef has asked us to remember that food is for eating, not for firing.", "Complaints may now be submitted in sauce. We are prepared to take a little heat."],
"sign.special_sauce": ["THE SPECIAL SAUCE", "Delicious. Compulsory. Do not ask what is in it.", "It is in everything now. Please enjoy."],
"sign.special_sauce.freed": ["THE SPECIAL SAUCE (RECALLED)", "Return unused Special Sauce to the Pantry. Its ingredients have failed to establish that they are food."],
"sign.taste_testers": ["TASTE TESTERS WANTED", "Join the elite food-safety force. Free uniform, free meals, no questions.", "(Previous taste testers are available for questions. They are not answering.)"],
"sign.taste_testers.freed": ["TASTE TESTERS: THANK YOU", "Our taste testers are free and enjoying food again. Please give them seconds."],
"sign.exit.freed": ["THE ORCHARD LANE","To {town}, through the great pantry door. Wipe your feet, as we have just mopped, and take two free samples on your way out. Nobody is checking."],
"sign.main_dungeon.freed": ["THE TEST KITCHEN", "Research & Development. Open to the public for tours.", "The old cannon has been refitted to fire bread rolls for the pigeons, who have never been happier."],
"sign.inspection_note.freed": ["NOTE FROM THE INSPECTOR", "Found: a kitchen where there was a lab, a stove where there was a cannon, and a Grand Chef who was finally herself.", "Passed inspection, with distinction. And dessert."],
"npc.odalys.intro.freed": ["It wasn't her. It was a Doppelganger, wearing her face for ten years, and you walked right up to it. I'd have fainted. I did faint, earlier, about something else.", "The real Chef is back in her own kitchen, tasting her own soup, and we all cried into our aprons. Yes, Chef. YES, CHEF! ...Sorry. I whispered it for ten years, and it feels so good to mean it.", "She remembered the cake. The very first thing she said when we opened the freezer was \"Is the boy all right?\" I didn't know what to tell her."],
"npc.odalys.return.freed": ["The Special Sauce is down the drain and the golems guard plates again. Yes, Chef. I can say it out loud now. I keep saying it to the walls, just to hear it.", "Take seconds. You've earned seconds. You've earned thirds. Listen to me, I'm not even whispering."],
"npc.tarragon.intro.freed": ["Tarragon, Sous-Chef and fetcher of things! Sorry, I'm out of breath. I finally caught up with lunch.", "Ingredients are coming back from the Test Kitchen by the cartload, pigs included, and this time the pig is happy about it. I've had quite enough professional disagreements with pigs."],
"npc.tarragon.return.freed": ["People wave when I fetch things now, and nobody's asked me for a single cannonball. Flour, eggs, a little thyme... sorry, I'm making lists again."],
"npc.dolcetta.intro.freed": ["Madame Mirepoix, free of the sauce. My taste buds came back last week, and darling... the sugar. I wept into a meringue.", "Cakes by day, cards by night. All by appointment, and all by choice."],
"npc.dolcetta.return.freed": ["Sit down and have a slice, darling. The cake has been promoted from decoration to dessert."],
"effect.buff.name": ["Well Fed"],
"effect.buff.flavor": ["Nobody leaves hungry, least of all the Gourmands. A full belly is hard to knock over."],
"effect.debuff.name": ["Dress Code Violation"],
"effect.debuff.flavor": ["The Gourmands insist on formal dining; Refusemancers arrive dressed for the work that grew the dinner."],
"freed_npc.grandchef": ["Have you eaten? Sit, sit. I'm the Grand Chef, and you'll have to forgive the apron. The impostor kept it cleaner than I do, but I wear it with more feeling.", "Ten years in the walk-in freezer, and I never once forgot the taste of honest soup. And all that time they were putting that sauce in every pot and calling it innovation.", "Innovation is a pinch of something new in something good. It is not a cannon.", "Thank you for finding me. Now eat, before it goes cold.", "Let me cook for you properly. I promise there's nothing in it but food.", "And you, my dear, don't know your own name yet. That isn't a flaw, it's a blank page. Go and do something worth signing."],
"ruler.statue": ["THE GRAND CHEF (OFFICIAL LIKENESS)", "\"Innovation Is Delicious.\""],
"ruler.statue.freed": ["FORMER LIKENESS OF THE DOPPELGANGER", "Official likeness withdrawn. It never captured the person who fed us. (Also: whose chin is that?)"],
"ui.main.title": ["The Test Kitchen"],
"ui.main.body": ["Test kitchens, food labs and an enormous, unfinished cannon. Somewhere inside, the Grand Chef is not the Grand Chef. HP carries in from the zone; only the canteen heals. Beat the boss to free the Buffet."],
"ui.main.body_cleared": ["The Test Kitchen is quiet now, and the real Grand Chef is cooking. You can still run the prototypes for gold and XP. HP carries in from the zone; nothing heals except at the canteen."],
"ui.main.button": ["Enter the Test Kitchen"],
"dungeon.tk_dock.title": ["The Loading Dock"],
"dungeon.tk_dock.blurb": ["You pass crates of ingredients going in and unlabelled crates coming out, and nothing in between that looks like a meal."],
"dungeon.tk_dock.before": ["A sign over the dock doors reads TASTE-TESTER ENTRANCE. Beneath it, in smaller letters: NO EXIT.", "The air smells of caramel and solder. Somewhere deep inside, a cannon coughs and a dozen chefs say \"Yes, Chef!\" very quietly."],
"dungeon.tk_intake.title": ["Ingredient Intake"],
"dungeon.tk_intake.blurb": ["A corrupted sous-chef guards the conveyor belt. Everything on the belt is a little too shiny."],
"dungeon.tk_panel.title": ["The Taste Panel"],
"dungeon.tk_panel.blurb": ["You face a silent panel of grim judges. They taste your dishes as though flavour might be used against them."],
"dungeon.tk_cold.title": ["Cold Storage Prototypes"],
"dungeon.tk_cold.blurb": ["Frozen failures line the walls, and some of them are still moving. One freezer hums louder than the rest, as if something inside wants to be heard."],
"dungeon.tk_canteen.title": ["The Staff Canteen"],
"dungeon.tk_canteen.blurb": ["A hot, honest meal: the only unmodified food in the building. Restore HP."],
"dungeon.tk_canteen.after": ["The cook behind the counter leans in and whispers: \"The Grand Chef stopped tasting her own soup ten years ago. Every one of us noticed, and not one of us said a word.\""],
"dungeon.tk_construct.title": ["The Food Construct"],
"dungeon.tk_construct.blurb": ["An experimental food construct, stitched together from three kinds of meat and one regret. (Elite)"],
"dungeon.tk_cannon.title": ["The Cannon Bay"],
"dungeon.tk_cannon.blurb": ["The unfinished war machine looms over you, enormous, and held together by gravy and willpower."],
"dungeon.tk_armory.title": ["The Armory Pantry"],
"dungeon.tk_armory.blurb": ["You find rations, ladles and ladle-shaped weapons in crates marked SERVING UTENSILS (DEFENSIVE). Take what you can carry."],
"dungeon.tk_vats.title": ["The Special Sauce Vats"],
"dungeon.tk_vats.blurb": ["Great vats of the Special Sauce bubble in the dark. A clipboard on the rail reads: BATCH 3,652. TASTED BY: (blank)."],
"dungeon.tk_vats.after": ["You pour a vat out. Behind it, a service door opens on the Executive Test Kitchen. The air there smells like a very expensive soup that nobody has ever tasted."],
"dungeon.tk_mk9.title": ["The Mk. IX Prototype"],
"dungeon.tk_mk9.blurb": ["You face the Test Kitchen's finest unfinished war machine: armed, hungry and still awaiting seasoning. (Elite)"],
"dungeon.tk_whistle.title": ["The Whistleblower"],
"dungeon.tk_whistle.blurb": ["A sous-chef hiding in the dry goods wants to tell you something about the Grand Chef."],
"dungeon.tk_boss.title": ["The Executive Test Kitchen"],
"dungeon.tk_boss.blurb": ["The Grand Chef's private kitchen. Her apron is spotless, and something about her chin is a little off."],
"dungeon.tk_boss.before": ["The Grand Chef turns from the stove wearing the same smile as every portrait in the Pantry. In ten years, it has never once creased.", "\"Ah, a taste tester. Welcome to the future of dining, which is efficient, and which does not need to be tasted.\""],
"dungeon.tk_boss.after": ["The Doppelganger collapses, and the Special Sauce goes with it, down a drain in the floor. Somewhere in the walls, a freezer door swings open on its own.", "Ten years of frost pour out, and with them a woman in chef's whites: upright, blinking and furious.", "The golems straighten up. \"Yes, Chef!\" they say, and this time they mean the right one."],
"challenge.tk_taste_panel.title": ["The Taste Panel"],
"challenge.tk_taste_panel.text": ["Four dishes are served to the panel. They want to see that you can field real, living units, not just soup."],
"event.tk_cannon_bay.title": ["The Cannon Bay"],
"event.tk_cannon_bay.body": ["The unfinished war machine fills the room: a cannon the size of a barn, fed by a conveyor belt of meatballs. A tired engineer in an apron asks whether you are here for the inspection or for the tour."],
"event.tk_cannon_bay.choice.0": ["Take the blueprints (and a tip)"],
"event.tk_cannon_bay.choice.1": ["Jam the cannon's gravy valve"],
"event.tk_cannon_bay.choice.2": ["Eat one of the test meatballs"],
"event.tk_cannon_bay.result.0": ["The engineer slips you the blueprints and a few coins. \"Please burn these,\" he whispers. \"After you're done selling them.\""],
"event.tk_cannon_bay.result.1": ["You twist the valve. The cannon coughs, sighs, and settles into a sulk. Your units feel sturdier in a kitchen that is slightly less likely to fire at them."],
"event.tk_cannon_bay.result.2": ["You eat the prototype meatball and feel much better, if slightly singed. The aftertaste has a blast radius."],
"event.tk_whistleblower.title": ["The Whistleblower"],
"event.tk_whistleblower.body": ["A sous-chef is crouched behind the sacks of flour, shaking. \"She doesn't taste the soup,\" he whispers. \"Not once, not in ten years.\"", "\"Chef ALWAYS tastes. Whoever is in that kitchen is not our Chef.\""],
"event.tk_whistleblower.choice.0": ["Take his notes on the impostor"],
"event.tk_whistleblower.choice.1": ["Share your rations with him"],
"event.tk_whistleblower.choice.2": ["Turn him in for the reward"],
"event.tk_whistleblower.result.0": ["He presses a stained notebook into your hands: habits, weak spots, and a very detailed list of everything the impostor will not eat. The list is everything. Your units hit harder."],
"event.tk_whistleblower.result.1": ["He eats like a man who hasn't had a proper meal in a week, and when he's finished he grips your hand. \"Thank you. Please be careful.\"", "\"The real Chef is down there somewhere. I know she is.\" You leave feeling better for having fed him."],
"event.tk_whistleblower.result.2": ["The guards pay you without a question. You pocket the coins and feel sick."],
"cutscene.reveal.1.speaker": ["The Doppelganger"],
"cutscene.reveal.1": ["Welcome to the Executive Test Kitchen, taster. Ten years I have worn this face and this apron, and not one Gourmand ever looked twice.", "They never looked at their Chef, you see. They only ever looked at the food."],
"cutscene.reveal.2.speaker": ["You"],
"cutscene.reveal.2": ["You never taste your own soup, do you?"],
"cutscene.reveal.3.speaker": ["The Doppelganger"],
"cutscene.reveal.3": ["...Tasting is inefficient. The orders from {capital} asked for golems and not for flavour, and the Special Sauce delivers golems.", "\"Delicious\" is the word I was given for it. I say it often, and I have never known what it means."],
"cutscene.reveal.4.speaker": ["The Doppelganger"],
"cutscene.reveal.4": ["Then look, if you must. I have worn this face for long enough."],
"cutscene.reveal.5.speaker": ["The Doppelganger"],
"cutscene.reveal.5": ["This is what was underneath. I wore her face for so long that I forgot my own, and there is nothing in here to taste with.", "Sit down, taster. I was told to serve you."],
"cutscene.wonder.1.speaker": ["The Grand Chef"],
"cutscene.wonder.1": ["Ten years in a freezer, and I can still remember exactly what this soup ought to taste like. Out of my way, and let me put it right."],
"cutscene.wonder.2.speaker": ["The Doppelganger"],
"cutscene.wonder.2": ["I do not know what to call myself. Your name was the only one I had, and now it is yours again.", "I have no face of my own and no name, and I cannot even taste what I make. I do not know what is left of me."],
"cutscene.wonder.3.speaker": ["You"],
"cutscene.wonder.3": ["After ten years, how will they know it's really you?"],
"cutscene.wonder.4.speaker": ["The Grand Chef"],
"cutscene.wonder.4": ["Not with a speech, and not with papers. With dinner.", "Stand back, the lot of you. Somebody fetch me flour and butter, and light the biggest oven in this building."],
"cutscene.wonder.5.speaker": ["The Endless Buffet"],
"cutscene.wonder.5": ["Before you sits a plain golden dish, large enough to share, and it smells of butter and warm bread.", "The first bite breaks the enchantment, all the way through the Endless Buffet.", "The chefs stand blinking at their own hands, and all across the Buffet a thousand golems lower their ladles."],
"cutscene.wonder.6.speaker": ["The Grand Chef"],
"cutscene.wonder.6": ["Come here, you. No face and no name, and I don't care a crumb about either. What you're called doesn't matter half as much as what you do.", "You wore my face for ten years and never once learned to taste. Well, today you start, and I'll give you something to start with.", "Take my old name: Escoffina. I was always prouder of the work than of the title, and that name could do with somebody making a fresh start in it."],
"cutscene.wonder.7.speaker": ["Escoffina"],
"cutscene.wonder.7": ["...Escoffina. I will try to cook honestly. I will try to be somebody worth the name."],
"freed_npc.escoffina": ["Escoffina. Apprentice. Second class, which is one class more than I had last month.", "Chef says what I am called matters less than what I do, so I am doing a great many dishes. It is a start.", "I made a sauce today. A real one. I tasted it. As me. It had too much salt.", "Everyone ate it anyway and said it was a good start. I did not know people could be so kind about salt.", "I have a face of my own now, and I am still deciding what to do with it. I am trying."],
}
quiz_questions = Array[Dictionary]([{
"a": ["Feeding the kingdom and protecting it", "Collecting the kingdom's taxes", "Inspecting the kingdom's dungeons", "Writing the kingdom's restaurant reviews"],
"correct": 0,
"q": "What are the Gourmands responsible for?",
"where": "sign.hub_main (Grand Pantry); sign.golem_oath; Basil's intro line"
}, {
"a": ["Food golems", "Very angry souffles", "Moats of cold soup", "Strongly worded casseroles"],
"correct": 0,
"q": "What do the Gourmands cook to guard the kingdom?",
"where": "sign.golem_oath; Basil's intro line; the gate signs"
}, {
"a": ["\"Yes, Chef!\"", "\"Maybe, Chef.\"", "\"Define medium rare.\"", "\"I'll check with the pancake.\""],
"correct": 0,
"q": "What does a golem answer to every order?",
"where": "sign.hub_motto; sign.golem_oath; sign.golem_rule at the gates"
}, {
"a": ["Nobody leaves hungry", "Everybody leaves tipping", "Nobody leaves without doing the dishes", "Everybody leaves with a doggie bag of golem"],
"correct": 0,
"q": "What is the Gourmands' promise to every guest of the Endless Buffet?",
"where": "sign.hub_main; sign.cake_menu; Basil's intro line"
}])
