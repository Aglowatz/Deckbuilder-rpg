[gd_resource type="Resource" script_class="ZoneStoryText" format=3]

[ext_resource type="Script" path="res://core/data/zone_story_text.gd" id="1_buf"]

[resource]
script = ExtResource("1_buf")
lines = {
"hud.objective": ["The Endless Buffet: the Grand Pantry is safe. Life does not come back after battles - sit down for a hearty meal, or walk back down the Path of the Gourmand."],
"ui.mini.body": ["Three courses in a row. Your life carries from one course to the next and nothing heals in between. Finish all three for a unique Gourmand card."],
"ui.mini.body_cleared": ["You already took the unique card from this freezer. You can still eat your way through the courses for gold and XP. Life carries over; nothing heals in between."],
"ui.mini.button": ["Open the door"],
"ui.exit.title": ["Walk back down the Path of the Gourmand?"],
"ui.exit.body": ["Leaving the Endless Buffet ends this visit. Town heals you fully; the roaming golems, sentinels and meatballs will be back next time. The buffet, as the name suggests, is endless."],
"fx.main_dungeon": ["CLOSED FOR HEALTH INSPECTION. The inspector went in on a Tuesday and has not been seen since. A lovely smell, though."],
"fx.heal_couch": ["You sit down to a hearty meal: roast something, a bowl of soup the size of a bathtub, and a roll that hugs you back. Life restored."],
"fx.heal_already": ["You are already full of life. The chef politely refuses to give you seconds. The chef is lying; there are always seconds."],
"fx.hit": ["BONK! A runaway meatball hits you right in the shins. (-2 life)"],
"fx.wake": ["You wake up face-down in a bowl of mashed potatoes at the Grand Pantry. Head Chef Odalys is holding a ladle and a very long receipt.", "\"You fainted into the gravy, dear. We fished you out. The dish duty fee is on you. Yes, Chef is what you say.\""],
"fx.chest": ["A hidden stash! Nobody tasted that one."],
"fx.bounce": ["BOING!"],
"fx.landed": ["Stuck the landing. In the sense that you are stuck to it a little."],
"fx.soup_fall": ["You fell in the gravy! Somebody fishes you out and sets you on dry ground. (-1 life)"],
"fx.soup_fall_log": ["Fell into the soup at %s - fished out at the last safe spot, 1 damage to zone life."],
"fx.gate_open": ["The golem steps aside. The way is open."],
"fx.pickup": ["Found:"],
"fx.pickup_again": ["You already took the one lying here. Come back on your next visit; the pantry restocks overnight."],
"fx.oven_done": ["Ding! A Hearty Pot Pie, golden and steaming, drops into your bag. The oven looks very proud of itself."],
"fx.oven_missing": ["The Grand Oven rumbles. \"A pie needs honey, basil and a ghost pepper. I am an oven, not a miracle.\""],
"fx.taste_good": ["Smooth, balanced, a touch of citrus. You nod like a professional. +life."],
"fx.taste_great": ["A transcendent sip. A tear rolls down your cheek. A critic somewhere gives it five stars. Big recovery!"],
"fx.taste_buff": ["Your palate sharpens. You can taste what the cheese had for breakfast. A little extra life for the visit."],
"fx.taste_tip": ["The judges are impressed and tip you for the privilege of watching. +gold."],
"fx.taste_spicy": ["Ghost pepper, hidden in the third spoon. Your ears ring. -1 life."],
"fx.taste_bland": ["Boiled water, a hint of ambition. The judges look at their shoes. Nothing happens."],
"fx.taste_broke": ["The station wants 8 gold. Your wallet is as empty as a diner at 4 a.m."],
"fx.fountain_1": ["You ladle some soup. Tomato with a hint of basil. Warm all the way down. +life."],
"fx.fountain_2": ["Second ladle: cream of mushroom, which is a little unfair to the mushroom. +life."],
"fx.fountain_3": ["Third ladle: minestrone, mostly noodles. You feel taller. +life."],
"fx.fountain_full": ["You ladle some soup. Delicious, but you are already stuffed to the brim."],
"fx.fountain_limit": ["The fountain's tank is dry for now. It refills on your next visit. Soup takes time."],
"fx.cookie_broke": ["The dispenser wants 5 gold. Fortune favours the people who bring change."],
"fx.cookie_crack": ["You crack the cookie open. A tiny paper slip falls out. It reads:"],
"fx.mend_done": ["Old Meatloaf is mended! He gets up, stretches, and sizzles a little."],
"prop.arch": ["THE PATH OF THE GOURMAND"],
"prop.dispenser": ["FORTUNE COOKIES"],
"prop.broken_golem": ["OUT OF ORDER"],
"prop.stage": ["DINNER IN A DASH!"],
"prop.freezer": ["THE WALK-IN FREEZER"],
"prop.kitchen": ["CLOSED"],
"prop.stew": ["THE MYSTERY STEW"],
"gate.ingredient.open": ["Brisket nods slowly. \"Go on in. Mind the cheese. It has opinions about being stepped on.\""],
"gate.ingredient.pass": ["Brisket sniffs the air, eyes closing in bliss. \"Saffron. Real saffron. Do you know how long it has been?\" He takes the threads with great tenderness and steps aside.", "\"Go on through. Tell the Cheddar Cliffs I said they are overdue for a good grating.\""],
"gate.ingredient.need": ["Brisket does not look at you. He looks over your head, at the horizon. \"I only open this gate for a pinch of saffron. Real saffron. It grows in the Candy Field. Ask a sous-chef.\"", "He sighs. \"Come back when your pockets are fancier.\""],
"gate.quest.open": ["Sir Loin raises his fork in salute. \"You mended Old Meatloaf, so you are a friend of the Pantry. The town is yours.\""],
"gate.quest.pass": ["Sir Loin inspects you. \"Old Meatloaf has been mended. Head Chef Odalys sends her thanks, and her orders, which are: let you in. Yes, Chef!\"", "He lowers his fork-lance. The gate swings open."],
"gate.quest.need": ["Sir Loin clanks to attention. \"HALT! Nobody enters Layer-Cake Town unless they have mended Old Meatloaf. Quest from Head Chef Odalys. Speak to her at the Grand Pantry. Yes, Chef!\""],
"gate.battle.open": ["Colonel Casserole tips his lid. \"A fair fight, well fought. The Pancake Plateau is open to you. Mind the syrup; it pools.\""],
"gate.battle.intro": ["Colonel Casserole bubbles ominously. \"Halt! This gate is guarded by a Colonel. I do not give passes. I do not take bribes. I take challengers in single combat, with cards.\"", "\"If you win, you pass. If you lose, you do the washing up. Both are honourable.\""],
"gate.battle.ask": ["Defeat Colonel Casserole in a card battle to open the way to the Pancake Plateau. Your life carries over as usual."],
"sign.hub_main": ["THE GRAND PANTRY", "Hub of the Endless Buffet. The Gourmands feed the kingdom and protect it.", "Nobody leaves hungry."],
"sign.hub_motto": ["TODAY'S SPECIALS", "- Feed the kingdom", "- Guard the kingdom (with golems)", "- Answer every order with \"Yes, Chef!\""],
"sign.exit": ["THE PATH OF THE GOURMAND", "(Town. Wipe your feet. We just mopped.)"],
"sign.heal_table": ["THE HEARTY MEAL", "Sit. Eat. Do not ask what the gravy is made of."],
"sign.vendor": ["DOLCETTA'S DESSERT & DECKERY", "Cards, cakes and a little something for the golem in your life. Mostly cards."],
"sign.oven": ["THE GRAND OVEN", "Honey, basil and one ghost pepper make one Hearty Pot Pie.", "Do not open the oven door to check. Do not."],
"sign.fountain": ["THE SOUP FOUNTAIN", "Three ladles per customer. The soup of the day is soup."],
"sign.golem_oath": ["THE GOLEM OATH", "We are the Gourmands: chefs of the kingdom.", "We feed the kingdom. We protect the kingdom.", "We cook food golems to guard it. They answer every order with \"Yes, Chef!\""],
"sign.cookie": ["FORTUNE COOKIES - 5 GOLD", "Each one holds a hint about a secret. Handle with care. The secrets are crumbly."],
"sign.old_meatloaf": ["OLD MEATLOAF", "Out of order. Needs sea salt and a black truffle. Please be gentle.", "- Head Chef Odalys"],
"sign.forest": ["THE BROCCOLI FOREST", "Please do not eat the trees.", "The trees say the same about you."],
"sign.quiz": ["THE COOKBOOK GAZEBO", "Lady Brioche asks 4 questions on the Gourmands and their kitchens. The answers are on the signs of the Endless Buffet."],
"sign.truffle_note": ["NOTE", "A black truffle was last seen near this tree.", "The tree was last seen near the truffle. They are inseparable."],
"sign.candy": ["THE CANDY FIELD", "Everything here is edible. Not everything is wise."],
"sign.studio": ["STUDIO 3: DINNER IN A DASH!", "Now taping: three tickets, one stove, zero patience.", "Live studio audience: a bowl of sprouts."],
"sign.taste_test": ["BLIND TASTE TEST - 8 GOLD", "Judges: a spoon, a larger spoon and a very patient cloche.", "Results may vary. So may your stomach."],
"sign.salt": ["THE SALT FLATS", "A pinch here. A pinch there. A pinch of sea salt for your troubles."],
"sign.butte": ["BUTTER BUTTE", "Step on the jelly pad. Mind the ceiling.", "(There is no ceiling. Mind the sky.)"],
"sign.pad_rule": ["JELLY PADS: HOW TO USE", "1. Step on.", "2. Boing.", "3. There is no step 3. There is only boing."],
"sign.river": ["THE GRAVY RIVER", "Thick, hot and entirely made of gravy.", "The only ways across: a crouton raft or the lazy susan."],
"sign.river_warning": ["WARNING: GRAVY", "Do not swim. Do not wade. Do not ask how deep it is.", "If you fall in, somebody will fish you out. It costs 1 life."],
"sign.raft_west": ["CROUTON RAFT FERRY", "Hop on when it docks. Ride. Hop off on the other side.", "Please keep arms and legs inside the croutons."],
"sign.susan": ["THE LAZY SUSAN", "The world's largest serving platter, slowly turning.", "Step on at one side. Step off at the other. Patience is a garnish."],
"sign.raft_east": ["CROUTON RAFT FERRY", "Eastbound and northbound. Please have exact change.", "(There is no change. It is gravy. Everything is gravy.)"],
"sign.bank": ["GRAVY BANK", "Welcome to the far side. The gates ahead are guarded by golems, as is the custom."],
"sign.gate_ingredient": ["THE CHEESE CLIFFS GATE", "Doorman: Brisket.", "Admission: a pinch of saffron."],
"sign.gate_quest": ["THE LAYER-CAKE TOWN GATE", "Warden: Sir Loin.", "Admission: a letter from Head Chef Odalys, proving Old Meatloaf has been mended."],
"sign.gate_battle": ["THE PANCAKE PLATEAU GATE", "Gatekeeper: Colonel Casserole.", "Admission: defeat the Colonel in a card battle."],
"sign.cheddar": ["THE CHEDDAR CLIFFS", "Sharp. Sharper. Do not lean on the walls. Do not lick the walls."],
"sign.cake_town": ["LAYER-CAKE TOWN", "Population: a lot of crumbs.", "Please do not bite the buildings."],
"sign.pancake": ["THE PANCAKE PLATEAU", "Syrup flows downhill. So do tourists."],
"sign.mini_dungeon": ["THE WALK-IN FREEZER", "Three courses. Mandatory. No leftovers.", "Please do not lock yourself in. (Somebody already has.)"],
"sign.main_dungeon": ["KITCHEN CLOSED", "FOR HEALTH INSPECTION", "Please come back when it is less educational."],
"sign.inspection_note": ["NOTE FROM THE INSPECTOR", "Found: one (1) very good smell, three (3) violations, and a door I cannot find the handle of.", "Back at lunch."],
"sign.stew": ["THE MYSTERY STEW", "Four ingredients, in the right order, tastes like victory.", "Read the recipe card. Cooking is a science. And a vibe."],
"sign.golem_rule": ["GATE RULES", "Golems stand guard. Golems ask nicely, once.", "Golems answer every order with \"Yes, Chef!\""],
"sign.cake_menu": ["TODAY'S CAKE", "Chocolate, vanilla and structural.", "Nobody leaves hungry. Nobody leaves without a slice, either."],
"sign.cheese_note": ["GROCERY LIST", "Cheese. More cheese. Something to put on the cheese. Different cheese.", "- a sous-chef, 3 weeks ago"],
"enemy.loaf": ["A meatloaf the size of a wardrobe, wearing a ketchup glaze and a frown. Has opinions about seasoning."],
"enemy.jelly": ["A lime gelatin sentinel with a spoon spear and a fruit cocktail soul. Wobbles when it thinks."],
"enemy.meatball": ["Pure momentum with a side of sauce. Nobody knows what it is running from. It is probably spaghetti."],
"enemy.casserole": ["A pot-bellied colonel with a lid for a hat and a ladle for a sword. Thirty years of service, forty years of cheese."],
"npc.odalys.intro": [
"Welcome to the Grand Pantry! I am Head Chef Odalys. Ladle in one hand, kingdom in the other.",
"We are the Gourmands, little one. We feed the kingdom and we protect it. Every plate is a promise. Every golem is a guard.",
"The golems are our soldiers. We cook them from the finest ingredients and they never, ever complain. They say \"Yes, Chef!\" to every order. Say it. Practise it.",
"The Endless Buffet runs on three rules: nobody leaves hungry, nobody double-dips, and everyone cleans their own plate. Dishes are not optional."
],
"npc.odalys.return": ["Back at my kitchen? Good. A Gourmand never stops stirring. What do we say? Yes, Chef."],
"npc.tarragon.intro": [
"Oh! A customer! A helper! A pair of hands! Sous-Chef Tarragon, the Head Chef's fetcher of things. I fetch. All day. It is a lot of fetching.",
"We are always out of something. Basil, honey, ghost pepper... the Pantry is a leaky bucket made of ingredients. Please, if you see any lying around, pick them up. I would be so grateful.",
"I once fetched a whole pig. It was the wrong pig. It is still angry about it."
],
"npc.tarragon.return": ["Any ingredients? Anything? I will take a single leaf of anything. I am not proud. I am hungry."],
"npc.dolcetta.intro": [
"Dolcetta Crumb, dessert dealer and card shark of the Grand Pantry. Cakes by day. Cards by night. Both by appointment.",
"Everything here is Gourmand-issue: baked, bottled and slightly haunted by the sugar. Strong cards. Bold cards. Cards that taste of victory.",
"I take gold, favours and sprinkles, in that order. Mostly gold."
],
"npc.dolcetta.return": ["Shop is open. The cards are fresh. The cake is for decoration. Mostly decoration."],
"quest.buf_pantry.offer": [
"Oh good, you can fetch! Wonderful! I mean, I am not saying I want you to fetch, I am saying fetching is a gift.",
"We need three ingredients, quick. They are scattered all over the Endless Buffet: truffles by the broccoli, salt by the river, honey up on the Butte. Pick up three and I will make it worth your while."
],
"quest.buf_pantry.active": ["Three ingredients, remember. The pantry is empty and the Head Chef is staring at me. Please hurry."],
"quest.buf_pantry.ready": ["You did it! Three whole ingredients! The Pantry is saved! Here, a little something. It is a card. It is soup. It is soup you can play."],
"quest.buf_pantry.done": ["The pantry is stocked. Until tomorrow. Then we start over. It is a lovely cycle."],
"quest.buf_pie.offer": [
"Do me a favour. I have a customer who wants a Hearty Pot Pie and the Grand Oven is feeling temperamental.",
"Bring me one, baked fresh. Honey, giant basil and a ghost pepper, straight into the Oven near the arch. Careful with the pepper. The pepper is not a team player."
],
"quest.buf_pie.active": ["One Hearty Pot Pie. Honey, basil, ghost pepper, the Grand Oven. I will be here. I have cake."],
"quest.buf_pie.ready": ["A pie! Golden and warm! The customer is going to cry. I am going to cry. Here is your reward. Thank you. Thank you."],
"quest.buf_pie.done": ["That was the best pie we have had in years. The oven wants a word with you, actually. It wants to say thanks."],
"quest.buf_mend.offer": [
"A word, if you please. Old Meatloaf, the oldest golem in the Grand Pantry, has stopped working. He is standing over there in two pieces and he has not said a word since Tuesday.",
"Fix him. Sea salt, to season his joints, and a black truffle, for his heart. Both are out there somewhere. Mend him and the Warden of Layer-Cake Town will let you into the cake district. Yes, Chef?"
],
"quest.buf_mend.active": ["Old Meatloaf is over by the west wall. Sea salt, a black truffle, and a bit of tenderness."],
"quest.buf_mend.ready": ["He is walking! He is sizzling! Old Meatloaf is back on duty! Here is your reward, and Sir Loin will honour your passage now. Well done, Gourmand. Yes, Chef."],
"quest.buf_mend.done": ["Old Meatloaf is the best golem in the kingdom. Do not tell the others."],
"npc.old_meatloaf.broken": ["Old Meatloaf is slumped on the floor, in two pieces, with crossed-out eyes. A note on his chest reads: SEA SALT AND A BLACK TRUFFLE. PLEASE BE GENTLE."],
"npc.old_meatloaf.fix": ["You season Old Meatloaf's joints with the sea salt and tuck the black truffle where his heart should be. He sits up slowly.", "\"...Chef?\" he says. \"Yes, Chef,\" you say, because it feels right. His eyes uncross."],
"npc.old_meatloaf.mended": ["Old Meatloaf stands guard with great dignity. \"Yes, Chef!\" he whispers. He says it to you. You are not a chef. He does not care."],
"npc.quiz.intro": [
"Ah, a student! Lady Brioche, Keeper of the Cookbook. I have read every recipe in the kingdom. Twice. The second time was for the footnotes.",
"Four questions about the Gourmands: who they are, what they cook, how their golems speak. Every answer is written on a sign somewhere in the Endless Buffet.",
"Answer well and earn gold, glory and the respect of a very old book. Answer poorly and earn a gentle, scholarly sigh."
],
"npc.quiz.return": ["Back to improve your score? Splendid. Practice makes perfect. Perfect makes me a little smug."],
"quiz.result.0": ["Zero. Remarkable in its way. Nothing for you. The signs are patient. I am slightly less so."],
"quiz.result.1": ["One. A pinch of knowledge, barely seasoned. Here is a small token. It is a thimble of encouragement."],
"quiz.result.2": ["Two. Half-baked. A fine place to start. Half-baked things can still be rescued."],
"quiz.result.3": ["Three! Nearly perfect. Perfect would make me suspicious. Take your reward and a warm roll."],
"quiz.result.4": ["FOUR! A perfectly risen set! You may now call yourself a Certified Gourmand, First Class. The reward is real. The certificate is imaginary."],
"quiz.repeat": ["Another round! The Cookbook pays a small fee for repeat scholarship."],
"quiz.not_passed": ["Not a pass. Walk the Endless Buffet, read the signs, and come back. There is no limit on attempts."],
"npc.minigame.intro": [
"*cue brass fanfare and a rimshot* WELCOME, WELCOME, WELCOME to DINNER IN A DASH! I'm your host, Chef Turbo Tartine, and tonight we are LIVE from a field of candy!",
"You may remember me from the old tapes: nineteen ninety-seven to two-thousand-three, the kitchen that moved faster than the cameraman. My catchphrase was an actual sound effect. A whoosh. People still do the whoosh.",
"My arch-rival, Chef Savannah Souffle, stole my signature dish: Spaghetti Surprise. The surprise was more spaghetti. She called it Spaghetti Deluxe. The nerve!",
"I also had a line of kids'-meal toys: the Turbo Tots, tiny plastic spatulas that spun. They were recalled. Not for safety. For spinning too well. That's a different kind of danger.",
"Tonight's show: ORDER UP! Six tickets, one counter, no mercy. Stack the dish in the right order before the timer dings. Rewards for performance, and a first-time bonus. The audience is ten sprouts and a very patient cloche. Let's COOK!"
],
"npc.minigame.return": [
"Back for another shift, champ? The cameras are always rolling. They are not. They ran out of film in two-thousand-three. Smile anyway.",
"Remember: the ticket is your friend. The ticket does not judge. The ticket is judging, but kindly."
],
"order.intro": ["Six tickets. Press the ingredient stations in the right order (click or keys 1-6) before the timer runs out. A wrong ingredient tosses the plate and costs time. Faster is better."],
"order.stations": ["Bun", "Patty", "Cheese", "Lettuce", "Tomato", "Fries"],
"order.dishes": ["The Plain Jane Burger", "The Cheese Please", "Garden of Eatin'", "Burger & Fries", "The Deluxe Dash", "The Turbo Special"],
"order.shouts": ["Order up! First ticket!", "Second ticket, and I do mean it!", "Garden salad! Light and leafy!", "Burger and fries, hot hot hot!", "The Deluxe! Hands moving!", "TURBO SPECIAL! Whoosh!"],
"order.win": ["THAT'S the way! You cook like you were born in a kitchen. The camera loves you. The camera also loves a clean counter."],
"order.first": ["Your very first shift on the show! Here is your bonus, free, no obligation. It is a scroll. Chef Savannah would call it Scroll Deluxe."],
"order.lose": ["Not quite a shift, champ. That is fine. Breathe. Re-tie the apron. The ticket rail is not going anywhere."],
"recipe.intro": ["A huge pot bubbles on a fire. Beside it hangs the recipe card: seven clues for the Mystery Stew. Choose four of the six ingredients and add them in the right order. Serve it when you are sure; the pot only tells you right or wrong."],
"recipe.ingredients": ["Carrot", "Onion", "Mushroom", "Paprika", "Leek", "Pumpkin"],
"recipe.clue.1": ["Exactly one of the Pumpkin and the Mushroom goes in the stew."],
"recipe.clue.2": ["The Carrot has been banned from the stew. Long story."],
"recipe.clue.3": ["The first ingredient is the Onion or the Carrot."],
"recipe.clue.4": ["The Leek goes in after the Mushroom (not necessarily right after)."],
"recipe.clue.5": ["The Paprika is never second."],
"recipe.clue.6": ["The Leek is never last."],
"recipe.clue.7": ["The Mushroom does not go in first."],
"recipe.hint": ["Start with what is banned and what must be present. Four of the six are in, two are out. Then place them one clue at a time."],
"recipe.solved": ["The stew thickens. The ladle hums. A small, heavy parcel rises out of the steam: the pot has given you its seasoning."],
"recipe.already": ["The stew sits perfectly seasoned. Nothing left to cook."],
"recipe.incomplete": ["The pot needs exactly four different ingredients before you can serve it."],
"recipe.wrong": ["The golem that tastes it gags politely. \"Chef, this is not it.\"", "The stew goes bland. The pot sighs. The pot has seen better cooks.", "A single sad bubble rises. It pops. That was all it had to say.", "\"Chef, with respect: no.\""],
"fortune.hints": ["A stash lies in the shade of the broccoli, in a loaf that has gone hollow.", "On the Butte, behind the butter, someone left a present for the brave.", "Candy is sweeter when it is hidden. Try the big jar in the south-east.", "Between the shakers on the salt flats, something shines.", "Cheddar tastes sharper from above. Take the lime jelly to the top.", "Behind a wheel of cheese, a smaller wheel of gold.", "At the summit of the pancakes, a tip: the syrup hides a treasure.", "In Layer-Cake Town, behind a cake: a cake of another kind."],
"npc.gate.hint": ["The golem stands firm."]
}
quiz_questions = Array[Dictionary]([{
"a": ["Feeding the kingdom and protecting it", "Collecting the kingdom's taxes", "Inspecting the kingdom's dungeons", "Writing the kingdom's restaurant reviews"],
"correct": 0,
"q": "What are the Gourmands responsible for?",
"where": "sign.hub_main (Grand Pantry); sign.golem_oath; Head Chef Odalys' intro line"
}, {
"a": ["Food golems", "Very angry souffles", "Moats of cold soup", "Strongly worded casseroles"],
"correct": 0,
"q": "What do the Gourmands cook to guard the kingdom?",
"where": "sign.golem_oath; Odalys' intro line; the gate signs"
}, {
"a": ["\"Yes, Chef!\"", "\"Maybe, Chef.\"", "\"Define medium rare.\"", "\"I'll check with the pancake.\""],
"correct": 0,
"q": "What does a golem answer to every order?",
"where": "sign.hub_motto; sign.golem_oath; sign.golem_rule at the gates"
}, {
"a": ["Nobody leaves hungry", "Everybody leaves tipping", "Nobody leaves without doing the dishes", "Everybody leaves with a doggie bag of golem"],
"correct": 0,
"q": "What is the Gourmands' promise to every guest of the Endless Buffet?",
"where": "sign.hub_main; sign.cake_menu; Odalys' intro line"
}])
