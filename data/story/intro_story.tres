[gd_resource type="Resource" script_class="StoryText" format=3]

[ext_resource type="Script" path="res://core/data/story_text.gd" id="1_st0ry"]

[resource]
script = ExtResource("1_st0ry")
awakening_lines = Array[String](["...Cold. Leaves in my mouth. Great start.", "I reach for my name. Nothing. Not even the shape of one.", "Two hands, one of them shaking. I'll start with the other one. ...And I'm not alone."])
beefcake_npc_intro_lines = Array[String](["NOBODY CROSSES THE GORGE WITHOUT A SPOTTER. I AM THE SPOTTER.","The bridge stays up by order of the regime and Chancellor Clench. Only iron matters! IRON! Also hydration!","YOU WANT THE CRANK? EARN YOUR TURN - TEN REPS OF PAIN!"])
beefcake_npc_victory_lines = Array[String](["...Oh no. Was I yelling? I was yelling. Sorry. That was the pre-workout talking, and it talks a lot.","Chancellor Clench locked Grandmaster Flex in the House of Gains. People whispered the old man never broke. I didn't whisper. I yelled. Sorry again.","The bridge is yours, friend. Stretch before you cross. Hamstrings are friends, and friends don't let friends pull one."])
beefcake_npc_defeat_lines = Array[String](["HA! The pump is still MINE!","COME BACK WHEN YOU CAN LIFT! THE BRIDGE STAYS UP - FINALLY, SOMETHING THAT HOLDS ITS FORM!"])
gourmand_npc_intro_lines = Array[String](["TASTE IT. TASTE IT! The Special Sauce is in everything. My soup. My tea. My SOUL.","The pantry is closed by order of the Grand Chef. The key stays on my apron. For the war effort!","You want in? Beat me first. Yes, Chef! No, YOU, Chef!"])
gourmand_npc_victory_lines = Array[String](["The simmer let go. The sauce let go. Plain bread. No sauce. I could weep. I am weeping.","The Grand Chef stopped tasting her own sauces. The real one ALWAYS tasted. Same face. Ask yourself who was wearing the apron.","The Test Kitchen is at the far end of the Buffet, and it was never making casserole. Take a biscuit. Take two. Heroes need carbs."])
gourmand_npc_defeat_lines = Array[String](["Under-seasoned. NEXT!","The pantry door stays shut until you learn to cook. Consider this a closed-course meal."])
refusemancer_npc_intro_lines = Array[String](["...the green is hungry... the green is HUNGRY... nothing goes to waste...","The Rot keeps this path for the Rotheart. Turn back. Turn back. Turn... into compost.","If you will not leave, the hungry green will keep you. Forever. Very nicely. Like mulch."])
refusemancer_npc_victory_lines = Array[String](["Oh. Oh no. Did I thorn at you? I'm so sorry. The Rot speaks very softly, right up until it doesn't.","The Rot took Archdruid Compostella first, at the Rotheart, deep in the Verdant Dump. Everything else grew out from her.","The path is clear. Go gently in there. And if you see a raccoon, say hi. They're very good boys."])
refusemancer_npc_defeat_lines = Array[String](["...the green is patient... it has all the time in the world... and so does the garbage...","...come back... the green can wait... it has nowhere to leaf..."])
necrocrat_npc_intro_lines = Array[String](["Halt. This checkpoint requires a permit. Permits are not issued. Please take a number.","Your number is zero. It is always zero. Now serving: nobody.","The authorization is valid. Policy says I must stop you. I have read all of the policy. Twice."])
necrocrat_npc_victory_lines = Array[String](["...I can hear my own thoughts again. I think I was Pending for a decade. Old habits die hard. Unlike me.","{villain} did not corrupt us. He used our own rules: a perfectly valid transfer of authority, notarized and filed.","The Hall of Final Approvals is at the top of the D.N.A. Go carefully. Or fill out a form. Ideally both."])
necrocrat_npc_defeat_lines = Array[String](["Application denied; reapply in ten to twelve centuries. This is our express service.","Not yet, then. Take a number. It is still zero."])
equipment_vendor_intro_lines = Array[String](["Security Protocol One: assess the customer's gait. Adequate - you may approach at your current level of walking.", "Bertram Beetsworth, Assistant TO the Regional Merchant. The TO is load-bearing.", "Everything on this rack is inventoried and oiled under Security Protocol Seven. Protocol Seven is need-to-know. You do not need to know.", "Do not reach for the drawer. Its contents are classified, and so is your interest in them."])
equipment_vendor_return_lines = Array[String](["A return customer strengthens the economy and my employee-of-the-month case file. Please look satisfied for the record.", "Fact: the beets came in early this year. The bear has been informed. We have an understanding. I do not ask why it is here."])
graveyard_intro_lines = Array[String](["The stones here were stacked by hands that stopped moving a long time ago.", "Something under the cairn is still keeping count of its turns. It has been keeping count since before {villain} came.", "Touch it, and it will not stop counting until one of you does."])
graveyard_victory_lines = Array[String](["The counting stops. For now.", "Whatever was keeping time down there has nothing left to spend it on.", "The stones are just stones again. Take what it was guarding."])
graveyard_defeat_lines = Array[String](["It is still counting.", "Come back when you have more turns to spare than it does."])
quest_dialogue = {}
texts = {
"still.wake": ["You wake in a forest clearing with leaves in your hair.", "A faint glow of four colors fades from your hand, like a thought you almost had.", "Beside you kneels someone hooded, very still, as if they have waited a long time."],
"still.flex": ["You watch Grandmaster Flex enter the throne room in his prison rags. No one speaks.", "You hear him breathe in, slow and even. Ten years without iron have left him thin.", "Before you, the ruler of the House of Gains takes one step back."],
"still.doppel": ["You watch the chef's perfect smile slip away with her face.", "Beneath it, you see a shifting shadow in a spotless white coat.", "Behind the shadow, you see the unfinished war machines standing still."],
"still.approval": ["You hear the great DENIED stamp crack. For the first time in the Department's long afterlife, it does not come down.", "Forms rise around you. Across the Department, a thousand clerks look up from their desks.", "Somewhere nearby, you hear a pen stop scratching."],
"still.rotheart": ["You see light pour through the splitting Rotheart.", "Before you, the purple vines wither. At the heart of the wound, the Archdruid kneels, free and breathing.", "You watch wildflowers follow the light outward through the Dump."],
"still.primm": ["You hear the mirrors crack one by one. For the first time in ten years, {villain} sees himself in them.", "Above the small kingdom, you see a tired man kneeling without his crown or his perfect smile.", "You stand in the light pouring through the broken glass."],
"still.reunion": ["In the Capital's square, you watch the leaders of the four Paths clasp hands. Several people cry.", "Above you, four banners share one crowded pole.", "At the crowd's edge, you see a hooded traveler smile, leaves still in their hair. There is always another path."],
"start.gate_title": ["The Forgotten Cave"],
"start.gate_prompt": ["A cold draft rises from the dark. It smells of old stone and older water. The stranger said the town is on the other side. Go in?"],
"prologue.rescuer.1": ["Easy. Stay down. Hands like ice, pulse like a rabbit's. We'll fix that later.", "Keep your voice low. We are not the only ones in these woods tonight."],
"prologue.wanderer.1": ["I don't know this place. I don't know my own name. ...Who are you?"],
"prologue.rescuer.2": ["A friend. That's all I can give you, and it's already more than is safe.", "Can you still fight, still draw on the Paths? Hold out your hand like you used to... never mind, just your hand."],
"prologue.wanderer.2": ["...I feel them. All four, faintly. Like voices through a wall."],
"prologue.rescuer.3": ["Faint will do - it has to. Those torches on the ridge are looking for us.", "Tell me: which Path resonates the strongest within you?"],
"prologue.rescuer.4": ["That one, then. Hold on to it, and it will hold on to you.", "Behind me is the Forgotten Cave. Follow it all the way through to {town}. Someone there will be waiting for you.", "Hear that? They're close. I'll draw them off the other way. They know my face; let them chase it.", "So you go on alone. Don't thank me. Thank me when you're somewhere with a roof. Go!"],
"prologue.wanderer.3": ["...Gone, toward the torches. I never even asked their name."],
"prologue.self_talk": ["The trees close up that way. The cave, then.", "No point getting lost twice in one day. Back to the cave.", "Whatever is waiting for me, it's through that cave.", "Torches that way, cave this way. I'll take the one that isn't looking for me."],
"memory.title_format": ["Fragment %d of 4: %s"],
"memory.hint": ["E / click: continue"],
"memory.1.title": ["Warmth"],
"memory.1.intro": ["You're pale. Sit, sit. Something came back to you, didn't it?", "Tell me. All of it, however small."],
"memory.1.fragment": ["Light. Four colors of it, warm as bathwater, spilling across a ceiling I can't quite see.", "A woman is humming. A tune with no words, rising and falling like breathing.", "A hand rests on my head. Gentle. Certain. It smells of lavender and woodsmoke.", "Then the light thins, like breath on glass, and I am back."],
"memory.1.after": ["...A lullaby. That tune is from the old days. From the court. Few remember it, and fewer hum it.", "Eat some pie. Don't ask me why my eyes are wet.", "And look at you. With a zone free, the corruption's grip on the land is slipping, and it is slipping off you with it.", "You should be able to carry a second Path now. Go on, try it at the Deck Station."],
"memory.1.announce_title": ["A Second Path Opens"],
"memory.1.announce_body": ["With the first zone free, the corruption smothering your gift has weakened. Your decks may now use two Paths, and dual-Path cards can finally be played."],
"memory.1.announce_line": ["Decks may now use two Paths."],
"memory.2.title": ["The Cells"],
"memory.2.intro": ["Another one. Don't hide it behind your teacup. Say it."],
"memory.2.fragment": ["White rooms. White light that never changes with the hour.", "Glass on every side, and faces behind it in white coats, taking notes.", "They never use my name. They call me 'the Subject.' They say 'again.'", "Again. Again. Again.", "I wasn't lost. I was kept."],
"memory.2.after": ["Glass, and coats, and 'again.' So that is where you have been.", "You have earned the truth. I have been keeping more from you than I should.", "There is a resistance in this kingdom, and I am its contact in {town}. Wren leads it, from a hideout in the Capital.", "I wasn't sure I could trust you before. I am now."],
"memory.3.title": ["The Coup"],
"memory.3.intro": ["You're shaking. Sit. Slowly now."],
"memory.3.fragment": ["A throne room at night. Candles guttering, banners with four colors woven as one.", "A man in white and gold kneels before the king. Soft voice. Then he stands.", "Hands on my shoulders. Two people pushing me behind them, toward the dark.", "I know that man's face. I have always known it. {villain}."],
"memory.3.after": ["A man in white and gold, kneeling, and then standing. And a lab with glass on every side.", "I know that glass, because I helped to blow it. I founded the study of the Paths, long ago, for the best of reasons.", "{villain} took my work and turned it into a cage. My best student kept the lab running for him. And I ran.", "I have been hiding here ever since.", "That is my secret. Now you hold it, the same as I hold yours."],
"memory.4.title": ["A Name"],
"memory.4.intro": ["There is something in your face today. The look of someone who has been handed a key. Tell me."],
"memory.4.fragment": ["A boy of eleven, in a coat too fine for the cold. Someone calls across a courtyard: '{prince}!'", "I turn. A woman's voice. A man's voice. The {royal_house} crest on every door: four signs in a ring.", "{prince_full}. The son of the king and queen. Presumed dead.", "That is who I am."],
"memory.4.after": ["{prince}. {prince} {royal_house}. I met a boy once at court, hiding behind his mother's cloak, who asked me why tortoises carry their houses.", "I told him, 'So we are never far from home.'", "And I knew. The Warden opens that tunnel for one family only. I knew the moment you walked out of it, and I was too frightened to say so.", "Four signs in a ring. The same as on my stick. I have carried it for ten years and told nobody why.", "And my lab, my life's work, was used on that boy. Forgive me, if you ever can."],
"memory.4.reply": ["There is nothing to forgive. You gave me a bed and pie when you thought I might be a spy."],
"memory.4.after2": ["...Then let us make the kingdom a home again, {prince}."],
"memory.4.intro_known": ["You have the look of someone who was told something he did not want to hear. {villain}?", "Sit. Tell me what he said."],
"memory.4.after_known": ["So he knew you from the first. He told you, and you came to me for the rest.", "I knew too, dearie. The Warden opens that tunnel for one family only. I knew, and I was too frightened to say it.", "So hear it from the one who held your hand at court: you are {prince_full}, and I am so sorry for what was done to you in my name."],
"town.elder.stage.0": ["Eat. Rest. Mind the questions you ask out loud, dearie. This town has ears.","And stop staring at my stick. Four little carvings in a ring, older than you, and none of your business."],
"town.elder.stage.1": ["You are warmer than you were. Don't mistake me, dearie, I am still watching you. The watching is free.","My pie recipe is pinned by the door, in my own hand. Round letters, careful loops. Copy it if you like. Smudge it and I will know."],
"town.elder.stage.2": ["Somebody in the square says you have a look of the old court about you. That is no prince, I told them. That is a damp young man with good posture.","And if you meet Wren in the Capital, tell her my pie is still the best thing in the kingdom. She'll argue. She'll be wrong."],
"town.elder.stage.3": ["I have told you the worst of me. The rest is easy, by comparison.","Go on, dearie, the next zone won't free itself. At my pace, we'd have to outlive the regime."],
"town.elder.stage.4": ["{prince}. I keep wanting to curtsy. My knees have voted against it.", "Go on, the kingdom is waiting. The pie has less patience."],
"town.elder.known_early": ["{prince}. {villain} let it slip to you, didn't he, that smug man. I had hoped to tell you myself.", "Sit. When you are ready, the memories will come, and I will be here. With pie. Obviously."],
"tutorial.warden.before": ["...Hm. Woken. For this. Another of the little scavengers, I suppose.", "...No. Not that. You smell familiar. Like old stone, and cold nights, in a house I used to keep.", "The house does not open for just anyone. ...Show me."],
"tutorial.warden.after": ["...Yes. The old walls do not lie. The spring at the end ran once. You would not remember.", "Go. The house is yours to leave. Someone is waiting at the far end with a kettle on."],
"cave_mouth.maren": ["So. You're the one they sent through the old tunnel. Kettle's been on since noon.", "I was told someone would come past the dry spring and that grumpy Warden. Nobody mentioned I'd need to wring them out.", "This isn't trust, dearie. You could be anyone's spy, and whoever pushed you into that tunnel is reckless. I don't like reckless.", "But a body in that state needs a bed, and I have far too much pie. Welcome to {town}. Questions later."],
"cave_mouth.wanderer": ["...I don't remember who I am. Not sure I'm worth the bed."],
"cave_mouth.maren_end": ["Hm. Then we start with tea and pie and work up from there.", "First, get yourself known. Say hello to Sable, Tilly and Pip on the square, and buy a card from Sable. Then come back and knock."],
"start.tunnel": ["A narrow gap in the old treeline - easy to miss, easy enough to slip through, if you're not afraid of a shortcut."],
"town.name": ["{town}"],
"town.elder.first": ["Up and walking. Good. I am Elder Maren, dearie, and this is {town}, where the four Paths used to meet, and argue, and borrow each other's pans.","Ten years ago {kingdom} was whole. Beefcakes made the energy, Gourmands fed us, Necrocrats minded the dead, Refusemancers hauled the waste and grew the crops.","Then {villain} took the Paths, one by one, and set his rulers over them. Every road out of town has a gatekeeper now: a bridge, a barrier, a pantry door, a wall of thorns.","Beat a gatekeeper and its road opens. Buy cards from Sable, fix your deck at the Deck Station, and come back to me for pie. Not answers. Pie."],
"town.elder.return": ["The roads are waiting, dearie: the Gainlands, the Buffet, the D.N.A. and the Dump. One zone at a time.","You could still be anyone's spy. I have been wrong about people before. Once. In 1987."],
"town.elder.idle": ["Still here, dearie? The roads won't walk themselves. Well. Some of them would, if {villain} let them.","The pie on the sill is cooling, dearie. Unlike you, it knows when to wait.","If you're looking for advice: eat something. If you're looking for more advice: eat something else.","I've given you all the answers you need for now, dearie. Further questions require fieldwork.","Mind the fountain, dearie. People throw wishes in it. Most of them are mine.","Off you go, dearie; I'll be here. I'm dependable at a speed you can barely measure."],
"town.elder.idle.1": ["One zone free and back for pie already. Fine. One slice per zone, dearie. Those are the rules now.", "Three roads still shut. I'd go myself, dearie, but I'd arrive next spring.", "The square sang last night. Badly. Best thing I've heard in ten years. Don't you dare tell them."],
"town.elder.idle.2": ["Two zones free. The square's louder now. I complain about it every morning and mean none of it.", "Halfway, dearie. I'd say I'm proud of you, but then you'd stop trying.", "Auntie Alembic keeps asking after you. I tell her you're busy. For once it's even true."],
"town.elder.idle.3": ["One Path left under {villain}'s thumb. The whole town is holding its breath. It's murder on my knees.", "Three zones free, dearie. Finish the fourth before my pie goes stale. That gives you about a week.", "You walk like somebody with somewhere to be now. I preferred the damp young man. He visited more."],
"town.elder.idle.4": ["All four Paths free, and {villain} still sitting in his castle. Go and knock, dearie. Loudly.", "The roads are open. Even the tortoises use them. I passed one this morning. Barely.", "Eat something first. Then the castle. Nobody topples a tyrant well on an empty stomach."],
"town.elder.progress.1": ["One zone free. Hm. And the old cottage at the end of Champions' Road has started cheering at night. From the cellar. I am choosing not to ask."],
"town.elder.progress.2": ["Two zones free. Auntie Alembic has opened her shop on the square, the Alchemist's.","She asks for your leftovers. From her, that is a compliment."],
"town.elder.progress.3": ["Three zones free. Only one Path left under {villain}'s thumb. I will not say what I'm feeling. I will say it is a lot of feelings."],
"town.elder.progress.4": ["All four Paths are free. {kingdom} is whole again, or nearly. And up in his castle, {villain} is counting what he has left.", "Rest. Then we finish this."],
"town.guard": ["Hm. You came back. Wrote it in the notebook: 'came back.' Best two words I know.","Gate stays open. Always is. My girl's still up that road somewhere. In case."],
"town.guard.capital_offer": ["Hm. That road. The Capital. You want to know why nobody comes back.", "Four Paths kept that city alive. Beefcakes ran the lights, Gourmands the kitchens, Necrocrats the graveyards, Refusemancers the bins. {villain} chained all four.", "So now it's Blackout, Famine, Restless Dead and Clutter up there. Dark streets, slow legs, no food that heals, rubbish in your deck.", "You could walk in today. You would not walk far. Free the four zones: each one you free turns one service back on.", "My girl Isla went up that road eight years ago. If you see her... tell her the gate is still open."],
"town.guard.capital_active": ["Hm. Services still broken. Count them on the board by the road.", "Hm, each freed zone restores a service and makes the castle less frightening. My knees remain a local problem."],
"town.guard.capital_done": ["Hm. All four zones free. The lights are on up there. I can see them from here.", "Go on. Knock on that castle door. Hard. And if you see Isla... I'm still watching the road."],
"capital.castle.warning": ["The castle door is cold to the touch. With the city's services still broken, whatever waits inside will have every advantage.", "You can go in. You probably should not. Yet."],
"gate.beefcake.freed": ["You did it. Grandmaster Flex is out. He made me stretch for forty minutes. I cried twice. Good tears.","The bridge stays down now, but I still oil the crank every morning. Maintenance is how I say sorry.","Want to spar? Gently. I'll spot you. I'm a spotter. ...I'm SO glad I can say that quietly."],
"gate.necrocrat.freed": ["The afterlife is processing again. Agnes says the queue moved four whole numbers yesterday. We had cake.","I have a new stamp. It says HELPED. I have used it nine times. I am counting.","You may challenge me again, if you like. No permit required. That one is my favourite rule."],
"gate.gourmand.freed": ["She's back. The real Grand Chef. She tasted my soup and said 'more salt' and I have never been so happy.","The pantry door stays wide open, and people come in for biscuits. At last, a proper open-door pastry.","A friendly duel? For old times' sake. Loser washes the ladle. It is a very big ladle."],
"gate.refusemancer.freed": ["Archdruid Compostella is herself again. She hugged me. She smells like rain and a little bit like compost. Perfect.","Most of the thorns are gone; I keep one in a pot. It's behaving, but I'm not ready to let it meet the curtains.","Want a practice round? I promise not to thorn at you. Much. The raccoons are judging, so be nice."],
"gate.beefcake.blocked": ["The bridge is drawn up on the far side of the gorge. Somebody very large is standing by the crank."],
"gate.beefcake.cleared": ["Brick Bronson cracks his knuckles, grabs the crank, and lowers the bridge with one arm. Show-off.", "The planks thump down across the gorge. The Gainlands are open."],
"gate.necrocrat.blocked": ["The barrier is down. A sign with a stamp on it says the road needs a permit. Nobody has ever been issued one."],
"gate.necrocrat.cleared": ["Prudence Pallor stamps a permit, hands it over, and files the original in triplicate.", "The barrier creaks up. The road to the D.N.A. is open."],
"gate.gourmand.blocked": ["An enormous pantry door blocks the lane. Locked. The keyhole is the size of a dinner plate."],
"gate.gourmand.cleared": ["Chef Fennel Gravois hands over a key the size of a ladle. It turns with a satisfying clunk.", "The great pantry door swings open. Somewhere beyond, something smells incredible."],
"gate.refusemancer.blocked": ["A wall of thorns has swallowed the forest path. It looks like it is breathing."],
"gate.refusemancer.cleared": ["Moss Mulligan lays a hand on the thorns. They sigh, brown, and crumble into leaf mould.", "The forest path to the Verdant Dump is open."],
"town.vendor.first": ["Well met, {wanderer}. Sable, darling: seller of cards, and of very good stories about cards.","You start with plain neutral cards. The Paths are where the power is. Browse, buy, then put it all to work at the Deck Station.","Where do my cards come from? The past. Next question. My prices are fair, mostly. {villain}'s taxes are not."],
"town.vendor.return": ["Back, darling? The cards are honest; the misprints simply have a more adventurous relationship with spelling."],
"town.item_vendor.first": ["Hi! Hello! You look like you need supplies! Tilly Tonic! I'm teal today, which means the new batch works!","Everything here is one use in a fight! Equip what you buy on your Character screen, then use it on your turn!","Probably not on yourself! Unless it's a healing one! I tested the healing one! I'm fine! I'm green! I'm usually green!"],
"town.item_vendor.return": ["Potions and charms, back for more! Equip them on your Character screen for fights - maybe skip the orange one until I stop matching it!"],
"storeroom.locked": ["The door rattles. Something behind it is muttering about a receipt.", "Whatever it is, it is not open for business."],
"storeroom.before": ["OooOOOooo. Who disturbs the store room? We are VERY busy haunting it.", "Ninety years ago the three of us bought one lantern between us. It never worked. Tilly's great-grandmother said: no receipt, no refund.", "We waited, died, and kept waiting. Your haunting is very important to us."],
"storeroom.wanderer": ["...You're haunting a shop over a lantern."],
"storeroom.challenge": ["A FAULTY lantern. Four copper. With ninety years' interest, it is still four copper. We did the maths. We had time.", "Nobody comes in until it is refunded. Or until somebody beats us at cards. Everyone settles everything with cards round here."],
"storeroom.after_win": ["...Fine. FINE. You play like someone who kept the receipt.", "We'll go. The chapel belfry has a lovely draught and nobody has complained about it in centuries.", "Tell Tilly the lantern's on the top shelf, still broken after ninety years of nightly checks. We were thorough, if poorly lit."],
"storeroom.after_loss": ["Ha! No refund, no entry. Come back with a better deck. Or a receipt. Ideally both."],
"storeroom.cleared": ["Just shelves now. And one broken lantern on the top shelf, exactly where they said it would be."],
"town.equipment_vendor.too_early": ["Halt. Equipment is issued on referral only. Security Protocol Two. Elder Maren does the referring.", "Bring Elder Maren's blessing. Better posture is appreciated but cannot be accepted in its place."],
"quest.armory.start": ["Elder Maren sent you. I could tell from your gait. It says 'referred'. Congratulations: your file is now thick enough to be a file.", "Before I issue gear, protocol asks for exactly one thing: win a fight. Any fight. A roamer, a gatekeeper, a dungeon, the arena. I will know.", "Then come back and I will hand you something pointy."],
"quest.armory.waiting": ["One fight won. That is the whole requirement. So far I count zero. I am very good at counting to zero.", "Go win a fight. Any fight. I will be here, guarding the drawer."],
"quest.armory.done": ["One fight, won. Stamp. Stamp. Stamp. Three stamps is the correct number of stamps.", "Your Starter Blade. The first unit you play each battle hits a little harder. Do not run with it.", "And all five equipment slots are yours now: helm, weapon, armor, boots, relic.", "The good stuff is rarer, and you can only wear so much of it until you level up. Protocol. Fact: bears do not wear helms. Bears are wiser than us."],
"town.hidden_vendor": ["You found the chest, so I suppose you've earned a look. Epic and Legendary goods, quiet prices.","{villain}'s tax collectors don't know this stall exists. Let's keep it that way. Shh."],
"town.arena.name": ["The Undercroft"],
"town.arena.locked": ["A cellar hatch beside the old cottage, chained shut. Someone has scratched two little crossed swords into the wood.", "Whatever is down there is not open for business. Yet."],
"town.arena.announce": ["Word around the square: the abandoned cottage at the end of Champions' Road has started roaring at night.", "From the cellar. Somebody brave should check the hatch. Somebody like you."],
"town.arena.intro": ["WELCOME TO THE UNDERCROFT, CHAMPION - ANNOUNCER GRAND BELLOWS, KEEPER OF THE SAND! Mind the third stair; it bites without an introduction.", "For a thousand years the four Paths settled their rivalries in the old arena, until {villain} chained the doors. SO WE DUG.", "Since you freed a zone, THE RING IS OPEN! Battles and puzzles, tiers one to three, with prizes: ring-exclusive gear, gold, essence!", "First clears pay out. Repeats are for GLORY. And for snacks. I brought snacks."],
"town.arena.return": ["THE SAND IS HOT AND THE CEILING IS LOW! Pick a fight, champion - the crowd is mostly my echo, and he agrees with EVERYTHING!"],
"town.alchemist.name": ["Auntie Alembic's"],
"town.alchemist.locked": ["The door of Auntie Alembic's is bolted. A note is pinned to it in green ink, in what looks like four handwritings at once:", "'CLOSED UNTIL TWO ZONES ARE FREE. {villain} TOOK MY CAULDRON. I AM BREWING IN THE SINK. THE SINK IS COPING. - A.'"],
"town.alchemist.announce": ["With two zones free, a cauldron bubbles to life in {town}. Auntie Alembic's is open! Bring essence. Bring courage. Bring a fire blanket."],
"town.alchemist.intro": ["Auntie Alembic. Alchemist. Do not touch anything. ...Fine. Touch that one. It likes you.", "Whenever you collect more copies of a card than you can carry, the extras turn into essence of that card's Path.", "Bring me ALL the essence of two Paths, plus a little gold, and I will brew you a card of BOTH. Random. Unpredictable. Occasionally on fire.", "They say there was one spring once, the Wellspring, that fed all four Paths. Everything mixed at the source, dear. That is the kingdom I brew for."],
"town.alchemist.return": ["Essence of two Paths and a little gold, dear; faith helps with the waiting. Lower your voice around the red flask - it takes things personally."],
"town.alchemist.need_more": ["You do not have enough essence of two different Paths yet. Collect more duplicates, then come back. The cauldron will wait.", "The cauldron is patient. Please don't confuse patience with having had lunch."],
"zone.complete.beefcake.title": ["THE GAINLANDS ARE FREE!"],
"zone.complete.beefcake.body": ["Chancellor Clench is down, Grandmaster Flex is back, and the weights are in the gym. The mills turn at a sensible pace; Gary lifts with a spotter."],
"zone.complete.gourmand.title": ["THE ENDLESS BUFFET IS FREE!"],
"zone.complete.gourmand.body": ["The Doppelganger is exposed, the Special Sauce is recalled, and the real Grand Chef is back in her kitchen. The golems guard plates again. Nobody leaves hungry."],
"zone.complete.necrocrat.title": ["THE D.N.A. IS FREE!"],
"zone.complete.necrocrat.body": ["Mortimer Grimsby is removed from office, and the vacancy passes by policy to the senior-most applicant on file: Agnes Overdue. The Department of Necrotic Affairs belongs to itself again, and it is terrified by the freedom."],
"zone.complete.refusemancer.title": ["THE VERDANT DUMP IS FREE!"],
"zone.complete.refusemancer.body": ["The Rotheart is silent. The vines are only vines again. The Archdruid is herself and deeply apologetic about the barn. The land starts, slowly, to heal."],
"zone.complete.count": ["%d of 4 zones free"],
"town.objective": ["{villain} rules the four Paths through his rulers. Beat each road's gatekeeper, then free its zone by beating the boss of its main dungeon.","The imperial road to the Capital is open from the start, but its broken services will flatten you. Free the zones first. Gatekeeper Brannoch can explain."],
"town.objective.free": ["All four Paths are free. Buy cards, test yourself in the Undercroft, and brew something dangerous at the Alchemist's."],
"town.elder.postgame": ["{villain} is gone, and the Paths are shouting at each other in the street again. I have never been so glad to be annoyed.", "The Capital is open to everyone now, and your decks may mix any Paths you like. Go and see what you can make of it, dearie. Then come home and eat."],
"town.objective.postgame": ["{villain} has fallen and the Paths are free to mix. Build decks from three or four Paths at once, try the Alchemist's tri-Path crafting, test yourself in the Undercroft and visit the changed Capital."],
"town.arena.unlock_line": ["Something under the old cottage at the end of Champions' Road is open for business. Listen for the crowd."],
"town.alchemist.unlock_line": ["Auntie Alembic's, the Alchemist, is now open in {town}. Bring your leftovers."],
"town.pack_vendor.name": ["Foil Fenwick"],
"town.pack_vendor.title": ["Fenwick's Sealed Goods"],
"town.pack_vendor.first": ["Psst... hear that crinkle? That's possibility, with excellent packaging.", "Foil Fenwick, Purveyor of Sealed Goods - packs only. Open one where the light's good; if I cry, I want to see what I'm crying about.", "How it works: whenever a Path's final dungeon falls, that Path sends me its pack. Don't ask how. Lots of foil, no paperwork. The Necrocrats find it upsetting.", "Free a zone and I stock its pack. Until then it's just a rumour in a wrapper. Browse! Sniff, if you like. I won't judge. I sniff."],
"town.pack_vendor.return": ["Browse, sniff, but don't shake the packs. ...A little, then; I'm a collector, not a strong person.", "A repeat customer... shh, listen to that foil. You understand me, and I don't know what to do with that."],
"town.pack_vendor.prismatic_reveal": ["Fenwick pulls a curtain aside. \"The back room. Prismatic packs: every Path in one wrapper.", "They only exist because the Paths are talking to each other again. Terrible for my exclusivity. Wonderful for my sales.\""],
"pack.vendor.bought": ["Crinkle! You've made a wrapper very happy.", "Sealed, signed, and slightly warm.", "No refunds on bad luck. Bad luck is non-transferable.", "It wants to be opened. I'm trying to respect its wishes without getting involved."],
"pack.vendor.poor": ["Gold, friend. The foil does not accept good intentions.", "Not enough gold. The wrapper can tell."],
"pack.vendor.locked": ["Not yet. That one is still a rumour in a wrapper."],
"town.tailor.name": ["Pip Threadwell"],
"town.tailor.title": ["Threadwell's Hats & Hems"],
"town.tailor.line": ["Try everything on. The mirror is polite; I am not."],
"town.tailor.first": ["Hat! Hat. Marvellous head. Hold still: your left shoulder is a size braver than your right.", "Pip Threadwell, Haberdasher and Hemmer! Everything in here is purely cosmetic. It will not make you stronger, braver or better at card games.", "It will make you LOOK all three, which is eighty percent of the job. Try anything on in the little mirror first: hats up top, cloaks down the back, dye on both.", "Free zones and climb levels, and I will find grander stock. I hear rumours of rarer pieces, too. People tell hatmakers everything."],
"town.tailor.return": ["Back to change your mind and your hat? Excellent - one of those I can fit properly.", "My favourite head, in the nick of time! Brim, brooch or billowing - this could be a hem-ergency."],
"town.tailor.progress": ["Oh, you have been busy. New fabrics arrived. Do not ask where from. Some of them were yelling.", "Stock has grown! Freed zones send me their finest fashions. Slightly singed, mostly fabulous."],
"town.tailor.secrets": ["Between us: a crown made of living leaves is growing in a bin somewhere in the Verdant Dump. And a cloak that has survived more than you have is draped over a chest on a muscly island.", "And the Capital's mantle... well. Someone has to defeat the person who owns it first."],
"tailor.bought": ["Gorgeous. Truly. You are going to turn heads, mostly in confusion.", "Wear it out! A hat cannot have an entrance if you keep it in a bag!", "Sold! Such a dramatic fit - the hat looks surprised to be wearing you."],
"tailor.poor": ["Gold, my dear head. Thread is not free, and neither is my charm.", "A little more gold, my dear head. I can work wonders with fabric, but it insists on being paid for."],
"tailor.locked": ["Not yet. That one is still on the sewing table, and it is sulking."],
"tailor.owned": ["You own that one already! Do introduce it to the outside world."],
"pack.hint.path_beefcake": ["Stocked once the Gainlands' final dungeon is cleared."],
"pack.hint.path_gourmand": ["Stocked once the Endless Buffet's final dungeon is cleared."],
"pack.hint.path_refusemancer": ["Stocked once the Verdant Dump's final dungeon is cleared."],
"pack.hint.path_necrocrat": ["Stocked once the D.N.A.'s final dungeon is cleared."],
"pack.hint.gilded_beefcake": ["Fig can only get these once the Gainlands are free."],
"pack.hint.gilded_gourmand": ["Fig can only get these once the Endless Buffet is free."],
"pack.hint.gilded_refusemancer": ["Fig can only get these once the Verdant Dump is free."],
"pack.hint.gilded_necrocrat": ["Fig can only get these once the D.N.A. is free."],
"pack.hint.general_2": ["The back crates open at level 10, or once two zones are free, whichever comes first."],
"pack.hint.prismatic": ["Unlocks after the final victory."],
"pack.card_vendor.title": ["Sable's Sealed Surprises"],
"pack.card_vendor.line": ["Sable pats a stack of wrapped bundles. \"Surprise packs, darling. Fresh from the crates, and I never ask a crate where it has been.", "What's inside? The crate has declined to comment, darling, and I admire a professional.\""],
"pack.card_vendor.tier2": ["Sable grins at you. \"The back crates are open, darling - more cards, bigger surprises, the same discreet fainting policy.\""],
"pack.black_market.title": ["Fig's Gilded Goods"],
"pack.black_market.line": ["Fig Sly taps a gold-edged wrapper. \"Guaranteed good stuff. Do not ask where the guarantee comes from.", "It is not legal. It is, however, very shiny.\""],
"pack.reward.clear": ["The Path sends you its pack: %s."],
"pack.reward.first_bonus": ["First clear bonus: %s."],
"pack.reward.vendor_unlock": ["Foil Fenwick now stocks the %s."],
"pack.reward.title": ["Packs received"],
"pack.reward.primm": ["Every Path sends a thank-you: %s."],
"pack.reward.quest": ["Pack reward: %s."],
"arena.tier.1": ["Bronze Sand"],
"arena.tier.2": ["Silver Sand"],
"arena.tier.3": ["Gold Sand"],
"arena.tier.1.blurb": ["Where every champion starts: loud, dusty and mostly forgiving."],
"arena.tier.2.blurb": ["The crowd has stopped laughing and started betting."],
"arena.tier.3.blurb": ["Only legends stand here. Only the sand remembers who fell."],
"arena.arena_warmup.title": ["Warm-Up Brawl"],
"arena.arena_warmup.blurb": ["A rookie gladiator rattles inside oversized armor. Bring your own deck; the armor has enough room for its own audience."],
"arena.arena_warmup.rules": ["Your own deck, full HP. Win the duel."],
"arena.arena_lethal_lunch.title": ["Lethal Lunch"],
"arena.arena_lethal_lunch.blurb": ["The lunch rush has an enemy blocker, ten HP and no mercy. You have exactly one turn and just enough energy."],
"arena.arena_lethal_lunch.rules": ["PUZZLE: win THIS turn. Preset board. If the turn ends and your opponent still stands, you lose."],
"arena.arena_neutral_mile.title": ["The Neutral Mile"],
"arena.arena_neutral_mile.blurb": ["The Marshal's favorite warm-down: no Paths, no tricks, no excuses. Everyone fights with a borrowed gladiator's kit."],
"arena.arena_neutral_mile.rules": ["RESTRICTED DECK: you fight with the Gladiator's Kit (neutral cards), not your own deck."],
"arena.arena_hold_the_line.title": ["Hold the Line"],
"arena.arena_hold_the_line.blurb": ["A stampeding squad charges across the sand before you can even take a breath. You only have to outlast them."],
"arena.arena_hold_the_line.rules": ["PUZZLE: survive 3 of the enemy's turns. Preset board; the enemy moves first. You win when the third enemy turn ends and you still stand."],
"arena.arena_spells_only.title": ["Spells Only, Please"],
"arena.arena_spells_only.blurb": ["The Cardboard Colossus does not like being hit by anything with a heartbeat. Win without playing a single unit."],
"arena.arena_spells_only.rules": ["RESTRICTED DECK + RULE: you fight with the Spellslinger's Satchel and may NOT play unit cards this duel."],
"arena.arena_four_fists.title": ["The Four Fists"],
"arena.arena_four_fists.blurb": ["A champion who fights with every Path at once, and has a hand on every card. Bring your best deck."],
"arena.arena_four_fists.rules": ["Your own deck, full HP. Win the duel."],
"arena.arena_zero_to_hero.title": ["Zero to Hero"],
"arena.arena_zero_to_hero.blurb": ["The Wall of Fame has two blockers and eleven HP. The crowd has already booked your funeral. Show them lethal."],
"arena.arena_zero_to_hero.rules": ["PUZZLE: win THIS turn. Preset board, five energy, two blockers to deal with."],
"arena.arena_marshal.title": ["The Marshal"],
"arena.arena_marshal.blurb": ["Announcer Grand Bellows steps onto the sand. He has not lost a bout in eleven years. He is smiling, and so is the moustache."],
"arena.arena_marshal.rules": ["Your own deck, full HP. Win the duel. No excuses."],
"arena.screen.title": ["The Undercroft"],
"arena.screen.locked": ["The gates are chained until the first zone is free."],
"arena.screen.cleared": ["CLEARED"],
"arena.screen.new": ["NEW"],
"arena.screen.replay": ["Replay (no prize)"],
"arena.screen.fight": ["Fight"],
"arena.screen.first_prize": ["First-clear prize"],
"arena.screen.puzzle": ["PUZZLE"],
"arena.screen.battle": ["BATTLE"],
"arena.won.first": ["VICTORY ON THE SAND - THE PRIZE IS YOURS! The echo would like it known that it believed in you first."],
"arena.won.replay": ["Another win for the books. The crowd roars (and tosses you some coins)."],
"arena.lost": ["NOT THIS TIME, CHAMPION! Come back whenever you're ready; the sand has yet to win a rematch."],
"arena.puzzle.won": ["PUZZLE SOLVED - THE CROWD GOES WILD! A triumph for thinking, shouted at full volume!"],
"arena.puzzle.lost": ["The puzzle got the better of you. Study the board and try again."],
"travel.title": ["The Beefcake Rift Express"],
"travel.subtitle": ["Rips while-you-wait. Tips accepted in protein."],
"travel.here": ["You are here. A Rip is stationed here."],
"travel.locked.name": ["???"],
"travel.locked.blurb": ["No station yet. Walk into the town there and a cousin will wake up and rip one into the wall."],
"travel.warning": ["Ripping out of a zone ends your visit: you arrive at full HP, and the roaming enemies there come back. Rips are free. Beefcakes charge for spotting, and spotting is also free."],
"travel.button": ["Rip me there!"],
"travel.close": ["Not today"],
"travel.operator.town": ["Rip Tearson, Rift Technician"],
"travel.operator.necrocrat": ["Rip Tearson (Cousin #2)"],
"travel.operator.beefcake": ["Rip Tearson (Cousin #3)"],
"travel.operator.gourmand": ["Rip Tearson (Cousin #4, the One Who Eats)"],
"travel.operator.refusemancer": ["Rip Tearson (Cousin #5, Smells Fine)"],
"travel.operator.final": ["Rip Tearson (Cousin #7, Allegedly)"],
"travel.station.town.name": ["{town}"],
"travel.station.town.blurb": ["The home station. A well-supported sky is a happy sky."],
"travel.station.necrocrat.name": ["The Department of Necrotic Affairs"],
"travel.station.necrocrat.blurb": ["The elevator lobby. A cousin ripped it into the wall beside the Out-Of-Order sign. It is the only thing in the building that works."],
"travel.station.beefcake.name": ["The Gainlands: Swole Station"],
"travel.station.beefcake.blurb": ["Between the hot tub and the protein stand, where the gains are public."],
"travel.station.gourmand.name": ["The Endless Buffet: The Grand Pantry"],
"travel.station.gourmand.blurb": ["A short walk from the heavy meal table. The cousin ripped it open just by the napkins."],
"travel.station.refusemancer.name": ["The Verdant Dump: The Compost Grange"],
"travel.station.refusemancer.blurb": ["Right by the harvest table. The Rip is slightly damp. So is everything."],
"travel.station.final.name": ["{capital}: The Crease"],
"travel.station.final.blurb": ["A rip into the hideout under the Capital. Do not ask how we found it. We followed the smell of Fig Sly's hot sauce through the fabric of space."],
"travel.intro.town": ["HNNNGH. SPOTTER! Spot me! No, not you, the other guy. ...Hello. Welcome to the Beefcake Rift Express.", "We tear the world open so you don't have to walk, buddy. Two men hold the sky - that's our overhead.", "The sky is surprisingly heavy. Do NOT skip sky day. And do not look at the seam. It is not a seam. It is a PUMP.", "Reach a town and we send a cousin to rip a station there. All named Rip; around cousin four, naming became a cooldown exercise.", "Walk into a town, and its station wakes up. Then you can rip between any two of them. Thank you for ripping with the Express."],
"travel.return.town": ["Back for another rip, little buddy? Say where, and we will tear it right open. Rips are free.", "Spotting is free, buddy. Hydration is a bring-your-own-water situation."],
"travel.intro.zone": ["HNNNGH... Rip Tearson, Beefcake Rift Express, serving this exact spot. I'm a cousin; we hire entirely on relative strength.", "We are all very proud of one another and rarely speak.", "Say where, buddy. We will rip it."],
"travel.return.zone": ["Need a rip, brother? I've held this sky since breakfast, and I'd hate to put it down with no one through it."],
"travel.intro.final": ["Shhh. Keep it down, there is a Wrinkle sleeping behind the crates. Rip Tearson, Cousin #7, Rift Express. Allegedly.", "I was told this place did not exist, so I ripped a hole to it. Sometimes you just have to want it. And the sauce smell helped."],
"travel.rip.1": ["Grab the edges! On three! One!", "...Two! ...What comes after two? ...RIP!"],
"travel.rip.2": ["Hold the sky, brother! Feel the burn! RRRRRIP!"],
"travel.rip.3": ["Spot this whole dimension, brother! Lift with your LEGS - lower back does not mean lower universe!"],
"travel.rip.4": ["Loosen the shoulders. Roll the neck. Tear a hole in the fabric of space. And never, ever skip leg day."],
"travel.rip.sound": ["RIIIIIIP!"],
"travel.arrive.town": ["The rift folds shut behind you with a very satisfied pop. A nearby Beefcake flexes at the hole to say well done."],
"travel.arrive.necrocrat": ["The rift drops you by the lobby elevator and pops shut. You catch a fluttering memo: YOU WERE NOT AUTHORIZED TO ARRIVE.", "You check for an approved way to have arrived. The memo offers none."],
"travel.arrive.beefcake": ["The rift spits you out next to the Swole Station. A passing brute gives you a thumbs-up, then another to himself, then one to the hole."],
"travel.arrive.gourmand": ["You land in the Pantry and receive a napkin before you find your balance. Priorities are immaculate."],
"travel.arrive.refusemancer": ["You arrive at the Grange in a whiff of ozone, mulch and gym sock. The Express leaves a personal impression."],
"travel.arrive.final": ["The rift spits you out in the Crease. Somebody says shh. Somebody else says it was not them. The rift closes politely."],
"travel.unlock.title": ["Rift Station ripped"],
"travel.unlock.toast": ["A Beefcake cousin has ripped a Rift Station into this town. Fast travel unlocked."],
"travel.unlock.necrocrat": ["Rift Station unlocked: the Department of Necrotic Affairs. A cousin ripped it in beside the Out-Of-Order sign. Fast travel to and from here is now open."],
"travel.unlock.beefcake": ["Rift Station unlocked: the Gainlands. Two cousins have ripped it in with their bare hands and are now doing a victory pose. Fast travel to and from here is now open."],
"travel.unlock.gourmand": ["Rift Station unlocked: the Endless Buffet. A cousin ripped it in, then asked if there were seconds. Fast travel to and from here is now open."],
"travel.unlock.refusemancer": ["Rift Station unlocked: the Verdant Dump. A cousin ripped it in, then looked at his hands, then at the hole, then at his hands again. Fast travel to and from here is now open."],
"travel.unlock.final": ["Rift Station unlocked: the Crease, the hideout under the Capital. A very quiet cousin ripped it in. Fast travel to and from here is now open."],
"travel.prompt": ["Use the Rift Station"],
"travel.sign.town": ["BEEFCAKE RIFT EXPRESS", "Rips while-you-wait. Space torn to order. No refunds on the sky."],
"travel.sign.zone": ["BEEFCAKE RIFT EXPRESS", "A cousin is on duty. Do not look at the seam."],
"travel.station.forest.name": ["The Forest Outside {town}"],
"travel.station.forest.blurb": ["A hasty rip where you first woke up, between the trees. There is a hatch in the clearing now that nobody remembers being there. It smells like a hospital."],
"travel.operator.forest": ["Rip Tearson (Cousin #8, Mossy)"],
"travel.sign.forest": ["BEEFCAKE RIFT EXPRESS", "FOREST STATION", "(Please do not eat the hatch.)"],
"travel.intro.forest": ["Rip Tearson, Cousin Number Eight, rift technician, tree enthusiast. This is the clearing where I found the hatch, buddy. I did not open it.", "I have manners. Mostly.", "Say the word and I will rip you back to {town}. Or you can go down the hatch. I will hold the sky."],
"travel.return.forest": ["Need a rip back to {town}, or are you heading down the hatch? Either way, I have been holding this sky since breakfast."],
"travel.arrive.forest": ["Forest station! Mind the roots. And the hatch. Mostly the hatch."],
"travel.forest_tip": ["Spotter! Big news. You know that forest where you all started out?", "I went exploring up there, and I saw some very interesting things. A hatch in the clearing that was NOT there before. Little glowing roots. A smell like a hospital.", "I did not open it. I have manners, and also I am scared. But I did put a rift station up there, so you can pop over whenever you like.", "It is on the Express now. Say 'forest' and I will tear it right open.", "Whatever is under that hatch, it is yours, I think. It feels like yours. Be careful, buddy."],
"postgame.rescuer.freed": ["You came for me. Twice, if you count the woods. I'm counting the woods.", "Finish it, Tess. I'll be here. I've had a lot of practice waiting in this forest."],
"postgame.rescuer.cleared": ["The Lab is quiet. For the first time in ten years I can hear the trees from down there.", "Dad is in {town}, listening to Maren. She let him have one slice of pie. One. I've never seen him so frightened."],
"travel.unlock.forest": ["Rift Station unlocked: the forest outside {town}. Rip has torn it open where you first woke up. Fast travel to and from here is now open."],
}
