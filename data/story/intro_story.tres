[gd_resource type="Resource" script_class="StoryText" format=3]

[ext_resource type="Script" path="res://core/data/story_text.gd" id="1_st0ry"]

[resource]
script = ExtResource("1_st0ry")
awakening_lines = Array[String](["Ugh... where am I? And while I'm asking, who am I?", "I keep reaching for my name, or for how I got here, and there's nothing there at all.", "I should get up. My legs have other ideas, and every part of me aches."])
beefcake_npc_intro_lines = Array[String](["NOBODY CROSSES THE GORGE WITHOUT A SPOTTER. I AM THE SPOTTER.","THE BRIDGE STAYS UP BY ORDER OF CHANCELLOR CLENCH! ONLY IRON MATTERS! ...AND HYDRATION! (quieter) The regime is very big on hydration.","YOU WANT THE CRANK? EARN IT! TEN REPS, NO REST! I HAVE NOT SAT DOWN SINCE SPRING AND I FEEL FANTASTIC!"])
beefcake_npc_victory_lines = Array[String](["...Oh no. Was I yelling? I was yelling, wasn't I. I'm so sorry - that was the pre-workout talking, and it doesn't know when to stop.","Chancellor Clench had Grandmaster Flex locked away under the House of Gains, ten years ago now. Folks still whisper that the old man never broke. I should've whispered with them instead of yelling.","The bridge is yours, friend. Stretch before you cross, though - a pulled hamstring is a terrible souvenir."])
beefcake_npc_defeat_lines = Array[String](["HA! THE PUMP IS STILL MINE! GO HOME AND HYDRATE! THAT IS AN ORDER, NOT CONCERN! ...IT IS A LITTLE BIT CONCERN.","COME BACK WHEN YOU CAN LIFT! THE BRIDGE STAYS UP, AND SO DO I! NEITHER OF US IS ALLOWED TO SIT DOWN!"])
gourmand_npc_intro_lines = Array[String](["TASTE IT! The Special Sauce is in everything now - my soup, my tea, my very SOUL - and isn't it WONDERFUL?","The pantry is closed by order of the Grand Chef, and the key stays on my apron. It's all for the war effort!","You want the key? You'll have to beat me for it! Yes, Chef! No - YOU, Chef!"])
gourmand_npc_victory_lines = Array[String](["The sauce has let go of me. Is that plain bread, with no sauce on it at all? I could weep. In fact, I am weeping.","The Grand Chef stopped tasting her own sauces years ago, and the Chef I trained under ALWAYS tasted. Same face, same apron... so who has been wearing it?","Whatever's wrong here starts in the Test Kitchen, at the far end of the Buffet, and it was never making casserole. Take a biscuit for the road. Take two."])
gourmand_npc_defeat_lines = Array[String](["Under-seasoned. NEXT!","The pantry door stays shut until you've learned to cook. Come back when you're properly seasoned!"])
refusemancer_npc_intro_lines = Array[String](["...the green is hungry... the green is HUNGRY... nothing goes to waste...","...this path belongs to the Rotheart now... turn back... before the green decides you would make good compost...","...if you won't leave, the green will keep you... it keeps everything now... nothing it holds is ever allowed to go..."])
refusemancer_npc_victory_lines = Array[String](["Oh no, did I thorn at you? I'm so sorry. The Rot talks very softly in your head, right up until the moment it's doing all the talking.","The Rot took Archdruid Compostella first, down at the Rotheart in the deepest part of the Verdant Dump. Everything grew out from there, and it got into me the day a very tidy lady with shears came calling.","The path's clear now. Go gently in there, and if you meet a raccoon, say hello for me. They're very good boys, whatever anyone tells you."])
refusemancer_npc_defeat_lines = Array[String](["...the green is patient... nothing ends here any more... come back when you're ready to stay...","...come back... the green can wait... it has forgotten how to do anything else..."])
necrocrat_npc_intro_lines = Array[String](["Halt. Passage through this checkpoint requires a permit, and no permit has ever been issued. Please take a number.","Your number is zero, as is everyone's. This checkpoint is now serving nobody, and will continue to do so.","The authorization is valid, and policy states that I must stop you. I have read all of the policy, twice."])
necrocrat_npc_victory_lines = Array[String](["...I can hear my own thoughts again. I think I've been Pending for ten years. It was very quiet in there, and very orderly, and none of it was me.","{villain} didn't need to corrupt us. He used our own rules: a perfectly valid transfer of authority, notarized and filed. We stamped it ourselves.","The Hall of Final Approvals is at the top of the D.N.A., and whoever sits in it holds the authorization. Go carefully, or fill out a form first. Ideally both."])
necrocrat_npc_defeat_lines = Array[String](["Application denied; reapply in ten to twelve centuries. This is our express service.","Not yet, then. You may take another number, though it will also be zero."])
equipment_vendor_intro_lines = Array[String](["Security Protocol One: assess the customer's gait. Adequate - you may approach at your current level of walking.", "Bertram Beetsworth, Assistant TO the Regional Merchant. The TO is load-bearing.", "Everything on this rack is inventoried and oiled under Security Protocol Seven. Protocol Seven is need-to-know. You do not need to know.", "Do not reach for the drawer. Its contents are classified, and so is your interest in them."])
equipment_vendor_return_lines = Array[String](["A return customer strengthens the economy and my employee-of-the-month case file. Please look satisfied for the record.", "Fact: the beets came in early this year, and the bear has been informed. We have an understanding. I do not ask why it is here, and it does not ask about the beets."])
graveyard_intro_lines = Array[String](["The stones here were stacked by hands that stopped moving a long time ago.", "Something under the cairn is still keeping count of its turns. It has been keeping count since before {villain} came.", "Touch it, and it will not stop counting until one of you does."])
graveyard_victory_lines = Array[String](["The counting stops. For now.", "Whatever was keeping time down there has nothing left to spend it on.", "The stones are just stones again. Take what it was guarding."])
graveyard_defeat_lines = Array[String](["It is still counting.", "Come back when you have more turns to spare than it does."])
quest_dialogue = {}
texts = {
"still.wake": ["You wake in a forest clearing with leaves in your hair.", "A faint glow of four colors fades from your hand, like a thought you almost had.", "Someone in a hood is kneeling beside you, shaking your shoulder gently, then less gently. Their face stays in shadow."],
"still.flex": ["Grandmaster Flex walks into the throne room in his prison rags, and the whole hall falls silent.", "He breathes in, slow and even. Ten years without iron have worn him thin as wire, but he stands perfectly straight.", "Across the room, the ruler of the House of Gains takes one step back."],
"still.doppel": ["You watch the chef's perfect smile slip away with her face.", "Beneath it, you see a shifting shadow in a spotless white coat.", "Behind the shadow, you see the unfinished war machines standing still."],
"still.approval": ["You hear the great DENIED stamp crack. For the first time in the Department's long afterlife, it does not come down.", "Forms rise around you. Across the Department, a thousand clerks look up from their desks.", "Somewhere nearby, you hear a pen stop scratching."],
"still.rotheart": ["Light pours through the splitting Rotheart.", "Before you, the purple vines wither. At the heart of the wound, the Archdruid kneels, free and breathing.", "Wildflowers follow the light outward, field by field, through the Dump."],
"still.primm": ["The mirrors crack one by one, and for the first time in ten years {villain} sees himself in them.", "There is no crown and no perfect smile, only a tired man kneeling above a very small kingdom.", "Light pours in through the broken glass. It does not feel like winning. It feels like the end of a long, quiet lie."],
"still.reunion": ["In the Capital's square the leaders of the four Paths clasp hands, and several people in the crowd begin to cry.", "Four banners fly from the same pole. It is a little crowded, and nobody minds.", "At the edge of the crowd, a hooded traveler smiles, leaves still in their hair. There is always another path."],
"start.gate_title": ["The Forgotten Cave"],
"start.gate_prompt": ["A cold draft rises out of the dark, smelling of old stone and older water. The stranger said the town lies on the other side. Go in?"],
"prologue.rescuer.1": ["Easy. Stay down a moment and get your breath back. After what they put you through, I'm amazed you're breathing at all.", "And keep your voice low. We're not the only ones in these woods tonight."],
"prologue.wanderer.1": ["I don't know this place, and I don't know my own name. ...Who are you?"],
"prologue.rescuer.2": ["A friend. That's all I can tell you, and there isn't time for more.", "Can you still draw on the Paths? Hold out your hand and let me see."],
"prologue.wanderer.2": ["...I feel them. All four, faintly. Like voices through a wall."],
"prologue.rescuer.3": ["Faint will have to do. The Path-ologists are already hunting us.", "Tell me: which Path resonates within you?"],
"prologue.rescuer.4": ["That one, then. Hold on to it. The others will come back to you, in time.", "The Forgotten Cave behind me is your escape. It comes out at {town}, and Elder Maren will be waiting for you there. Find her first.", "Hear that? They're close, but they don't know about the cave. Hardly anyone remembers it now.", "Go, and don't stop for anything. I'll draw them off the other way, and when I'm clear, I'll find you. I always do."],
"prologue.wanderer.3": ["She's gone, and she's taking the shouting with her. Whoever they are, I'd rather not meet them."],
"prologue.self_talk": ["The trees are packed too tight to get through. The cave it is, then.", "No point getting lost twice in one day. I'll head back up the path to the glowing arch.", "Whatever is waiting for me, it's through that cave.", "Whoever she was, she said help would be waiting on the other side. Whatever's in that cave, it has to be better than those Path-ologists."],
"memory.title_format": ["Fragment %d of 4: %s"],
"memory.hint": ["E / click: continue"],
"memory.1.title": ["Warmth"],
"memory.1.intro": ["You've gone pale as flour. Sit down, sit. Something's come back to you, hasn't it?", "Tell me all of it, however small it seems. The small things are usually the ones that matter."],
"memory.1.fragment": ["There's light, four colors of it, warm as bathwater, spilling across a ceiling I can't quite see.", "A woman is humming a tune with no words, and it rises and falls like someone breathing in their sleep.", "A hand rests on my head, gentle and certain, and it smells of lavender and woodsmoke.", "Then the light thins, like breath on glass, and I am back."],
"memory.1.after": ["...A lullaby. That tune is from the old days, from the court, and there are very few left who remember it. Fewer still who'd hum it.", "Have some pie. And don't ask me why my eyes are wet, because I won't tell you.", "And look at you. With one zone free, the corruption's grip on the land is slipping, and it's slipping off you along with it.", "You ought to be able to carry a second Path now. Go to the Deck Station and try building a deck with two; I'd like to hear how it feels."],
"memory.1.announce_title": ["A Second Path Opens"],
"memory.1.announce_body": ["With the first zone free, the corruption smothering your gift has weakened. Your decks may now use two Paths, and dual-Path cards can finally be played."],
"memory.1.announce_line": ["Decks may now use two Paths."],
"memory.2.title": ["The Cells"],
"memory.2.intro": ["Another one, is it? Don't hide behind your teacup, dearie. Just say it."],
"memory.2.fragment": ["White rooms, and a white light that never changes, whatever the hour.", "Glass on every side, and faces behind it in white coats, taking notes.", "No one there ever uses my name. They call me 'the Subject', and whatever I do, they only say 'again.'", "Again. Again. Again.", "I wasn't lost. I was kept."],
"memory.2.after": ["Glass, and white coats, and 'again.' So that's where you've been all this time.", "You've earned some truth from me, so here's the first piece of it: I'm not just an old tortoise who bakes.", "There's a resistance in this kingdom, and I'm its contact here in {town}. A woman called Wren leads it, from a hideout in the Capital.", "I wasn't sure of you before. I am now, near enough, and I don't say that about many people."],
"memory.3.title": ["The Coup"],
"memory.3.intro": ["You're shaking. Sit down, slowly now. Here, take my hand."],
"memory.3.fragment": ["A throne room at night, the candles guttering under banners with four colors woven into one.", "A man in white and gold kneels before the king and speaks in a soft voice. Then he rises, and his soft voice is the last soft thing in the room.", "Two pairs of hands are on my shoulders, pushing me behind them, toward the dark.", "I know that man's face, and I think I have always known it. {villain}."],
"memory.3.after": ["A man in white and gold, kneeling and then standing. And before that, those rooms with glass on every side.", "I know that glass, because I helped to blow it. Long ago I founded the study of the Paths, and I did it for the best of reasons.", "{villain} took my work and made a cage of it, and my best student kept the lab running for him. And I ran.", "I've been hiding here ever since, with my hands in pie dough, where nobody would think to ask what else those hands had made.", "That's my secret. Now you're holding it, the same way I've been holding yours."],
"memory.4.title": ["A Name"],
"memory.4.intro": ["There's something in your face today, the look of someone who's just been handed a key. Tell me what it opens."],
"memory.4.fragment": ["A boy of eleven stands in a coat too fine for the cold. Someone calls across a courtyard: '{prince}!'", "I turn toward a woman's voice, and then a man's, and on every door is the {royal_house} crest: four signs in a ring.", "{prince_full}, son of the king and queen. The whole kingdom believes he died ten years ago.", "That is who I am."],
"memory.4.after": ["{prince}. {prince} {royal_house}. I met a boy once at court, hiding behind his mother's cloak, who asked me why tortoises carry their houses.", "I told him, 'So we are never far from home.'", "I knew, you see. The Warden opens that tunnel for one family only, and I knew it the moment you walked out of it. I was too frightened to say so.", "Four signs in a ring, the same as the ones carved on my stick. I've carried it for ten years and never told a soul why.", "And my lab, my life's work, was used on that boy. On you. Forgive me if you ever can. I'd understand if you couldn't."],
"memory.4.reply": ["There's nothing to forgive. You gave me a bed and pie when you still thought I might be a spy."],
"memory.4.after2": ["...Then let us make the kingdom a home again, {prince}."],
"memory.4.intro_known": ["You've the look of someone who was told something he didn't want to hear. Was it {villain}?", "Sit down and tell me what he said. All of it."],
"memory.4.after_known": ["So he knew you from the very first. He told you who you are, and you've come to me for the rest of it.", "I knew too. The Warden opens that tunnel for one family only, and I knew it the moment you came out of it. I was just too frightened to say so.", "So hear it from someone who held your hand at court: you are {prince_full}, and I'm so sorry for what was done to you with the things I built."],
"town.elder.stage.0": ["I still don't know what to make of you, dearie. But you need feeding more than you need questioning, so sit down a minute.","Have as much pie as you like. Just keep your eyes off the recipe; better people than you have tried."],
"town.elder.stage.1": ["That tune's stayed with you, hasn't it? I can see it on your face. Good. Keep it somewhere safe, dearie, even when it hurts.","Found any more answers out there? I keep telling myself it's none of my business, and I keep asking anyway."],
"town.elder.stage.2": ["Somebody in the square says you've a look of the old court about you. 'That's no prince,' I told them. 'That's a damp young man with good posture.'","When you find Wren in the Capital, tell her my pie is still the best thing in the kingdom. She'll argue, and she'll be wrong."],
"town.elder.stage.3": ["I have told you the worst of me. The rest is easy, by comparison.","Go on, dearie. The next road won't open itself, and if we left it to me, we'd be at it until the regime died of old age."],
"town.elder.stage.4": ["{prince}. I keep wanting to curtsy. My knees have voted against it.", "Go on, then. The kingdom has waited ten years for you; the pie won't wait ten minutes."],
"town.elder.known_early": ["{prince}. {villain} let it slip to you, didn't he, that smug man. I had hoped to tell you myself.", "Sit down. The rest of your memories will come when they're ready, and I'll be right here when they do. With pie, obviously."],
"tutorial.warden.before": ["...Footsteps. It has been a long time since anything woke me.", "No one has walked this way since the house fell silent. I have kept the door all the same.", "Turn back. Only one may pass this door, and he is long dead."],
"tutorial.warden.after": ["...The door knows your hand. I do not understand it, but I will not stand against it. Pass, and let the Paths guide you.", "The light goes out of the Warden's eyes slowly, like a lamp turned down for the night."],
"cave_mouth.maren": ["Hmph. About time. {villain}'s soldiers have been up and down the road all day, and nobody has come out of that cave in ten years, so forgive me for staring.", "And look at the state of you. I told her I'd help whoever she sent along. I never said I'd take in a half-drowned stray.", "I didn't want any part of this, and I told her so. She went ahead anyway. She always does.", "But you need a bed, and I've baked far too much pie, so I can hardly leave you out here on your own, can I?"],
"cave_mouth.wanderer": ["I don't know who I am, or where this is. I don't even know the name of the woman who got me out."],
"cave_mouth.maren_end": ["Hm. If she didn't give you her name, she had a reason, and I won't be the one to spoil it. As for where you are: this is {town}. We settle most things here with cards, and I see you've already got a deck.", "If your memory's really gone, you'll be here a while, so you'd best get to know people. Say hello to Sable, Tilly and Pip on the square, buy yourself a card from Sable, then come back to me."],
"start.tunnel": ["A narrow gap in the old treeline - easy to miss, easy enough to slip through, if you're not afraid of a shortcut."],
"town.name": ["{town}"],
"town.elder.first": ["Up and walking. Good. I am Elder Maren, dearie, and this is {town}, where the four Paths used to meet, and argue, and borrow each other's pans.","Ten years ago {kingdom} was whole. Beefcakes kept the lights on, Gourmands fed us, Necrocrats minded the dead and Refusemancers turned rubbish into harvests. Everyone complained, and everything worked.","Then {villain}, the Minister of Improvements, took the Paths one by one and set his own people over them. Now every road out of town has a gatekeeper: a bridge, a barrier, a pantry door, a wall of thorns.","Beat a road's gatekeeper and that road opens. Before you try, buy a few cards from Sable and sort your deck at the Deck Station. Then come back to me for pie. Pie, mind. Not answers."],
"town.elder.return": ["Four roads out of town, dearie: the Gainlands, the Buffet, the D.N.A. and the Dump. Pick one and see it through before you start the next.","For all I know, you're somebody's spy. I've been wrong about people before. Once, in 1987."],
"town.elder.idle": ["Still here, dearie? {villain} would like nothing better than you sitting by my fire forever, so don't give him the satisfaction. And give me back my chair.","The pie on the sill needs another hour, dearie. You don't. Off you go.","If you're looking for advice: eat something. If you're looking for more advice: eat something else.","I've given you all the answers you need for now, dearie. Further questions require fieldwork.","Mind the fountain, dearie. People throw wishes in it. Most of them are mine.","Off you go, dearie. I'll be here when you get back. Tortoises are very dependable, just not quickly."],
"town.elder.idle.1": ["One zone free and you're back for pie already. Fine, but it's one slice per zone from now on, dearie. I've just made that rule.", "Three roads are still shut. I'd see to them myself, dearie, but at my pace I'd arrive next spring.", "The square sang last night, and badly. It was the best thing I've heard in ten years, so don't you dare tell them."],
"town.elder.idle.2": ["Two zones free, and the square's louder for it. I complain about the noise every morning and don't mean a word of it.", "Halfway, dearie. I'd say I'm proud of you, but then you'd stop trying.", "Auntie Alembic keeps asking after you. I tell her you're busy, and for once it's even true."],
"town.elder.idle.3": ["One Path left under {villain}'s thumb, and the whole town's holding its breath. I can hold mine for a week, being a tortoise. They can't.", "Three zones free, dearie. Do finish the fourth before this pie goes stale; I'd give it about a week.", "You walk like somebody with somewhere to be these days. I liked the damp young man better. He visited more."],
"town.elder.idle.4": ["All four Paths free, and {villain} still sitting in his castle as if nothing's changed. Go and knock, dearie. Loudly.", "The roads are open, and even I've been using them. I passed a hare this morning; he's asked for a recount.", "Eat something first, then go to the castle. Nobody ever toppled a tyrant properly on an empty stomach."],
"town.elder.progress.1": ["One zone free. Hm. And the old cottage at the end of Champions' Road has started cheering at night, from somewhere down in the cellar. I've decided not to ask."],
"town.elder.progress.2": ["Two zones free, and Auntie Alembic has opened the Alchemist's on the square. She brews cards from two Paths at once, if you can stand the steam.","She's been asking for your leftovers. From her, that's a compliment."],
"town.elder.progress.3": ["Three zones free. Only one Path is left under {villain}'s thumb now, and I won't tell you what I'm feeling about it, except that it's a great deal."],
"town.elder.progress.4": ["All four Paths are free, and {kingdom} is whole again, or nearly. Up in his castle, {villain} will be counting what he has left.", "Get some rest. Then we finish this, together."],
"town.guard": ["Hm. You came back. Wrote it in the notebook: 'came back.' Best two words I know.","Gate stays open. Always has. My girl's still up that road somewhere, and I'd hate for her to come home and find it shut."],
"town.guard.capital_offer": ["Hm. That road goes to the Capital. You'll be wanting to know why nobody comes back from it.", "Four Paths kept that city alive. Beefcakes ran the lights, Gourmands the kitchens, Necrocrats the graveyards, Refusemancers the bins. Then {villain} chained all four.", "So now it's Blackout, Famine, Restless Dead and Clutter up there. Dark streets, slow legs, no food that heals, rubbish in your deck.", "You could walk in today, but you wouldn't get far. Free the four zones first. Each one you free turns one of those services back on.", "My girl Isla went up that road eight years ago. If you see her... tell her the gate is still open."],
"town.guard.capital_active": ["Hm. Services still broken up there. The board by the road keeps count, if you want to check.", "Hm. Each zone you free turns another service back on, and the castle gets a little less frightening. My knees, sadly, are a local problem."],
"town.guard.capital_done": ["Hm. All four zones free. The lights are on up there. I can see them from here.", "Go on, knock on that castle door, and knock hard. And if you see Isla up there... tell her I'm still watching the road."],
"capital.castle.warning": ["The castle door is cold to the touch. With the city's services still broken, whatever waits inside will have every advantage.", "You could go in now. It would be wiser to wait until the city is back on its feet."],
"gate.beefcake.freed": ["You actually did it - Grandmaster Flex is out! First thing he did was make me stretch for forty minutes. I cried twice, but they were good tears. Stretchy ones.","The bridge stays down now, but I still oil the crank every morning. Maintenance is how I say sorry, and I've got a lot of sorry left to get through.","Want to spar? Gently, I mean. I'll spot you. I'm still a spotter, I just get to say it at a normal volume now, and honestly, it's a huge relief."],
"gate.necrocrat.freed": ["The afterlife is processing again. Agnes says the queue moved four whole numbers yesterday, so we had cake.","I've got a new stamp that says HELPED. I've used it nine times so far, and yes, I'm counting.","You can challenge me again if you like, and you won't need a permit to do it. That's my favourite rule. I wrote it myself."],
"gate.gourmand.freed": ["She's back - the real Grand Chef. She tasted my soup, frowned and said 'more salt', and I have never been so happy in my life.","The pantry door stays wide open now, and people wander in for biscuits all day long. I keep a tin by the hinge for them.","Fancy a friendly duel, for old times' sake? Loser washes the ladle, and I should warn you, it's a very big ladle."],
"gate.refusemancer.freed": ["Archdruid Compostella is herself again, and she hugged me! She smells like rain and a little bit like compost, which is exactly how an Archdruid ought to smell.","Most of the thorns are gone; I keep one in a pot. It's behaving, but I'm not ready to let it meet the curtains.","Fancy a practice round? I'll try very hard not to thorn at you. The raccoons have come to watch, so let's both be on our best behaviour."],
"gate.beefcake.blocked": ["The bridge is drawn up on the far side of the gorge. Somebody very large is standing by the crank, shouting about hydration."],
"gate.beefcake.cleared": ["Brick Bronson cracks his knuckles, takes the crank in one hand and lowers the bridge with it, making very sure you're watching.", "The planks thump down across the gorge, and the road into the Gainlands lies open."],
"gate.necrocrat.blocked": ["The barrier is down, and a stamped sign beside it says the road needs a permit. Nobody has ever been issued one."],
"gate.necrocrat.cleared": ["Prudence Pallor stamps a permit, hands it over, and files the original in triplicate.", "The barrier creaks up. The road to the D.N.A. is open."],
"gate.gourmand.blocked": ["An enormous pantry door blocks the lane, locked tight, with a keyhole the size of a dinner plate."],
"gate.gourmand.cleared": ["Chef Fennel Gravois hands over a key the size of a ladle, and it turns in the lock with a satisfying clunk.", "The great pantry door swings open on a smell of roasting meat and fresh bread, and underneath it, faintly, the smell of hot iron."],
"gate.refusemancer.blocked": ["A wall of thorns has swallowed the forest path. It looks like it is breathing."],
"gate.refusemancer.cleared": ["Moss Mulligan lays a hand on the thorns. They sigh, brown, and crumble into leaf mould.", "The forest path to the Verdant Dump is open."],
"town.vendor.first": ["Well met, {wanderer}. Sable, darling: seller of cards, and of very good stories about cards.","Your deck's all plain neutral cards, darling: honest, dependable and dull. The power is in the Paths. Buy a few, then put them to work at the Deck Station.","Where do my cards come from? The past, darling. Next question. My prices are fair, more or less; {villain}'s taxes on them are not."],
"town.vendor.return": ["Back, darling? The cards are honest; the misprints simply have a more adventurous relationship with spelling."],
"town.item_vendor.first": ["Hi! Hello! You look like you need supplies! Tilly Tonic! I'm teal today, which means the new batch works!","Everything here is one use in a fight! Equip what you buy on your Character screen, then use it on your turn!","Probably not on yourself! Unless it's a healing one! I tested the healing one! I'm fine! I'm green! I'm usually green!"],
"town.item_vendor.gift": ["First visit gets a freebie! Power Wraps! Wrap a unit, it gets tougher for the whole fight! I wrapped my own arm once! Still tough! Still a bit stuck!","Here's how! Press C, or Menu then Character! Find Items, the big shiny panel!","Click the Power Wraps, then click an empty slot! Done! Whatever's in a slot comes with you into every fight!","One wrap, one use, then it's gone! More on my shelf! I'm green again! Green means business is good!"],
"town.item_vendor.gift_waiting": ["Did you equip the Power Wraps yet? Press C! Items! Click the wraps, then an empty slot!","I'll wait! I'm bad at waiting! I'm turning yellow!"],
"town.item_vendor.return": ["Back for more potions! Equip them on your Character screen before a fight! Maybe skip the orange one until I stop matching it!"],
"storeroom.locked": ["The door rattles. Something behind it is muttering about a receipt.", "Whatever it is, it sounds like it has been on hold for a very long time."],
"storeroom.before": ["OooOOOooo. Who disturbs the store room? We are VERY busy haunting it.", "Ninety years ago the three of us went halves - well, thirds - on one lantern, and it never worked. Tilly's great-grandmother said no receipt, no refund.", "We waited, died, and kept waiting. Your haunting is very important to us."],
"storeroom.wanderer": ["...You're haunting a shop over a lantern."],
"storeroom.challenge": ["A FAULTY lantern, for four copper. We worked out ninety years' interest and it's still four copper. We had the time.", "Nobody comes in until it's refunded, or until somebody beats us at cards. That's how everything gets settled round here, living or otherwise."],
"storeroom.after_win": ["...Fine. FINE. You play like someone who kept the receipt.", "We'll go. The chapel belfry has a lovely draught and nobody has complained about it in centuries.", "Tell Tilly the lantern's on the top shelf, still broken after ninety years of nightly checks. We were thorough, if poorly lit."],
"storeroom.after_loss": ["Ha! No refund, no entry. Come back with a better deck. Or a receipt. Ideally both."],
"storeroom.cleared": ["Just shelves now. And one broken lantern on the top shelf, exactly where they said it would be."],
"town.equipment_vendor.too_early": ["Halt. Security Protocol Two. Equipment is issued on referral only, and Elder Maren does the referring.", "Bring Elder Maren's blessing. Better posture is appreciated but cannot be accepted in its place."],
"quest.armory.start": ["Elder Maren sent you; I could tell from your gait, which now says 'referred'. Congratulations. Your file is finally thick enough to be a file.", "Before I issue gear, protocol requires exactly one thing: win a fight. Any fight counts, and I will know if you lie.", "Fact: things roam the outskirts, on the lanes round the edge of town. They are rude, they are close, and they are not on my referral list.", "Beat one. Then come back and I will hand you something pointy."],
"quest.armory.waiting": ["One fight won. That is the whole requirement. So far I count zero. I am very good at counting to zero.", "Security Protocol Four: check the outskirts. Enemies roam the lanes round the edge of town, and any win counts.", "I will be here, guarding the drawer. The drawer does not know. That is the point."],
"quest.armory.equip": ["Security Protocol Nine: gear in a bag protects nobody. Equip it.","Press C, click the Weapon slot on the figure, choose the blade and press Equip. Four steps. I have written them down for you, in my head.","Unequipped gear will be noted in your file. Your file is already very thick."],
"quest.armory.equip_waiting": ["The blade is still in the bag. I can see the bag. The bag can see me.","Menu. Character. Weapon slot. Equip. Security Protocol Nine does not repeat itself. I am repeating it for you as a courtesy."],
"quest.armory.done": ["One fight, won. Stamp. Stamp. Stamp. Three stamps is the correct number of stamps.", "Security Protocol Twelve: report to Elder Maren. She decides where things get pointed.", "Your Starter Blade. The first unit you play each battle hits a little harder. Do not run with it.", "And all five equipment slots are yours now: helm, weapon, armor, boots, relic.", "The good stuff is rarer, and you can only wear so much of it until you level up. Protocol. Fact: bears do not wear helms. Bears are wiser than us."],
"town.hidden_vendor": ["You found the chest, so I suppose you've earned a look. Epic and Legendary goods, quiet prices.","{villain}'s tax collectors don't know this stall exists. Let's keep it that way. Shh."],
"town.arena.name": ["The Undercroft"],
"town.arena.locked": ["A cellar hatch beside the old cottage, chained shut. Someone has scratched two little crossed swords into the wood.", "Somewhere below, very faintly, someone is rehearsing the word CHAMPION. Not yet, apparently."],
"town.arena.announce": ["Word around the square: the abandoned cottage at the end of Champions' Road has started roaring at night.", "From the cellar. Somebody brave should check the hatch. Somebody like you."],
"town.arena.intro": ["WELCOME TO THE UNDERCROFT, CHAMPION! I AM ANNOUNCER GRAND BELLOWS, KEEPER OF THE SAND! (normal voice) Mind the third stair. It's loose, and it holds a grudge.", "For a thousand years the four Paths settled their rivalries in the old arena, until {villain} chained the doors. SO WE DUG.", "Since you freed a zone, THE RING IS OPEN! Battles and puzzles, tiers one to three, with prizes: ring-exclusive gear, gold, essence!", "First clears pay out. Repeats are for GLORY. And for snacks. I brought snacks."],
"town.arena.return": ["THE SAND IS HOT AND THE CEILING IS LOW! Pick a fight, champion - the crowd is mostly my echo, and he agrees with EVERYTHING!"],
"town.alchemist.name": ["Auntie Alembic's"],
"town.alchemist.locked": ["The door of Auntie Alembic's is bolted. A note is pinned to it in green ink, in what looks like four handwritings at once:", "'CLOSED UNTIL TWO ZONES ARE FREE. {villain} TOOK MY CAULDRON. I AM BREWING IN THE SINK. THE SINK IS COPING. - A.'"],
"town.alchemist.announce": ["With two zones free, a cauldron bubbles to life in {town}. Auntie Alembic's is open! Bring essence. Bring courage. Bring a fire blanket."],
"town.alchemist.intro": ["Auntie Alembic, dear: alchemist, and keeper of some very nervous glassware. Don't touch anything. ...Oh, fine, touch that one. It likes you.","When you collect more copies of a card than you can carry, dear, the extras boil down into essence of that card's Path. Nothing goes to waste here.","Bring me six essence each of two Paths, plus 100 gold, and I'll brew you a card of BOTH. Which card is up to the cauldron, and now and then it's on fire. I only take what the brew needs; the rest stays in your jars.","Your jars hold eighteen of a Path. Past that it evaporates, and my ceiling gets a new colour.","They say there was one spring once, the Wellspring, that fed all four Paths. Everything mixed at the source, dear. That is the kingdom I brew for."],
"town.alchemist.return": ["Six essence each of two Paths and 100 gold, dear, and the cauldron does the rest. Lower your voice near the red flask. It takes things personally."],
"town.alchemist.quest_gift": ["Oh, and here. A starter jar of every Path, six of each. Enough for one brew of any two. Don't drink it. People drink it."],
"town.alchemist.need_more": ["You do not have enough essence of two different Paths yet. Collect more duplicates, then come back. The cauldron will wait.", "The cauldron is patient. Please don't confuse patience with having had lunch."],
"zone.complete.beefcake.title": ["THE GAINLANDS ARE FREE!"],
"zone.complete.beefcake.body": ["Chancellor Clench is down, Grandmaster Flex is back, and the weights are in the gym. The mills turn at a sensible pace; Gary lifts with a spotter."],
"zone.complete.gourmand.title": ["THE ENDLESS BUFFET IS FREE!"],
"zone.complete.gourmand.body": ["The Doppelganger is exposed, the Special Sauce is recalled, and the real Grand Chef is back in her own kitchen with the golems guarding plates again. Nobody leaves hungry."],
"zone.complete.necrocrat.title": ["THE D.N.A. IS FREE!"],
"zone.complete.necrocrat.body": ["Mortimer Grimsby is removed from office, and the vacancy passes by policy to the senior-most applicant on file: Agnes Overdue. The Department of Necrotic Affairs belongs to itself again, and it is terrified by the freedom."],
"zone.complete.refusemancer.title": ["THE VERDANT DUMP IS FREE!"],
"zone.complete.refusemancer.body": ["The Rotheart has gone silent and the vines are only vines again. The Archdruid is herself once more, deeply apologetic about the barn, and slowly the land begins to heal."],
"zone.complete.count": ["%d of 4 zones free"],
"town.objective": ["{villain} rules the four Paths through his rulers. Beat each road's gatekeeper, then free its zone by beating the boss of its main dungeon.","The imperial road to the Capital is open from the start, but its broken services will flatten you. Free the zones first. Gatekeeper Brannoch can explain."],
"town.objective.free": ["All four Paths are free. Buy cards, test yourself in the Undercroft, and brew something dangerous at the Alchemist's."],
"town.elder.postgame": ["{villain} is gone, and the Paths are shouting at each other in the street again. I have never been so glad to be annoyed.", "The Capital is open to everyone now, and your decks may mix any Paths you like. Go and see what you can make of it, dearie. Then come home and eat."],
"town.objective.postgame": ["{villain} has fallen and the Paths are free to mix. Build decks from three or four Paths at once, try the Alchemist's tri-Path crafting, test yourself in the Undercroft and visit the changed Capital."],
"town.arena.unlock_line": ["Something under the old cottage at the end of Champions' Road is open for business. Listen for the crowd."],
"town.alchemist.unlock_line": ["Auntie Alembic's, the Alchemist, is now open in {town}. Bring your leftovers."],
"town.pack_vendor.name": ["Foil Fenwick"],
"town.pack_vendor.title": ["Fenwick's Sealed Goods"],
"town.pack_vendor.first": ["Psst... hear that crinkle? That's possibility, with excellent packaging.", "Foil Fenwick, Purveyor of Sealed Goods - packs only. Open one where the light's good; if I cry, I want to see what I'm crying about.", "Here's how it works: whenever a Path's final dungeon falls, that Path sends me its pack. Don't ask how. There's a great deal of foil and no paperwork at all, which the Necrocrats find upsetting.", "Free a zone and I'll stock its pack; until then it's just a rumour in a wrapper. Browse, sniff if you like. I won't judge. I sniff."],
"town.pack_vendor.return": ["Browse, sniff, but don't shake the packs. ...A little, then; I'm a collector, not a strong person.", "A repeat customer... shh, listen to that foil. You understand me, and I don't know what to do with that."],
"town.pack_vendor.prismatic_reveal": ["Fenwick pulls a curtain aside. \"The back room. Prismatic packs: every Path in one wrapper.", "They only exist because the Paths are talking to each other again. Terrible for my exclusivity. Wonderful for my sales.\""],
"pack.vendor.bought": ["Crinkle! You've made a wrapper very happy.", "Sealed, signed, and slightly warm.", "No refunds on bad luck. Bad luck is non-transferable.", "It wants to be opened. I'm trying to respect its wishes without getting involved."],
"pack.vendor.poor": ["Gold, friend. The foil does not accept good intentions.", "Not enough gold. The wrapper can tell."],
"pack.vendor.locked": ["Not yet. That one is still a rumour in a wrapper."],
"town.tailor.name": ["Pip Threadwell"],
"town.tailor.title": ["Threadwell's Hats & Hems"],
"town.tailor.line": ["Look closely. Every stitch tells a story; the good ones tell it with a feather."],
"town.tailor.first": ["Hat! Hat. Marvellous head. Hold still: your left shoulder is a size braver than your right.", "Pip Threadwell, Haberdasher and Hemmer! Everything in here is purely cosmetic. It will not make you stronger, braver or better at card games.", "It will make you LOOK all three, which is eighty percent of the job. Try anything on in the little mirror first: hats up top, cloaks down the back, dye on both.", "Free zones and climb levels, and I will find grander stock. I hear rumours of rarer pieces, too. People tell hatmakers everything."],
"town.tailor.return": ["Back to change your mind and your hat? Excellent - one of those I can fit properly.", "My favourite head, in the nick of time! Brim, brooch or billowing - this could be a hem-ergency."],
"town.tailor.progress": ["Oh, you have been busy. New fabrics arrived. Do not ask where from. Some of them were yelling.", "Stock has grown! Freed zones send me their finest fashions. Slightly singed, mostly fabulous."],
"town.tailor.secrets": ["Between us: a crown made of living leaves is growing in a bin somewhere in the Verdant Dump. And a cloak that has survived more than you have is draped over a chest on a muscly island.", "And the Capital's mantle... well. Someone must defeat its owner first. The mantle, frankly, is rooting for you."],
"tailor.bought": ["Gorgeous. Truly. You are going to turn heads, mostly in confusion.", "Wear it out! A hat cannot have an entrance if you keep it in a bag!", "Sold! Such a dramatic fit - the hat looks surprised to be wearing you."],
"tailor.poor": ["Gold, my dear head. Thread is not free, and neither is my charm.", "A little more gold, my dear head. I can work wonders with fabric, but it insists on being paid for."],
"tailor.locked": ["Not yet. That one is still on the sewing table, and it is sulking."],
"tailor.equipped": ["Hat! On the head, where hats belong. My work here is done. Briefly.", "A classic. Wear it like you mean it, and tilt it a fraction left. Your left. No, my left. Perfect."],
"tailor.bare_head": ["No hat. Bold. Brave. Wrong, but brave.", "The bare-head look! I shall lie down in the back for a moment. Carry on."],
"tailor.owned": ["You own that one already! Do introduce it to the outside world."],
"tailor.plain_cloak": ["The Plain Cloak, undyed! Classic. Humble. Secretly the best cut in the shop. I made it, so I would know."],
"tailor.dyed": ["A new colour! Hold still while the cloak gets used to it. Gasp. It suits you. It suits it.", "Dyed and dried! Walk into the light. No, more light. There. Devastating."],
"tailor.cloak_on": ["Cloak! Over the shoulders, swishing on cue. Do turn around once. For me.", "A cloak with a past. You will give it a future. Mind the hem on stairs."],
"pack.hint.path_beefcake": ["Stocked once the Gainlands' final dungeon is cleared."],
"pack.hint.path_gourmand": ["Stocked once the Endless Buffet's final dungeon is cleared."],
"pack.hint.path_refusemancer": ["Stocked once the Verdant Dump's final dungeon is cleared."],
"pack.hint.path_necrocrat": ["Stocked once the D.N.A.'s final dungeon is cleared."],
"pack.hint.gilded_beefcake": ["Fig can only get these once the Gainlands are free."],
"pack.hint.gilded_gourmand": ["Fig can only get these once the Endless Buffet is free."],
"pack.hint.gilded_refusemancer": ["Fig can only get these once the Verdant Dump is free."],
"pack.hint.gilded_necrocrat": ["Fig can only get these once the D.N.A. is free."],
"pack.hint.general_2": ["The back crates open at level 10, or once two zones are free, whichever comes first."],
"pack.hint.prismatic": ["Unlocks after the final victory."],
"pack.card_vendor.title": ["Sable's Sealed Surprises"],
"pack.card_vendor.line": ["Sable pats a stack of wrapped bundles. \"Surprise packs, darling. Fresh from the crates, and I never ask a crate where it has been.", "What's inside? The crate has declined to comment, darling, and I admire a professional.\""],
"pack.card_vendor.tier2": ["Sable grins at you. \"The back crates are open, darling - more cards, bigger surprises, the same discreet fainting policy.\""],
"pack.black_market.title": ["Fig's Gilded Goods"],
"pack.black_market.line": ["Fig Sly taps a gold-edged wrapper. \"Guaranteed good stuff. Do not ask where the guarantee comes from.", "It is not legal. It is, however, very shiny.\""],
"pack.reward.clear": ["The Path sends you its pack: %s."],
"pack.reward.first_bonus": ["First clear bonus: %s."],
"pack.reward.vendor_unlock": ["Foil Fenwick now stocks the %s."],
"pack.reward.title": ["Packs received"],
"pack.reward.primm": ["Every Path sends a thank-you: %s."],
"pack.reward.quest": ["Pack reward: %s."],
"arena.tier.1": ["Bronze Sand"],
"arena.tier.2": ["Silver Sand"],
"arena.tier.3": ["Gold Sand"],
"arena.tier.1.blurb": ["Where every champion starts: loud, dusty and mostly forgiving."],
"arena.tier.2.blurb": ["The crowd has stopped laughing and started betting."],
"arena.tier.3.blurb": ["Only legends stand here. Only the sand remembers who fell."],
"arena.arena_warmup.title": ["Warm-Up Brawl"],
"arena.arena_warmup.blurb": ["A rookie gladiator rattles inside oversized armor. Bring your own deck; the armor has enough room for its own audience."],
"arena.arena_warmup.rules": ["Your own deck, full HP. Win the duel."],
"arena.arena_lethal_lunch.title": ["Lethal Lunch"],
"arena.arena_lethal_lunch.blurb": ["The lunch rush has an enemy blocker, ten HP and no mercy. You have exactly one turn and just enough energy."],
"arena.arena_lethal_lunch.rules": ["PUZZLE: win THIS turn. Preset board. If the turn ends and your opponent still stands, you lose."],
"arena.arena_neutral_mile.title": ["The Neutral Mile"],
"arena.arena_neutral_mile.blurb": ["The Marshal's favorite warm-down: no Paths, no tricks, no excuses. Everyone fights with a borrowed gladiator's kit."],
"arena.arena_neutral_mile.rules": ["RESTRICTED DECK: you fight with the Gladiator's Kit (neutral cards), not your own deck."],
"arena.arena_hold_the_line.title": ["Hold the Line"],
"arena.arena_hold_the_line.blurb": ["A stampeding squad charges across the sand before you can even take a breath. You only have to outlast them."],
"arena.arena_hold_the_line.rules": ["PUZZLE: survive 3 of the enemy's turns. Preset board; the enemy moves first. You win when the third enemy turn ends and you still stand."],
"arena.arena_spells_only.title": ["Spells Only, Please"],
"arena.arena_spells_only.blurb": ["The Cardboard Colossus does not like being hit by anything with a heartbeat. Win without playing a single unit."],
"arena.arena_spells_only.rules": ["RESTRICTED DECK + RULE: you fight with the Spellslinger's Satchel and may NOT play unit cards this duel."],
"arena.arena_four_fists.title": ["The Four Fists"],
"arena.arena_four_fists.blurb": ["A champion who fights with every Path at once, and has a fist for each. Bring your best deck."],
"arena.arena_four_fists.rules": ["Your own deck, full HP. Win the duel."],
"arena.arena_zero_to_hero.title": ["Zero to Hero"],
"arena.arena_zero_to_hero.blurb": ["The Wall of Fame has two blockers and eleven HP. The crowd has already booked your funeral. Show them lethal."],
"arena.arena_zero_to_hero.rules": ["PUZZLE: win THIS turn. Preset board, five energy, two blockers to deal with."],
"arena.arena_marshal.title": ["The Marshal"],
"arena.arena_marshal.blurb": ["Announcer Grand Bellows steps onto the sand. He has not lost a bout in eleven years. He is smiling, and so is the moustache."],
"arena.arena_marshal.rules": ["Your own deck, full HP. Win the duel. No excuses."],
"arena.screen.title": ["The Undercroft"],
"arena.screen.locked": ["The gates are chained until the first zone is free."],
"arena.screen.cleared": ["CLEARED"],
"arena.screen.new": ["NEW"],
"arena.screen.replay": ["Replay (no prize)"],
"arena.screen.fight": ["Fight"],
"arena.screen.first_prize": ["First-clear prize"],
"arena.screen.puzzle": ["PUZZLE"],
"arena.screen.battle": ["BATTLE"],
"arena.won.first": ["VICTORY ON THE SAND - THE PRIZE IS YOURS! (normal voice) Mind your head on the way up to collect it. The ceiling doesn't celebrate."],
"arena.won.replay": ["ANOTHER WIN FOR THE BOOKS! (normal voice) Here's a few coins from the crowd. The crowd is me, but I mean every one of them."],
"arena.lost": ["NOT THIS TIME, CHAMPION! Come back whenever you're ready; the sand has yet to win a rematch."],
"arena.puzzle.won": ["PUZZLE SOLVED - THE CROWD GOES WILD! (normal voice) Lovely bit of thinking, that. I could hear the gears turning from the booth."],
"arena.puzzle.lost": ["THE PUZZLE WINS THIS ROUND! (normal voice) Have a good long look at the board and try again. It's not going anywhere, and neither am I."],
"travel.title": ["The Beefcake Rift Express"],
"travel.subtitle": ["Rips while-you-wait. Tips accepted in protein."],
"travel.here": ["You are here. A Rip is stationed here."],
"travel.locked.name": ["???"],
"travel.locked.blurb": ["No station yet. Walk into that town yourself and a cousin will turn up and rip one into the nearest wall."],
"travel.warning": ["Ripping out of a zone ends your visit: you arrive at full HP, and the roaming enemies there come back. Rips are free, and so is the spotting."],
"travel.button": ["Rip me there!"],
"travel.close": ["Not today"],
"travel.operator.town": ["Rip Tearson, Rift Technician"],
"travel.operator.necrocrat": ["Rip Tearson (Cousin #2)"],
"travel.operator.beefcake": ["Rip Tearson (Cousin #3)"],
"travel.operator.gourmand": ["Rip Tearson (Cousin #4, the One Who Eats)"],
"travel.operator.refusemancer": ["Rip Tearson (Cousin #5, Smells Fine)"],
"travel.operator.final": ["Rip Tearson (Cousin #7, Allegedly)"],
"travel.station.town.name": ["{town}"],
"travel.station.town.blurb": ["The home station. A well-supported sky is a happy sky."],
"travel.station.necrocrat.name": ["The Department of Necrotic Affairs"],
"travel.station.necrocrat.blurb": ["The elevator lobby, where a cousin ripped it into the wall beside the Out-Of-Order sign. It's the only thing in the building that works."],
"travel.station.beefcake.name": ["The Gainlands: Swole Station"],
"travel.station.beefcake.blurb": ["Between the hot tub and the protein stand, where the gains are public."],
"travel.station.gourmand.name": ["The Endless Buffet: The Grand Pantry"],
"travel.station.gourmand.blurb": ["A short walk from the heavy meal table. The cousin ripped it open right by the napkins, so you'll never arrive without one."],
"travel.station.refusemancer.name": ["The Verdant Dump: The Compost Grange"],
"travel.station.refusemancer.blurb": ["Right by the harvest table. The Rip on duty is slightly damp, but then so is everything else out there."],
"travel.station.final.name": ["{capital}: The Crease"],
"travel.station.final.blurb": ["A rip into the hideout under the Capital. Don't ask how we found it; we followed the smell of Fig Sly's hot sauce straight through the fabric of space."],
"travel.intro.town": ["HNNNGH. SPOTTER! Spot me! No, not you, the other guy. ...Hello. Welcome to the Beefcake Rift Express.", "We tear the world open so you don't have to walk, buddy. Two men hold the sky - that's our overhead.", "The sky is heavier than it looks, buddy, so we never skip sky day. Do not look at the seam. It's working very hard and it's shy about it.", "Reach a new town and we send a cousin to rip a station there. Every one of them is called Rip. Our mother found a name she liked and saw no reason to stop.", "After that, you can rip between any two stations. Thank you for ripping with the Express. Please keep your elbows inside the sky."],
"travel.return.town": ["Back for another rip, buddy? Say where and we'll tear it right open. Rips are free, same as always.", "Spotting is free, buddy. Water, sadly, you'll have to bring yourself."],
"travel.intro.zone": ["HNNNGH... Rip Tearson, Beefcake Rift Express, serving this exact spot. I'm a cousin; we hire entirely on relative strength.", "We are all very proud of one another and rarely speak.", "Say where, buddy. We will rip it."],
"travel.return.zone": ["Need a rip, brother? I've held this sky since breakfast, and I'd hate to put it down with no one through it."],
"travel.intro.final": ["Shhh. Keep it down, buddy, there's a Wrinkle asleep behind the crates. Rip Tearson, Cousin Number Seven, Rift Express. Allegedly.", "They told me this place didn't exist, so I ripped a hole to it anyway. Sometimes you just have to believe in yourself. The sauce smell helped."],
"travel.rip.1": ["Grab the edges! On three! One!", "...Two! ...What comes after two? ...RIP!"],
"travel.rip.2": ["Hold the sky, brother! Feel the burn! RRRRRIP!"],
"travel.rip.3": ["Spot this whole dimension, brother! Lift with your LEGS! Nobody ever tore the sky open with their lower back!"],
"travel.rip.4": ["Loosen the shoulders. Roll the neck. Tear a hole in the fabric of space. And never, ever skip leg day."],
"travel.rip.sound": ["RIIIIIIP!"],
"travel.arrive.town": ["The rift folds shut behind you with a very satisfied pop. A nearby Beefcake flexes at the hole to say well done."],
"travel.arrive.necrocrat": ["The rift drops you by the lobby elevator and pops shut. You catch a fluttering memo: YOU WERE NOT AUTHORIZED TO ARRIVE.", "You turn the memo over, looking for an approved way to have arrived. There isn't one."],
"travel.arrive.beefcake": ["The rift spits you out next to the Swole Station. A passing brute gives you a thumbs-up, then another to himself, then one to the hole."],
"travel.arrive.gourmand": ["You land in the Pantry, and someone hands you a napkin before you've found your feet."],
"travel.arrive.refusemancer": ["You arrive at the Grange in a whiff of ozone, mulch and gym sock, and the gym sock is definitely the Express."],
"travel.arrive.final": ["The rift spits you out in the Crease. Somebody says shh. Somebody else says it was not them. The rift closes politely."],
"travel.unlock.title": ["Rift Station ripped"],
"travel.unlock.toast": ["A Beefcake cousin has ripped a Rift Station into this town. Fast travel unlocked."],
"travel.unlock.necrocrat": ["Rift Station unlocked: the Department of Necrotic Affairs. A cousin ripped it in beside the Out-Of-Order sign. Fast travel to and from here is now open."],
"travel.unlock.beefcake": ["Rift Station unlocked: the Gainlands. Two cousins have ripped it in with their bare hands and are now doing a victory pose. Fast travel to and from here is now open."],
"travel.unlock.gourmand": ["Rift Station unlocked: the Endless Buffet. A cousin ripped it in, then asked if there were seconds. Fast travel to and from here is now open."],
"travel.unlock.refusemancer": ["Rift Station unlocked: the Verdant Dump. A cousin ripped it in, then looked at his hands, then at the hole, then at his hands again. Fast travel to and from here is now open."],
"travel.unlock.final": ["Rift Station unlocked: the Crease, the hideout under the Capital. A very quiet cousin ripped it in. Fast travel to and from here is now open."],
"travel.prompt": ["Use the Rift Station"],
"travel.sign.town": ["BEEFCAKE RIFT EXPRESS", "Rips while-you-wait. Space torn to order. No refunds on the sky."],
"travel.sign.zone": ["BEEFCAKE RIFT EXPRESS", "A cousin is on duty. Do not look at the seam."],
"travel.station.forest.name": ["The Forest Outside {town}"],
"travel.station.forest.blurb": ["A hasty rip between the trees where you first woke up. There's a hatch south of the clearing now that nobody remembers being there, and it smells like a hospital."],
"travel.operator.forest": ["Rip Tearson (Cousin #8, Mossy)"],
"travel.sign.forest": ["BEEFCAKE RIFT EXPRESS", "FOREST STATION", "(Please do not eat the hatch.)"],
"travel.intro.forest": ["HNNNGH. Rip Tearson, Cousin Number Eight, rift technician and tree enthusiast. This is where I found the hatch, buddy, and no, I didn't open it.", "I have manners. Mostly.", "Say the word and I'll rip you back to {town}. Or, if you're going down the hatch, I'll hold the sky open till you're back up."],
"travel.return.forest": ["Back to {town}, buddy, or down the hatch? Either way, I've been holding this sky since breakfast and it's ready when you are."],
"travel.arrive.forest": ["Forest station! Mind the roots. And the hatch. Mostly the hatch."],
"travel.forest_tip": ["Spotter! Big news. You know that forest outside town, where you first turned up?", "I went up there on my day off and saw some very interesting things. The brambles south of the clearing just... let go, and there's a path now, with a hatch at the end that was NOT there before. Glowing roots, and a hospital smell.", "I did not open it. I have manners, and also I am scared. But I did put a rift station up there, so you can pop over whenever you like.", "It is on the Express now. Come to any of my stations, say 'forest', and I will tear it right open.", "Whatever is under that hatch, it is yours, I think. It feels like yours. Be careful, buddy."],
"postgame.rescuer.freed": ["You came back for me. Down there, on purpose. I'm going to need a while to stop being cross about it.", "Finish it, Tess. I'll be here. I've had a lot of practice waiting in this forest."],
"postgame.rescuer.cleared": ["The Lab is quiet. For the first time in ten years I can hear the trees from down there.", "Dad is in {town}, listening to Maren. She let him have one slice of pie. One. I've never seen him so frightened."],
"travel.unlock.forest": ["Rift Station unlocked: the forest outside {town}. Rip has torn it open where you first woke up. Fast travel to and from here is now open."],
}
