[gd_resource type="Resource" script_class="StoryText" format=3]

[ext_resource type="Script" path="res://core/data/story_text.gd" id="1_st0ry"]

[resource]
script = ExtResource("1_st0ry")
awakening_lines = Array[String](["Where am I?", "What happened?", "My head... I remember a kingdom. Four Paths. A great, bright city where they all met. And then... nothing.", "...There. Light, through the rocks. That must be the way out."])
beefcake_npc_intro_lines = Array[String](["Cardio. Cardio. CARDIO. The regime says I'm an Envoy of the Beefcake Path. The regime puts pre-workout in the water. Every hour. EVERY HOUR!", "Commander Gristle's orders: nobody gets down the Beefcake Path without a spotter. I AM THE SPOTTER. Stand still and let me spot you - INTO THE NEXT ZIP CODE!"])
beefcake_npc_victory_lines = Array[String](["...it's quiet. First time in - I don't know how long. Thank you.", "The Gainlands is under the regime's thumb. They took the weights and locked up our leader, Heartlift, in the House of Gains. Free us. Please. Don't skip leg day on the way.", "Be careful out there. The pre-workout is in the water."])
beefcake_npc_defeat_lines = Array[String](["Ha! The pump's still mine.", "Come back when you can actually lift, shrimp. The regime approves of this message."])
gourmand_npc_intro_lines = Array[String](["Taste it. TASTE IT. The Special Sauce. It is in everything. It is in my soup. It is in my tea. It is in my soul. Delicious. Delicious. DELICIOUS.", "The Grand Chef has asked every envoy to taste test the roads. You will have to get through me first, little one. Yes, Chef!"])
gourmand_npc_victory_lines = Array[String](["The simmer let go. The sauce let go. I can taste plain bread again, and it's the best thing I've ever eaten.", "The Grand Chef is not the Grand Chef. He has the same face, but the real one never stopped tasting. There is a Test Kitchen at the far end of the Endless Buffet where they are building something that is NOT a casserole.", "Please free us. Yes, Chef. No, I mean it. Yes, you. You are the chef now."])
gourmand_npc_defeat_lines = Array[String](["Under-seasoned. Next!", "Try again when you have learned to cook. The Grand Chef will be thrilled."])
refusemancer_npc_intro_lines = Array[String](["The compost took hold of me long before I noticed. It spoke so softly. It was so warm. I stopped fighting it.", "Now the Rot speaks through my mouth, and it says: NOTHING GOES TO WASTE. NOTHING GOES TO WASTE. NOTHING GOES TO WASTE. LEAVE."])
refusemancer_npc_victory_lines = Array[String](["The Rot has loosened its grip. My apologies for its rudeness. Also for the moss.", "Our Archdruid, Fernwick Loam, was the first to be taken. The corruption came through the living world itself. It spreads from a place called the Rotheart, at the heart of the Verdant Dump. The plants there are alive in ways they should not be.", "Free him. Please. Take a handful of compost. For luck."])
refusemancer_npc_defeat_lines = Array[String](["The Rot is patient. It has all the time in the world, and so does the garbage.", "Come back when you can turn something rotten into something useful."])
necrocrat_npc_intro_lines = Array[String](["I was filing a form. It has been, I am told, ten years. The form is still in my hand. It is not finished.", "The authorization is valid. The authorization is valid. THE AUTHORIZATION IS VALID. I am an Envoy of the Necrocrat Path. You do not have a permit to pass. Please take a number. It is zero. It is always zero."])
necrocrat_npc_victory_lines = Array[String](["...I can hear my own thoughts again. I think I was Pending for a decade.", "{villain} did not corrupt us. He used our own rules against us. A perfectly valid transfer of authority, notarized and filed. We cannot unfile it, and we cannot disobey it. Even though we know. We all know.", "The Hall of Final Approvals is at the top of the D.N.A. Whoever signs the final approval holds the whole department. Go carefully. Or file a form."])
necrocrat_npc_defeat_lines = Array[String](["Not yet, then. The Necrocrats keep no schedule.", "Return whenever you're ready to lose again. We will process you shortly."])
equipment_vendor_intro_lines = Array[String](["Halt. ...Or don't. I'm not a gate, I'm a merchant's assistant. But you were going to stop anyway - I could see it in your gait. Security Protocol One: assess the gait.", "Wendell Cobb. Assistant to the Regional Merchant. Not the Regional Merchant. Assistant TO. Say it with me. No? Fine. It matters to me.", "Everything on this rack is inventoried, oiled, and accounted for under Security Protocol Seven, which I will not explain, because it is need-to-know and you do not need to know.", "I keep the rest under the counter. Do not reach for the drawer. The drawer is not for you. The drawer has never been for anyone."])
equipment_vendor_return_lines = Array[String](["Back again. Good - returning customers are the backbone of a healthy economy, and of my personal employee-of-the-month case file.", "The beets are coming in early this year. I'm choosing to see that as a sign.", "There's a bear that comes around some nights. We've reached an understanding: it doesn't ask about the beets, and I don't ask why it's there."])
graveyard_intro_lines = Array[String](["The stones here were stacked by hands that stopped moving a long time ago.", "Something under the cairn is still keeping count of its turns. It has been keeping count since before {villain} came.", "Touch it, and it will not stop counting until one of you does."])
graveyard_victory_lines = Array[String](["The counting stops. For now.", "Whatever was keeping time down there has nothing left to spend it on.", "The stones are just stones again. Take what it was guarding."])
graveyard_defeat_lines = Array[String](["It is still counting.", "Come back when you have more turns to spare than it does."])
quest_dialogue = {}
texts = {
"start.gate_title": ["Trial of the Hollow"],
"start.gate_prompt": ["A cold draft rises from the dark. {villain}'s wardens test everyone who wanders out of the old caves. This looks like the only way out. Go in?"],
"start.tunnel": ["A narrow gap in the old treeline - easy to miss, easy enough to slip through, if you're not afraid of a shortcut."],
"town.name": ["Concord Crossing"],
"town.elder.first": ["You made it out of the Hollow, and with a deck to your name. Not everyone does. Welcome to Concord Crossing, where the four Paths used to meet.", "Ten years ago, the Kingdom of Concordia was whole. Four Paths kept it running: the Beefcakes made the energy and moved us about, the Gourmands fed us, the Necrocrats handled our dead and their paperwork, and the Refusemancers hauled away the waste and tended the farms. Then {villain} came and took them, one by one.", "Each Path lives under an oppressive ruler now. Their envoys at the four gates have been turned or bound, and they will not let you pass until you beat them. Do, and the roads open. Free the zones. Free the kingdom.", "Buy cards from Sable, refine your deck at the station by the tavern, and come to me when you need a reminder of what we are fighting for."],
"town.elder.return": ["The Paths are still waiting. {villain}'s rulers hold the Gainlands, the Endless Buffet, the D.N.A. and the Verdant Dump. One zone at a time, hero.", "Build a better deck, and go carefully. Everyone here is counting on you."],
"town.elder.progress.1": ["One zone is free! The Arena, the Grand Clashatorium, has opened its gates for you. They are very excited. They are always very excited."],
"town.elder.progress.2": ["Two zones are free! Zinnia Vex has opened the Alchemist's shop, Crucible & Co. She asks for your leftovers, which, from her, is a compliment."],
"town.elder.progress.3": ["Three zones are free. Only one Path remains under {villain}'s thumb. I will not say what I'm feeling. I will say it is a lot of feelings."],
"town.elder.progress.4": ["All four Paths are free. Concordia is whole again. And somewhere out there, {villain} is watching. Rest. Then we finish this."],
"town.guard": ["You came back from the Hollow. Not many do on the first try. {villain}'s wardens use it to test newcomers.", "The gate stays open. The scavengers restock, and they pay well."],
"town.vendor.first": ["Well met, Wanderer! Sable the Trader, at your service.", "You start with common neutral cards, but the Paths are where the power is. Have a look, then check the Deck Station to put your purchases to use. Prices are fair, mostly. {villain}'s taxes are not."],
"town.vendor.return": ["Cards for coin, friend. Everything on the table is honest, mostly."],
"town.item_vendor.first": ["You look like you could use some supplies. Wick, at your service.", "Everything here is a one-time use in a fight - equip what you buy from the Character screen, then use it on your turn."],
"town.item_vendor.return": ["Potions, charms, one good tonic if you're feeling reckless. Equip what you buy from your Character screen to carry it into a fight."],
"town.hidden_vendor": ["You found the chest, so I suppose you've earned a look. Epic and Legendary goods, quiet prices. {villain}'s tax collectors don't know this stall exists."],
"town.arena.name": ["The Grand Clashatorium"],
"town.arena.locked": ["The great gates of the Grand Clashatorium are chained shut. A sign hangs from the chains:", "'CLOSED UNTIL THE FIRST PATH IS FREE. THE MANAGEMENT (FORMERLY IN HIDING).'"],
"town.arena.announce": ["The chains fall off the Grand Clashatorium's gates, one by one, and a roar rises from inside. 'CHAMPIONS WANTED!' The Arena is open!"],
"town.arena.intro": ["WELCOME, CHAMPION, to the Grand Clashatorium! I am Marshal Vesna Tuskmore, keeper of the sand. Four Paths settled their rivalries here for a thousand years, until {villain} chained the doors.", "Since you freed a zone, the gates are open. Battles and puzzles, tiers one to three, with prizes: arena-exclusive gear, gold, essence. First clears pay out. Repeats are for glory, and for snacks."],
"town.arena.return": ["The sand is hot and the crowd is louder than ever. Pick a fight, champion."],
"town.alchemist.name": ["Crucible & Co."],
"town.alchemist.locked": ["The door of Crucible & Co. is bolted. A note is pinned to it, in green ink:", "'CLOSED UNTIL TWO PATHS ARE FREE. THE USURPER CONFISCATED MY CAULDRON. I AM STILL BREWING IN THE SINK. - Z.V.'"],
"town.alchemist.announce": ["With two zones free, a cauldron bubbles to life in Concord Crossing. Crucible & Co., the Alchemist's, is open!"],
"town.alchemist.intro": ["Zinnia Vex. Alchemist. Do not touch anything. Fine, touch that one.", "Whenever you collect more than four copies of a card, the extras turn into essence of that card's Path. Bring me ALL the essence of two Paths, plus a little gold, and I will brew you a card of BOTH. Random. Unpredictable. Occasionally on fire."],
"town.alchemist.return": ["Back already? Good. Essence of two Paths, a little gold, and a lot of faith. That is the whole recipe."],
"town.alchemist.need_more": ["You do not have enough essence of two different Paths yet. Collect more duplicates, then come back. The cauldron will wait. The cauldron is patient. The cauldron is also hungry."],
"zone.complete.beefcake.title": ["THE GAINLANDS ARE FREE!"],
"zone.complete.beefcake.body": ["Commander Gristle is down, Grand Champion Heartlift is back, and the weights are back in the gym. The mills turn at a sensible pace. Somewhere, Gary lifts something."],
"zone.complete.gourmand.title": ["THE ENDLESS BUFFET IS FREE!"],
"zone.complete.gourmand.body": ["The False Aurelio is exposed, the Special Sauce is recalled, and the real Grand Chef is back in his kitchen. The golems guard plates again. Nobody leaves hungry."],
"zone.complete.necrocrat.title": ["THE D.N.A. IS FREE!"],
"zone.complete.necrocrat.body": ["The Registrar's authorization was revoked on a technicality. Form 1-A was filed on a Tuesday. The Department of Necrotic Affairs belongs to itself again, and it is terrified by the freedom."],
"zone.complete.refusemancer.title": ["THE VERDANT DUMP IS FREE!"],
"zone.complete.refusemancer.body": ["The Rotheart is silent. The vines are only vines. The Archdruid is himself again and deeply apologetic about the barn. The ecosystem begins to heal."],
"zone.complete.count": ["%d of 4 zones free"],
"town.objective": ["{villain} rules the four Paths through their rulers. Beat each Path's envoy at its gate, then free its zone by defeating the boss of its final dungeon. The last gate leads to the Capital and {villain} himself, and it is open, but you will want the Paths on your side. Buy cards, refine your deck at the Deck Station, and replay the Trial for gold."],
"town.objective.free": ["All four Paths are free. Buy cards, test yourself in the Grand Clashatorium, and brew something dangerous at the Alchemist's."],
"town.elder.postgame": ["{villain} is gone, and the Paths are shouting at each other in the street again. I have never been so glad to be annoyed. The Capital is open to everyone now, and your decks may mix any Paths you like. Go and see what you can make of it."],
"town.objective.postgame": ["{villain} has fallen and the Paths are free to mix. Build decks from three or four Paths at once, try the Alchemist's tri-Path crafting, test yourself in the Grand Clashatorium and visit the changed Capital."],
"town.arena.unlock_line": ["The Grand Clashatorium (the Arena) is now open in Concord Crossing!"],
"town.alchemist.unlock_line": ["Crucible & Co. (the Alchemist) is now open in Concord Crossing!"],
"arena.tier.1": ["Bronze Sand"],
"arena.tier.2": ["Silver Sand"],
"arena.tier.3": ["Gold Sand"],
"arena.tier.1.blurb": ["Where every champion starts: loud, dusty and mostly forgiving."],
"arena.tier.2.blurb": ["The crowd has stopped laughing and started betting."],
"arena.tier.3.blurb": ["Only legends stand here. Only the sand remembers who fell."],
"arena.arena_warmup.title": ["Warm-Up Brawl"],
"arena.arena_warmup.blurb": ["A gladiator rookie in oversized armor wants to see what you are made of. Bring your own deck."],
"arena.arena_warmup.rules": ["Your own deck, full life. Win the duel."],
"arena.arena_lethal_lunch.title": ["Lethal Lunch"],
"arena.arena_lethal_lunch.blurb": ["The lunch rush has an enemy blocker, ten life and no mercy. You have exactly one turn and just enough energy."],
"arena.arena_lethal_lunch.rules": ["PUZZLE: win THIS turn. Preset board. If the turn ends and your opponent still stands, you lose."],
"arena.arena_neutral_mile.title": ["The Neutral Mile"],
"arena.arena_neutral_mile.blurb": ["The Marshal's favorite warm-down: no Paths, no tricks, no excuses. Everyone fights with a borrowed gladiator's kit."],
"arena.arena_neutral_mile.rules": ["RESTRICTED DECK: you fight with the Gladiator's Kit (neutral cards), not your own deck."],
"arena.arena_hold_the_line.title": ["Hold the Line"],
"arena.arena_hold_the_line.blurb": ["A stampeding squad charges across the sand before you can even take a breath. You only have to outlast them."],
"arena.arena_hold_the_line.rules": ["PUZZLE: survive 3 of the enemy's turns. Preset board; the enemy moves first. You win when the third enemy turn ends and you still stand."],
"arena.arena_spells_only.title": ["Spells Only, Please"],
"arena.arena_spells_only.blurb": ["The Cardboard Colossus does not like being hit by anything with a heartbeat. Win without casting a single creature."],
"arena.arena_spells_only.rules": ["RESTRICTED DECK + RULE: you fight with the Spellslinger's Satchel and may NOT cast creature cards this duel."],
"arena.arena_four_fists.title": ["The Four Fists"],
"arena.arena_four_fists.blurb": ["A champion who fights with every Path at once, and has a hand on every card. Bring your best deck."],
"arena.arena_four_fists.rules": ["Your own deck, full life. Win the duel."],
"arena.arena_zero_to_hero.title": ["Zero to Hero"],
"arena.arena_zero_to_hero.blurb": ["The Wall of Fame has two blockers and eleven life. The crowd has already booked your funeral. Show them lethal."],
"arena.arena_zero_to_hero.rules": ["PUZZLE: win THIS turn. Preset board, five energy, two blockers to deal with."],
"arena.arena_marshal.title": ["The Marshal"],
"arena.arena_marshal.blurb": ["Marshal Vesna Tuskmore steps onto the sand. She has not lost a bout in eleven years. She is smiling."],
"arena.arena_marshal.rules": ["Your own deck, full life. Win the duel. No excuses."],
"arena.screen.title": ["The Grand Clashatorium"],
"arena.screen.locked": ["The gates are chained until the first zone is free."],
"arena.screen.cleared": ["CLEARED"],
"arena.screen.new": ["NEW"],
"arena.screen.replay": ["Replay (no prize)"],
"arena.screen.fight": ["Fight"],
"arena.screen.first_prize": ["First-clear prize"],
"arena.screen.puzzle": ["PUZZLE"],
"arena.screen.battle": ["BATTLE"],
"arena.won.first": ["Victory on the sand! The crowd roars, and the prize is yours."],
"arena.won.replay": ["Another win for the books. The crowd roars (and tosses you some coins)."],
"arena.lost": ["Not this time. The sand is patient: try again whenever you like."],
"arena.puzzle.won": ["Puzzle solved! The crowd goes wild."],
"arena.puzzle.lost": ["The puzzle got the better of you. Study the board and try again."],
"travel.title": ["The Beefcake Rift Express"],
"travel.subtitle": ["Rips while-you-wait. Tips accepted in protein."],
"travel.here": ["You are here. A Rip is stationed here."],
"travel.locked.name": ["???"],
"travel.locked.blurb": ["No station yet. Walk into the town there and a cousin will wake up and rip one into the wall."],
"travel.warning": ["Ripping out of a zone ends your visit: you arrive at full life, and the roaming enemies there come back. Rips are free. Beefcakes charge for spotting, and spotting is also free."],
"travel.button": ["Rip me there!"],
"travel.close": ["Not today"],
"travel.operator.town": ["Rip Brogan, Rift Technician"],
"travel.operator.necrocrat": ["Rip Brogan (Cousin #2)"],
"travel.operator.beefcake": ["Rip Brogan (Cousin #3)"],
"travel.operator.gourmand": ["Rip Brogan (Cousin #4, the One Who Eats)"],
"travel.operator.refusemancer": ["Rip Brogan (Cousin #5, Smells Fine)"],
"travel.operator.final": ["Rip Brogan (Cousin #7, Allegedly)"],
"travel.station.town.name": ["Concord Crossing"],
"travel.station.town.blurb": ["The home station. The sky here is well maintained."],
"travel.station.necrocrat.name": ["The Department of Necrotic Affairs"],
"travel.station.necrocrat.blurb": ["The elevator lobby. A cousin ripped it into the wall beside the Out-Of-Order sign. It is the only thing in the building that works."],
"travel.station.beefcake.name": ["The Gainlands: Swole Station"],
"travel.station.beefcake.blurb": ["Between the hot tub and the protein stand, where the gains are public."],
"travel.station.gourmand.name": ["The Endless Buffet: The Grand Pantry"],
"travel.station.gourmand.blurb": ["A short walk from the heavy meal table. The cousin ripped it open just by the napkins."],
"travel.station.refusemancer.name": ["The Verdant Dump: The Compost Grange"],
"travel.station.refusemancer.blurb": ["Right by the harvest table. The Rip is slightly damp. So is everything."],
"travel.station.final.name": ["Neatropolis: The Crease"],
"travel.station.final.blurb": ["A rip into the hideout under the Capital. Do not ask how we found it. We followed the smell of Fig Sly's hot sauce through the fabric of space."],
"travel.intro.town": ["SPOTTER! Spot me! No, not you, the other guy. Welcome to the Beefcake Rift Express, where we tear a hole in the fabric of the world so that you do not have to walk.", "It is a two-man job. One man holds the sky open and the other man... also holds the sky open. The sky is surprisingly heavy. Do NOT skip sky day.", "Rule one: do not look at the seam. Rule two: it is not a seam, it is a PUMP. Rule three: I have forgotten rule three. It was probably about the pump.", "Every town you reach, we send a cousin ahead to rip a station into the wall. They are all named Rip. We ran out of names around cousin four. Walk into a town, and its station wakes up. Then you can rip between any two of them."],
"travel.return.town": ["Back for another rip, little buddy? Say where, and we will tear it right open. Rips are free. Spotting is free. Hydration is on you."],
"travel.intro.zone": ["Rip Brogan, Beefcake Rift Express, now serving this exact spot. I am a cousin. The other Rips are also cousins. We are all very proud of one another and rarely speak.", "Say where. We will rip it."],
"travel.return.zone": ["Need a rip? Say where, brother. I have been holding this sky since breakfast and I am NOT putting it down until somebody uses it."],
"travel.intro.final": ["Shhh. Keep it down, there is a Wrinkle sleeping behind the crates. Rip Brogan, Cousin #7, Rift Express. Allegedly.", "I was told this place did not exist, so I ripped a hole to it. Sometimes you just have to want it. And the sauce smell helped."],
"travel.rip.1": ["Grab the edges! On three! One! ...Two! ...What comes after two? ...RIP!"],
"travel.rip.2": ["Hold the sky, brother! Feel the burn! RRRRRIP!"],
"travel.rip.3": ["Spotter, I need you to spot this whole dimension. Lift with your legs! Nobody lifts with their back! Lift with your LEGS!"],
"travel.rip.4": ["Loosen the shoulders. Roll the neck. Tear a hole in the fabric of space. And never, ever skip leg day."],
"travel.rip.sound": ["RIIIIIIP!"],
"travel.arrive.town": ["The rift folds shut behind you with a very satisfied pop. A nearby Beefcake flexes at the hole to say well done."],
"travel.arrive.necrocrat": ["The rift spits you out beside the lobby elevator. It closes with a pop. A memo flutters down: YOU WERE NOT AUTHORIZED TO ARRIVE. (This is a joke. Nobody here is authorized to anything.)"],
"travel.arrive.beefcake": ["The rift spits you out next to the Swole Station. A passing brute gives you a thumbs-up, then another to himself, then one to the hole."],
"travel.arrive.gourmand": ["The rift spits you out in the Pantry. Somebody hands you a napkin. You did not ask for one. You are not allowed to refuse it."],
"travel.arrive.refusemancer": ["The rift spits you out at the Grange. It leaves a faint smell of ozone, mulch and gym sock. That is how you know it was a real rip."],
"travel.arrive.final": ["The rift spits you out in the Crease. Somebody says shh. Somebody else says it was not them. The rift closes politely."],
"travel.unlock.title": ["Rift Station ripped"],
"travel.unlock.toast": ["A Beefcake cousin has ripped a Rift Station into this town. Fast travel unlocked."],
"travel.unlock.necrocrat": ["Rift Station unlocked: the Department of Necrotic Affairs. A cousin ripped it in beside the Out-Of-Order sign. Fast travel to and from here is now open."],
"travel.unlock.beefcake": ["Rift Station unlocked: the Gainlands. Two cousins have ripped it in with their bare hands and are now doing a victory pose. Fast travel to and from here is now open."],
"travel.unlock.gourmand": ["Rift Station unlocked: the Endless Buffet. A cousin ripped it in, then asked if there were seconds. Fast travel to and from here is now open."],
"travel.unlock.refusemancer": ["Rift Station unlocked: the Verdant Dump. A cousin ripped it in, then looked at his hands, then at the hole, then at his hands again. Fast travel to and from here is now open."],
"travel.unlock.final": ["Rift Station unlocked: the Crease, the hideout under the Capital. A very quiet cousin ripped it in. Fast travel to and from here is now open."],
"travel.prompt": ["Use the Rift Station"],
"travel.sign.town": ["BEEFCAKE RIFT EXPRESS", "Rips while-you-wait. Space torn to order. No refunds on the sky."],
"travel.sign.zone": ["BEEFCAKE RIFT EXPRESS", "A cousin is on duty. Do not look at the seam."],
}
