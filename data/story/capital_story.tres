[gd_resource type="Resource" script_class="ZoneStoryText" format=3]

[ext_resource type="Script" path="res://core/data/zone_story_text.gd" id="1_cap"]

[resource]
script = ExtResource("1_cap")
zone_id = "final"
lines = {
"hud.objective": ["The Capital: the walls are up and the Approved Gate is the only way in. Pass Captain Spotless's entry examination (a card battle), or find another way.", "HP does not come back after battles; rifts hurt; the hideout heals. {villain}'s Castle waits at the far end of the city."],
"hud.objective.inside": ["Find the Wrinkles' hideout: knock at the manhole near the gate. Help them with one quest for each Path, seal the rifts, and reach {villain}'s Castle at the north end. Each Path you free mends a broken city service."],
"hud.objective.freed": ["The Capital is free. The facade is down, the rifts are closed and the citizens are saying whatever they like, mostly to each other. The Crease is open to everybody."],
"ui.exit.title": ["Walk back down the road to {town}?"],
"ui.exit.body": ["Leaving the Capital ends this visit. Town heals you fully. The Approved Gate stays open for you, but every roaming officer, inspector and Tidy-Bot will be back next time, and so will the rifts."],
"ui.exit.body.freed": ["Leaving the Capital ends this visit, and Town heals you fully. Nobody will ask for an exit permit on the way out; the road is just a road again."],
"ui.gate.title": ["The Entry Examination"],
"ui.gate.body": ["Captain Spotless measures you against the Approved Visitor Standard: a hard card battle, his deck fair to nobody. Your HP carries in from the zone and nothing heals in between. Lose, and you wake outside, a little poorer."],
"ui.gate.button": ["Take the examination"],
"ui.main.title": ["{villain}'s Castle"],
"ui.main.body": ["The great doors stand open, which is worse than closed. Twenty-odd rooms of portraits and good intentions, then {villain} himself. HP carries in; nothing heals except at the shrines. Your zone's broken-service debuffs apply to every duel."],
"ui.main.body_cleared": ["{villain} is gone. The castle is just a very large, very tidy building now, and the portraits have started to peel. You may walk through it again for the memories (and the gold). HP carries in; nothing heals except at the shrines."],
"ui.main.button": ["Enter the castle"],
"fx.main_dungeon": ["You see your worried face in the gold handles of {villain}'s Castle. Beyond the doors, you smell floor wax and hear someone humming."],
"fx.gallery_sealed": ["The glass is cracked from the inside, and behind it the castle's halls go on in silver, too clean to be real. Wren would want to hear about this."],
"fx.gallery_enter": ["Behind the cracked glass the castle's halls go on in silver: every frame holds someone you beat, perfect and cold, waiting for you."],
"quest.cracks_in_the_glass.offer": ["Before you go, there is one entry I cannot close. The mirrors in his castle are still showing a kingdom that never was: straight streets, smiling people and nobody hungry.", "One of them, by the castle door, cracked from the inside last night, and I did not like what I saw behind it. Will you go and look, so that it can be written down by someone who was there?"],
"quest.cracks_in_the_glass.active": ["It is the mirror by the castle door, the one that cracked from the inside. Go and look into it, and then come back and tell me I imagined it. I would be glad to strike the entry out."],
"fx.main_dungeon.freed": ["The doors of {villain}'s Castle stand open, and the gold is flaking off them. A pigeon has built a nest in the crown above the lintel, and nobody has asked it for a permit."],
"fx.heal_couch": ["Nurse Hesper hands you a cup of the Tea of Dissent. It is strong, bitter and entirely unapproved. HP restored."],
"fx.heal_already": ["You are already at full HP. Nurse Hesper hands you a cup anyway. 'Dissent,' she says, 'is good for the circulation.'"],
"fx.hit": ["The Capital catches you hard, the way it catches everyone. (-HP)"],
"fx.hit_rift": ["A rift tears at you as you pass. The Capital has no record of it. (-%d HP)"],
"fx.hit_roamer": ["%s knocks you flat. Please remain orderly. (-%d HP)"],
"fx.wake": ["You wake up on a cot in the Crease. Nurse Hesper Dray is writing on a clipboard that, you notice, is blank on purpose.", "'Dragged you in by the collar. Tore up the correction fee they'd have charged you. Drink that, and then you can tell me why you keep arriving unconscious.'"],
"fx.wake.freed": ["You wake on a cot in the Crease. Nurse Hesper Dray looks up from her clipboard as if she has been expecting you for some time.", "'You fell over, so we rolled you in. No fee. There never was one, down here. Sit up slowly and drink the tea.'"],
"fx.wake_outside": ["You wake in the dust outside the Approved Gate. A guard leans over you, measuring your height with a long stick.", "'Falling down in the approved queue area is a minor offence, but the fine is waived, since you were unconscious for it. Up you get, citizen. I cannot measure you while you are lying along the ground.'"],
"fx.chest": ["A hidden stash! Someone hid this where {villain}'s inspectors would not look: behind something untidy."],
"fx.inside": ["You're through the walls. Somewhere above you a loudspeaker clears its throat, and you are now, officially, a Visitor in {capital}, the Capital of {kingdom}."],
"fx.no_travel": ["The service-tunnel network is down. The wheels that once turned the shaft lifts have spent ten years lighting the facade instead. 'No travel,' says a Wrinkle's note on the hatch.", "'Free the Gainlands and we will get the lifts turning.'"],
"fx.shaft": ["You drop down the shaft, ride the lift through the dark and climb out somewhere else, smelling of rust."],
"fx.ladder": ["You climb the ladder and push the manhole open. The Capital's cold light falls in."],
"fx.tunnel_out": ["You crawl out through the old tunnel and shove the rubble aside, and you're back in the Outskirts, a long way from anybody's approved queue."],
"fx.tunnel_in": ["You squeeze back down the collapsed shaft and follow the old tunnel in the dark."],
"fx.tunnel_found": ["Past the rubble and a toppled statue, a flight of stairs leads down to an old plaque: 'THE OLD JOINT WORKS. BUILT BY ALL FOUR PATHS, TOGETHER.'", "The tunnel runs under the wall, under the gate and under every one of {villain}'s checkpoints, and you walk beneath them all without being measured once. It's the best moment you've had all day."],
"fx.manhole": ["You knock three times, and the manhole opens on a hand and a tired voice that says, 'Down you come.'"],
"fx.manhole_first": ["There's a manhole by the wall with a small scratch on its lid, like a tiny wrinkle. You knock three times, without being able to say why.", "After a pause the lid lifts and a hand beckons you down. 'Wrinkle?' a voice mutters, and you decide that, yes, you probably are.", "You climb down a ladder and along a brick tunnel into a warm room full of mismatched furniture and people who are all, quite visibly, not ironed."],
"fx.deface": ["You draw a moustache on {villain_title}'s portrait. A small coin drops from the frame: the Wrinkles' bounty for this improvement."],
"fx.deface_again": ["Someone has already improved this one. With the moustache he looks, for the first time, like a person."],
"fx.complaint_compensation": ["You post a complaint. A coin drops from a slot with a note: 'Compensation for your inconvenience. Please use it to have less inconvenience.'"],
"fx.complaint_tea": ["You post a complaint. A hatch opens and a warm cup of tea is pushed out, still steaming. 'We value your concern,' says a note. You feel a little better."],
"fx.complaint_noted": ["You post a complaint. 'Noted,' says the box, gently, and after a long wait you understand that this was the whole service."],
"fx.complaint_inspector": ["You post a complaint, and a klaxon sounds. A Perfection Inspector appears from nowhere, measures your frown, writes you up and walks off.", "'Thank you for your feedback,' says the box."],
"fx.complaint_limit": ["The box rattles, full to the slot. It has had quite enough of your feedback for one visit."],
"fx.seal": ["You set the rift-stone and say the old word: close. The tear shudders, folds in on itself like a letter, and is gone. The air smells of rain. Sealed!"],
"fx.seal_guarded": ["The rift-stone will not take while the rift's guardian still stands. Whatever it spat out has to go first."],
"fx.seal_done": ["The rift is sealed. Where it was there is a scorch mark and the memory of a very bad idea."],
"fx.seal_cannot": ["This one is too big to seal. It runs all the way up into the castle, and it will only close when he does."],
"fx.pickup_recipe": ["A real recipe, written by hand, with a stain of actual sauce on the corner! Flour: some. Salt: enough. Time: until it smells right. It is wonderfully imprecise. You tuck it away."],
"fx.pickup_compost": ["A banished compost heap is hiding in a cellar where it was never allowed to be, still warm and still very much alive.", "It steams, very slightly, with gratitude. Rescued!"],
"fx.pickup_stamp": ["You unwrap a handkerchief and find a worn rubber stamp: FINAL APPROVAL. Someone hid it here, ready for the day it was needed."],
"fx.pickup_seed": ["An old glass jar holds a single seed, glowing very faintly green. Nobody has planted anything in the Capital for ten years, and the seed hasn't given up."],
"fx.pickup_again": ["You already took the one lying here."],
"fx.pickup_unknown": ["There is nothing here."],
"fx.wheel_1": ["The crew of the first wheel keeps running while you talk, because stopping is not permitted. 'Cardio,' pants a woman, 'is mandatory.' You find the brake lever under a pile of notices.", "The wheel groans, slows and stops. The crew sit on the floor and laugh and cry at the same time."],
"fx.wheel_2": ["The second wheel has been turning since some of its runners were too small to reach the pedals. A foreman's whistle hangs on a hook nearby, and you pocket it.", "The wheel winds down. 'We were told,' says a man, 'that this was how you got strong.'"],
"fx.wheel_3": ["The third wheel's crew are children in school caps. 'It is a school activity,' says a banner, but nobody has rung the bell in years.", "You pull the lever and lift them down one by one. They're very small and very proud, and they keep asking, 'Did Rollo send you?'"],
"fx.wheel_again": ["This crew is free. They're lying on their backs looking up at the sky, and it's the best they've felt in ten years."],
"fx.cable": ["You cut the big black cable from the wheels to the facade's lights. There is a spark, then silence, and far off the perfect lamps flicker and come back on: {villain} keeps a small private generator, just for himself."],
"fx.cable_again": ["The cable is cut. The wires twitch occasionally, out of habit."],
"fx.paste": ["You pull the lever and ask the Perfect Nutrient Paste Dispenser for a refund. It chokes, burps and covers itself in green foam that smells, fatally, of real cabbage. A paste machine is not supposed to remember cabbage."],
"fx.paste_again": ["The dispenser is spoiled and sulking. The foam is still fizzing a little."],
"fx.plot": ["With the Stamp of Final Approval pressed to the form, the grave plot's little iron gate unlocks. A line of mourners, who have waited three years outside, file in.", "You watch the neighbourhood carry Mr. Pell to his grave. Nobody holds a permit to sing, so they sing very quietly. Nobody stops them."],
"fx.plot_again": ["The Pell plot is tended and quiet, with fresh flowers on it. The family comes every morning now."],
"fx.plot_locked": ["The iron gate is sealed with a notice: 'NO BURIAL WITHOUT A STAMPED PERMIT (FORM 27-B/6, FINAL APPROVAL).' Widow Pell said a stamp was hidden in Grave Row, north of the permit office."],
"fx.patch": ["You kneel, scoop a hole with your hands and drop in the seed. You water it with what is left in your flask. Nothing happens, for one long, bad moment.", "Then a shoot as thin as a thread noses out of the dirt, and then another, and then a flower the colour of everything the Capital is not."],
"fx.patch_again": ["The patch is green and growing. A bee, which should not exist in the Capital, hovers over it, deciding."],
"fx.patch_locked": ["The patch is sick, grey and cracked, and nothing will grow in it without a seed. Old Fern mentioned an old seed in a jar, hidden somewhere in the Reek."],
"fx.permit_1": ["The clerk behind the window slides you a form. 'For a burial permit, Form 27-B. Please attach Form 27-C (Proof of Grief).'", "You ask for 27-C. 'Please attach Form 27-B,' she says."],
"fx.permit_2": ["'Form 27-C requires Form 27-B,' she says, 'and Form 27-B requires Form 27-C.' You point out, gently, that this is a loop.", "'It is a process,' she says, with fear in her eyes."],
"fx.permit_3": ["'Please take a number,' she says, so you take one, and it says 4,112,009.", "The sign above the window says NOW SERVING: 3. It has said so for three years."],
"fx.ward_window": ["You read: 'Spontaneity Permits: Thursdays, 3:00 to 3:05, by appointment.' Inside, the clerk sleeps upright, eyes open."],
"debuff.beefcake.name": ["Blackout"],
"debuff.beefcake.flavor": ["The Beefcakes kept the kingdom's energy and its roads: the wheels, the mills, the throwers and the portal-rippers. {villain} put them all on wheels to light one showpiece street. The rest of the kingdom went dark."],
"debuff.beefcake.freed": ["The lights are back on: the street lamps burn, the lifts run, the tunnels are open again, and the Beefcakes' wheels, free at last, turn for everyone."],
"debuff.gourmand.name": ["Famine"],
"debuff.gourmand.flavor": ["The Gourmands fed and guarded the kingdom. {villain} replaced them with Perfect Nutrient Paste. Real food is gone from the Capital, and so is the comfort it gave."],
"debuff.gourmand.freed": ["The food stalls have reopened: awnings, steam, lanterns, real food. Healing items work again, and the stomachs of the Capital are not quite so empty."],
"debuff.necrocrat.name": ["Restless Dead"],
"debuff.necrocrat.flavor": ["The Necrocrats looked after the dead and their paperwork. {villain}'s permits locked the dead out of their graves and the paperwork in an endless loop. The dead do not rest, and the things that have died keep coming back."],
"debuff.necrocrat.freed": ["The cemetery is calm: graves are tended, the permit loop has been broken, and the dead are finally allowed to lie down."],
"debuff.refusemancer.name": ["Clutter"],
"debuff.refusemancer.flavor": ["The Refusemancers took out the kingdom's waste and turned it back into soil. {villain} called composting untidy and hid the garbage behind the facade. Rubbish is piling up, in the streets and in your deck."],
"debuff.refusemancer.freed": ["The heaps are smaller and greener. Things are being composted again and the Reek smells, very faintly, of flowers."],
"debuff.rule.darkness": ["The Capital is dark and you can see only a short way."],
"debuff.rule.slow": ["You move more slowly."],
"debuff.rule.no_travel": ["The service-tunnel network is down: no travel."],
"debuff.rule.no_food_heal": ["Healing items do not work (food does not agree with the Capital)."],
"prop.facade_arch": ["THE SHOWCASE QUARTER"],
"prop.complaint_box": ["COMPLAINTS"],
"prop.compost_shack": ["COMPOST (ILLEGAL)"],
"prop.parlor": ["PELL FAMILY PARLOUR"],
"prop.permit_office": ["PERMIT OFFICE (BURIALS, CREMATIONS, DISCOURAGEMENTS)"],
"prop.paste_dispenser": ["PERFECT NUTRIENT PASTE. TASTES OF NOTHING. THAT IS THE POINT."],
"sign.gate_main": ["THE APPROVED GATE", "Visitors are welcome (conditions apply)."],
"sign.gate_main.freed": ["THE GATE (OPEN)", "Everybody is welcome. Conditions: none. Please do not feed the pigeons."],
"sign.gate_requirements": ["APPROVED VISITOR STANDARD", "1. Visitors must be of approved height.", "2. Visitors must be smiling at an approved angle.", "3. Visitors must not have unapproved opinions.", "4. Visitors must have already been approved."],
"sign.gate_requirements.freed": ["FORMER APPROVED VISITOR STANDARD", "1. Be of whatever height you are.", "2. Smile (or not).", "3. Have opinions (loudly).", "4. Come in."],
"sign.gate_exit": ["EXITS ARE CONTROLLED", "To leave, please obtain an Exit Permit, an Exit Interview and an Exit Interview Permit."],
"sign.gate_height": ["APPROVED HEIGHT", "Between this line and that line. Slouching is a violation. Standing on tiptoes is a violation.", "Having a height is, on balance, a violation."],
"sign.gate_inside": ["WELCOME TO {capital}", "The Capital. Population: neat. Remember: it is perfect. If it is not, that is your fault."],
"sign.gate_exit_inside": ["EXIT INTERVIEW", "All departures require an interview. Please explain how elsewhere could possibly be an improvement."],
"sign.facade_welcome": ["THE SHOWCASE QUARTER", "Every house in this quarter was built to show what the whole kingdom could be if everybody simply tried harder."],
"sign.facade_welcome.freed": ["WAS: THE SHOWCASE QUARTER", "Now: some houses, a very tidy lawn and a lot of citizens who would like to go home."],
"sign.facade_hats": ["APPROVED HAT SIZES", "Approved Hat Sizes: 1. A perfect fit is your responsibility.", "Hats of other sizes are a Disagreement."],
"sign.facade_spontaneity": ["SPONTANEITY BY PERMIT ONLY", "Fun may be had Thursdays 3:00 to 3:05. Please queue for fun."],
"sign.facade_spontaneity.freed": ["SPONTANEITY: NO PERMIT NEEDED", "Somebody has crossed out BY PERMIT and written BY SURPRISE."],
"sign.facade_smile": ["SMILING IS MANDATORY", "Please smile at least 70% of the time. Smile with your teeth. Mind the edges."],
"sign.facade_smile.freed": ["SMILING IS ENCOURAGED", "(somebody has written 'when you feel like it' underneath, in small neat letters)"],
"sign.facade_lawns": ["REGULATION LAWNS", "Grass shall be 2.0 cm tall. Do not walk on it. Your footprints have not been approved."],
"sign.facade_hedges": ["HEDGE LAW", "Hedges shall be square. Hedges that wish to be round must submit a request."],
"sign.facade_queue": ["THE ORDERLY QUEUE", "Queue here for the Orderly Queue. Any impatience must be expressed in order."],
"sign.facade_loudspeaker": ["LISTEN FOR YOUR ANNOUNCEMENTS", "Announcements are cheerful. Cheerfulness is not optional. Neither are announcements."],
"sign.facade_shop_1": ["BAKERY", "Fresh Approved Bread (Daily). Closed (Permanently)."],
"sign.facade_shop_2": ["BOOKS & WELLNESS", "Approved titles: 1. Approved wellness: 1."],
"sign.facade_back": ["SERVICE ENTRANCE", "(Not a real door. Please do not look behind it. There is nothing behind it.)"],
"sign.reek_main": ["THE REEK", "Formerly the Verdant Quarter. Now the place we put everything that does not look nice."],
"sign.reek_untidy": ["COMPOSTING IS UNTIDY", "By decree: all composting is outlawed. Rubbish shall be placed where it cannot be seen. That place is here."],
"sign.reek_compost_ban": ["NO COMPOST", "The act of composting is a form of Disorder. Offenders will be corrected."],
"sign.reek_behind_facade": ["ALL GARBAGE GOES BEHIND THE FACADE", "(It is not garbage. It is Behind.)"],
"sign.reek_sick_patch": ["THE SICK PATCH", "The soil here has stopped growing. Please do not ask why. Please do not plant anything. Please do not feel anything."],
"sign.net_reek": ["SERVICE SHAFT: THE REEK", "To the Crease. Wrinkles only. If you are not a Wrinkle, you did not see this."],
"sign.grave_main": ["GRAVE ROW", "Formerly the Cemetery of {kingdom}. Currently Closed Pending Review."],
"sign.grave_permit": ["PERMIT OFFICE", "Burial permit: Form 27-B. Attach Form 27-C. Form 27-C requires Form 27-B. Please queue."],
"sign.grave_queue": ["QUEUE FOR THE QUEUE", "Take a number to take a number. Your number is: 4,112,009. Now serving: 3."],
"sign.grave_waiting": ["WAITING (DEAD)", "The deceased are asked to remain in their parlours until a permit has been approved. Please do not wander."],
"sign.grave_plot": ["PELL FAMILY PLOT", "Reserved since before the permit system. Locked since the permit system."],
"sign.net_grave": ["SERVICE SHAFT: GRAVE ROW", "To the Crease. Living passengers only. The dead have asked to come down too; we are thinking about it. Be kind."],
"sign.transit_main": ["THE TRANSIT YARDS", "Where the kingdom's energy and its roads were made. Now: where the facade's lights are made."],
"sign.transit_cardio": ["MANDATORY CARDIO", "Every citizen shall run the wheels for six hours a day, so that the wheels never stop and the lights never go out. Your legs are not your own."],
"sign.transit_lines": ["TRAM LINES: SUSPENDED", "Trams must arrive on time. None did. All trams are suspended. Punctuality has improved considerably."],
"sign.transit_lights": ["THE LIGHTS OF THE FACADE", "Powered by You, personally."],
"sign.transit_cable": ["DO NOT CUT", "The big black cable is the facade's lifeline. Cutting it is a crime. Please do not cut it."],
"sign.net_transit": ["SERVICE SHAFT: THE TRANSIT YARDS", "To the Crease. Out of service: the lifts need the wheels, and the wheels are busy lighting a small town."],
"sign.hungry_main": ["THE HUNGRY QUARTER", "Formerly the Market of the Four Paths. Now: where everybody queues for the one approved meal."],
"sign.hungry_paste": ["PERFECT NUTRIENT PASTE", "One serving per citizen per meal. Every meal. Tastes of nothing. No preferences will be left unsatisfied."],
"sign.hungry_closed": ["ALL STALLS CLOSED", "Real food is a source of Individual Preference and has therefore been replaced."],
"sign.hungry_nutrition": ["NUTRITION IS NOT DELIGHT", "Delight is a form of inefficiency. Please eat in silence."],
"sign.hungry_menu": ["TODAY'S MENU", "Paste.", "The same as yesterday and the same as tomorrow. You may stop consulting the menu."],
"sign.net_hungry": ["SERVICE SHAFT: THE HUNGRY QUARTER", "To the Crease. There's a smell of real cooking coming up this shaft, and nobody ever mentions it."],
"sign.castle_main": ["THE CASTLE OF HIS PERFECTION", "Please do not stare. He can tell."],
"sign.castle_main.freed": ["THE CASTLE (FORMERLY OF HIS PERFECTION)", "Under new management. The new management is: all of us, arguing."],
"sign.castle_avenue": ["THE AVENUE OF PORTRAITS", "Each portrait has been improved. Please admire them in order."],
"sign.castle_warning": ["WARNING: TEARS IN REALITY", "{villain} has assured everyone that the tears are temporary. He has assured everyone of this for ten years."],
"sign.castle_warning.freed": ["WARNING: PIGEONS", "The tears are sealed. The pigeons have moved in, and they are staying."],
"sign.net_approach": ["SERVICE SHAFT: THE CASTLE APPROACH", "To the Crease. If you hear humming from the castle above, do not hum along."],
"sign.yard_main": ["CHECKPOINT ROW", "Seventeen checkpoints in one street. The last checks whether you enjoyed the first sixteen."],
"sign.yard_abandoned": ["ABANDONED CHECKPOINT", "The staff left in the night. They left their forms behind."],
"sign.yard_form": ["FORM 1-A (STAMPED)", "Authority transferred, reviewed, approved, notarized, filed. The authorization is valid. Nobody is here to enforce it."],
"sign.ward_main": ["THE CORRECTION WARD", "Citizens who smile incorrectly are sent here for improvement. Improvement takes as long as it takes."],
"sign.ward_permit": ["SPONTANEITY PERMIT WINDOW", "Thursdays, 3:00 to 3:05, by appointment."],
"sign.ward_rules": ["WARD RULES", "No laughter. No sighing. No unapproved crying.", "Crying must be done in the correct order."],
"sign.out_welcome": ["WELCOME TO THE CAPITAL OF {kingdom}", "Please join the approved queue and wait to be measured."],
"sign.out_queue": ["APPROVED QUEUE", "Queue here. You may not queue anywhere else. You may not queue here without a queue number. You may not have a queue number."],
"sign.out_abandoned_a": ["CHECKPOINT 14 (ABANDONED)", "It was a very good checkpoint. It checked everything."],
"sign.out_abandoned_b": ["CHECKPOINT 15 (ABANDONED)", "(somebody has drawn a moustache on the guard. It suits him.)"],
"sign.out_rift": ["WARNING: RIFT", "The tears are temporary and fully under control. (Scrawled below: the Paths tear where {villain} forced them into one shape. His hold is failing; it first slipped the night someone escaped the Ministry.)", "Do not touch. Do not look. Do not whistle."],
"sign.out_exit_rules": ["EXIT RULES", "To leave the Outskirts, walk back down the road. To leave the Capital, please see: the Exit Interview Booth."],
"sign.out_tunnel_clue": ["the old tunnel came out near here", "(a scrap of paper pinned under a stone: 'forgotten service shaft, SW of the wall, behind the fallen statue. Rubble is mostly for show.')"],
"sign.out_old_works": ["OLD JOINT WORKS: PROPERTY OF THE FOUR PATHS", "Closed and forgotten, and on nobody's map. (Try the south-west corner.)"],
"sign.plaza_main": ["CHECKPOINT PLAZA", "Please proceed in an orderly fashion, in the approved direction, at the approved speed, with the approved face."],
"sign.plaza_main.freed": ["THE PLAZA", "Proceed however you like. There is a very large statue; it is lying down."],
"sign.plaza_exit_interview": ["EXIT INTERVIEWS", "Departures require an interview. Interviews require an appointment. Appointments require a departure."],
"sign.plaza_complaints": ["THE ANONYMOUS COMPLAINT BOX", "Your complaint matters. Reading it remains optional."],
"sign.plaza_manhole": ["(a small scratch on the cover, like a wrinkle)", "Knock three times."],
"sign.net_plaza": ["SERVICE SHAFT: CHECKPOINT PLAZA", "To the Crease. Authorized personnel only. The authorization is: you knocked."],
"sign.crease_main": ["THE CREASE", "A Wrinkle is something that does not go away when you press it."],
"sign.crease_wrinkle": ["THE WRINKLES", "Founded by the people {villain} could not iron out. No dues, no forms, and nobody here has to smile."],
"sign.crease_network": ["THE SERVICE SHAFT NETWORK", "Built by all four Paths, together, back when we did that. Six shafts, six streets. (Beefcake wheels power the lifts. No wheels, no lifts.)"],
"sign.crease_rules": ["HOUSE RULES", "1. Say what you think.", "2. Eat what you like. 3. Wear a hat of any size.", "4. Do not tell anyone where we are."],
"npc.wren.intro": ["Another one down through the shafts. Sit, please. I'm Wren. I was the Royal Archivist once, and these days I keep the records this city isn't supposed to have.", "Maren sent word from {town} that someone might come. This is the Crease, and we're the Wrinkles: the people {villain} couldn't iron out. We have tea and grudges. The tea's better.", "He's in the castle at the north end, and he truly believes he is helping, which is the hard part. Talk to the people in the streets. Each of them carries a piece of what he did, and I want all of it in the record."],
"npc.wren.intro.freed": ["You did it. Sit down for a moment. I'm Wren, the Royal Archivist, and for ten years I kept the only honest record in this city.", "The Crease is only a cellar now, but we are keeping it. Too many true things were written down here to let it go.", "Thank you. I mean that more than I have ever meant a footnote."],
"npc.wren.return": ["Back in one piece? Good. Hesper charges by the piece.", "The records say that he began well. His very first decree put a hot lunch in front of every schoolchild, and I want you to remember that. It excuses nothing, but remember it."],
"npc.wren.return.freed": ["The kingdom is mending itself one argument at a time, and it's dreadfully inefficient. I have never been happier. Take your time."],
"npc.wren.insight.1": ["You've brought me something from the streets. It goes into the true record, in ink, where he can't correct it."],
"npc.wren.insight.2": ["That makes two pieces of him: a man who needs to be right, and a man who can't bear to be disagreed with. I can almost see his shape now."],
"npc.wren.insight.3": ["That makes three. He is afraid, you know, and it isn't you he's afraid of.", "He is afraid of everything that won't obey him. It's a small, sad sort of fear, for a man with so much gold."],
"npc.wren.insight.4": ["That's all four, and now I have the whole of him. He is not a monster.", "He is a man who made a list of everything he couldn't control, and then made every item on it illegal.", "Go and finish it. Gently, if you can. But finish it."],
"npc.fig.intro": ["Psst. Over here. Fig Sly, purveyor of contraband and curiosities.", "Everything on this table is illegal, uneven or both.", "Rare cards, good prices, no questions. Well: one question. Would you like a bag? Bags are illegal too."],
"npc.fig.intro.freed": ["Fig Sly, formerly purveyor of contraband. Now: purveyor of things. It is a much less exciting job.", "The margins are better. Take a look."],
"npc.fig.return": ["Back for more? Wise. Rare stock never lasts. Mind the one on the end: it bites."],
"npc.fig.return.freed": ["Still selling. Nobody arrests me. It is horrible. I miss the thrill."],
"npc.hesper.intro": ["Hesper Dray. Nurse. Sit. Drink.", "It's tea. Strong, bitter, unapproved. Finish the cup.", "The rifts? That's his hold failing. Everything he forced together is coming apart at the seams, and he keeps on stitching.", "It began the night the boy got out, they say. Don't say 'boy' near a loudspeaker."],
"npc.hesper.return": ["Bleeding again? Sit. I'll pretend to be surprised."],
"npc.fern.intro": ["Keep your voice down, will you? I'm Old Fern, and I'm a composter, which in this city is about the worst thing a body can own up to.", "Forty years I turned this city's scraps back into good soil, and then one morning it was all 'untidy', and so was I. Well, I've got worms in my hat, so I suppose they had a point.", "They swept the rubbish in behind the facade and called that clean. Now the soil's sick and nothing grows in the Reek, and my knees won't do the digging alone any more. Help me save what's left of it."],
"npc.fern.intro.freed": ["Old Fern, composter, and I'll say it as loud as I please now, so don't you go shushing me.", "The patch came in, the heaps are steaming, and nobody's thumped me for any of it in a week. I'm untidy and I always was, and these days I'm proud of it."],
"npc.fern.return": ["Well, any luck? My heaps are tucked down cellars and holes all over the Reek, keeping quiet because they think the inspectors are still after them. You tell them from me that they're coming home."],
"npc.fern.return.freed": ["Smell that? That's honest compost, that is. I could cry over it, but it'd be a waste of good water, so I'll just stand here and breathe. You come back any time you like."],
"npc.pell.intro": ["Oh, you've come to the door. Forgive me, it's been such a long while since anyone did. I'm Widow Pell, and my husband died three years ago, in his chair in the front parlour.", "And I can't bury him. Form 27-B needs a 27-C, and the 27-C needs a 27-B, so he's still in his chair, waiting, the way he always used to wait for me.", "I still go in and talk to him, I'm afraid. He's always been the patient one of the two of us, and I'm finding that I am not. I'm sorry to ask it of a stranger, but if you could help us at all..."],
"npc.pell.intro.freed": ["I'm Widow Pell, and I'm so glad you've come by. My husband is at rest at last, and I walk up to visit him every morning, the way I always meant to.", "Thank you. I know I shall never manage to say it enough, so you'll have to forgive me if I simply keep on saying it."],
"npc.pell.return": ["I'm told somebody kind hid the Stamp of Final Approval where no official would ever think to look: in Grave Row, north of the permit office, in among papers nobody reads. I'm only sorry I can't go myself."],
"npc.pell.return.freed": ["We're both very well, thank you for asking. My husband says you're late, mind you, but he only ever says that to people he's fond of."],
"npc.rollo.intro": ["Name's Rollo Spokes... wheel foreman, Beefcake, out of the Gainlands. Back home... a wheel stopped at night... and so did the man on it.", "Here, the facade needs lighting... so we pedal it. No pay, no end. They told us it was cardio... My calves have calves.", "My crews have pedalled six hours a day for ten years... and nobody's ever told them they can stop. Somebody ought to... somebody they'll believe."],
"npc.rollo.intro.freed": ["Rollo Spokes... and look at that, I've nearly got my breath back. The wheels are turning slow and the crews are sat out in the sun, lifting nothing at all... and it's the best I've ever seen them look."],
"npc.rollo.return": ["Three wheels in the Yards... pull each brake and talk to the crew. Then the big cable by the east wall, the one that feeds the facade... cut it.", "The crews won't get off... till somebody tells them it's all right to. So you tell them... and mean it."],
"npc.rollo.return.freed": ["We're lifting again... real things, and on purpose this time, because we feel like it. Come down and watch the crews some afternoon... and bring a snack, they'll want to share theirs."],
"npc.marlo.intro": ["Hands where I can see them first... good, no inspector's gloves. I'm Chef Marlo. I used to cook at the Market of the Four Paths, and now they call me a 'Nutrient Distributor' and my recipes live in my apron.", "Everybody in this city eats {villain}'s Perfect Nutrient Paste three times a day, and between you and me, paste is food the way a form is a hug.", "So for ten years I've been tucking real recipes away in corners all over this quarter, so that somebody, somewhere, will still remember what food is when all this is over."],
"npc.marlo.intro.freed": ["It's Chef Marlo. Chef! Go on, say it with me, I can't hear it often enough. The stalls are open and every single thing on them is real food.", "It's chaos, I'll grant you that. There's flour on the ceiling and somebody's burned the onions twice, and I have never in my life been so happy to look at a mess."],
"npc.marlo.return": ["Keep it down. It's three recipe cards, tucked away around the quarter, and after that the paste dispenser. Spoil it for me, and spoil it properly, because I've waited ten years to say that to somebody."],
"npc.marlo.return.freed": ["Come and eat! You're having 'some' of everything, and if you ask me how much that is, I'll have no choice but to demonstrate with the big ladle."],
"npc.spotless.intro": ["HALT. I am Captain Spotless. State your height.", "No: do not state it. Stand at it. Straighter than that, but not as straight as THAT, which is showing off. Stand APPROVED straight.", "Entry to the Capital requires the Approved Visitor Standard, and you do not meet it. You are somehow both too tall and too short, and your shadow is the wrong length for the hour.", "The Standard does, however, provide for an Entry Examination, which is conducted as a card battle. Should you win it, you will be retroactively approved, and I shall have to sign for you.", "Do not look nervous. Nervousness is a Violation. (He polishes a button.) Shall we begin?"],
"npc.spotless.return": ["You again. Still too tall. Still smiling at the wrong angle. Ready for the Examination?"],
"npc.spotless.open": ["You are approved, and I should like it noted that I have always supported this outcome. Please remember that exact wording, in case anybody asks.", "And please do not tell {villain_title} that I lost. In fact, if it is all the same to you, please do not tell anyone at all."],
"npc.spotless.open.freed": ["I don't measure anyone any more; I simply stand here. Yesterday a man walked by at exactly the approved height, and I wept, and I could not tell you why."],
"npc.spotless.defeated": ["You are... approved. Let the record show that you are retroactively approved, as of some time before I lost.", "The Standard is satisfied. The gate opens, by order of the Standard and against my personal feelings.", "In my years at this gate I have measured twelve thousand visitors and approved four. Nine thousand were sent home, and about the rest I would rather not say.", "Go through, citizen, and for your own sake, once you are in there, try not to be what you are."],
"npc.guard_height.intro": ["Height inspection! Stand against the post for me, please, and straighten up as far as you are able.", "No, not as straight as that, that is worse. Now you are one hair above regulation, and the form only has the two boxes on it.", "I will let one hair go, this once, because nobody has ever told me what a hair counts as. Only please do not grow while you are inside, or I shall be the one who has to explain it."],
"npc.guard_height.return": ["You are still one hair above regulation. I have thought about that hair all week, and I looked for it in the manual, and it is not in there, so please do not make me regret it."],
"npc.guard_queue.intro": ["Queue management! This is the approved queue, and I am pleased to tell you that you are already standing in it.", "You are not allowed to leave the queue, and you are not allowed to join it either, which I grant you is awkward. I have read the rule four times and I do not understand it any better than you do."],
"npc.guard_queue.return": ["Still queueing, I see, and very nicely too. You have a real gift for remaining eligible, and I would write that down for you if there were a box for it.", "It is a long queue, I know, but it is the best one we have, and between ourselves I have never seen where the front of it goes."],
"npc.guard_in_1.intro": ["Exit control. You wish to leave? I am sorry, but according to this you have not finished arriving yet, and I cannot let anyone out who is not properly in. Please arrive first."],
"npc.guard_in_1.return": ["Exit control. Please have your exit permit ready, and your exit interview permit, and, if at all possible, a reason."],
"npc.guard_in_2.intro": ["Exit control. This is the exit, and it is also the entrance, and they told me on my first day that from some angles it is a wall. I try not to stand at those angles."],
"npc.guard_in_2.return": ["Exit control. As far as I can tell you are still inside, so congratulations, I suppose, unless it is commiserations. Nobody has told me which."],
"npc.exit_clerk.intro": ["Exit Interview Booth, good day. May I take your name, and your reason for departing the most perfect place in the kingdom?", "I am afraid 'it is not perfect' is not one of the approved answers, and neither is pointing at something while you say it. I do not choose the answers. I am not certain anybody does."],
"npc.exit_clerk.return": ["Your departure request has been received and filed under 'Dissent', which is the only drawer I was given. Somebody will look at it in four to six years, and I do hope for both our sakes that it is not me."],
"npc.patient.intro": ["Good day! I am Citizen 4471, and I am being helped. I was brought here for smiling incorrectly: eleven degrees, when the approved angle is eight.", "It was... it was our wedding day, you see. I had been crying, the happy kind of crying, and they corrected me for that as well.", "I do not smile at all any more. It is a strange thing, to forget how your own face works."],
"npc.patient.intro.freed": ["Citizen... no. My name is Aldous.", "I smile whenever I want to now, and it comes out crooked every time. My wife says it's the best thing she's ever seen. I told her she was wrong, just to try disagreeing, and we both enjoyed it very much."],
"npc.patient.return": ["They tell me I am improving, and I thank them for it. ...Between ourselves, I am not at all sure that it is a good thing."],
"npc.patient.return.freed": ["It's Aldous, remember? The smile's still crooked, but I'm practising it on everybody I meet, and so far nobody has written me up for it."],
"quest.cap_burial.offer": ["All we're asking for is a burial permit, you see. It's Form 27-B/6, and it only wants the Stamp of Final Approval on it, and then he can stop waiting in that chair and rest at last.", "Somebody hid the Stamp of Final Approval in Grave Row, north of the permit office, among papers nobody reads. If you would find it and carry it to our family plot at the north end of the Row, he could lie down at last."],
"quest.cap_burial.active": ["I'm sorry to keep on at you. The stamp is in Grave Row, north of the permit office, among the papers nobody reads, and when you have it, it wants taking to our plot at the north end of the Row."],
"quest.cap_burial.ready": ["He's at rest? Truly? Oh... oh, forgive me, I shall need a moment.", "I sat by the plot the whole morning and never said a word to him, and it was the first quiet in three years that I wasn't afraid of.", "Here, please take this. It was his, and he'd want it to go to somebody young who will get some use out of it, and not leave it sitting in a drawer.", "There is one thing you ought to know about the man in the castle. He has grief on a schedule: Thursdays, from 3:00 to 3:05, and anyone found crying outside those five minutes is corrected.", "I don't think he is cruel. I think he simply cannot bear to watch."],
"quest.cap_burial.done": ["Thank you, a hundred times over. I sit with him at the plot every morning now, and nobody moves me along. Do remember what I told you, it's in your journal: he can't bear a sadness he didn't schedule."],
"quest.cap_wheels.offer": ["Three wheels in the Transit Yards... three crews nobody ever told to stop. Pull each brake lever... and tell them it's all right, in plain words.", "They won't believe you at first... say it anyway. Then cut the big cable by the east wall. Those facade lights have run on my crews' legs... for ten years."],
"quest.cap_wheels.active": ["Three wheels in the Transit Yards... free the crews, then cut the big cable by the east wall. Keep telling them they can stop... it takes a few goes."],
"quest.cap_wheels.ready": ["I heard the lights flicker from here... then I heard the crews sit down. The whole yard's gone quiet.", "Haven't heard a quiet yard since the coup. Thank you.", "Here... from the old days. We gave these out... at the end of a shift. Remember ends?", "One more thing about the man in the castle: he made lateness illegal. That's a man who can't bear to wait for anyone.", "Remember that when you meet him. He's always in a hurry... to be loved."],
"quest.cap_wheels.done": ["The wheels are slowing... and the crews are resting. Remember what I told you, it's in your journal: to him, lateness is disagreement... and that's the one thing he won't forgive."],
"quest.cap_recipes.offer": ["There's three of my recipes hidden in the Hungry Quarter: a bread, a stew and a sauce. They're real ones, in my own hand, with the quantities written as 'some'. Find them before the inspectors do, will you?", "And then there's the paste dispenser, here in the quarter. I want you to spoil it for me. Get something into it that actually tastes of something, and I don't much mind what."],
"quest.cap_recipes.active": ["It's three recipe cards in the Hungry Quarter, and then the dispenser to spoil. You'll know my cards when you see them: 'some' of this and 'a bit' of that, which is how any honest recipe ought to read."],
"quest.cap_recipes.ready": ["The bread, and the stew, and... you found the sauce as well? Give them here, quick, before somebody sees!", "Look at the stains on them, and look at my spelling, it's dreadful! And that smell coming off the dispenser... that's cabbage, isn't it? Real boiled cabbage, stinking up the whole street.", "Yes, I'm crying, and you'll just have to let me. Here, this is for you: my real recipe, the one I never once dared to write down until today.", "And I'll tell you one thing about the man in the castle that not many people know: he can't taste. Not his food, not his wine, not even salt, and he never could.", "So he went and built a whole kingdom of paste, because he honestly could not understand what the rest of us thought we were missing."],
"quest.cap_recipes.done": ["I'm cooking again, real food, and making a real mess while I do it. Remember what I told you, it's in your journal: he made everyone eat what he couldn't taste."],
"quest.cap_untidy.offer": ["There's three compost heaps hiding in the Reek, down in cellars and yards and under floors, where they were told to wait. I want them rescued. They're alive, whatever the inspectors like to say about it.", "And somewhere in the Reek there's a jar of old seed. Find it and plant it in the Sick Patch for me, because nobody's put a thing in the ground in this city for ten years and it's high time somebody did."],
"quest.cap_untidy.active": ["That's three heaps to rescue in the Reek, and the seed for the Sick Patch. Find the jar first, mind, and then give that seed its chance. It's waited long enough, and so have I."],
"quest.cap_untidy.ready": ["It took? You're telling me it TOOK? A flower, a real one, in this city, after all this time!", "I'm going to have to sit down. I'm going to sit right down in the dirt beside it and smell it, and you can think what you like.", "Here, take this, you've earned it. And I'll tell you one thing about the man in the castle: he's afraid of anything that grows without asking him first.", "Weeds, moss, children. Anything at all that might surprise him. I've had a good while to think about it, out here with the worms, and I reckon that's the whole of him."],
"quest.cap_untidy.done": ["The patch is blooming and the heaps are steaming, and it's all as untidy as you like. Remember what I said, it's in your journal: he's afraid of anything that grows on its own."],
"facade.citizen.1.approved": ["Good day! The weather has been approved, and the lawn is exactly regulation!", "Everything is perfect, and I am so, so pleased about it."],
"facade.citizen.1.approved2": ["Good day! It is a very good day, exactly the same as yesterday.", "Yesterday was also very good, so I am quite confident about tomorrow. It is restful, knowing in advance."],
"facade.citizen.1.slip": ["Everything is perfect. Everything is... (a pause, then a whisper) ...please do not tell the Inspector I blinked."],
"facade.citizen.2.approved": ["Welcome to {showcase}! We have houses, and lawns, and a small round approved fountain, which is everything you could want. It is also everything you may want, so that works out very nicely."],
"facade.citizen.2.approved2": ["The bread is lovely. The bread is... (a fixed smile) I am only permitted to call it lovely. I would like, very much, to see some."],
"facade.citizen.2.slip": ["I had a name before. I think it started with a B. We are allowed to forget them, and I am doing very well at it."],
"facade.citizen.3.approved": ["My house is identical to my neighbour's! Is that not wonderful? There is nothing to envy, and nothing to be envied for."],
"facade.citizen.3.approved2": ["Isn't it lovely to be exactly the same? I used to be different, I think, though I cannot remember why. It sounds very tiring."],
"facade.citizen.3.slip": ["(a whisper) Sometimes I go round behind the house and look at the wall. It is only a wall, but nobody has told me how to feel about it. Please do not tell them I go."],
"facade.citizen.4.approved": ["Smile! That is all there is to it! Smiling is mandatory, and I am, in my opinion, a very good smiler."],
"facade.citizen.4.approved2": ["Seventy percent cheerfulness is the minimum, and today I am at seventy-one! It is a good day.", "My cheeks hurt. Please do not tell anyone my cheeks hurt."],
"facade.citizen.4.slip": ["The man next door smiled at his wife's funeral. He was remembering her laugh.", "(a whisper) They corrected him for a month. He does not remember her laugh now."],
"facade.citizen.5.approved": ["The hedge is square! The hedges are all square! I trim the hedge every morning, to make sure it is as square as yesterday's."],
"facade.citizen.5.approved2": ["The Showcase receives visitors from all over! (a pause) Nobody has visited in six years. We still smile, in case they do."],
"facade.citizen.5.slip": ["Do you hear the loudspeaker? It says the same things every day, but once, years ago, it said my name.", "(a whisper) It was only the once, and I think it was a mistake. I stand under it most mornings all the same, in case it makes another."],
"facade.citizen.6.approved": ["Spontaneity is only for Thursdays! Today is Wednesday! I am almost allowed to be excited!"],
"facade.citizen.6.approved2": ["It is Thursday! I have my permit ready for my five minutes of spontaneity, and I have rehearsed being caught off guard all week, so I expect to do it very well."],
"facade.citizen.6.slip": ["I tried to be spontaneous once, on a Tuesday. I said 'hello' to a bird.", "I was corrected for two weeks. (a whisper) I still think about that bird."],
"facade.citizen.7.approved": ["Your hat is of an unapproved size, but I will not mention it, because that would be impolite. I am so, so polite. I am the politest person in the Showcase."],
"facade.citizen.7.approved2": ["There is one Approved Hat Size, and this is the hat. It is a good hat, although I do not know whose it was."],
"facade.citizen.7.slip": ["My daughter had a green hat. A little green hat. They said it was a Disagreement.", "I do not know where the hat is. I do not know where my daughter is. Everything is perfect."],
"facade.citizen.8.approved": ["The Showcase is the best of all possible places! I would not live anywhere else! (looking at the exit) ...I would not be allowed to."],
"facade.citizen.8.approved2": ["Everyone is so friendly! Everyone is so friendly. It is like living inside a greeting card, one of the kind with nothing written in it."],
"facade.citizen.8.slip": ["(a whisper) There is a door at the back that does not open. I put my ear to it sometimes. I think there is a world on the other side, and I think it is raining there."],
"facade.citizen.9.approved": ["{villain_title} is so kind. He loves us all, and he made everything this way, for us. For our own good. (a shake) For our own good."],
"facade.citizen.9.approved2": ["The portrait is looking at me. It is always looking at me, wherever I stand on the lawn, and it is very kind of him to take the trouble.", "I would never look away, of course. (a small laugh) I did try it once, and I cannot."],
"facade.citizen.9.slip": ["(a pause, then quietly) He is never here, you know. In all these years he has not once come down to see us. Only the portraits come.", "The portraits do all the looking for him. It is all done by portrait, and lately I have begun to think that must be lonely."],
"facade.citizen.1.approved.freed": ["Good day! And I mean it's really a good one, I'm not just reporting it. The weather's doing whatever it wants, and I didn't even check first.", "I got rained on this morning and I complained about it to a total stranger, and she complained right back. It was wonderful."],
"facade.citizen.1.approved2.freed": ["I'm going to wear a hat of whatever size I like, and I might wear two at once. I haven't decided yet, and I'm enjoying not having decided."],
"facade.citizen.1.slip.freed": ["I blinked twice just now, and nobody came to write it down."],
"facade.citizen.2.approved.freed": ["The bakery's only painted on, but there's going to be a real one as soon as someone learns to bake. I have a recipe. It says: try."],
"facade.citizen.2.approved2.freed": ["My name is Berta! I'd forgotten it. It was on the tip of my tongue for ten years."],
"facade.citizen.2.slip.freed": ["Berta. I keep saying it to hear how it sounds. Berta. Do you know, it's a very good name, and I think my mother chose it."],
"facade.citizen.3.approved.freed": ["My house is different from my neighbour's now, because he's painted his purple. I'm furious about it, and I'm so happy to be furious."],
"facade.citizen.3.approved2.freed": ["I painted my door green. Do you like it? Please say no, so I can have an argument."],
"facade.citizen.3.slip.freed": ["I still go round the back and look at the wall sometimes. It's a good wall, and it's only a wall."],
"facade.citizen.4.approved.freed": ["I smiled at a funeral yesterday, and nobody corrected me. It was a good funeral.", "I cried and smiled and it was exactly right."],
"facade.citizen.4.approved2.freed": ["My cheeks don't hurt any more. They're mine again, and I rested them all of yesterday by frowning at a pigeon."],
"facade.citizen.4.slip.freed": ["I'm not going to smile at all today unless I want to, and I'm enjoying it enormously."],
"facade.citizen.5.approved.freed": ["The hedge is round because it wanted to be round. I asked it myself, and I didn't have to submit a form."],
"facade.citizen.5.approved2.freed": ["We get visitors now, real ones! They're mostly lost and a bit confused, but they come, and I don't smile at them until I've decided whether I like them."],
"facade.citizen.5.slip.freed": ["The loudspeaker's gone quiet. I stood under it for an hour and said my own name out loud, just because I could."],
"facade.citizen.6.approved.freed": ["It's spontaneity every day now, and I'm exhausted! I'm honestly not sure I like it. No, I do, I love it. I'm allowed to change my mind now, you see."],
"facade.citizen.6.approved2.freed": ["I said hello to the bird again. I have named the bird Thursday."],
"facade.citizen.6.slip.freed": ["Now that every day is Spontaneity Thursday, I don't know what to do with any of them."],
"facade.citizen.7.approved.freed": ["My daughter came home in her little green hat. I've never loved a hat more in my life."],
"facade.citizen.7.approved2.freed": ["We have every hat size now, all of them at once! Come and see the hats. My daughter's trying them all on, and she says most of them are terrible."],
"facade.citizen.7.slip.freed": ["I'm not going to be polite today, I'm going to be honest: your hat is awful, and I love it."],
"facade.citizen.8.approved.freed": ["I opened the back door and it was raining, so I stood out in it for an hour."],
"facade.citizen.8.approved2.freed": ["The Showcase isn't the best of all places any more. It's just a place, and it's mine, and it's a good one."],
"facade.citizen.8.slip.freed": ["I'm going to go somewhere else, just to see what it's like. Then I'll come back, if I want to."],
"facade.citizen.9.approved.freed": ["He wasn't kind, he was afraid, and for ten years none of us could tell the difference.", "I'm not sure I forgive him, and I'm not sure I need to."],
"facade.citizen.9.approved2.freed": ["The portraits are coming down, and there's a great deal of wall behind them. Nobody can agree what to put there instead, which is the best part."],
"facade.citizen.9.slip.freed": ["He's gone, so I looked away from his portrait for a whole minute. It was a very long minute."],
"facade.door.1": ["You try the front door, but it does not open, because it is not a door.", "It is a very well-painted rectangle on the wall. Somebody has even painted a tiny brass knocker, so you knock.", "It makes a sound like knocking on a wall."],
"facade.door.2": ["The door will not open. Through the window you see a painting of a window, and beyond it a painted living room where a painted family sits.", "They are all smiling, and they have been smiling for six years."],
"facade.door.3": ["The door has no handle, and the house has no inside. In the gap behind the facade there is just room for a ladder and a young woman painting the same window for the thousandth time.", "She looks at you, then away. She has the face of someone who has meant to write home for years."],
"facade.door.4": ["You try the door, and to your surprise it opens. It is a closet.", "It contains a mop, a bucket and a sign that says: IF YOU ARE READING THIS, SMILE."],
"facade.door.1.freed": ["The front door is still painted on. Someone has written under the knocker: 'Come round the back, we have a kettle.'"],
"facade.door.2.freed": ["The painted window now has a real curtain, hung over it by a citizen who wanted one. The family in the painting has acquired a moustache."],
"facade.door.3.freed": ["The door has a handle now, and the house has an inside: two chairs, a table, a tea tray. The paintbrush has been left on the ladder, for good."],
"facade.door.4.freed": ["The closet is just a closet now. A sign inside says: IF YOU ARE READING THIS, YOU DO NOT HAVE TO SMILE."],
"facade.speaker.1.0": ["Great news, citizens! Today is a PERFECT day! The weather is APPROVED, and I am delighted to confirm that it was my own office that approved it!", "Do please continue to be happy, as scheduled! And one small reminder: lost Ministry property must be returned at once, and must on no account be spoken to!"],
"facade.speaker.1.1": ["Attention, citizens! A friendly reminder that smiling is MANDATORY! Anyone found frowning will be helped, promptly and at some length, and will thank us for it afterwards!"],
"facade.speaker.1.2": ["Attention, citizens! (a pause) Attention, citizens! (a very long pause) ...the announcement has been completed. Please clap."],
"facade.speaker.2.0": ["Great news, citizens! This season brings one Approved Hat Size! Choice has never been easier!"],
"facade.speaker.2.1": ["Attention, citizens! {villain_title} reminds you that he loves you, and that he is watching. These are the same statement."],
"facade.speaker.2.2": ["Great news, citizens! Spontaneity Thursday approaches! Please rehearse your surprise. We expect a natural performance at three!"],
"facade.speaker.3.0": ["Great news, citizens! The public records have never been tidier! Every untidy page has been corrected!", "If you remember things differently, please report to the Correction Ward. Your memory will be tidied too!"],
"facade.speaker.3.1": ["Attention, citizens! All is well. All has always been well.", "A correction: this message has always been correct."],
"facade.speaker.3.2": ["Great news, citizens! The Wrinkles do not exist.", "Please report anyone who exists. This has been your Deputy Minister of Good News!"],
"facade.speaker.1.0.freed": ["Attention, citizens. (a cough) The weather is no longer approved; it is just weather, and it seems to be managing on its own.", "So please do whatever you like today. I have nothing further to announce, and I find, rather to my surprise, that I do not mind."],
"facade.speaker.1.1.freed": ["Attention, citizens. A reminder that you do not have to smile. (a pause) You may, of course, if something strikes you. We are very easy about it these days."],
"facade.speaker.1.2.freed": ["Attention, citizens. A pigeon is using the loudspeaker. Please stand by."],
"facade.speaker.2.0.freed": ["Attention, citizens! Hats of any size are now permitted. Hats of negative size remain under review."],
"facade.speaker.2.1.freed": ["Attention, citizens. He was afraid, and we were afraid of him. Please be gentle with yourselves."],
"facade.speaker.2.2.freed": ["Attention, citizens! Spontaneity Thursday is now every day. You may stop rehearsing your surprise. I am told the real kind needs no practice."],
"facade.speaker.3.0.freed": ["Attention, citizens. The exits are open, and so, it turns out, are the entrances.", "The walls are still walls. Please do not run into them."],
"facade.speaker.3.1.freed": ["Attention, citizens. All is not well. I am told that I may say so now. All is not well yet, but it is getting better.", "It is a great deal of work, and I notice it is mostly you who are doing it. Thank you. This has been... well. This has been Percival."],
"facade.speaker.3.2.freed": ["Attention, citizens. The Wrinkles were real all along, and they kept the true record. Please thank them.", "They are in the cellar, and there is tea. I am told I would be welcome, which is generous of them, and I have not yet found the nerve to go down."],
"dungeon.pc_gate.title": ["The Great Doors"],
"dungeon.pc_gate.blurb": ["Solid gold, ten metres tall, and polished until you can see your own worried face in them. They swing open before you touch them, which is somehow the worst part."],
"dungeon.pc_gate.before": ["The great doors swing open, silent and perfectly balanced, onto a long hall and a red carpet that smells of floor wax and lemons. Somewhere a very long way off, someone is humming.", "'Welcome,' says a quiet, polite voice from nowhere. 'Please wipe your feet, and your opinions, on the mat provided. You are expected.'"],
"dungeon.pc_hall.title": ["The Great Hall"],
"dungeon.pc_hall.blurb": ["A hall the length of a street, and not one speck of dust. Guards stand at attention every ten paces, each one exactly the same height. (A battle.)"],
"dungeon.pc_portraits.title": ["The Portrait Gallery"],
"dungeon.pc_portraits.blurb": ["Thousands of portraits of one man, hung in order, each a little taller, straighter and more perfect than the last. A story event."],
"dungeon.pc_curator.title": ["The Curator's Rounds"],
"dungeon.pc_curator.blurb": ["A curator with a feather duster patrols the side gallery. Anything crooked, he straightens. Anything alive, he dusts. (A battle.)"],
"dungeon.pc_alcove.title": ["The Forgotten Alcove"],
"dungeon.pc_alcove.blurb": ["A side door behind a very large frame: a small alcove where the old portraits went when they were replaced. A dead end with a prize, then back to the gallery."],
"dungeon.pc_alcove.after": ["The old portraits lean against the wall, faces to the plaster. Behind the last one someone has left a small bag and a note: 'In case anyone comes looking for the real one.' You take it and go back."],
"dungeon.pc_mirror_knight.title": ["The Mirror Knight"],
"dungeon.pc_mirror_knight.blurb": ["A knight made entirely of mirror plates, every one showing the same smiling face. It moves exactly like you, right up until it doesn't. (A battle.)"],
"dungeon.pc_mirror_test.title": ["The Hall of Mirrors"],
"dungeon.pc_mirror_test.blurb": ["A hall of mirrors that reflect only him. A deck challenge: how well do you lead with your own face?"],
"dungeon.pc_honest_mirror.title": ["The One Honest Mirror"],
"dungeon.pc_honest_mirror.blurb": ["A small, dusty mirror in a closet, hung by someone who had to hide it. It shows whoever is standing in front of it. A dead end with a story."],
"dungeon.pc_mirror_shrine.title": ["The Quiet Room"],
"dungeon.pc_mirror_shrine.blurb": ["A room of mirrors where, for once, nobody is reflected at all: they have been turned to face the wall. Rest here. Restore HP."],
"dungeon.pc_mirror_shrine.after": ["You sit on the floor between mirrors that show only plaster. It is, for a few minutes, the most peaceful room in the Capital. Somebody has left a mug of tea and a biscuit.", "The biscuit is a little crooked. You eat it."],
"dungeon.pc_desk.title": ["The Desk of Correction"],
"dungeon.pc_desk.blurb": ["A long brass desk, a stamp and a form: 'FORM OF CORRECTION'. A deck challenge: do you have the bodies to fill the form?"],
"dungeon.pc_clerk.title": ["The Ministry Clerk"],
"dungeon.pc_clerk.blurb": ["A clerk at a tall desk stamps everything that moves, quickly and rather sadly. His eyes never leave the paper. (A battle.)"],
"dungeon.pc_corrector.title": ["The Chief Corrector"],
"dungeon.pc_corrector.blurb": ["The head of the Ministry of Correction, with white gloves, kind eyes and a ruler. She is very, very gentle, and that is what makes her frightening. (Elite)"],
"dungeon.pc_corrector.after": ["The Chief Corrector sits down on her own chair, very carefully, and lays her ruler on the desk. 'I corrected eleven thousand,' she says.", "'I never once asked what was wrong with them. Please, take the door on the left and go and look at them.'"],
"dungeon.pc_corrected.title": ["The Corrected"],
"dungeon.pc_corrected.blurb": ["A long ward behind the Ministry where citizens who were 'corrected' are kept. A dead end with a story, then back to the corridor."],
"dungeon.pc_junction.title": ["The Hall of the Four Wings"],
"dungeon.pc_junction.blurb": ["A circular hall with four doors, one for each Path. Each wing is a dead end: a place where he 'perfected' that Path. Visit any, all or none; then take the corridors on."],
"dungeon.pc_junction.before": ["Four great doors, each in its own Path's colour: red with a dumbbell, gold with a ladle, violet with a notary's seal, green with a seed.", "Over each, a brass plate: 'PERFECTED'."],
"dungeon.pc_wing_gourmand.title": ["The Gourmand Wing: The Laboratory"],
"dungeon.pc_wing_gourmand.blurb": ["The doppelganger's laboratory: vats of Special Sauce, rows of masks, one very worried technician. (A battle, then lab notes.)"],
"dungeon.pc_wing_gourmand.before": ["Racks of masks line the walls, each one a face: the Grand Chef, smiling, smiling, smiling. On a clipboard by the door, in a neat hand:", "'LAB NOTES: Subject A (the Grand Chef) proved resistant to persuasion. Resolved by substitution. The substitute is cooperative, and does not argue about the sauce.'", "'All Gourmands to be fed the sauce. They will be happier, and a little less themselves. I consider this the improvement.'"],
"dungeon.pc_wing_gourmand.after": ["You tear the last page off the clipboard. Under the neat hand, in the margin, in a small shaking one: 'He did not look at the faces. He never looked at the faces.'", "You fold it into your pocket and go back."],
"dungeon.pc_wing_beefcake.title": ["The Beefcake Wing: The War Room"],
"dungeon.pc_wing_beefcake.blurb": ["A war room full of maps, flags and one very large, very empty throne: the place where the coup was planned. (A battle, then the orders.)"],
"dungeon.pc_wing_beefcake.before": ["A table covered in maps of the Gainlands, with little red pins in every mill and wheel. On a clipboard:", "'COUP ORDERS: Remove Grandmaster Flex. Remove his weights, his protein, his gymnasium. Observe.'", "'When the champion is sufficiently weak, he will no longer be a disagreement. NOTE: do not underestimate him. He does a lot of stretching.'"],
"dungeon.pc_wing_beefcake.after": ["In the margin of the orders, in a smaller, shakier hand: 'He was not weak. We took everything from him and he got stronger. I do not understand it.'", "'I have asked the champions to be weak. They will not.' You fold the orders and go back."],
"dungeon.pc_wing_necrocrat.title": ["The Necrocrat Wing: The Notary's Office"],
"dungeon.pc_wing_necrocrat.blurb": ["A tall office of notarized, filed and countersigned paper: the authorization that took the Necrocrats. (A battle, then the paperwork.)"],
"dungeon.pc_wing_necrocrat.before": ["Shelves of paper to the ceiling, every sheet stamped. On the top of the pile, a single form:", "'FORM 1-A (NOTARIZED): Authority over all Necrocrat government is hereby transferred to {villain_title}. Reviewed. Approved.'", "'Filed. VALID. NOTE: the Necrocrats will obey this, because it is their nature to obey a valid form.'", "'I did not need to force anyone. I needed only to be correct.'"],
"dungeon.pc_wing_necrocrat.after": ["The Wraith's last words, as it folds: 'The authorization is valid.' Then, very quietly: 'It was never right.'", "You take the form. Somewhere in all this paper there must be a technicality, and you suspect someone will find it."],
"dungeon.pc_wing_refusemancer.title": ["The Refusemancer Wing: The Greenhouse"],
"dungeon.pc_wing_refusemancer.blurb": ["A glass greenhouse where something glowing and green grows in a single pot. The Rot began here. (A battle, then the seed.)"],
"dungeon.pc_wing_refusemancer.before": ["In the middle of the greenhouse, under a glass dome, a single seed sprouts, glowing sickly green. A label on the pot:", "'THE SEED: Nature is untidy, inefficient and forever disagreeing with itself.'", "'A seed, properly corrupted, can be made to agree with me. Plant it in the Archdruid, and observe.'", "'NOTE: it will spread, and what grows will be orderly. I believe she will thank me.'"],
"dungeon.pc_wing_refusemancer.after": ["The dome is cracked. The glowing seed lies in the dirt and is, for a moment, just a seed. In the label's margin, in a smaller hand: 'She was grieving. I told myself that made it a kindness.'", "You leave the seed where it fell. Out of its dome it looks smaller, as most things here do once you get close, and you go back."],
"dungeon.pc_servants.title": ["The Servants' Corridor"],
"dungeon.pc_servants.blurb": ["A narrow back corridor where the castle's servants work in matching grey, silent and very fast. They do not smile any more; they have stopped trying. (A battle.)"],
"dungeon.pc_staircase.title": ["The Grand Staircase"],
"dungeon.pc_staircase.blurb": ["A staircase so grand it has its own staircase. Every step is exactly the same height; you cannot see the landing from the bottom. A story event."],
"dungeon.pc_vault.title": ["The Wing Vault"],
"dungeon.pc_vault.blurb": ["Where the two ways round the wings meet: a small vault of confiscated things. Treasure."],
"dungeon.pc_archive_gate.title": ["The Archive Door"],
"dungeon.pc_archive_gate.blurb": ["A tall oak door with a brass sign: 'ARCHIVE OF GOOD INTENTIONS'. A warden stands in front, arms folded. (A battle.)"],
"dungeon.pc_archive_gate.before": ["The sign is older than the rest of the castle and painted by hand. Beneath it, in different ink, someone has written: 'He meant well.'"],
"dungeon.pc_journals.title": ["The Early Journals"],
"dungeon.pc_journals.blurb": ["Shelves of journals in a young man's handwriting: the years before the throne. A story event."],
"dungeon.pc_reading_room.title": ["The Reading Room"],
"dungeon.pc_reading_room.blurb": ["A quiet reading room with one lamp and one chair. Someone used to read here every night. Rest and restore HP."],
"dungeon.pc_reading_room.after": ["You sit in the old reading chair, which is worn exactly where one person sat every night for years. Someone made the lampshade by hand, and it is a little crooked."],
"dungeon.pc_blueprints.title": ["The Blueprint Vault"],
"dungeon.pc_blueprints.blurb": ["A side vault of blueprints: the sound reforms he drew up before it all went wrong. A dead end with a prize, then back to the reading room."],
"dungeon.pc_blueprints.after": ["There are plans for wells, plans for a hot school lunch, and plans for a bridge that was actually built.", "They are good, genuinely good, and something catches in your throat as you roll up the best of them and take it."],
"dungeon.pc_shelf.title": ["The Escalation Shelf"],
"dungeon.pc_shelf.blurb": ["A single long shelf where the reforms are filed in order, each a little bigger than the last. A deck challenge: can your deck keep its footing?"],
"dungeon.pc_automaton.title": ["The Archive Automaton"],
"dungeon.pc_automaton.blurb": ["A tall brass automaton that files, stamps and shelves. It has been told the archive is complete, and it is very sure of that. (Elite)"],
"dungeon.pc_last_journal.title": ["The Last Journal"],
"dungeon.pc_last_journal.blurb": ["A single book lies open on a stand, its last page still wet. A story event: the moment you see him as he sees himself."],
"dungeon.pc_last_journal.before": ["A lectern stands in the middle of a round room, with a book open on it and a pen beside the book. The ink on the last page is still wet; he wrote this today."],
"dungeon.pc_model_warden.title": ["The Model Warden"],
"dungeon.pc_model_warden.blurb": ["The last guard before the Model Room: a warden whose job is to keep everyone away from the table. (Elite)"],
"dungeon.pc_model_warden.after": ["The Warden steps aside. Through the doors: a huge round room, a vaulted ceiling and, on a table the size of a house, a perfect miniature of the whole kingdom.", "Somebody is bending over it, moving a tiny house one centimetre to the left."],
"dungeon.pc_boss.title": ["The Model Room"],
"dungeon.pc_boss.blurb": ["A giant model of the whole kingdom, and the man who rearranges it by hand. {villain_title}, {villain}. (Boss: three phases)"],
"dungeon.pc_boss.before": ["The Model Room is round and domed, and in its centre stands a table the size of a house: a perfect miniature of {kingdom}.", "Roads, rivers, four districts and a hundred thousand tiny houses, and every one of them is exactly where he wants it.", "A man in a pressed white-and-gold coat and a thin gold circlet stands with his back to you, moving a tiny cottage one centimetre to the left with a pair of tweezers."],
"dungeon.pc_boss.after": ["The model lies in pieces, a hundred thousand tiny houses scattered across the floor in all the wrong places, and somehow they look better.", "{villain} sits among them, small, in his pressed white-and-gold coat, and does not move for a long time."],
"challenge.pc_mirror_test.title": ["The Hall of Mirrors"],
"challenge.pc_mirror_test.text": ["Every mirror shows only him. They turn to look at you and, for a moment, one of them hesitates. Reveal cards until the first unit: if its attack is 3 or more, a mirror will let you through (and show you, briefly, yourself).", "If not, they will look through you and it will hurt."],
"challenge.pc_ministry_desk.title": ["The Desk of Correction"],
"challenge.pc_ministry_desk.text": ["A FORM OF CORRECTION asks for a list of bodies: names, numbers and heights. Five cards are revealed; if at least two are units, you have enough people on your form to get past the desk. If not, the stamp comes down."],
"challenge.pc_escalation_shelf.title": ["The Escalation Shelf"],
"challenge.pc_escalation_shelf.text": ["Every reform on the shelf is bigger than the last: school lunches, lunch rules, lunch inspectors, inspector rules. Five cards fall off; if at least two are infrastructure, your deck holds. If not, the shelf comes down on you."],
"event.pc_improved_portraits.title": ["The Improved Portraits"],
"event.pc_improved_portraits.body": ["Thousands of portraits of one man, one a year. In the first he is a thin young clerk, anxious and kind, smiling at nothing in particular.", "Each one is a little straighter and a little taller, until by the last he is eleven feet tall, with no wrinkles and a smile that does not move. Under every one: 'IMPROVED.'"],
"event.pc_improved_portraits.choice.0": ["Study them closely, from the first to the last"],
"event.pc_improved_portraits.choice.1": ["Look away and breathe"],
"event.pc_improved_portraits.choice.2": ["Take a gold frame off the wall and sell it"],
"event.pc_improved_portraits.result.0": ["You look at them all, in order. The anxious clerk grows steadily less anxious, and steadily less there. You find the exact portrait where it happens: the tenth.", "In the ninth he looks so tired, and so sincere, that you know you will not forget it. After that, none of the frames can fool you."],
"event.pc_improved_portraits.result.1": ["You look down at your feet. The red carpet is worn a little in the middle, which is the one honest thing in the room, and you feel steadier for it."],
"event.pc_improved_portraits.result.2": ["The frame comes off with a squeal, and an alarm goes off somewhere, very politely: 'Please do not remove the improvements.' A small portrait falls and cuts your hand, but the frame is worth a lot."],
"event.pc_honest_mirror.title": ["The One Honest Mirror"],
"event.pc_honest_mirror.body": ["In the broom cupboard, behind a bucket, hangs a small, cracked mirror. A note taped to it: 'FOR THE WRINKLES. IT SHOWS WHOEVER STANDS IN FRONT OF IT. WE LOST A MAN FOR THIS MIRROR.'", "You step in front of it and, for the first time in this castle, you see yourself."],
"event.pc_honest_mirror.choice.0": ["Stand and look for a while"],
"event.pc_honest_mirror.choice.1": ["Take the mirror's frame; it is quite valuable"],
"event.pc_honest_mirror.result.0": ["It is your face, tired and dusty and a little crooked, and entirely your own. It is the most welcome thing you have seen in this castle.", "You stand there until you feel like yourself again, and a little more."],
"event.pc_honest_mirror.result.1": ["You prise off the old gold frame and leave the mirror hanging, bare. It still shows whoever stands in front of it. It never needed the gold."],
"event.pc_corrected_citizens.title": ["The Corrected"],
"event.pc_corrected_citizens.body": ["A long white ward holds fifty beds, and in each lies a citizen in a grey gown with a small, fixed smile, looking at nothing.", "A nurse moves among them, adjusting each smile by a few degrees. One man has been smiling at the ceiling for three years. A woman in the corner has forgotten the name of her own daughter.", "One of them whispers to you as you pass: 'I smiled at a funeral.'"],
"event.pc_corrected_citizens.choice.0": ["Sit with them and listen"],
"event.pc_corrected_citizens.choice.1": ["Free the nearest bed and help them out"],
"event.pc_corrected_citizens.choice.2": ["Take the ward's record book as proof"],
"event.pc_corrected_citizens.result.0": ["You sit by the beds and listen for as long as it takes, which is a long time, and one by one they tell you their names.", "You listen to what they smiled at: a funeral, a wedding, a bird. When you rise, you repeat their names to yourself."],
"event.pc_corrected_citizens.result.1": ["You undo the straps and help a man to his feet. He weeps and laughs and falls over, and cannot remember how to frown. A nurse hits an alarm.", "You carry him out through a window. He is heavier than you expected, and it costs you something, though it has cost him far more.", "He says: 'Thank you.' It is the first thing he has said in three years."],
"event.pc_corrected_citizens.result.2": ["The record book lists every citizen corrected, their offence and the angle of their smile on admission. It is eleven thousand pages long. You will not need to read it all.", "The first page is enough. Somebody will pay well for this book, and somebody, one day, will read it aloud."],
"event.pc_four_wings.title": ["The Hall of the Four Wings"],
"event.pc_four_wings.body": ["Four great doors in four Path colours, and over each a brass plate: PERFECTED. Behind each, you can hear nothing at all. A fifth and sixth way lead on: the servants' corridor and the grand staircase.", "You could visit all four wings, or none. Each wing is a dead end, and each one will tell you how he did it."],
"event.pc_four_wings.choice.0": ["Rest on the bench in the hall"],
"event.pc_four_wings.choice.1": ["Take the coins from the collection plate by the door"],
"event.pc_four_wings.result.0": ["You sit on a long bench under a brass plate and breathe. The doors do not open. Nothing in the hall moves, and everything in it seems to be listening. After a time you feel steadier."],
"event.pc_four_wings.result.1": ["A little brass plate for donations to {villain_title} is bolted to the wall by the door, and it is quite full. You take the lot.", "It is other people's money, after all, and you think they would want it back from him."],
"event.pc_grand_staircase.title": ["The Grand Staircase"],
"event.pc_grand_staircase.body": ["A staircase of five hundred steps, every one exactly the same height, and at the top a very large clock.", "Halfway up, a servants' door stands ajar: through it, a narrow plain stair with worn steps. Nobody has ever climbed the grand staircase for pleasure."],
"event.pc_grand_staircase.choice.0": ["Climb the grand staircase, step by identical step"],
"event.pc_grand_staircase.choice.1": ["Sit on a step and rest"],
"event.pc_grand_staircase.choice.2": ["Take the servants' stair"],
"event.pc_grand_staircase.result.0": ["Five hundred identical steps. By the three hundredth you are trembling; by the four hundredth you want to scream.", "At the top, a pot of coins sits on the landing: a tip left by the last person who made it. You rub your legs and pocket the coins."],
"event.pc_grand_staircase.result.1": ["You sit on step two hundred and fifty and look up at the very large clock. It has no hands, only a brass plate that says 'ON TIME'.", "You sit there for as long as you like. Nobody comes to correct you."],
"event.pc_grand_staircase.result.2": ["The servants' stair is steep and narrow and wonderfully uneven. Every step is a different height. A cook has left a little shelf of bread and a pipe.", "You eat and climb and feel, curiously, much better about the whole world."],
"event.pc_early_journals.title": ["The Early Journals"],
"event.pc_early_journals.body": ["A wall of journals in a young man's neat handwriting, each one dated. 'Year 1: Wells. Half the lower city has to walk two miles for clean water.'", "'I have drawn up plans for six new ones, and the Council has approved every one. I did not sleep at all. It was wonderful.'", "'Year 3: School lunches. A child asked me why the soup was warm. I said, so that you can eat it.'", "'She said, that is the best idea anyone has ever had. I put it in a frame.'", "It goes on like that for years, and they are good. They are so good."],
"event.pc_early_journals.choice.0": ["Read the first journals, all the way through"],
"event.pc_early_journals.choice.1": ["Close the book and sit with it for a moment"],
"event.pc_early_journals.result.0": ["You read until the light changes. Wells, schools, bridges, lamps: he built a hundred good things, and he loved every one.", "Once, he was exactly the person you would want running a kingdom. You close the last journal very gently."],
"event.pc_early_journals.result.1": ["You close the book and rest your hand on the cover. It is warm, as if someone had just put it down. You breathe, and wait until your hands are steady."],
"event.pc_last_journal.title": ["The Last Journal"],
"event.pc_last_journal.body": ["The last page, in a neat hand, the ink still wet: 'Today I corrected eleven more. They cried, which is understandable. They do not yet see it.'", "'In ten years' time they will thank me. In a hundred, they will not remember there was anything to thank me for. That is the point. That is how you know it has worked.'", "'I am so tired. I do not think anyone has ever tried so hard to be kind. I only wish somebody would say so.'"],
"event.pc_last_journal.choice.0": ["Read it all again, and let it settle"],
"event.pc_last_journal.choice.1": ["Close the journal and steady yourself"],
"event.pc_last_journal.result.0": ["You read it twice. He believes every word: that each portrait and each rule is a gift, that nobody has ever tried so hard to be kind.", "He is not lying, and that is the worst of it. You understand him a little now, and you understand exactly what you will have to do."],
"event.pc_last_journal.result.1": ["You close the book softly. Whatever is in the next room, it is not a monster. It is a man who needed to be right, and made the whole world pay for it.", "You breathe in, and out, and you go on."],
"cutscene.primm_intro.1.speaker": ["Primm"],
"cutscene.primm_intro.1": ["Ah, a visitor. Do come in. I so rarely receive anyone who has not been summoned.", "Mind the floor: it has just been polished, by seventeen people, whom I thank daily, in writing."],
"cutscene.primm_intro.2.speaker": ["Primm"],
"cutscene.primm_intro.2": ["I am {villain_title}, {villain}: Minister of Improvements, Steward of the Throne, Protector of {kingdom}.", "You have walked the whole length of my castle to reach this room. You have also, I notice, scuffed it."],
"cutscene.primm_intro.3.speaker": ["You"],
"cutscene.primm_intro.3": ["I'm sorry about the floor. It's forest mud. I've walked a long way to get here, and everyone I met on the road was afraid of you."],
"cutscene.primm_intro.4.speaker": ["Primm"],
"cutscene.primm_intro.4": ["Afraid? Of order, perhaps? Of comfort? Of the dreadful burden of being kept safe?", "I have given them roofs, and hats, and rules, and I have given every one of them exactly the same amount of each, which is more than anyone before me ever managed.", "Every one of them has a number, so that nobody is ever overlooked. Do you know how few kingdoms can say that? I do. I counted."],
"cutscene.primm_intro.5.speaker": ["Primm"],
"cutscene.primm_intro.5": ["For ten years I have been mending this kingdom. Ten years, and still you people come, with your different hats and your different opinions, to undo the only good thing anyone has ever done for it.", "I am afraid I shall have to correct you."],
"cutscene.primm_intro.6.speaker": ["Primm"],
"cutscene.primm_intro.6": ["This will not hurt. It will, however, be Standard."],
"cutscene.primm_p1.1.speaker": ["Primm"],
"cutscene.primm_p1.1": ["Why... why will they not all be three? It is a perfectly good number.", "Every unit was to be equal, in every way. Why must some of them be five? Why must anything ever be five?"],
"cutscene.primm_p1.2.speaker": ["You"],
"cutscene.primm_p1.2": ["Because some things are five. Some people are, too.", "I met a man who was locked up for ten years without a single weight, and he could still lift me off the floor. Strength is what you do with whatever is left to you, and strength is not control."],
"cutscene.primm_p1.2.rushed": ["Because some things are five. Some people are, too.","You took ten years from me. I don't know everything you took, but I know it wasn't the part that matters."],
"cutscene.primm_p1.3.speaker": ["Primm"],
"cutscene.primm_p1.3": ["Then they must be made the same, for their own good. I had rather hoped that you, of all people, would see that.", "You are not listening; nobody ever listens. (a breath) Very well. If you will not follow my rules, I shall simply have to use yours."],
"cutscene.primm_p1.4.speaker": ["Primm"],
"cutscene.primm_p1.4": ["Everything you can do, I can do. I have had ten years of practice with it.", "Let us see how you like fighting yourself."],
"cutscene.primm_p2.1.speaker": ["Primm"],
"cutscene.primm_p2.1": ["Your cards, your plays, your very own deck, held in my hands and played rather more tidily than you ever played it.", "And still you beat me. I should very much like to know how."],
"cutscene.primm_p2.2.speaker": ["You"],
"cutscene.primm_p2.2": ["You copied my cards, but what I do with them is mine. I watched a cook give her own name away and stay exactly who she was, so I know a name is a blank page until you sign it.", "And I spent ten years filed under 'subject'. Never again, for me or for anyone. No order you could ever write outranks treating people with respect."],
"cutscene.primm_p2.2.rushed": ["You copied my cards, but you can't copy what I do with them.","My name is mine to sign. You don't get to decide who I am."],
"cutscene.primm_p2.2.gourmand": ["You copied my cards, but what I do with them is mine. I watched a cook give her own name away and stay exactly who she was, so I know a name is a blank page until you sign it.", "Copying a face never made anyone a cook. You don't get to decide who I am."],
"cutscene.primm_p2.2.necrocrat": ["You copied my cards, but you can't copy what I do with them.", "I spent ten years filed under 'subject'. Never again, for me or for anyone. No order you could ever write outranks treating people with respect."],
"cutscene.primm_p2.3.speaker": ["Primm"],
"cutscene.primm_p2.3": ["That is simply not true. I made the wells, and I made the roads.", "I made... (he stops.) I made them, and they were good. And then I put my name on every one, and I stopped asking anyone whether they wanted the next."],
"cutscene.primm_p2.4.speaker": ["Primm"],
"cutscene.primm_p2.4": ["No. No, no, no. The rules are perfect. I checked every one of them myself, twice.", "The rules are perfect. They have to be, because if they aren't, then I have been... then all this time I have been..."],
"cutscene.primm_p2.5.speaker": ["Primm"],
"cutscene.primm_p2.5": ["Everything is coming apart, and I don't understand why. I only wanted it to be nice."],
"cutscene.primm_end.1.speaker": ["Primm"],
"cutscene.primm_end.1": ["...So it is over. I wrote such good rules, and they were not enough."],
"cutscene.primm_end.2.speaker": ["Primm"],
"cutscene.primm_end.2": ["I did it for them, for the people. You do see that, don't you?", "You must see that. Every rule, every portrait, every hat: so that nobody would ever be afraid again. So that nobody would ever be wrong."],
"cutscene.primm_end.3.speaker": ["You"],
"cutscene.primm_end.3": ["You kept every face and every house under glass. I've stood in a field where nothing was allowed to die, and nothing grows there either.", "You took my mother and father. Then you kept me behind glass for ten years, and every morning someone said 'again'. I remember that word better than I remember their faces."],
"cutscene.primm_end.3.rushed": ["You kept every face and every house. Nothing grows if you refuse to let anything go.","You took my mother and father. Then you kept me behind glass for ten years, and every morning someone said 'again'. I remember that word better than I remember their faces."],
"cutscene.primm_end.4.speaker": ["Primm"],
"cutscene.primm_end.4": ["...(a long silence)... Your mother and father were sentimental people, and sentiment was going to cost this kingdom everything. I removed two people so that a whole kingdom could be safe. I did the sums twice.", "And you, I looked after. You were fed at seven, at noon and at six, for ten years, and you were never once cold. Tell me which part of that was unkind. I should like it in writing."],
"cutscene.primm_end.5.speaker": ["Primm"],
"cutscene.primm_end.5": ["(You do not answer. He waits for a correction that does not come.) ...It was the mirrors, wasn't it? I wanted a world where nothing could ever surprise me.", "And I forgot that a world where nothing surprises you is a world with nobody else in it."],
"cutscene.primm_end.6.speaker": ["You"],
"cutscene.primm_end.6": ["I'm not going to correct you. That was always your way of doing things. And I'm not going to forgive you either, not today. Start with something smaller than a kingdom. Say sorry to one person."],
"cutscene.primm_end.7.speaker": ["Primm"],
"cutscene.primm_end.7": ["One? I corrected eleven thousand of them. Where would I even begin? I cannot remember a single one of their names."],
"cutscene.primm_end.8.speaker": ["Primm"],
"cutscene.primm_end.8": ["Take the crown. No: leave it. No: take it.", "It is very heavy. It was always very heavy. Tell the Wrinkles... tell them I am sorry about the hats. (He hears himself.) No. That is not the thing. I never learned how to say the thing."],
"boss.phase.standardization.title": ["Phase 1: Standardization"],
"boss.phase.standardization.rule": ["Every unit starts as a 3/3, so cheap units are as good as big ones; boons and buffs still add on top. You may play two cards a turn."],
"boss.phase.reflection.title": ["Phase 2: Reflection"],
"boss.phase.reflection.rule": ["He plays a copy of your own deck and draws two extra cards a turn, so expect your best cards to come back at you. His copies sit on his side of the table and shine silver, like a mirror; the plain ones are yours."],
"boss.phase.unraveling.title": ["Phase 3: Unraveling"],
"boss.phase.unraveling.rule": ["His units get +1/+1 and he draws an extra card, but he loses 1 HP every turn: every turn you hold the line wears him down."],
"boon.beefcake.name": ["Grandmaster Flex's Heart"],
"boon.beefcake.line": ["Grandmaster Flex steps out from behind a pillar, unwinding a very small bandage from a very large arm. 'Breathe in. Hold.'", "'Strength is the heart and the mind, son, and you brought both. We're with you.' (Grandmaster Flex's Heart: Beefcake units get +1 power, and you gain 2 max HP.)"],
"boon.gourmand.name": ["The Grand Chef's Feast"],
"boon.gourmand.line": ["The Grand Chef, in a clean apron, ladle in hand. 'Have you eaten? No, of course you haven't. Here. Eat first, fight after.'", "'Ten years of sauce that tasted of nothing. Let's feed this kingdom something real again.' (The Grand Chef's Feast: Gourmand units get +1 defense, life gain is stronger, and you gain 2 max HP.)"],
"boon.necrocrat.name": ["Agnes's Appeal"],
"boon.necrocrat.line": ["Agnes Overdue floats forward with her enormous ribboned stack of denied appeals. 'I have found a technicality, dear,' she says, and stamps it with the department seal.", "'It applies to him, dear. It applies to him very well.' (Agnes's Appeal: Necrocrat cards cost 1 less, and you gain 2 max HP.)"],
"boon.refusemancer.name": ["Compostella's Roots"],
"boon.refusemancer.line": ["Archdruid Compostella kneels and presses a palm to the marble. A small green shoot pushes up through the polish.", "'To grow, you have to let things go, child. Even him. Especially him.' (Compostella's Roots: Refusemancer units get +2 defense, and you gain 2 max HP.)"],
"boon.none.line": ["Nobody stands beside you. The Paths are not free yet, and their leaders are still held behind wheels and sauce and paperwork and thorns, so you step into the chamber alone.", "(Free the Paths and their leaders will stand with you.)"],
"ending.beat.1.title": ["The Model Falls"],
"ending.beat.1": ["The scale model cracks in half, and then the table under it, and then, with the sound of a very large drawer being pulled from a very large cabinet, every locked door in the castle swings open at once.", "In the gallery a portrait slips off its hook and lands face-up. For the first time in ten years, nobody picks it up."],
"ending.beat.2.title": ["The Facade Falls"],
"ending.beat.2": ["In {showcase}, a painted door falls flat, and a very surprised citizen steps through it onto a very real street.", "Shopfronts topple, hedges slump back into their own shapes, and the loudspeakers cough once and go quiet.", "Behind the facade are houses, lawns and people, all of them a little crooked. At the gate, a child paints the new sign: PATHORDIA."],
"ending.beat.3.title": ["The Rifts Close"],
"ending.beat.3": ["Across the Capital the rifts fold up like letters. In the Reek, the Sick Patch is a flower bed.", "In Grave Row, a family walks slowly to a quiet plot and stays. In the Transit Yards the wheels slow, and slow, and stop, and the crews lie in the sun.", "In the Hungry Quarter, somebody lights a stove."],
"ending.beat.4.title": ["The Wrinkles"],
"ending.beat.4": ["The Wrinkles climb up out of the Crease, blinking, into a light they had forgotten. Wren carries the true records under her arm. Nurse Hesper has brought the tea.", "Fig Sly comes up out of the Crease already selling something, to somebody, for some reason. Nobody stops him."],
"ending.beat.5.title": ["The Paths Meet"],
"ending.beat.5": ["And the Paths come home. Grandmaster Flex, the Grand Chef, Agnes Overdue and Archdruid Compostella meet in the plaza and look at one another for the first time in ten years.", "The Beefcakes are late, the Necrocrats have brought a form, the Gourmands are overdressed, and the Refusemancers smell faintly of compost.", "Nobody agrees on anything. It is the happiest sound the Capital has ever heard."],
"ending.beat.6.title": ["Together"],
"ending.beat.6": ["{villain} demanded one way for everyone. In the plaza, a Beefcake holds a ladder steady while a Necrocrat checks it against a form.", "A Gourmand passes up the hammer, and a Refusemancer catches the nail that falls, because it can still be used.", "Different Paths, working together, and arguing the whole time about where the sign should go. It goes up crooked, and it stays up."],
"ending.beat.7.title": ["The New Decree"],
"ending.beat.7": ["A new decree appears on the plaza wall of {pathordia}, in four different handwritings. It reads: DIFFERENT PATHS MAY MIX AGAIN.", "Somebody has crossed out MAY and written SHOULD. Somebody else has crossed out SHOULD and written WILL, IF THEY FEEL LIKE IT. A pigeon sits on the full stop."],
"ending.credits.1": ["THE END (OF THE BEGINNING)"],
"ending.credits.2": ["A game about a kingdom that was strong because its pieces did not match."],
"ending.credits.3": ["THE WAYWARD PATH"],
"ending.credits.4": ["Full credits and licences: Credits, on the title screen"],
"ending.credits.5": ["Engine: Godot 4"],
"ending.credits.6": ["Paintings made with AI image tools, chosen and fitted by hand. Models by KayKit and Kenney, icons from game-icons.net"],
"ending.credits.7": ["Music written as code and played on the FluidR3 soundfont"],
"ending.credits.8": ["{villain}'s rule is over. The voices of the kingdom remain."],
"ending.credits.9": ["In memory of Form 27-B, Form 27-C and Form 27-B"],
"ending.credits.10": ["No hats were harmed. Several were enlarged."],
"ending.credits.11": ["The Paths will be back, in some other order."],
"ending.credits.12": ["Thank you for playing."],
"ending.thanks.title": ["Thank you for playing"],
"ending.thanks.body": ["The kingdom is in one piece again, seams and all, and it is yours to walk."],
"ending.thanks.line.1": ["Under the forest: the Path-ology Lab. Someone is still waiting there."],
"ending.thanks.line.2": ["At the castle door: a cracked mirror, and the Shattered Gallery behind it."],
"ending.postgame.title": ["The Paths Unbound"],
"ending.postgame.body": ["With {villain} gone, the Paths are free to mix again. Your decks may now combine cards from ALL Paths, and the Alchemist's tri-Path crafting is open. And under the forest, someone is still waiting for you."],
"ending.postgame.line.1": ["Decks may now use 3 or more Paths."],
"ending.postgame.line.2": ["The Alchemist's cauldron now takes three Paths at once: brew their essence into a tri-Path card."],
"ending.postgame.line.3": ["{pathordia} is open to everyone: the facade is down, the rifts are sealed, and {villain} works under guard on wells and pipes, kept away from every Path."],
"ending.return": ["You are back in {pathordia}. The streets are mostly the same, but they sound quite different now: people are shouting at each other cheerfully, in every direction.", "Wren sits on the edge of the fountain with a ledger on her knee, writing the title of the first honest page: THE TRUE RECORD, VOLUME ONE."],
"fx.ending_return": ["The Capital is free. The postgame begins: decks of three or more Paths are now allowed."],
"freed_npc.heartlift": ["Breathe in. Hold. ...Feel that? That is a city with nowhere it has to be.", "Rollo's crews are lying in the sun, because I told them rest is a rep and they believed me. You used heart and mind both, son. That's the whole lift."],
"freed_npc.grandchef": ["The sauce is gone from every stove in the kingdom, and I'm cooking with real onions again. I haven't cried this much since I was a girl.", "Sit. Eat. You did something worth putting your name to, and you look as if you haven't had a proper meal since."],
"freed_npc.agnes": ["I have filed a Form of Gratitude on your behalf, dear, and it was approved on the first attempt. That is highly irregular, and I find I rather like irregular.", "I think I'm going to cry, dear. I've wanted to for a very long time."],
"freed_npc.compostella": ["Look at this crack in the marble, child. Something's growing out of it.", "I'm going to let it. It's earned the right, and so have you."],
"npc.guard_height.intro.freed": ["I used to measure people, and now I just look at them, which takes a lot less time. A man walked past yesterday who must have been nine feet tall, and all I said to him was 'good morning'.", "I'm not myself at all. I think I might be somebody better. I've still got the stick, mind, and I don't know where you go to hand a stick in."],
"npc.guard_height.return.freed": ["Come in, come in, and bring whatever height you've got. I've stopped keeping count, and I sleep much better for it."],
"npc.guard_queue.intro.freed": ["Queue management. There's no queue any more, so I'm only standing here out of habit.", "Nobody's told me where else to stand, so I thought I might go for a walk. If that's... no. I'm not asking permission, I'm telling you. I think."],
"npc.guard_queue.return.freed": ["There's still no queue. I did go for that walk, by the way. I got as far as the fountain and came back, but I'm doing very well."],
"npc.guard_in_1.intro.freed": ["Exit control, or it was. You can leave whenever you like now, and I'm only standing here because it turns out I'm rather fond of the view. It's a very open exit."],
"npc.guard_in_1.return.freed": ["Exit control. Goodbye, and do come back, won't you? I never used to be allowed to say that part, so I'm saying it to everyone."],
"npc.guard_in_2.intro.freed": ["Exit control. Well, this is an exit, and it's an entrance as well, and I walked the whole way round it this morning and from every angle it's a door."],
"npc.guard_in_2.return.freed": ["It's only a door, isn't it? It's a good door, though. I think I'll go on standing by it for a bit, if nobody minds."],
"npc.exit_clerk.intro.freed": ["Exit Interview Booth. Name, and reason for... no, I'm sorry, that just comes out by itself. You don't need a reason any more.", "I was never going to read the answers anyway, and nor was anybody else. Please go wherever you like, and have a nice day while you're about it."],
"npc.exit_clerk.return.freed": ["Have a nice day. I mean it now, which is new, so I'm still getting used to how it sounds."],
"npc.hesper.intro.freed": ["Hesper Dray. Sit. Drink.", "Tea's still unapproved. So is everything else now. Suits it."],
"end.marker": [""],
"cutscene.primm_reveal.1.speaker": ["Primm"],
"cutscene.primm_reveal.1": ["...You do not even know, do you? Look at you. You have walked my castle for hours and you have not once asked why my portraits stop at eleven."],
"cutscene.primm_reveal.2.speaker": ["You"],
"cutscene.primm_reveal.2": ["...What do you mean?"],
"cutscene.primm_reveal.3.speaker": ["Primm"],
"cutscene.primm_reveal.3": ["I kept your face. I kept it for ten years, in the one gallery I never let anyone clean. It is the only face I could not improve.", "You are the Royal Asset. You are the boy who got out. You are {prince_full}, and you have been so very hard to find."],
"cutscene.primm_reveal.4.speaker": ["You"],
"cutscene.primm_reveal.4": ["...That's not possible. I would remember."],
"cutscene.primm_reveal.5.speaker": ["Primm"],
"cutscene.primm_reveal.5": ["Your power has kept the Paths in one shape for ten years, and I have only ever looked after it. Surely you can see that.", "Come. You may as well see it used properly."],
"prop.lost_poster": ["HAVE YOU SEEN THIS IMPROVEMENT OPPORTUNITY?", "ESCAPED ROYAL ASSET. Age: approx. 21.", "Height: average. Distinguishing features: none, we hope. Last seen leaving a Ministry facility in the company of a traitor.", "Please return to the nearest Ministry office. Reward: a commendation."],
"prop.lost_poster.known": ["HAVE YOU SEEN THIS IMPROVEMENT OPPORTUNITY?", "ESCAPED ROYAL ASSET. Age: approx. 21.", "Height: yours. Face: yours. Last seen: reading this poster."],
"sign.lost_poster": ["LOST PROPERTY", "Have you seen this Improvement Opportunity? Please return to the nearest Ministry office. No questions will be answered."],
"fx.deface_poster": ["You cross out 'Asset' and write 'Person' in the margin, in large letters. A passing citizen pretends not to see, and then, quietly, nods. +12 gold from a grateful Wrinkle."],
"dungeon.pc_gallery.title": ["{villain}'s Private Gallery"],
"dungeon.pc_gallery.blurb": ["A small gallery behind a mirror, which nobody is allowed to clean. A dead end with a prize."],
"dungeon.pc_gallery.before": ["A single portrait hangs in a gilt frame, lit like a shrine: a royal family of three.", "The king and the queen have been painted over in white, so carefully that every brushstroke runs the same way. Only the boy between them was left untouched.", "A small card on the frame, in a neat hand: 'KEPT FOR REFERENCE.' The boy has your face.", "You stand there a long time. Your throat has closed, and you cannot say why."],
"dungeon.pc_gallery.after": ["Behind the frame, a hidden hatch holds a small bag. You take it, and you do not look back at the portrait, because if you do you will not be able to leave."],
"dungeon.pc_ward.title": ["The Correction Ward"],
"dungeon.pc_ward.blurb": ["A long ward of white cells. Free the prisoners for a boon, and read what the Path-ologists wrote."],
"dungeon.pc_ward.before": ["The Path-ologists' records are pinned to every door. 'SUBJECT 1, the Royal Asset. Drain cycle 3,114.'", "'Power stable, routed to the Throne. {villain}'s hold depends on it. Do not allow the Subject to leave.'", "You read the word Subject until it stops being a word.", "The oldest notes, at the far end, are in a different hand: careful, rounded, familiar. 'Observation, Year 1. The child is not a specimen. He asks for his mother. I am leaving the lab. M.'", "You have seen that handwriting on a pie recipe."],
"ending.beat.8.title": ["The Pathwork Throne"],
"ending.beat.8": ["Under the Model Room the floor opens too, and a stair of four colours winds down into the old heart of the Capital.", "At the bottom stands the Pathwork Throne: four seats grown into one, four colours woven as a single thread. It was never {villain}'s.", "You sit, and the Throne answers. It knows you.", "The Throne says your name back to you, {prince_full}, and this time it brings the Paths with it, all four, as they were always meant to be carried."],
"ending.beat.9.title": ["{villain} Sees"],
"ending.beat.9": ["{villain} sits among the pieces of his model. As the Paths settle, he sees the kingdom as it is, and not as his reflection.", "Cracked streets, real faces, and a boy he kept in a cell.", "Slowly, he understands how much he broke. The wells were good, and so were the schools, but he made one choice for everyone, and nobody will trust him with another."],
"ending.beat.10.title": ["File Complete"],
"ending.beat.10": ["Agnes Overdue floats up to the old transfer file, finds the heir clause and, with great ceremony, brings down her stamp: HEIR: ALIVE. FILE COMPLETE.", "Maren pushes through the crowd, tortoise-slow, and stops in front of you. There is flour on her sleeve.", "'{prince},' she says, loudly enough for the whole plaza to hear. She has said it in her kitchen, but this is the first time she has said it to the kingdom. 'Welcome home.'", "You look past her for a hood with leaves caught in it, and it isn't there. {rescuer} is still in the Path-ology Lab, under the forest where you woke. 'Eat first,' Maren says quietly. 'Then go and fetch her home.'"],
"freed_npc.primm": ["Do not look so alarmed. The guard is very kind. Every morning he brings me the list of the people I corrected, and I read it. There are eleven thousand names. I am on the third page.", "I am designing a water main. A real one: pipes, a pump and nothing clever. It is the first thing I have made in ten years that nobody had to agree to.", "I am not permitted to speak of the Paths, or to touch one. I find that I do not miss it. I find that I miss the wells."],
"freed_npc.primm_guard": ["He is allowed visitors: one at a time, ten minutes each, and no mirrors. Those are the rules. I did not write them and nobody made me recite them, and I find I do not mind them at all.", "He designs a very good drain, as it turns out. Please do not tell him I said so; I am not sure which of us it would embarrass more."],
}
