[gd_resource type="Resource" script_class="ZoneStoryText" format=3]

[ext_resource type="Script" path="res://core/data/zone_story_text.gd" id="1_cap"]

[resource]
script = ExtResource("1_cap")
zone_id = "final"
lines = {
"hud.objective": ["The Capital: the walls are up and the Approved Gate is the only way in. Pass Captain Spotless's entry examination (a card battle), or find another way.", "HP does not come back after battles; rifts hurt; the hideout heals. {villain}'s Castle waits at the far end of the city."],
"hud.objective.inside": ["You are inside the Capital. Find the hideout (the manhole near the gate), help the Wrinkles (one quest per Path), seal the rifts you can and reach {villain}'s Castle at the north end. Each Path you free mends one of the city's broken services."],
"hud.objective.freed": ["The Capital is free. The facade is down, the rifts are closed and the citizens are saying whatever they like, mostly to each other. The Crease is open to everybody."],
"ui.exit.title": ["Walk back down the road to {town}?"],
"ui.exit.body": ["Leaving the Capital ends this visit. Town heals you fully. The Approved Gate stays open for you, but every roaming officer, inspector and Tidy-Bot will be back next time, and so will the rifts."],
"ui.exit.body.freed": ["Leaving the Capital ends this visit. Town heals you fully. Nobody will ask for your exit permit. Nobody has a permit machine. The road is just a road."],
"ui.gate.title": ["The Entry Examination"],
"ui.gate.body": ["Captain Spotless measures you against the Approved Visitor Standard: a hard card battle, his deck fair to nobody. Your HP carries in from the zone and nothing heals in between. Lose, and you wake outside, a little poorer."],
"ui.gate.button": ["Take the examination"],
"ui.main.title": ["{villain}'s Castle"],
"ui.main.body": ["The great doors stand open, which is worse than closed. Twenty-odd rooms of portraits and good intentions, then {villain} himself. HP carries in; nothing heals except at the shrines. Your zone's broken-service debuffs apply to every duel."],
"ui.main.body_cleared": ["{villain} is gone. The castle is just a very large, very tidy building now, and the portraits have started to peel. You may walk through it again for the memories (and the gold). HP carries in; nothing heals except at the shrines."],
"ui.main.button": ["Enter the castle"],
"fx.main_dungeon": ["The doors of {villain}'s Castle are made of gold, and every handle has been polished until it shows you your own worried face. Beyond them: a long gallery, a smell of floor wax, and the sound of someone very pleased with himself, humming."],
"fx.main_dungeon.freed": ["The doors of {villain}'s Castle stand open. The gold is flaking. A pigeon has built a nest in the crown above the lintel and nobody has asked it for a permit."],
"fx.heal_couch": ["Nurse Hesper hands you a cup of the Tea of Dissent. It is strong, bitter and entirely unapproved. HP restored."],
"fx.heal_already": ["You are already at full HP. Nurse Hesper hands you a cup anyway. 'Dissent,' she says, 'is good for the circulation.'"],
"fx.hit": ["Ow! The Capital has hurt you again. (-HP)"],
"fx.wake": ["You wake up on a cot in the Crease. Nurse Hesper Dray is writing on a clipboard that, you notice, is blank on purpose.", "'Dragged you in by the collar. Correction fee is on you; the Wrinkles run on small coins and large grudges. Drink your tea.'"],
"fx.wake.freed": ["You wake up on a cot in the Crease. Nurse Hesper Dray is writing on a clipboard. It says 'NOTES', and then, in small letters, 'finally'.", "'Fell over. We rolled you in. The fee is on you, still; the tea is not free just because the kingdom is.'"],
"fx.wake_outside": ["You wake up in the dust outside the Approved Gate, under a sign that says STAND HERE. A guard is leaning over you, measuring your height with a long stick.", "'Fell over in the approved queue area. That is a minor offence: a fine. Please stand up to the approved height. You have shrunk, citizen.'"],
"fx.chest": ["A hidden stash! Someone hid this where {villain}'s inspectors would not look: behind something untidy."],
"fx.inside": ["You are through the walls. Somewhere a loudspeaker clears its throat. You are now, officially, a Visitor in {capital}, the Capital of {kingdom}."],
"fx.no_travel": ["The service-tunnel network is down. Nobody has run the wheels that power the shaft lifts in ten years. 'No travel,' says a Wrinkle's note on the hatch.", "'Free the Gainlands and we will get the lifts turning.'"],
"fx.shaft": ["You drop down the shaft, ride the lift through the dark and climb out somewhere else, smelling of rust."],
"fx.ladder": ["You climb the ladder and push the manhole open. The Capital's cold light falls in."],
"fx.tunnel_out": ["You crawl out through the old tunnel and push the rubble aside. The Outskirts again, and a long way from anybody's approved queue."],
"fx.tunnel_in": ["You squeeze back down the collapsed shaft and follow the old tunnel in the dark."],
"fx.tunnel_found": ["You push through a gap between rubble and a toppled statue. Behind it: stairs, a smell of damp brick, and an old plaque in four different handwritings: 'THE OLD JOINT WORKS. BUILT BY ALL FOUR PATHS, TOGETHER, BACK WHEN WE DID THAT.'", "The tunnel runs under the wall, under the gate and under every one of {villain}'s checkpoints. You walk under them all. It is the best moment you have had all day."],
"fx.manhole": ["You knock three times. The manhole opens to a hand and a tired voice: 'Down you come.'"],
"fx.manhole_first": ["A manhole by the wall, with a scratch on its lid like a tiny wrinkle. You knock three times, for no reason you can name.", "A pause. Then the lid lifts and a hand beckons. A voice mutters, 'Wrinkle?' You decide that, yes, you are.", "Down a ladder, along a brick tunnel, into a warm room full of mismatched furniture and people who are all, visibly, not ironed."],
"fx.deface": ["You scribble a moustache on His Perfection. It improves him enormously. A small coin falls out of the frame: somebody in the Wrinkles pays a bounty on moustaches."],
"fx.deface_again": ["Already improved. He has a moustache now. He looks, for the first time, like a person."],
"fx.complaint_compensation": ["You post a complaint. A slot opens and, impossibly, a small coin falls out with a note: 'Thank you for your feedback. Here is a small sum for your inconvenience. Do not complain again.'"],
"fx.complaint_tea": ["You post a complaint. A hatch opens and a warm cup of tea is pushed out, still steaming. 'We value your concern,' says a note. You feel a little better."],
"fx.complaint_noted": ["You post a complaint. Nothing happens. The box says, in a very gentle voice: 'Your complaint has been noted.' You have never felt so unnoted."],
"fx.complaint_inspector": ["You post a complaint. A klaxon sounds. A Perfection Inspector appears from nowhere, measures your frown, writes you up and walks off.", "'Thank you for your feedback,' says the box."],
"fx.complaint_limit": ["The box rattles. It is full. It has had enough of your feedback for one visit."],
"fx.seal": ["You set the rift-stone and say the old word: close. The tear shudders, folds in on itself like a letter, and is gone. The air smells of rain. Sealed!"],
"fx.seal_guarded": ["The rift-stone will not take while the rift's guardian still stands. Whatever it spat out has to go first."],
"fx.seal_done": ["The rift is sealed. Where it was there is a scorch mark and the memory of a very bad idea."],
"fx.seal_cannot": ["This one is too big. It runs all the way up into the castle. It will have to close when he does."],
"fx.pickup_recipe": ["A real recipe, written by hand, with a stain of actual sauce on the corner! A pinch of this, a spoonful of that. It is wonderfully imprecise. You tuck it away."],
"fx.pickup_compost": ["A banished compost heap, hiding in a cellar where it was not allowed to be. It is warm. It is alive.", "It steams, very slightly, with gratitude. Rescued!"],
"fx.pickup_stamp": ["A rubber stamp the size of your fist, the handle worn smooth. FINAL APPROVAL, it reads, in letters that have been inked a thousand times. Someone has wrapped it in a handkerchief and hidden it here, in case the world needed it."],
"fx.pickup_seed": ["An old glass jar with one seed in it. The seed is glowing very faintly green. Nobody has planted anything in the Capital for ten years. It has not given up."],
"fx.pickup_again": ["You already took the one lying here."],
"fx.pickup_unknown": ["There is nothing here."],
"fx.wheel_1": ["The crew of the first wheel keeps running while you talk, because stopping is not permitted. 'Cardio,' pants a woman, 'is mandatory.' You find the brake lever under a pile of notices.", "The wheel groans, slows and stops. The crew sit on the floor and laugh and cry at the same time."],
"fx.wheel_2": ["The second wheel has been turning since before some of its runners were old enough to vote. A foreman's whistle hangs from a hook. You take it off its hook and put it in your pocket.", "The wheel winds down. 'We were told,' says a man, 'that this was how you got strong.'"],
"fx.wheel_3": ["The third wheel's crew are children. Children! 'It is a school activity,' says a banner.", "You pull the lever, break the wheel's rhythm and get them off. They are very small and very proud and they will not stop saying 'Rollo sent you?'."],
"fx.wheel_again": ["This crew is free. They are lying on the ground, looking at the sky. It is the best they have felt in ten years."],
"fx.cable": ["You cut the big black cable that feeds the facade's lights from the wheels. A spark; a silence. Far off, the perfect lamps flicker, stutter and come back on: {villain} keeps a very small private generator, just for himself."],
"fx.cable_again": ["The cable is cut. The wires twitch occasionally, out of habit."],
"fx.paste": ["You pull the lever and ask the Perfect Nutrient Paste Dispenser for a refund. It chokes, burps and covers itself in a bright green foam that smells, fatally, of actual cabbage. A paste machine is not supposed to remember cabbage."],
"fx.paste_again": ["The dispenser is spoiled and sulking. The foam is still fizzing a little."],
"fx.plot": ["With the Stamp of Final Approval pressed to the form, the grave plot's little iron gate unlocks. A line of mourners, who have waited three years outside, file in.", "Mr. Pell, in a coffin carried by the whole neighbourhood, is laid to rest at last. Somebody plays a very small, very sad, very real tune."],
"fx.plot_again": ["The Pell plot is tended and quiet. Fresh flowers. The family comes every morning now."],
"fx.plot_locked": ["The iron gate is sealed with a notice: 'NO BURIAL WITHOUT A STAMPED PERMIT (FORM 27-B/6, FINAL APPROVAL).' You have no stamp. Widow Pell said something about a stamp, hidden somewhere in Grave Row."],
"fx.patch": ["You kneel, scoop a hole with your hands and drop in the seed. You water it with what is left in your flask. Nothing happens, for one long, bad moment.", "Then a shoot, as thin as a thread, noses out of the dirt. And another. And a flower, the colour of everything the Capital is not."],
"fx.patch_again": ["The patch is green and growing. A bee, which should not exist in the Capital, hovers over it, deciding."],
"fx.patch_locked": ["The patch is sick, grey and cracked, and nothing will grow in it without a seed. Old Fern mentioned an old seed in a jar, hidden somewhere in the Reek."],
"fx.permit_1": ["The clerk behind the window slides you a form. 'For a burial permit, Form 27-B. Please attach Form 27-C (Proof of Grief).'", "You ask for 27-C. 'Please attach Form 27-B,' she says."],
"fx.permit_2": ["'Form 27-C requires Form 27-B.' 'Form 27-B requires Form 27-C.' 'It is a loop,' you say.", "'It is a process,' she says, with fear in her eyes."],
"fx.permit_3": ["'Please take a number.' You take a number. It says 4,112,009.", "The sign above the window says NOW SERVING: 3. It has said so for three years."],
"fx.ward_window": ["'Spontaneity Permits are issued on Thursdays, between 3 and 3:05, by appointment,' says the sign. The clerk inside has been asleep, upright, with her eyes open, since the last Thursday."],
"debuff.beefcake.name": ["Blackout"],
"debuff.beefcake.flavor": ["The Beefcakes kept the kingdom's energy and its roads: the wheels, the mills, the throwers and the portal-rippers. {villain} put them all on wheels to light one small town. The rest of the kingdom went dark."],
"debuff.beefcake.freed": ["The lights are back on: the street lamps burn, the lifts run, the tunnels are open again, and the Beefcakes' wheels, free at last, turn for everyone."],
"debuff.gourmand.name": ["Famine"],
"debuff.gourmand.flavor": ["The Gourmands fed and guarded the kingdom. {villain} replaced them with Perfect Nutrient Paste. Real food is gone from the Capital, and so is the comfort it gave."],
"debuff.gourmand.freed": ["The food stalls have reopened: awnings, steam, lanterns, real food. Healing items work again, and the stomachs of the Capital are not quite so empty."],
"debuff.necrocrat.name": ["Restless Dead"],
"debuff.necrocrat.flavor": ["The Necrocrats looked after the dead and their paperwork. {villain}'s permits locked the dead out of their graves and the paperwork in an endless loop. The dead do not rest, and the things that have died keep coming back."],
"debuff.necrocrat.freed": ["The cemetery is calm: graves are tended, the permit loop has been broken, and the dead are finally allowed to lie down."],
"debuff.refusemancer.name": ["Clutter"],
"debuff.refusemancer.flavor": ["The Refusemancers took out the kingdom's waste and turned it back into soil. {villain} called composting untidy and hid the garbage behind the facade. Rubbish is piling up, in the streets and in your deck."],
"debuff.refusemancer.freed": ["The heaps are smaller and greener. Things are being composted again and the Reek smells, very faintly, of flowers."],
"debuff.rule.darkness": ["The Capital is dark and you can see only a short way."],
"debuff.rule.slow": ["You move more slowly."],
"debuff.rule.no_travel": ["The service-tunnel network is down: no travel."],
"debuff.rule.no_food_heal": ["Healing items do not work (food does not agree with the Capital)."],
"prop.facade_arch": ["THE SHOWCASE QUARTER"],
"prop.complaint_box": ["COMPLAINTS"],
"prop.compost_shack": ["COMPOST (ILLEGAL)"],
"prop.parlor": ["PELL FAMILY PARLOR"],
"prop.permit_office": ["PERMIT OFFICE (BURIALS, CREMATIONS, DISCOURAGEMENTS)"],
"prop.paste_dispenser": ["PERFECT NUTRIENT PASTE. TASTES OF NOTHING. THAT IS THE POINT."],
"sign.gate_main": ["THE APPROVED GATE", "Visitors are welcome (conditions apply)."],
"sign.gate_main.freed": ["THE GATE (OPEN)", "Everybody is welcome. Conditions: none. Please do not feed the pigeons."],
"sign.gate_requirements": ["APPROVED VISITOR STANDARD", "1. Visitors must be of approved height.", "2. Visitors must be smiling at an approved angle.", "3. Visitors must not have unapproved opinions.", "4. Visitors must have already been approved."],
"sign.gate_requirements.freed": ["FORMER APPROVED VISITOR STANDARD", "1. Be of whatever height you are.", "2. Smile (or not).", "3. Have opinions (loudly).", "4. Come in."],
"sign.gate_exit": ["EXITS ARE CONTROLLED", "To leave, please obtain an Exit Permit, an Exit Interview and an Exit Interview Permit."],
"sign.gate_height": ["APPROVED HEIGHT", "Between this line and that line. Slouching is a violation. Standing on tiptoes is a violation.", "Having a height is, on balance, a violation."],
"sign.gate_inside": ["WELCOME TO {capital}", "The Capital. Population: neat. Remember: it is perfect. If it is not, that is your fault."],
"sign.gate_exit_inside": ["EXIT INTERVIEW", "All departures require an interview. Please state your reasons for wishing to be somewhere less perfect."],
"sign.facade_welcome": ["THE SHOWCASE QUARTER", "A Showcase Quarter, built to show what the whole kingdom could be if everybody simply tried harder."],
"sign.facade_welcome.freed": ["WAS: THE SHOWCASE QUARTER", "Now: some houses. A very tidy lawn. A lot of citizens who would like to go home."],
"sign.facade_hats": ["APPROVED HAT SIZES", "Approved Hat Sizes: 1.", "Hats of other sizes are a Disagreement."],
"sign.facade_spontaneity": ["SPONTANEITY BY PERMIT ONLY", "Fun may be had Thursdays 3:00 to 3:05. Please queue for fun."],
"sign.facade_spontaneity.freed": ["SPONTANEITY: NO PERMIT NEEDED", "Somebody has crossed out BY PERMIT and written BY SURPRISE."],
"sign.facade_smile": ["SMILING IS MANDATORY", "Please smile at least 70% of the time. Smile with your teeth. Mind the edges."],
"sign.facade_smile.freed": ["SMILING IS ENCOURAGED", "(somebody has written 'when you feel like it' underneath, in small neat letters)"],
"sign.facade_lawns": ["REGULATION LAWNS", "Grass shall be 2.0 cm tall. Please do not walk on it. It will not forgive you."],
"sign.facade_hedges": ["HEDGE LAW", "Hedges shall be square. Hedges that wish to be round must submit a request."],
"sign.facade_queue": ["THE ORDERLY QUEUE", "Queue here for the Orderly Queue. No place is more orderly than the Orderly Queue."],
"sign.facade_loudspeaker": ["LISTEN FOR YOUR ANNOUNCEMENTS", "Announcements are cheerful. Cheerfulness is not optional. Neither are announcements."],
"sign.facade_shop_1": ["BAKERY", "Fresh Approved Bread (Daily). Closed (Permanently)."],
"sign.facade_shop_2": ["BOOKS & WELLNESS", "Approved titles: 1. Approved wellness: 1."],
"sign.facade_back": ["SERVICE ENTRANCE", "(Not a real door. Please do not look behind it. There is nothing behind it.)"],
"sign.reek_main": ["THE REEK", "Formerly the Verdant Quarter. Now the place we put everything that does not look nice."],
"sign.reek_untidy": ["COMPOSTING IS UNTIDY", "By decree: all composting is outlawed. Rubbish shall be placed where it cannot be seen. That place is here."],
"sign.reek_compost_ban": ["NO COMPOST", "The act of composting is a form of Disorder. Offenders will be corrected."],
"sign.reek_behind_facade": ["ALL GARBAGE GOES BEHIND THE FACADE", "(It is not garbage. It is Behind.)"],
"sign.reek_sick_patch": ["THE SICK PATCH", "The soil here has stopped growing. Please do not ask why. Please do not plant anything. Please do not feel anything."],
"sign.net_reek": ["SERVICE SHAFT: THE REEK", "To the Crease. Wrinkles only. If you are not a Wrinkle, you did not see this."],
"sign.grave_main": ["GRAVE ROW", "Formerly the Cemetery of {kingdom}. Currently Closed Pending Review."],
"sign.grave_permit": ["PERMIT OFFICE", "Burial permit: Form 27-B. Attach Form 27-C. Form 27-C requires Form 27-B. Please queue."],
"sign.grave_queue": ["QUEUE FOR THE QUEUE", "Take a number to take a number. Your number is: 4,112,009. Now serving: 3."],
"sign.grave_waiting": ["WAITING (DEAD)", "The deceased are asked to remain in their parlors until a permit has been approved. Please do not wander."],
"sign.grave_plot": ["PELL FAMILY PLOT", "Reserved since before the permit system. Locked since the permit system."],
"sign.net_grave": ["SERVICE SHAFT: GRAVE ROW", "To the Crease. The dead are not allowed down. The living are a little afraid of the dead down there. Be kind."],
"sign.transit_main": ["THE TRANSIT YARDS", "Where the kingdom's energy and its roads were made. Now: where the facade's lights are made."],
"sign.transit_cardio": ["MANDATORY CARDIO", "Every citizen shall run the wheels for six hours a day. The wheels never stop. The lights never go out. Your legs are not your own."],
"sign.transit_lines": ["TRAM LINES: SUSPENDED", "All tram lines are suspended due to the requirement that every tram shall arrive on time. None have. Trams are therefore suspended."],
"sign.transit_lights": ["THE LIGHTS OF THE FACADE", "Powered by You, personally."],
"sign.transit_cable": ["DO NOT CUT", "The big black cable is the facade's lifeline. Cutting it is a crime. Please do not cut it."],
"sign.net_transit": ["SERVICE SHAFT: THE TRANSIT YARDS", "To the Crease. Out of service: the lifts need the wheels, and the wheels are busy lighting a small town."],
"sign.hungry_main": ["THE HUNGRY QUARTER", "Formerly the Market of the Four Paths. Now: where everybody queues for the one approved meal."],
"sign.hungry_paste": ["PERFECT NUTRIENT PASTE", "One serving per citizen per meal. Every meal. Tastes of nothing. Nothing is perfect."],
"sign.hungry_closed": ["ALL STALLS CLOSED", "Real food is a source of Individual Preference and has therefore been replaced."],
"sign.hungry_nutrition": ["NUTRITION IS NOT DELIGHT", "Delight is a form of inefficiency. Please eat in silence."],
"sign.hungry_menu": ["TODAY'S MENU", "Paste.", "(The same menu as yesterday. And tomorrow. It was always going to be.)"],
"sign.net_hungry": ["SERVICE SHAFT: THE HUNGRY QUARTER", "To the Crease. There is a smell of cooking down there. Real cooking. Nobody mentions it."],
"sign.castle_main": ["THE CASTLE OF HIS PERFECTION", "Please do not stare. He can tell."],
"sign.castle_main.freed": ["THE CASTLE (FORMERLY OF HIS PERFECTION)", "Under new management. The new management is: all of us, arguing."],
"sign.castle_avenue": ["THE AVENUE OF PORTRAITS", "Each portrait has been improved. Please admire them in order."],
"sign.castle_warning": ["WARNING: TEARS IN REALITY", "{villain} has assured everyone that the tears are temporary. He has assured everyone of this for ten years."],
"sign.castle_warning.freed": ["WARNING: PIGEONS", "The tears are sealed. The pigeons have moved in. The pigeons are staying."],
"sign.net_approach": ["SERVICE SHAFT: THE CASTLE APPROACH", "To the Crease. If you hear humming from the castle above, do not hum along."],
"sign.yard_main": ["CHECKPOINT ROW", "Seventeen checkpoints in one street. Each one checks the last."],
"sign.yard_abandoned": ["ABANDONED CHECKPOINT", "The staff left in the night. They left their forms behind."],
"sign.yard_form": ["FORM 1-A (STAMPED)", "Authority transferred, reviewed, approved, notarized, filed. The authorization is valid. Nobody is here to enforce it."],
"sign.ward_main": ["THE CORRECTION WARD", "Citizens who smile incorrectly are sent here for improvement. Improvement takes as long as it takes."],
"sign.ward_permit": ["SPONTANEITY PERMIT WINDOW", "Thursdays, 3:00 to 3:05, by appointment."],
"sign.ward_rules": ["WARD RULES", "No laughter. No sighing. No unapproved crying.", "Crying must be done in the correct order."],
"sign.out_welcome": ["WELCOME TO THE CAPITAL OF {kingdom}", "Please join the approved queue and wait to be measured."],
"sign.out_queue": ["APPROVED QUEUE", "Queue here. You may not queue anywhere else. You may not queue here without a queue number. You may not have a queue number."],
"sign.out_abandoned_a": ["CHECKPOINT 14 (ABANDONED)", "It was a very good checkpoint. It checked everything."],
"sign.out_abandoned_b": ["CHECKPOINT 15 (ABANDONED)", "(somebody has drawn a moustache on the guard. It suits him.)"],
"sign.out_rift": ["WARNING: RIFT", "The Paths tear where {villain} forced them into one shape. His hold has been failing for ten years, ever since the night something escaped from the Ministry.", "Do not touch. Do not look. Do not whistle."],
"sign.out_exit_rules": ["EXIT RULES", "To leave the Outskirts, walk back down the road. To leave the Capital, please see: the Exit Interview Booth."],
"sign.out_tunnel_clue": ["the old tunnel came out near here", "(a scrap of paper pinned under a stone: 'forgotten service shaft, SW of the wall, behind the fallen statue. Rubble is mostly for show.')"],
"sign.out_old_works": ["OLD JOINT WORKS: PROPERTY OF THE FOUR PATHS", "Closed. Forgotten. Not on any map. (Try the south-west corner.)"],
"sign.plaza_main": ["CHECKPOINT PLAZA", "Please proceed in an orderly fashion, in the approved direction, at the approved speed, with the approved face."],
"sign.plaza_main.freed": ["THE PLAZA", "Proceed however you like. There is a very large statue; it is lying down."],
"sign.plaza_exit_interview": ["EXIT INTERVIEWS", "Departures require an interview. Interviews require an appointment. Appointments require a departure."],
"sign.plaza_complaints": ["THE ANONYMOUS COMPLAINT BOX", "Your complaint matters. It is read by nobody."],
"sign.plaza_manhole": ["(a small scratch on the cover, like a wrinkle)", "Knock three times."],
"sign.net_plaza": ["SERVICE SHAFT: CHECKPOINT PLAZA", "To the Crease. Authorized personnel only. The authorization is: you knocked."],
"sign.crease_main": ["THE CREASE", "A Wrinkle is something that does not go away when you press it."],
"sign.crease_wrinkle": ["THE WRINKLES", "Founded by people {villain} could not iron out. No dues. No forms. No smiling."],
"sign.crease_network": ["THE SERVICE SHAFT NETWORK", "Built by all four Paths, together, back when we did that. Six shafts, six streets. (Beefcake wheels power the lifts. No wheels, no lifts.)"],
"sign.crease_rules": ["HOUSE RULES", "1. Say what you think.", "2. Eat what you like. 3. Wear a hat of any size.", "4. Do not tell anyone where we are."],
"npc.wren.intro": ["Another one through the shafts. Sit. I am Wren. I was Royal Archivist, once. Now I keep the records this city is not supposed to have.", "Maren sent word from {town} that someone might come. This is the Crease. We are the Wrinkles: the people {villain} could not iron out. We have tea and grudges. The tea is better.", "He is in the castle at the north end, and he truly believes he is helping. That is the hard part. Talk to the streets. Each of them holds a piece of him."],
"npc.wren.intro.freed": ["You did it. Sit. I am Wren: Royal Archivist, and for ten years the only honest record in this city.", "The Crease is just a cellar now. We are keeping it anyway, for the stories.", "Thank you. I mean that more than I have ever meant a footnote."],
"npc.wren.return": ["Back in one piece? Good. Mostly one piece.", "The records say he began as a good man. Keep that in mind. It makes the work harder and the ending better."],
"npc.wren.return.freed": ["The kingdom is mending, one argument at a time. It is dreadfully inefficient. I have never been happier. Take your time."],
"npc.wren.insight.1": ["You brought me something from the streets. It goes in the true record, in ink, where he cannot correct it."],
"npc.wren.insight.2": ["Two pieces of him now. A man who needs to be right. A man who cannot bear to be disagreed with. I can almost see his shape."],
"npc.wren.insight.3": ["Three. He is afraid, you know. Not of you.", "Of everything that will not obey. A small, sad fear, for a man with so much gold."],
"npc.wren.insight.4": ["All four. I have the whole of him now. He is not a monster.", "He is a man who made a list of everything he could not control, and made it illegal.", "Go and finish it. Gently, if you can. But finish it."],
"npc.fig.intro": ["Psst. Over here. Fig Sly, purveyor of contraband and curiosities.", "Everything on this table is illegal, uneven or both.", "Rare cards, good prices, no questions. Well: one question. Would you like a bag? Bags are illegal too."],
"npc.fig.intro.freed": ["Fig Sly, formerly purveyor of contraband. Now: purveyor of things. It is a much less exciting job.", "The margins are better. Take a look."],
"npc.fig.return": ["Back for more? Wise. Rare stock never lasts. Mind the one on the end: it bites."],
"npc.fig.return.freed": ["Still selling. Nobody arrests me. It is horrible. I miss the thrill."],
"npc.hesper.intro": ["Hesper Dray. Nurse. Sit. Drink.", "Tea. Strong, bitter and unapproved. Unapproved things heal faster. That isn't medicine. It's just true.", "The rifts? His hold is failing. Everything he forced together keeps coming apart, and he keeps stitching.", "It began the night the boy got out, they say. Nobody says 'boy' where the loudspeakers can hear."],
"npc.hesper.return": ["Bleeding again? Sit. I'll pretend to be surprised."],
"npc.fern.intro": ["Shh. Keep it down. Old Fern. Composter.", "I turned this city's waste back into soil. Now that's 'untidy', and so am I. Criminally untidy. Worms in my hat to prove it.", "They shoved the rubbish behind the facade and called it 'Behind'. The land's sick. Nothing grows. Help me save what's left."],
"npc.fern.intro.freed": ["Old Fern. Composter. Allowed to say it out loud now.", "The patch came in, the heaps are steaming and nobody's hit me in a week. Untidy and proud."],
"npc.fern.return": ["Any luck? The heaps are in cellars and holes all over the Reek. They think they're hiding. They're being rescued."],
"npc.fern.return.freed": ["Smell that? Honest compost. I could cry. I might. Come back any time."],
"npc.pell.intro": ["Oh. A visitor. Forgive me, I've forgotten how this goes. I am Widow Pell.", "My husband died three years ago, in his chair in the front parlour. I cannot bury him. The permit loops.", "Form 27-B needs Form 27-C, and 27-C needs 27-B. So he waits in his chair. He was always the patient one.", "I've started talking to him. He doesn't interrupt. Please, if you can help."],
"npc.pell.intro.freed": ["Widow Pell. My husband is at rest. I visit him every morning.", "Thank you. I will never say it enough, so I keep saying it."],
"npc.pell.return": ["The stamp, remember. Someone hid the Stamp of Final Approval where nobody official would look: somewhere in Grave Row, among papers nobody reads."],
"npc.pell.return.freed": ["We're well. My husband would have said you were late. He'd have meant it fondly."],
"npc.rollo.intro": ["Rollo Spokes... foreman. Beefcake. Learned the wheels... in the Gainlands. Back then, a wheel stopped at night.", "Now the facade needs light... so we pedal. Free. Forever. We were told... it was cardio. My calves have calves.", "My crews run six hours a day... for ten years. Nobody's told them they can stop. Somebody ought to."],
"npc.rollo.intro.freed": ["Rollo Spokes. The wheels are slow, and the crews are sitting in the sun, lifting nothing. Best I've ever seen them look."],
"npc.rollo.return": ["Three wheels... pull the brakes. And that big cable by the east wall... feeds the facade. Cut it.", "The crews won't stop... till somebody says it's all right. You say it."],
"npc.rollo.return.freed": ["We're lifting again. Real things. On purpose. Come and watch the crews. Bring a snack."],
"npc.marlo.intro": ["Hands where I can see them. Good. Chef Marlo. Once of the Market of the Four Paths.", "Now I am a 'Nutrient Distributor'. I keep my recipes in my apron, where the inspectors won't reach.", "Everyone eats {villain}'s Perfect Nutrient Paste, three times a day. Paste is food the way a form is a hug.", "For ten years I've hidden real recipes all over this quarter, so that somebody, somewhere, remembers what food is."],
"npc.marlo.intro.freed": ["Chef Marlo. Chef. Say it with me. The stalls are open and the food is real.", "And chaotic. There is flour on the ceiling. I have never been so happy to have a mess."],
"npc.marlo.return": ["Three recipe cards, hidden in the quarter. And the dispenser: give it a good kick from me. Spoil it. Spoil it badly."],
"npc.marlo.return.freed": ["Come and eat. Anything. I mean it. 'Some' of everything."],
"npc.spotless.intro": ["HALT. I am Captain Spotless. State your height.", "No: do not state it. Stand at it. Straighter. Not that straight. APPROVED straight.", "Entry requires the Approved Visitor Standard. You are too tall. You are too short. Your shadow is the wrong length.", "However. The Standard has a provision: the Entry Examination. A card battle. Win it, and you are, retroactively, approved.", "Do not look nervous. Nervousness is a Violation. (He polishes a button.) Shall we begin?"],
"npc.spotless.return": ["You again. Still too tall. Still smiling at the wrong angle. Ready for the Examination?"],
"npc.spotless.open": ["You are approved. You were always going to be approved. I would like that noted.", "Please do not tell {villain_title} that I lost. Please do not tell anyone that I lost."],
"npc.spotless.open.freed": ["I do not measure anyone any more. I just stand here. Yesterday a man walked by at exactly the approved height, and I wept."],
"npc.spotless.defeated": ["You are... approved. You are retroactively approved.", "The Standard is satisfied. The gate opens, by order of the Standard and against my personal feelings.", "I have measured eleven thousand visitors. I approved four. Nine thousand were sent home. The rest, I will not say.", "Go through, citizen. In there, try not to be what you are."],
"npc.guard_height.intro": ["Height inspection! Stand against the post. Straighten.", "Not that straight. Hm. You are one hair above regulation.", "One hair. I will let it go. This time. Do not grow."],
"npc.guard_height.return": ["Still above regulation. Still letting it go. Do not make me regret it."],
"npc.guard_queue.intro": ["Queue management. The approved queue is this queue. You are in it.", "You are not allowed to leave the queue. You are not allowed to join the queue. I do not understand it either."],
"npc.guard_queue.return": ["Still queueing? Good. Stay in the queue.", "It is a long queue. It is the best queue we have."],
"npc.guard_in_1.intro": ["Exit control. You are leaving? You have not arrived. Please arrive first."],
"npc.guard_in_1.return": ["Exit control. Please have your exit permit ready. Please have your exit interview permit ready. Please have a reason."],
"npc.guard_in_2.intro": ["Exit control. This is the exit. It is also the entrance. It is also, from some angles, a wall."],
"npc.guard_in_2.return": ["Exit control. You are, I think, still inside. Congratulations."],
"npc.exit_clerk.intro": ["Exit Interview Booth. Name? Reason for departing the most perfect place in the kingdom?", "Please note: 'it is not perfect' is not an approved answer."],
"npc.exit_clerk.return": ["Your departure request has been received. It has been filed under 'Dissent'. It will be looked at in four to six years."],
"npc.patient.intro": ["Citizen 4471. I smiled incorrectly. Eleven degrees. The approved angle is eight.", "It was my wife's wedding. I had been crying. They corrected me.", "I do not smile any more. Not at all. It is a strange thing, to forget how a face works."],
"npc.patient.intro.freed": ["Citizen... no. My name is Aldous.", "I smile now, when I want. It comes out crooked. My wife says it is the best thing she has ever seen."],
"npc.patient.return": ["I am improving, they say. I am not sure that is a good thing."],
"npc.patient.return.freed": ["Aldous. Crooked. I'm practising."],
"quest.cap_burial.offer": ["Please. A burial permit is all we want: Form 27-B/6, stamped Final Approval.", "Somebody hid the Stamp of Final Approval in Grave Row, among papers nobody reads. Find it, bring it to our family plot by the east wall, and let him rest."],
"quest.cap_burial.active": ["The stamp is somewhere in Grave Row, among papers nobody reads. Then the plot, by the east wall. Please."],
"quest.cap_burial.ready": ["He's at rest? Oh. Oh.", "I sat by the plot all morning and didn't say a word. It was the first quiet in three years that wasn't a fear.", "Here. This was his. He'd want a young person to have it.", "And something about the man in the castle. He schedules grief. Thursdays, 3:00 to 3:05. Anyone who cries outside those hours is corrected.", "I don't think he is cruel. I think he simply cannot bear to watch."],
"quest.cap_burial.done": ["Thank you, a hundred times. We're at the plot every morning. What I told you is in your journal: he cannot stand a sadness he did not schedule."],
"quest.cap_wheels.offer": ["Three wheels in the Transit Yards... three crews nobody ever told to stop. Pull their brake levers... take the foreman's whistle... tell them it's all right.", "They won't believe you. Say it anyway. And cut the big cable by the east wall. The facade's lights have lived on my crews' legs for ten years."],
"quest.cap_wheels.active": ["Three wheels and a cable. Free the crews, cut the cable. They won't believe you at first... keep saying it."],
"quest.cap_wheels.ready": ["Heard the lights flicker from here. Heard the crews sit down. The whole yard... quiet.", "Haven't heard a quiet yard since the coup. Thank you.", "Here. From the old days: what we gave people who could keep going.", "And something about him. He made lateness illegal. A man who cannot wait for anyone.", "Remember that when you meet him. He's always in a hurry... to be loved."],
"quest.cap_wheels.done": ["Wheels are slow. Crews are resting. What I said is in your journal: to him, lateness is disagreement, and disagreement is the one thing he won't forgive."],
"quest.cap_recipes.offer": ["Three of my recipes are hidden in the Hungry Quarter: a bread, a stew, a sauce. Real ones, in my hand, quantities written as 'some'. Find them before the inspectors do.", "And the paste dispenser by the east wall: spoil it. Give it a very bad day."],
"quest.cap_recipes.active": ["Three recipe cards in the Hungry Quarter, and the dispenser to spoil. 'Some' of this, 'a bit' of that. Always a good recipe."],
"quest.cap_recipes.ready": ["The bread! The stew! The sauce!", "Look at the stains. Look at the spelling. And that smell from the dispenser: cabbage. Real cabbage.", "I am crying. Let me. Here: my real recipe, the one I never dared write down until today.", "And something about him. He cannot taste. Not food, not wine, not salt. He never could.", "He built a whole kingdom of paste because he could not understand what the rest of us were missing."],
"quest.cap_recipes.done": ["I'm cooking again. Real food, real mess. What I told you is in your journal: he made everyone eat what he could not taste."],
"quest.cap_untidy.offer": ["Three compost heaps are hiding in the Reek, in cellars and under floors, where they were told to wait. Rescue them. They're alive.", "And there's an old seed in a jar somewhere nearby. Plant it in the Sick Patch by the market. Nobody's planted a thing here in ten years."],
"quest.cap_untidy.active": ["Three heaps, one seed, the Sick Patch. Compost is a promise. Nothing grows without one."],
"quest.cap_untidy.ready": ["It took? It TOOK. A flower. In this city.", "I need to sit down. I need to sit down and smell it.", "Here. Take it. And something about him: he's afraid of anything that grows without asking him first.", "Weeds. Moss. Children. Anything that surprises him. I think that's the whole of him."],
"quest.cap_untidy.done": ["Patch is blooming. Heaps are steaming. What I said is in your journal: he's afraid of anything that grows on its own."],
"facade.citizen.1.approved": ["Good day! The weather is approved! The lawn is regulation!", "Everything is perfect, and I am so, so pleased about it."],
"facade.citizen.1.approved2": ["Good day! It is a very good day. It is the same day as yesterday.", "That is also good. That is the best."],
"facade.citizen.1.slip": ["Everything is perfect. Everything is... (a pause, then a whisper) ...please do not tell the Inspector I blinked."],
"facade.citizen.2.approved": ["Welcome to the Showcase Quarter! We have everything: houses, lawns and a small, round, approved fountain. We are all so happy."],
"facade.citizen.2.approved2": ["The bread is lovely. The bread is... (the smile does not move) ...I would like to say more about the bread. I have a permit for four more words."],
"facade.citizen.2.slip": ["I had a name before. I think it started with a B. I am allowed to forget it. I am doing very well at it."],
"facade.citizen.3.approved": ["My house is identical to my neighbour's! Is that not wonderful? There is nothing to envy, and nothing to be envied for."],
"facade.citizen.3.approved2": ["Isn't it lovely to be exactly the same? I used to be different. I do not remember why. It sounds very tiring."],
"facade.citizen.3.slip": ["Sometimes I go behind the house and look at the wall. Just the wall. Nobody has told me I cannot. Please do not tell them."],
"facade.citizen.4.approved": ["Smile! That is all there is to it! Smiling is mandatory, and I am, in my opinion, a very good smiler."],
"facade.citizen.4.approved2": ["Seventy percent, minimum! I am at seventy-one! It is a good day.", "My cheeks hurt. Please do not tell anyone my cheeks hurt."],
"facade.citizen.4.slip": ["The man next door smiled at his wife's funeral. He was remembering her laugh.", "(a whisper) They corrected him for a month. He does not remember her laugh now."],
"facade.citizen.5.approved": ["The hedge is square! The hedges are all square! I trim the hedge every morning, to make sure it is as square as yesterday's."],
"facade.citizen.5.approved2": ["The Showcase receives visitors from all over! (a pause) Nobody visits. Nobody has visited in six years. We still smile in case they do."],
"facade.citizen.5.slip": ["Do you hear the loudspeaker? It plays the same thing every day. It has said my name once.", "Once. I wish it would again."],
"facade.citizen.6.approved": ["Spontaneity is only for Thursdays! It is Wednesday! I will enjoy it so much, tomorrow."],
"facade.citizen.6.approved2": ["Thursday is coming! Five minutes of spontaneity, with a permit! I have been practising my spontaneous face. It is very good."],
"facade.citizen.6.slip": ["I tried to be spontaneous once. On a Tuesday. I said 'hello' to a bird.", "I was corrected for two weeks. (a whisper) I still think about that bird."],
"facade.citizen.7.approved": ["Your hat is of an unapproved size, but I will not mention it, because that would be impolite. I am so, so polite. I am the politest person in the Showcase."],
"facade.citizen.7.approved2": ["Approved Hat Size: 1. I wear the one. It is a good hat. I do not know whose it is."],
"facade.citizen.7.slip": ["My daughter had a green hat. A little green hat. They said it was a Disagreement.", "I do not know where the hat is. I do not know where my daughter is. Everything is perfect."],
"facade.citizen.8.approved": ["The Showcase is the best of all possible places! I would not live anywhere else! (looking at the exit) ...I would not be allowed to."],
"facade.citizen.8.approved2": ["Everyone is so friendly! Everyone is so friendly. It is like living inside a greeting card."],
"facade.citizen.8.slip": ["There is a door at the back that does not open. I think there is a world on the other side. I think it is raining."],
"facade.citizen.9.approved": ["{villain_title} is so kind. He loves us all, and he made everything this way, for us. For our own good. (a shake) For our own good."],
"facade.citizen.9.approved2": ["The portrait is looking at me. It is always looking at me. It is very kind of him to look.", "I would never look away. I cannot."],
"facade.citizen.9.slip": ["He is not here. He has never been here. The portraits are here.", "The portraits do all the looking. It is all done by portrait."],
"facade.citizen.1.approved.freed": ["Good day! A good day! The weather is whatever it wants!", "I do not know the hat size and I do not care! It is wonderful to be alive."],
"facade.citizen.1.approved2.freed": ["I am going to wear a hat of any size. Maybe two."],
"facade.citizen.1.slip.freed": ["I blinked just now. Twice. Nobody came."],
"facade.citizen.2.approved.freed": ["The bakery is not real, but there is going to be a real one, as soon as someone knows how to bake. I have a recipe for a loaf and the recipe is: try."],
"facade.citizen.2.approved2.freed": ["My name is Berta. I had forgotten. It was on the tip of my tongue for ten years."],
"facade.citizen.2.slip.freed": ["Berta. Berta. Berta. It is a very good name."],
"facade.citizen.3.approved.freed": ["My house is different from my neighbour's now. He has painted his purple. I am furious. I am so happy to be furious."],
"facade.citizen.3.approved2.freed": ["I painted my door green. Do you like it? Please say no, so I can have an argument."],
"facade.citizen.3.slip.freed": ["I go behind the house and look at the wall, still. It is a good wall. It is just a wall."],
"facade.citizen.4.approved.freed": ["I smiled at a funeral yesterday. Nobody corrected me. It was a good funeral.", "I cried and smiled and it was exactly right."],
"facade.citizen.4.approved2.freed": ["My cheeks do not hurt any more. My cheeks are mine."],
"facade.citizen.4.slip.freed": ["I will not smile at all today if I do not want to. I am enjoying it."],
"facade.citizen.5.approved.freed": ["The hedge is round. The hedge wanted to be round. I asked it. I did not have to submit a form."],
"facade.citizen.5.approved2.freed": ["Visitors come! Real ones! They are mostly confused, but they come."],
"facade.citizen.5.slip.freed": ["The loudspeaker is silent. I stood under it for an hour. I said my name aloud, myself."],
"facade.citizen.6.approved.freed": ["Spontaneity every day! I am exhausted! I am not sure I like it! I love it!"],
"facade.citizen.6.approved2.freed": ["I said hello to the bird again. I have named the bird Thursday."],
"facade.citizen.6.slip.freed": ["I do not know what to do on a Thursday, now it is all of them."],
"facade.citizen.7.approved.freed": ["My daughter came home. With the little green hat. I have never seen a hat I loved more."],
"facade.citizen.7.approved2.freed": ["Every hat size! All of them! Come and see the hats!"],
"facade.citizen.7.slip.freed": ["I do not need to be polite today. I am going to be honest. Your hat is awful. I love it."],
"facade.citizen.8.approved.freed": ["I opened the door at the back. It was raining. I stood in it for an hour."],
"facade.citizen.8.approved2.freed": ["The Showcase is not the best of all places. It is a place. It is mine. It is a good place."],
"facade.citizen.8.slip.freed": ["I am going to go somewhere else. Just to see. Then I will come back, if I want."],
"facade.citizen.9.approved.freed": ["He was not kind. He was afraid. I think both can be true.", "I am not sure I forgive him. I am not sure I need to."],
"facade.citizen.9.approved2.freed": ["The portraits are coming down. There is a lot of wall behind them. Nobody knows what to put there."],
"facade.citizen.9.slip.freed": ["He is gone. I looked away. I looked away for a whole minute. It was a very long minute."],
"facade.door.1": ["You try the front door. It does not open. It is not a door.", "It is a very well-painted rectangle on a wall. Somebody has painted a tiny brass knocker. You knock on it.", "It makes a sound like knocking on a wall."],
"facade.door.2": ["You try the door. It does not open. You peek through the window: it is a painting of a window, and beyond it a painting of a living room with a painting of a family.", "They are smiling. They have been smiling for six years."],
"facade.door.3": ["The door has no handle. The house has no inside. Behind the facade there is just room for a ladder and a young woman painting the same window for the thousandth time.", "She looks at you. She looks away. She has the face of someone who has meant to write home for years."],
"facade.door.4": ["You try the door. It is open! It is a closet.", "It contains a mop, a bucket and a sign that says: IF YOU ARE READING THIS, SMILE."],
"facade.door.1.freed": ["The front door is still painted on. Someone has written under the knocker: 'Come round the back, we have a kettle.'"],
"facade.door.2.freed": ["The painted window now has a real curtain, hung over it by a citizen who wanted one. The family in the painting has acquired a moustache."],
"facade.door.3.freed": ["The door has a handle now, and the house has an inside: two chairs, a table, a tea tray. The paintbrush has been left on the ladder, for good."],
"facade.door.4.freed": ["The closet is a closet. The sign says: IF YOU ARE READING THIS, YOU DO NOT HAVE TO SMILE."],
"facade.speaker.1.0": ["Attention, citizens! Today is a PERFECT day! The weather is APPROVED!", "Please continue to be happy, as scheduled! This has been your Deputy Minister of Good News!"],
"facade.speaker.1.1": ["Attention, citizens! A reminder that smiling is MANDATORY! Those found frowning will be helped! Thank you for your cooperation!"],
"facade.speaker.1.2": ["Attention, citizens! (a pause) Attention, citizens! (a very long pause) ...the announcement has been completed. Please clap."],
"facade.speaker.2.0": ["Great news, citizens! New this season: Approved Hat Sizes! There is one! Please wear it!"],
"facade.speaker.2.1": ["Attention, citizens! {villain_title} reminds you that he loves you, and that he is watching. These are the same statement."],
"facade.speaker.2.2": ["Attention, citizens! Spontaneity Thursday is coming! Please prepare your spontaneity in advance! Please be surprised at three o'clock!"],
"facade.speaker.3.0": ["Attention, citizens! Please remember: the exits are for ENTERING. The entrances are for EXITING.", "Anything else is an unapproved Direction."],
"facade.speaker.3.1": ["Attention, citizens! All is well. All has always been well.", "This message is brought to you by the number one."],
"facade.speaker.3.2": ["Great news, citizens! The Wrinkles do not exist.", "Please report anyone who exists. This has been your Deputy Minister of Good News!"],
"facade.speaker.1.0.freed": ["Attention, citizens. (a cough) This is a loudspeaker. Nobody is on the other end.", "Please do whatever you like. That is all."],
"facade.speaker.1.1.freed": ["Attention, citizens. A reminder: you do not have to smile. (a pause) Also: you may smile. We are very easy."],
"facade.speaker.1.2.freed": ["Attention, citizens. A pigeon is using the loudspeaker. Please stand by."],
"facade.speaker.2.0.freed": ["Attention, citizens! Hats of any size are now permitted. Hats of negative size remain a mystery."],
"facade.speaker.2.1.freed": ["Attention, citizens. He was afraid, and we were afraid of him. Please be gentle with yourselves."],
"facade.speaker.2.2.freed": ["Attention, citizens! Spontaneity Thursday is now all days. Please prepare to be surprised constantly."],
"facade.speaker.3.0.freed": ["Attention, citizens. The exits are open. The entrances are open.", "The walls are still walls. Please do not run into them."],
"facade.speaker.3.1.freed": ["Attention, citizens. All is not well. It will be.", "It is a lot of work. Thank you for helping."],
"facade.speaker.3.2.freed": ["Attention, citizens. The Wrinkles were real. Please thank them.", "They are in the cellar. There is tea."],
"dungeon.pc_gate.title": ["The Great Doors"],
"dungeon.pc_gate.blurb": ["Solid gold, ten metres tall, polished until you can see your own worried face in them. They open before you touch them. That is the worst part."],
"dungeon.pc_gate.before": ["The great doors swing open, silent and perfectly balanced. Beyond them, a long hall, a red carpet and a smell of floor wax and lemons. Somewhere, a very long way away, someone is humming.", "'Welcome,' says a tiny, polite voice from nowhere. 'Please wipe your feet. Please wipe your opinions.'"],
"dungeon.pc_hall.title": ["The Great Hall"],
"dungeon.pc_hall.blurb": ["A hall the length of a street, and not one speck of dust. Guards stand at attention every ten paces, each one exactly the same height. (A battle.)"],
"dungeon.pc_portraits.title": ["The Portrait Gallery"],
"dungeon.pc_portraits.blurb": ["Thousands of portraits of one man, in order. Each is a little taller, a little straighter, a little more perfect than the last. A story event."],
"dungeon.pc_curator.title": ["The Curator's Rounds"],
"dungeon.pc_curator.blurb": ["A curator with a feather duster and a very small smile patrols the side gallery. Anything crooked, he straightens. Anything alive, he dusts. (A battle.)"],
"dungeon.pc_alcove.title": ["The Forgotten Alcove"],
"dungeon.pc_alcove.blurb": ["A side door behind a very large frame: a small alcove where the old portraits went when they were replaced. A dead end with a prize, then back to the gallery."],
"dungeon.pc_alcove.after": ["The old portraits lean against the wall, face to the plaster. Behind the last one: a small bag someone left. 'In case anyone comes looking for the real one,' says a note. You take it and go back."],
"dungeon.pc_mirror_knight.title": ["The Mirror Knight"],
"dungeon.pc_mirror_knight.blurb": ["A knight made entirely of mirror plates, each of them showing only one face. It moves exactly like you. Then it stops doing that. (A battle.)"],
"dungeon.pc_mirror_test.title": ["The Hall of Mirrors"],
"dungeon.pc_mirror_test.blurb": ["A hall of mirrors that reflect only him. A deck challenge: how well do you lead with your own face?"],
"dungeon.pc_honest_mirror.title": ["The One Honest Mirror"],
"dungeon.pc_honest_mirror.blurb": ["A small, dusty mirror in a closet, hung by someone who had to hide it. It shows whoever is standing in front of it. A dead end with a story."],
"dungeon.pc_mirror_shrine.title": ["The Quiet Room"],
"dungeon.pc_mirror_shrine.blurb": ["A room of mirrors where, for once, nobody is reflected at all: they have been turned to face the wall. Rest here. Restore HP."],
"dungeon.pc_mirror_shrine.after": ["You sit on the floor between mirrors that show only plaster. It is, for a few minutes, the most peaceful room in the Capital. Somebody has left a mug of tea and a biscuit.", "The biscuit is a little crooked. You eat it."],
"dungeon.pc_desk.title": ["The Desk of Correction"],
"dungeon.pc_desk.blurb": ["A long brass desk, a stamp and a form: 'FORM OF CORRECTION'. A deck challenge: do you have the bodies to fill the form?"],
"dungeon.pc_clerk.title": ["The Ministry Clerk"],
"dungeon.pc_clerk.blurb": ["A clerk at a tall desk, stamping everything that moves. Quite fast. Quite sad. (A battle.)"],
"dungeon.pc_corrector.title": ["The Chief Corrector"],
"dungeon.pc_corrector.blurb": ["The head of the Ministry of Correction: white gloves, kind eyes, a ruler. She is very, very gentle. That is what makes it frightening. (Elite)"],
"dungeon.pc_corrector.after": ["The Chief Corrector sits down on her own chair, very carefully, and lays her ruler on the desk. 'I corrected eleven thousand,' she says.", "'I never once asked what was wrong with them. Please. The door on the left. Go and look.'"],
"dungeon.pc_corrected.title": ["The Corrected"],
"dungeon.pc_corrected.blurb": ["A long ward behind the Ministry where citizens who were 'corrected' are kept. A dead end with a story, then back to the corridor."],
"dungeon.pc_junction.title": ["The Hall of the Four Wings"],
"dungeon.pc_junction.blurb": ["A circular hall with four doors, one for each Path. Each wing is a dead end: a place where he 'perfected' that Path. Visit any, all or none; then take the corridors on."],
"dungeon.pc_junction.before": ["Four great doors, each in its own Path's colour: red with a dumbbell, gold with a ladle, violet with a notary's seal, green with a seed.", "Over each, a brass plate: 'PERFECTED'."],
"dungeon.pc_wing_gourmand.title": ["The Gourmand Wing: The Laboratory"],
"dungeon.pc_wing_gourmand.blurb": ["The doppelganger's laboratory: vats of Special Sauce, rows of masks, one very worried technician. (A battle, then lab notes.)"],
"dungeon.pc_wing_gourmand.before": ["Racks of masks line the walls, each one a face: the Grand Chef, smiling, smiling, smiling. On a clipboard by the door, in a neat hand:", "'LAB NOTES: Subject A (the Grand Chef) proved resistant to persuasion. Resolved by substitution. The substitute is cooperative, and does not argue about the sauce.", "All Gourmands to be fed the sauce. They will be happier. They will be less themselves. This is a feature.'"],
"dungeon.pc_wing_gourmand.after": ["You tear the last page off the clipboard. Under the neat hand, in the margin, in a small shaking one: 'He did not look at the faces. He never looked at the faces.'", "You fold it into your pocket and go back."],
"dungeon.pc_wing_beefcake.title": ["The Beefcake Wing: The War Room"],
"dungeon.pc_wing_beefcake.blurb": ["A war room full of maps, flags and one very large, very empty throne: the place where the coup was planned. (A battle, then the orders.)"],
"dungeon.pc_wing_beefcake.before": ["A table covered in maps of the Gainlands, with little red pins in every mill and wheel. On a clipboard:", "'COUP ORDERS: Remove Grandmaster Flex. Remove his weights, his protein, his gymnasium. Observe.", "When the champion is sufficiently weak, he will no longer be a disagreement. NOTE: do not underestimate him. He does a lot of stretching.'"],
"dungeon.pc_wing_beefcake.after": ["In the margin of the orders, in a smaller, shakier hand: 'He was not weak. We took everything from him and he got stronger. I do not understand it.'", "'I have asked the champions to be weak. They will not.' You fold the orders and go back."],
"dungeon.pc_wing_necrocrat.title": ["The Necrocrat Wing: The Notary's Office"],
"dungeon.pc_wing_necrocrat.blurb": ["A tall office of notarized, filed and countersigned paper: the authorization that took the Necrocrats. (A battle, then the paperwork.)"],
"dungeon.pc_wing_necrocrat.before": ["Shelves of paper to the ceiling, every sheet stamped. On the top of the pile, a single form:", "'FORM 1-A (NOTARIZED): Authority over all Necrocrat government is hereby transferred to His Perfection. Reviewed. Approved.", "Filed. VALID. NOTE: the Necrocrats will obey this, because it is their nature to obey a valid form.", "I did not need to force anyone. I needed only to be correct.'"],
"dungeon.pc_wing_necrocrat.after": ["The Wraith's last words, as it folds: 'The authorization is valid.' Then, very quietly: 'It was never right.'", "You take the form. It can be revoked, you suspect, on a technicality. You go back."],
"dungeon.pc_wing_refusemancer.title": ["The Refusemancer Wing: The Greenhouse"],
"dungeon.pc_wing_refusemancer.blurb": ["A glass greenhouse where something glowing and green grows in a single pot. The Rot began here. (A battle, then the seed.)"],
"dungeon.pc_wing_refusemancer.before": ["In the middle of the greenhouse, under a glass dome, a single seed sprouts, glowing sickly green. A label on the pot:", "'THE SEED: Nature is untidy. Nature is inefficient. Nature disagrees with itself.", "A seed, properly corrupted, can be made to agree with me. Plant in the Archdruid. Observe.", "NOTE: it will spread. I cannot say I am sorry about that. I am very busy.'"],
"dungeon.pc_wing_refusemancer.after": ["The dome is cracked. The glowing seed lies in the dirt and is, for a moment, just a seed. In the label's margin, in a smaller hand: 'She was grieving. I told myself that made it a kindness.'", "Somewhere in the Verdant Dump, if the Dump is free, a flower opens. You go back."],
"dungeon.pc_servants.title": ["The Servants' Corridor"],
"dungeon.pc_servants.blurb": ["A narrow back corridor where the castle's servants work, silent and very fast, in matching grey. They do not smile. They have stopped. (A battle.)"],
"dungeon.pc_staircase.title": ["The Grand Staircase"],
"dungeon.pc_staircase.blurb": ["A staircase so grand it has its own staircase. Every step is exactly the same height. It is exhausting. A story event."],
"dungeon.pc_vault.title": ["The Wing Vault"],
"dungeon.pc_vault.blurb": ["Where the two ways round the wings meet: a small vault of confiscated things. Treasure."],
"dungeon.pc_archive_gate.title": ["The Archive Door"],
"dungeon.pc_archive_gate.blurb": ["A tall oak door with a brass sign: 'ARCHIVE OF GOOD INTENTIONS'. A warden stands in front, arms folded. (A battle.)"],
"dungeon.pc_archive_gate.before": ["The sign is older than the rest of the castle. It is painted by hand. Under it, in different ink, someone has written: 'He meant well.'"],
"dungeon.pc_journals.title": ["The Early Journals"],
"dungeon.pc_journals.blurb": ["Shelves of journals in a young man's handwriting: the years before the throne. A story event."],
"dungeon.pc_reading_room.title": ["The Reading Room"],
"dungeon.pc_reading_room.blurb": ["A quiet reading room, a lamp, a chair. Someone used to read here. Rest and restore HP."],
"dungeon.pc_reading_room.after": ["You sit in the old reading chair. It is worn exactly where one person sat, every night, for a long time. The lamp has a small, hand-made lampshade. Something about it is very, very human."],
"dungeon.pc_blueprints.title": ["The Blueprint Vault"],
"dungeon.pc_blueprints.blurb": ["A side vault of blueprints: the sound reforms he drew up before it all went wrong. A dead end with a prize, then back to the reading room."],
"dungeon.pc_blueprints.after": ["Plans for wells. Plans for a school lunch. Plans for a bridge that was actually built.", "They are beautiful. They are so good. You roll up the best and take it, with something in your throat."],
"dungeon.pc_shelf.title": ["The Escalation Shelf"],
"dungeon.pc_shelf.blurb": ["A single long shelf where the reforms are filed in order. Each is a little bigger than the last. A deck challenge: can your deck keep its footing?"],
"dungeon.pc_automaton.title": ["The Archive Automaton"],
"dungeon.pc_automaton.blurb": ["A tall brass automaton that files, stamps and shelves. It has been told the archive is complete. It is very sure. (Elite)"],
"dungeon.pc_last_journal.title": ["The Last Journal"],
"dungeon.pc_last_journal.blurb": ["A single book on a stand, still open. The last page is still wet. A story event: the moment you see him as he sees himself."],
"dungeon.pc_last_journal.before": ["A lectern in the middle of a round room, a book open on it, a pen beside the book. The ink on the last page is still wet. He wrote this today."],
"dungeon.pc_model_warden.title": ["The Model Warden"],
"dungeon.pc_model_warden.blurb": ["The last guard before the Chamber of the Model: a warden whose job is to keep everyone away from the table. (Elite)"],
"dungeon.pc_model_warden.after": ["The Warden steps aside. Through the doors: a huge round room, a vaulted ceiling and, on a table the size of a house, a perfect miniature of the whole kingdom.", "Somebody is bending over it, moving a tiny house one centimetre to the left."],
"dungeon.pc_boss.title": ["The Scale Model Chamber"],
"dungeon.pc_boss.blurb": ["A giant model of the whole kingdom, and the man who rearranges it by hand. {villain_title}, {villain}. (Boss: three phases)"],
"dungeon.pc_boss.before": ["The Chamber of the Model is round and domed, and in its centre stands a table the size of a house: a perfect miniature of {kingdom}.", "Roads, rivers, four districts, a hundred thousand tiny houses. Every one of them is exactly where he wants it.", "A man in a pressed grey coat and a thin gold circlet stands with his back to you, moving a tiny cottage one centimetre to the left with a pair of tweezers."],
"dungeon.pc_boss.after": ["The model lies in pieces. A hundred thousand tiny houses on the floor, all in the wrong places, and somehow they look better.", "{villain} sits among them, small, in his pressed grey coat, and does not move for a long time."],
"challenge.pc_mirror_test.title": ["The Hall of Mirrors"],
"challenge.pc_mirror_test.text": ["Every mirror shows only him. They turn to look at you and, for a moment, one of them hesitates. Reveal cards until the first unit: if its attack is 3 or more, a mirror will let you through (and show you, briefly, yourself).", "If not, they will look through you and it will hurt."],
"challenge.pc_ministry_desk.title": ["The Desk of Correction"],
"challenge.pc_ministry_desk.text": ["A FORM OF CORRECTION asks for a list of bodies: names, numbers and heights. Five cards are revealed; if at least two are units, you have enough people on your form to get past the desk. If not, the stamp comes down."],
"challenge.pc_escalation_shelf.title": ["The Escalation Shelf"],
"challenge.pc_escalation_shelf.text": ["Every reform on the shelf is bigger than the last: school lunches, lunch rules, lunch inspectors, inspector rules. Five cards fall off; if at least two are infrastructure, your deck holds. If not, the shelf comes down on you."],
"event.pc_improved_portraits.title": ["The Improved Portraits"],
"event.pc_improved_portraits.body": ["Thousands of portraits of one man, one a year. In the first he is a thin young clerk, anxious and kind, smiling at nothing in particular.", "Each one is a little straighter, a little taller. By the last he is eleven feet tall, with no wrinkles and a smile that does not move. Under each: 'IMPROVED.'"],
"event.pc_improved_portraits.choice.0": ["Study them closely, from the first to the last"],
"event.pc_improved_portraits.choice.1": ["Look away and breathe"],
"event.pc_improved_portraits.choice.2": ["Take a gold frame off the wall and sell it"],
"event.pc_improved_portraits.result.0": ["You look at them all, in order. The anxious clerk grows steadily less anxious, and steadily less there. You find the exact portrait where it happens: the tenth.", "In the ninth he looks so tired, and so sincere. You will not forget it. You see through the frame."],
"event.pc_improved_portraits.result.1": ["You look at your feet. The carpet is red, and a little worn in the middle. That, at least, is honest. You feel a little steadier."],
"event.pc_improved_portraits.result.2": ["The frame comes off with a squeal. Somewhere an alarm goes off, very politely: 'Please do not remove the improvements.' A hand-sized portrait falls and cuts your hand. The frame is worth a lot."],
"event.pc_honest_mirror.title": ["The One Honest Mirror"],
"event.pc_honest_mirror.body": ["In the broom cupboard, behind a bucket, hangs a small, cracked mirror. A note taped to it: 'FOR THE WRINKLES. IT SHOWS WHOEVER STANDS IN FRONT OF IT. WE LOST A MAN FOR THIS MIRROR.'", "You step in front of it and, for the first time in this castle, you see yourself."],
"event.pc_honest_mirror.choice.0": ["Stand and look for a while"],
"event.pc_honest_mirror.choice.1": ["Take the mirror's frame; it is quite valuable"],
"event.pc_honest_mirror.result.0": ["Your face. Tired, dusty, crooked, entirely your own. It is the most welcome thing in the castle.", "You stand there until you feel like yourself again, and a little more."],
"event.pc_honest_mirror.result.1": ["The frame is old gold, worth a good deal. You leave the mirror hanging. It was never about the frame, and you were told as much."],
"event.pc_corrected_citizens.title": ["The Corrected"],
"event.pc_corrected_citizens.body": ["A long white ward. Fifty beds. In each, a citizen in a grey gown with a small, fixed smile, looking at nothing.", "A nurse moves among them, adjusting each smile by a few degrees. One man has been smiling at the ceiling for three years. A woman in the corner has forgotten the name of her own daughter.", "One of them whispers to you as you pass: 'I smiled at a funeral.'"],
"event.pc_corrected_citizens.choice.0": ["Sit with them and listen"],
"event.pc_corrected_citizens.choice.1": ["Free the nearest bed and help them out"],
"event.pc_corrected_citizens.choice.2": ["Take the ward's record book as proof"],
"event.pc_corrected_citizens.result.0": ["You sit by the bed and listen, for as long as it takes. It takes a long time. They tell you their names.", "They tell you what they smiled at: a funeral, a wedding, a bird. When you rise, you carry something heavy and exact. You are not going to forget what this cost."],
"event.pc_corrected_citizens.result.1": ["You undo the straps and help a man to his feet. He weeps and laughs and falls over, and cannot remember how to frown. A nurse hits an alarm.", "You carry him out through a window. He is heavier than you expected. It costs you a little. It costs him far more.", "He says: 'Thank you.' It is the first thing he has said in three years."],
"event.pc_corrected_citizens.result.2": ["The record book lists every citizen corrected, their offence and the angle of their smile on admission. It is eleven thousand pages long. You will not need to read it all.", "The first page is enough. Somebody will pay for this book. Somebody, one day, will read it aloud."],
"event.pc_four_wings.title": ["The Hall of the Four Wings"],
"event.pc_four_wings.body": ["Four great doors in four Path colours, and over each a brass plate: PERFECTED. Behind each, you can hear nothing at all. A fifth and sixth way lead on: the servants' corridor and the grand staircase.", "You could visit all four wings, or none. Each wing is a dead end, and each one will tell you how he did it."],
"event.pc_four_wings.choice.0": ["Rest on the bench in the hall"],
"event.pc_four_wings.choice.1": ["Take the coins from the collection plate by the door"],
"event.pc_four_wings.result.0": ["You sit on a long bench under a brass plate and breathe. The doors do not open. Nothing in the hall moves, and everything in it seems to be listening. After a time you feel steadier."],
"event.pc_four_wings.result.1": ["A little brass plate for donations to His Perfection, bolted to the wall. It is quite full. You take the lot.", "It is, after all, other people's money, and they would want it back."],
"event.pc_grand_staircase.title": ["The Grand Staircase"],
"event.pc_grand_staircase.body": ["A staircase of five hundred steps, every one exactly the same height, and at the top a very large clock.", "Halfway up, a servants' door stands ajar: through it, a narrow plain stair with worn steps. Nobody has ever climbed the grand staircase for pleasure."],
"event.pc_grand_staircase.choice.0": ["Climb the grand staircase, step by identical step"],
"event.pc_grand_staircase.choice.1": ["Sit on a step and rest"],
"event.pc_grand_staircase.choice.2": ["Take the servants' stair"],
"event.pc_grand_staircase.result.0": ["Five hundred identical steps. By the three hundredth you are trembling; by the four hundredth you want to scream.", "At the top, a pot of coins sits on the landing: a tip left by the last person who made it. You rub your legs and pocket the coins."],
"event.pc_grand_staircase.result.1": ["You sit on step two hundred and fifty, and look up at the very large clock. It has no hands. It has only a plate that says 'ON TIME'.", "You sit there for as long as you like. Nobody comes to correct you."],
"event.pc_grand_staircase.result.2": ["The servants' stair is steep and narrow and wonderfully uneven. Every step is a different height. A cook has left a little shelf of bread and a pipe.", "You eat and climb and feel, curiously, much better about the whole world."],
"event.pc_early_journals.title": ["The Early Journals"],
"event.pc_early_journals.body": ["A wall of journals in a young man's neat handwriting, each one dated. 'Year 1: Wells. Half the lower city has to walk two miles for clean water.", "I have drawn up plans for six new ones. The Council has approved them. I did not sleep. It was wonderful.'", "'Year 3: School lunches. A child asked me why the soup was warm. I said, so that you can eat it.", "She said, that is the best idea anyone has ever had. I put it in a frame.'", "It goes on. They are good. They are so good."],
"event.pc_early_journals.choice.0": ["Read the first journals, all the way through"],
"event.pc_early_journals.choice.1": ["Close the book and sit with it for a moment"],
"event.pc_early_journals.result.0": ["You read until the light changes. Wells, schools, bridges, lamps: he built a hundred good things, and he loved every one.", "Once, he was exactly the person you would want running a kingdom. You close the last journal very gently."],
"event.pc_early_journals.result.1": ["You close the book and rest your hand on the cover. It is warm, as if someone had just put it down. You breathe, and wait until your hands are steady."],
"event.pc_last_journal.title": ["The Last Journal"],
"event.pc_last_journal.body": ["The last page, in a neat hand, the ink still wet: 'Today I corrected eleven more. They cried, which is understandable. They do not yet see it.", "In ten years' time they will thank me. In a hundred, they will not remember there was anything to thank me for. That is the point. That is how you know it has worked.", "I am so tired. I do not think anyone has ever tried so hard to be kind. I only wish somebody would say so.'"],
"event.pc_last_journal.choice.0": ["Read it all again, and let it settle"],
"event.pc_last_journal.choice.1": ["Close the journal and steady yourself"],
"event.pc_last_journal.result.0": ["You read it twice. He believes every word: that each portrait and each rule is a gift, that nobody has ever tried so hard to be kind.", "He is not lying. That is the worst of it. You understand him a little, and you understand exactly what you will have to do."],
"event.pc_last_journal.result.1": ["You close the book softly. Whatever is in the next room, it is not a monster. It is a man who needed to be right, and made the whole world pay for it.", "You breathe in, and out, and you go on."],
"cutscene.primm_intro.1.speaker": ["Primm"],
"cutscene.primm_intro.1": ["Ah. A visitor. Do come in.", "Mind the floor: it has just been polished, by seventeen people, whom I thank daily, in writing."],
"cutscene.primm_intro.2.speaker": ["Primm"],
"cutscene.primm_intro.2": ["I am {villain_title}, {villain}: Minister of Improvements, Steward of the Throne, Protector of {kingdom}.", "You have walked the whole length of my castle. You have, I notice, scuffed it."],
"cutscene.primm_intro.3.speaker": ["You"],
"cutscene.primm_intro.3": ["Sorry. That's forest mud. I've walked a long way, and everyone I met on the way here was afraid of you."],
"cutscene.primm_intro.4.speaker": ["Primm"],
"cutscene.primm_intro.4": ["Afraid? Of what? Of order?", "Of comfort? Of being safe? I have given them roofs, and hats, and rules.", "Every one of them has a number. Do you know how few kingdoms can say that?"],
"cutscene.primm_intro.5.speaker": ["Primm"],
"cutscene.primm_intro.5": ["Ten years I have been mending this kingdom. Ten years, and still you come, with your different hats and your different opinions, to undo the only good thing anyone has ever done.", "I am afraid I shall have to correct you."],
"cutscene.primm_intro.6.speaker": ["Primm"],
"cutscene.primm_intro.6": ["This will not hurt. It will, however, be Standard."],
"cutscene.primm_p1.1.speaker": ["Primm"],
"cutscene.primm_p1.1": ["Why... why will they not all be three? It is a perfectly good number.", "Every unit, equal, in every way. Why must some of them be five? Why must anything be five?"],
"cutscene.primm_p1.2.speaker": ["You"],
"cutscene.primm_p1.2": ["Because some things are five. Some people are.", "You took ten years from me. Whatever you took, it was not the part that matters, and strength is not control."],
"cutscene.primm_p1.3.speaker": ["Primm"],
"cutscene.primm_p1.3": ["Then they must be made the same. For their own good. Do you not see?", "You are not listening. Nobody ever listens. (a breath) Very well. If you will not follow my rules, I shall use yours."],
"cutscene.primm_p1.4.speaker": ["Primm"],
"cutscene.primm_p1.4": ["Everything you can do, I can do. I have had ten years of practice with it.", "Let us see how you like fighting yourself."],
"cutscene.primm_p2.1.speaker": ["Primm"],
"cutscene.primm_p2.1": ["Your cards. Your plays. Your own deck, in my hands.", "And you still beat me. How?"],
"cutscene.primm_p2.2.speaker": ["You"],
"cutscene.primm_p2.2": ["You copied my cards. You can't copy what I do with them. A name is a blank page until you sign it.", "And nobody files me under 'subject' again. No order outranks treating people with respect."],
"cutscene.primm_p2.3.speaker": ["Primm"],
"cutscene.primm_p2.3": ["That is not true. I made the wells. I made the roads.", "I made... (he stops.) I made a list of things other people had already built, and I put my name on it."],
"cutscene.primm_p2.4.speaker": ["Primm"],
"cutscene.primm_p2.4": ["NO. No, no, no. The rules are PERFECT.", "The rules ARE perfect. If the rules are not perfect then I have been... then I have been..."],
"cutscene.primm_p2.5.speaker": ["Primm"],
"cutscene.primm_p2.5": ["Everything is coming apart. Why is everything coming apart? I only wanted it to be nice!"],
"cutscene.primm_end.1.speaker": ["Primm"],
"cutscene.primm_end.1": ["...It is over. The rules were not enough."],
"cutscene.primm_end.2.speaker": ["Primm"],
"cutscene.primm_end.2": ["I did it for them. I did it for the people. You do see that?", "You must see that. Every rule, every portrait, every hat: so that nobody would ever be afraid again. So that nobody would ever be wrong."],
"cutscene.primm_end.3.speaker": ["You"],
"cutscene.primm_end.3": ["You kept everything. Every face, every rule, every house on that table. But nothing grows if you refuse to let anything go.", "You took my mother and father. I can't even remember their faces. I'm not burying that in a jar. I'm letting it go."],
"cutscene.primm_end.4.speaker": ["Primm"],
"cutscene.primm_end.4": ["...(a long silence)... I made them smile. I made them all smile.", "And they smiled, and they smiled, and I looked at their faces, and I thought: they look like me. And I was so happy."],
"cutscene.primm_end.5.speaker": ["Primm"],
"cutscene.primm_end.5": ["It was the mirrors. Wasn't it. I wanted a world where nothing could surprise me.", "And I forgot that a world where nothing surprises you is a world with nobody else in it."],
"cutscene.primm_end.6.speaker": ["You"],
"cutscene.primm_end.6": ["I'm not going to correct you. That was your way. Start smaller. Say sorry to one person."],
"cutscene.primm_end.7.speaker": ["Primm"],
"cutscene.primm_end.7": ["One? I corrected eleven thousand. Where would I even begin? I cannot remember a single one of their names."],
"cutscene.primm_end.8.speaker": ["Primm"],
"cutscene.primm_end.8": ["Take the crown. No: leave it. No: take it.", "It is very heavy. It was always very heavy. And tell the Wrinkles... tell them I am sorry about the hats."],
"boss.phase.standardization.title": ["Phase 1: Standardization"],
"boss.phase.standardization.rule": ["Every unit, yours and his, is a 3/3. You may play at most two non-infrastructure cards a turn. (Two is the perfect number.)"],
"boss.phase.reflection.title": ["Phase 2: Reflection"],
"boss.phase.reflection.rule": ["His deck is a copy of yours, and he draws an extra card each turn. He can only imitate; he has never created anything."],
"boss.phase.unraveling.title": ["Phase 3: Unraveling"],
"boss.phase.unraveling.rule": ["His units get +1/+1 and he draws an extra card each turn, but he loses 1 HP at the start of each of his turns. The rules he wrote are breaking down."],
"boon.beefcake.name": ["Grandmaster Flex's Heart"],
"boon.beefcake.line": ["Grandmaster Flex steps out from behind a pillar, rolling a very small bandage off a very large arm. 'Breathe in. Hold.'", "'The heart and the mind, son. You brought both. We are with you.' (Grandmaster Flex's Heart: Beefcake units get +1 power, and you gain 2 max HP.)"],
"boon.gourmand.name": ["The Grand Chef's Feast"],
"boon.gourmand.line": ["The Grand Chef, restored, in a clean apron, with a ladle. 'Have you eaten? No. Of course not.'", "'Ten years of sauce that tasted of nothing. Let us feed this kingdom something real.' (The Grand Chef's Feast: Gourmand units get +1 defense, life gain is stronger, and you gain 2 max HP.)"],
"boon.necrocrat.name": ["Agnes's Appeal"],
"boon.necrocrat.line": ["Agnes Overdue floats forward with her enormous ribboned stack of denied appeals. 'I have found a technicality, dear,' she says, and stamps it with the department seal.", "'It applies to him. It applies to him very well.' (Agnes's Appeal: Necrocrat cards cost 1 less, and you gain 2 max HP.)"],
"boon.refusemancer.name": ["Compostella's Roots"],
"boon.refusemancer.line": ["Archdruid Compostella kneels and presses a palm to the marble. A small green shoot pushes up through the polish.", "'To grow, you have to let things go, child. Even him. Especially him.' (Compostella's Roots: Refusemancer units get +2 defense, and you gain 2 max HP.)"],
"boon.none.line": ["Nobody stands beside you. The Paths are not free yet: their leaders are still behind wheels, behind sauce and behind paperwork. You step into the chamber alone.", "(Free the Paths and their leaders will stand with you.)"],
"ending.beat.1.title": ["The Model Falls"],
"ending.beat.1": ["The scale model cracks in half. Then the table cracks. Then, with the sound of a very large drawer being pulled from a very large cabinet, the walls of the castle begin to come down.", "In the gallery a portrait slips off its hook and lands face-up. For the first time in ten years, nobody picks it up."],
"ending.beat.2.title": ["The Facade Falls"],
"ending.beat.2": ["In the Showcase Quarter a painted door falls flat, and a very surprised citizen steps through it onto a very real street.", "Shopfronts topple. Hedges wilt into their own shapes. The loudspeakers cough once and go quiet.", "Behind the facade: houses, lawns and people, all of them a bit crooked. A child paints the new sign at the gate: PATHORDIA."],
"ending.beat.3.title": ["The Rifts Close"],
"ending.beat.3": ["Across the Capital the rifts fold up like letters. In the Reek, the Sick Patch is a flower bed.", "In Grave Row, a family walks slowly to a quiet plot and stays. In the Transit Yards the wheels slow, and slow, and stop, and the crews lie in the sun.", "In the Hungry Quarter, somebody lights a stove."],
"ending.beat.4.title": ["The Wrinkles"],
"ending.beat.4": ["The Wrinkles climb up out of the Crease, blinking, into a light they had forgotten. Wren carries the true records under her arm. Nurse Hesper has brought the tea.", "Fig Sly is already selling something, to somebody, for some reason. Nobody stops him."],
"ending.beat.5.title": ["The Paths Meet"],
"ending.beat.5": ["And the Paths come home. Grandmaster Flex, the Grand Chef, Agnes Overdue and Archdruid Compostella meet in the plaza and look at one another for the first time in ten years.", "The Beefcakes are late. The Necrocrats have brought a form. The Gourmands are overdressed. The Refusemancers smell, faintly, of compost.", "Nobody agrees on anything. It is the happiest sound the Capital has ever heard."],
"ending.beat.6.title": ["Together"],
"ending.beat.6": ["{villain} demanded one way for everyone. It was never what made the kingdom strong.", "Muscle and stoves, records and soil: each was good alone. Together they ran a kingdom, argued about it every day, and it worked.", "The point was never to be the same. The point was the argument. Different Paths, working together."],
"ending.beat.7.title": ["The New Decree"],
"ending.beat.7": ["A new decree appears on the plaza wall of {pathordia}, in four different handwritings. It reads: DIFFERENT PATHS MAY MIX AGAIN.", "Somebody has crossed out MAY and written SHOULD. Somebody else has crossed out SHOULD and written WILL, IF THEY FEEL LIKE IT. A pigeon sits on the full stop."],
"ending.credits.1": ["THE END (OF THE BEGINNING)"],
"ending.credits.2": ["A game about a kingdom that was strong because it was not the same."],
"ending.credits.3": ["PLACEHOLDER CREDITS"],
"ending.credits.4": ["Design and direction: you"],
"ending.credits.5": ["Engine: Godot 4"],
"ending.credits.6": ["Art: Kenney, KayKit, game-icons.net and friends (see CREDITS.md)"],
"ending.credits.7": ["Music: synthesized in code"],
"ending.credits.8": ["The voice of {villain}: nobody. He never really got to be heard, and that was rather the point."],
"ending.credits.9": ["In memory of Form 27-B, Form 27-C and Form 27-B"],
"ending.credits.10": ["No hats were harmed. Several were enlarged."],
"ending.credits.11": ["The Paths will be back, in some other order."],
"ending.credits.12": ["Thank you for playing."],
"ending.postgame.title": ["The Paths Unbound"],
"ending.postgame.body": ["With {villain} gone, the Paths are free to mix again. Your decks may now combine cards from ALL Paths, and the Alchemist's tri-Path crafting is open. What made the kingdom strong was never sameness."],
"ending.postgame.line.1": ["Decks may now use 3 or more Paths."],
"ending.postgame.line.2": ["The Alchemist's tri-Path crafting is unlocked (no tri-Path recipes exist yet)."],
"ending.postgame.line.3": ["{pathordia} is open to everyone: the facade is down, the rifts are sealed, and {villain} works under guard on wells and pipes, kept away from every Path."],
"ending.return": ["You are back in {pathordia}. It is mostly the same streets, but it sounds quite different: people are shouting at each other cheerfully, in every direction.", "Wren sits on the edge of the fountain with a ledger on her knee, writing the title of the first honest page: THE TRUE RECORD, VOLUME ONE."],
"fx.ending_return": ["The Capital is free. The postgame begins: decks of three or more Paths are now allowed."],
"freed_npc.heartlift": ["Breathe in. Hold. ...Feel that? That is a city with nowhere it has to be.", "Rollo's crews are lying in the sun. I told them rest is a rep. They believed me. Heart and mind, son. You used both."],
"freed_npc.grandchef": ["The sauce is gone from every stove in the kingdom. Real onions again. I have not wept so much since I was a girl.", "You did something worth signing, you know. Now sit. Eat. Eat a mess."],
"freed_npc.agnes": ["I have filed a Form of Gratitude, dear. It was approved on the first attempt. Irregular.", "I am going to cry anyway. In triplicate."],
"freed_npc.compostella": ["Look at this crack in the marble. Something is growing out of it.", "I am going to let it. It has earned the right. So have you, child."],
"npc.guard_height.intro.freed": ["I used to measure people. Now I just look at them. A man walked past yesterday who was nine feet tall and I said 'good morning'.", "I am not myself. I am much better."],
"npc.guard_height.return.freed": ["Come in, come in. Bring any height."],
"npc.guard_queue.intro.freed": ["Queue management. There is no queue any more. I am standing here out of habit.", "And because nobody has told me where else to stand."],
"npc.guard_queue.return.freed": ["Still no queue. I am doing very well."],
"npc.guard_in_1.intro.freed": ["Exit control. You may leave whenever you like. I am just standing here. It is a very open exit."],
"npc.guard_in_1.return.freed": ["Exit control. Goodbye. Come back. Goodbye."],
"npc.guard_in_2.intro.freed": ["Exit control. This is an exit. It is also an entrance. It is, from every angle, a door."],
"npc.guard_in_2.return.freed": ["A door. A good door."],
"npc.exit_clerk.intro.freed": ["Exit Interview Booth. Name? Reason for leaving?", "...I was never going to read the answers. Please go and have a nice day."],
"npc.exit_clerk.return.freed": ["Have a nice day."],
"npc.hesper.intro.freed": ["Hesper Dray. Sit. Drink.", "Still unapproved. Nothing's approved any more. Best thing that ever happened to my tea."],
"end.marker": [""],
"cutscene.primm_reveal.1.speaker": ["Primm"],
"cutscene.primm_reveal.1": ["...You do not even know, do you? Look at you. You have walked my castle for hours and you have not once asked why my portraits stop at eleven."],
"cutscene.primm_reveal.2.speaker": ["You"],
"cutscene.primm_reveal.2": ["...What do you mean?"],
"cutscene.primm_reveal.3.speaker": ["Primm"],
"cutscene.primm_reveal.3": ["I kept your face. I kept it for ten years, in the one gallery I never let anyone clean. It is the only face I could not improve.", "You are the Royal Asset. You are the boy who got out. You are {prince_full}, and you have been so very hard to find."],
"cutscene.primm_reveal.4.speaker": ["You"],
"cutscene.primm_reveal.4": ["...That's not possible. I would remember."],
"cutscene.primm_reveal.5.speaker": ["Primm"],
"cutscene.primm_reveal.5": ["Everything is possible when it is filed correctly. Your power has kept this kingdom lit for ten years. I have only been looking after it.", "Come. You may as well see it used properly."],
"prop.lost_poster": ["HAVE YOU SEEN THIS IMPROVEMENT OPPORTUNITY?", "ESCAPED ROYAL ASSET. Age: approx. 21.", "Height: average. Distinguishing features: none, we hope. Last seen leaving a Ministry facility, ten years ago, in the company of a traitor.", "Please return to the nearest Ministry office. Reward: a commendation."],
"prop.lost_poster.known": ["HAVE YOU SEEN THIS IMPROVEMENT OPPORTUNITY?", "ESCAPED ROYAL ASSET. Age: approx. 21.", "Height: yours. Face: yours. Last seen: reading this poster."],
"sign.lost_poster": ["LOST PROPERTY", "Have you seen this Improvement Opportunity? Please return to the nearest Ministry office. No questions will be answered."],
"fx.deface_poster": ["You cross out 'Asset' and write 'Person' in the margin, in large letters. A passing citizen pretends not to see, and then, quietly, nods. +12 gold from a grateful Wrinkle."],
"dungeon.pc_gallery.title": ["{villain}'s Private Gallery"],
"dungeon.pc_gallery.blurb": ["A small gallery behind a mirror, which nobody is allowed to clean. A dead end with a prize."],
"dungeon.pc_gallery.before": ["A single portrait hangs in a gilt frame, lit like a shrine: a royal family of three.", "The king and the queen have been painted over in white, so carefully that every brushstroke runs the same way. Only the boy between them was left untouched.", "A small card on the frame, in a neat hand: 'KEPT FOR REFERENCE.' The boy has your face.", "You stand there a long time. Your throat has closed, and you cannot say why."],
"dungeon.pc_gallery.after": ["Behind the frame, a hidden hatch holds a small bag. You take it, and you do not look back at the portrait, because if you do you will not be able to leave."],
"dungeon.pc_ward.title": ["The Correction Ward"],
"dungeon.pc_ward.blurb": ["A long ward of white cells. Free the prisoners for a boon, and read what the Path-ologists wrote."],
"dungeon.pc_ward.before": ["The Path-ologists' records are pinned to every door. 'SUBJECT 1, the Royal Asset. Drain cycle 3,114.", "Power stable, routed to the Throne. {villain}'s hold depends on it. Do not allow the Subject to leave.'", "You read the word Subject until it stops being a word.", "The oldest notes, at the far end, are in a different hand: careful, rounded, familiar. 'Observation, Year 1. The child is not a specimen. He asks for his mother. I am leaving the lab. M.'", "You have seen that handwriting on a pie recipe."],
"ending.beat.8.title": ["The Pathwork Throne"],
"ending.beat.8": ["The castle does not fall. It opens. Where the Model Room floor was, a stair of four colours winds down into the old heart of the Capital.", "At the bottom stands the Pathwork Throne: four seats grown into one, four colours woven as a single thread. It was never {villain}'s.", "You sit, and the Throne answers. It knows you.", "Everything comes back at once: the lullaby, the glass, the throne room, the name. {prince_full}. And the Paths, all four, as they were always meant to be carried."],
"ending.beat.9.title": ["{villain} Sees"],
"ending.beat.9": ["{villain} sits among the pieces of his model. As the Paths settle, he sees the kingdom as it is, and not as his reflection.", "Cracked streets. Real faces. A boy he kept in a cell.", "Slowly, he understands how much he broke. The wells were good. The schools were good. He made one choice for everyone, and nobody will trust him with another."],
"ending.beat.10.title": ["File Complete"],
"ending.beat.10": ["Agnes Overdue floats up to the old transfer file, finds the heir clause and, with great ceremony, brings down her stamp: HEIR: ALIVE. FILE COMPLETE.", "Maren pushes through the crowd, tortoise-slow, and stops in front of you. There is flour on her sleeve.", "'{prince},' she says. It is the first time anyone has said it aloud and meant it. 'Welcome home.'"],
"freed_npc.primm": ["Do not look so alarmed. The guard is very kind, and the workshop has a very nice window.", "I am designing a water main. A real one: pipes, a pump and nothing clever. It is the first thing I have made in ten years that nobody had to agree to.", "I am not permitted to speak of the Paths, or to touch one. I find that I do not miss it. I find that I miss the wells."],
"freed_npc.primm_guard": ["He is allowed visitors, one at a time, ten minutes, no mirrors. Those are the rules. I did not write them, and I find I do not mind them.", "He designs very good drains, it turns out. Do not tell him I said so."],
}
