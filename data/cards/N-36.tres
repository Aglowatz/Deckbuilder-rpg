script_text = "trap(plays:opp) ? played(opp)==2 => lose(opp,2); create(redtape)"
rules_hash = "69fa6a5d4b42"
image_description = "Stylized fantasy card illustration, painterly digital art with clean bold shapes and soft cel-shaded lighting, whimsical and expressive young-adult tone like a modern indie RPG, rich saturated colors with a warm key light and colored shadows, a single clear focal subject with a readable silhouette, simple atmospheric background, slight exaggeration for comedy. Vertical 2:3 portrait composition for a full-art trading card: main subject in the upper-middle of the frame, fully visible, head and key details within the upper 60%; top 10% uncluttered; lower third calmer and less detailed (soft background, ground, or atmosphere) so rules text can overlay it; keep important elements away from the outer edges. No text, no letters, no card frame, no border. Cool grays with sickly green highlights, paperwork, filing cabinets, ghostly light. A ghostly cashier wraith at a brass register sliding a receipt as long as a scroll toward the viewer, green ectoplasm coins in a tray, a sign-shaped blank placard above."
