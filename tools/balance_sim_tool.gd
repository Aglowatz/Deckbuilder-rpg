extends RefCounted
## Rebalance Part B: the balance simulator's command line, run by `tools/run_balance_sim.gd` once the autoloads exist.
## --what: encounters (every fight vs each Path's expected player), tutorial (the three tutorial fights per Path plus the run with HP carried),
##         sequence (fights sharing one HP pool: --filter names the sequence key, e.g. zone:beefcake or side:S-BEEF), decks (the four Paths'
##         reference decks round robin at --level), iron (Beefcake's reference deck with and without using Iron, vs its home fights),
##         one (a single encounter, --id=..., with the full card-impact lists per Path)
## --mode: quick (12 games per Path and encounter) or full (100); --games overrides. --level forces the player's level. --seed sets the base seed.
## --path=beefcake limits the player to one Path. --nogear strips equipment and items. --filter narrows the encounter list (id or group substring).
## Writes markdown to --out (default res://docs/design/sim/latest.md) and prints the table.

var args: Dictionary = {}


func run() -> bool:
	for arg: String in OS.get_cmdline_user_args():
		if arg.begins_with("--"):
			var parts: PackedStringArray = arg.substr(2).split("=", true, 1)
			args[parts[0]] = parts[1] if parts.size() > 1 else "true"
	var what: String = str(args.get("what", "encounters"))
	var mode: String = str(args.get("mode", "quick"))
	var games: int = int(args.get("games", BalanceSim.FULL_GAMES if mode == "full" else BalanceSim.QUICK_GAMES))
	var out_path: String = str(args.get("out", "res://docs/design/sim/latest.md"))
	var seed_value: int = int(args.get("seed", 7000))
	var content: ContentSet = ContentLibrary.load_all()
	var started: int = Time.get_ticks_msec()
	var lines: PackedStringArray = []
	lines.append("# Balance sim: %s (%s, %d games per Path and encounter, seed %d)" % [what, mode, games, seed_value])
	lines.append("")
	lines.append("Generated by `tools/run_balance_sim.gd` on %s. Player = `ProgressionModel` expected player (level, reference deck, gear, items)%s%s." % [
		Time.get_datetime_string_from_system(), (" at level %s" % str(args["level"])) if args.has("level") else "", ", no gear or items" if args.has("nogear") else ""])
	lines.append("")
	match what:
		"encounters":
			_encounters(content, games, seed_value, lines)
		"tutorial":
			_tutorial(content, games, seed_value, lines)
		"sequence":
			_sequence(content, games, seed_value, lines)
		"decks":
			_decks(content, games, seed_value, lines)
		"iron":
			_iron(content, games, seed_value, lines)
		"one":
			_one(content, games, seed_value, lines)
		"matchup":
			_matchup(content, games, seed_value, lines)
		_:
			push_error("unknown --what=%s" % what)
			return false
	lines.append("")
	lines.append("Simulated in %.1fs." % (float(Time.get_ticks_msec() - started) / 1000.0))
	var text: String = "\n".join(lines) + "\n"
	print(text)
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(out_path).get_base_dir())
	var file: FileAccess = FileAccess.open(out_path, FileAccess.WRITE)
	if file != null:
		file.store_string(text)
		file.close()
		print("Wrote %s" % out_path)
	return true


func _paths() -> Array[Affinity.Type]:
	if args.has("path"):
		var wanted: String = str(args["path"]).to_lower()
		for path: Affinity.Type in Affinity.colored_types():
			if Affinity.display_name(path).to_lower() == wanted:
				return [path] as Array[Affinity.Type]
	return Affinity.colored_types()


func _player(content: ContentSet, spec: EncounterSpec, path: Affinity.Type) -> PlayerSpec:
	var player: PlayerSpec = ProgressionModel.player_for(content, spec, path)
	var level_override: int = int(args.get("level", 0))
	if level_override > 0:
		player.level = level_override
		player.deck = ProgressionModel.reference_deck(content, path, level_override)
		player.equipment_ids = ProgressionModel.equipment_for(level_override)
		player.items = ProgressionModel.items_for(level_override)
	if args.has("nogear"):
		player.equipment_ids = []
		player.items = {}
	return player


func _run_all(content: ContentSet, spec: EncounterSpec, games: int, seed_value: int) -> Dictionary:
	var per_path: Dictionary = {}
	var merged: BalanceSim.Result = BalanceSim.Result.new()
	merged.encounter = spec
	merged.player_label = "all Paths"
	for path: Affinity.Type in _paths():
		var result: BalanceSim.Result = BalanceSim.run(content, _player(content, spec, path), spec, games, seed_value + int(path) * 100000)
		per_path[path] = result
		merged.merge(result)
	return {"all": merged, "paths": per_path}


func _encounters(content: ContentSet, games: int, seed_value: int, lines: PackedStringArray) -> void:
	var filter: String = str(args.get("filter", ""))
	var specs: Array[EncounterSpec] = EncounterCatalog.filtered(content, filter)
	var rows: Array[Dictionary] = []
	var flagged: Array[String] = []
	for spec: EncounterSpec in specs:
		var row: Dictionary = _run_all(content, spec, games, seed_value)
		rows.append(row)
		var all: BalanceSim.Result = row["all"] as BalanceSim.Result
		print("%-44s %4s  turns %.1f  %s" % [spec.id, BalanceSim.percent(all.win_rate()), all.avg_player_turns(), BalanceSim.verdict(all)])
		if not spec.in_target(all.win_rate()):
			flagged.append("%s (%s, target %s): %s" % [spec.id, BalanceSim.percent(all.win_rate()), spec.target_text(), _per_path_summary(row)])
	lines.append("## Encounters (%d)" % rows.size())
	lines.append("")
	lines.append(BalanceSim.table(rows))
	lines.append("")
	lines.append("## Outside the target band (%d)" % flagged.size())
	lines.append("")
	for entry: String in flagged:
		lines.append("- " + entry)


## "Beefcake 92% (weakest cards: ...), Necrocrat 33% (...)" - the per-Path win rates with each Path's least helpful cards.
func _per_path_summary(row: Dictionary) -> String:
	var parts: PackedStringArray = []
	var paths: Dictionary = row["paths"] as Dictionary
	for path: Variant in paths.keys():
		var result: BalanceSim.Result = paths[path] as BalanceSim.Result
		var impact: Array[Dictionary] = result.impact()
		var worst: PackedStringArray = []
		for index: int in range(maxi(0, impact.size() - 2), impact.size()):
			worst.append("%s %+d" % [str(impact[index]["id"]), roundi(float(impact[index]["lift"]) * 100.0)])
		parts.append("%s %s%s" % [Affinity.display_name(path as Affinity.Type), BalanceSim.percent(result.win_rate()), (" (drag: " + ", ".join(worst) + ")") if not worst.is_empty() else ""])
	return "; ".join(parts)


func _tutorial(content: ContentSet, games: int, seed_value: int, lines: PackedStringArray) -> void:
	var specs: Array[EncounterSpec] = EncounterCatalog.tutorial()
	var rows: Array[Dictionary] = []
	for spec: EncounterSpec in specs:
		rows.append(_run_all(content, spec, games, seed_value))
	lines.append("## The tutorial's fights (each from full HP)")
	lines.append("")
	lines.append(BalanceSim.table(rows))
	lines.append("")
	lines.append("## The whole Forgotten Cave as played: HP carried, the Hollow Well (heal 4 / lose a card), the shrine's full heal, the 3 reward picks")
	lines.append("")
	lines.append("| Path | Runs | Cleared | Avg turns/run | Lost at |")
	lines.append("|---|---:|---:|---:|---|")
	var runs: int = games * 2
	var map: DungeonMap = TrialOfTheHollow.build_map()
	var ai: AIPlayer = AIPlayer.new(AIPersonality.balanced())
	for path: Affinity.Type in _paths():
		var deck: Deck = ProgressionModel.reference_deck(content, path, 1)
		var results: Array[DungeonSimulation.RunResult] = DungeonSimulation.run_many(content, map, deck, ai, runs, seed_value + int(path) * 100000, path)
		var fail_counts: Dictionary = {}
		var turns: int = 0
		for result: DungeonSimulation.RunResult in results:
			turns += result.turns_played
			if not result.won:
				fail_counts[result.failed_at] = int(fail_counts.get(result.failed_at, 0)) + 1
		var parts: PackedStringArray = []
		for node_title: Variant in fail_counts.keys():
			parts.append("%s: %d" % [str(node_title), int(fail_counts[node_title])])
		lines.append("| %s | %d | %s | %.1f | %s |" % [Affinity.display_name(path), runs, BalanceSim.percent(DungeonSimulation.win_rate(results)), float(turns) / float(runs), ", ".join(parts) if not parts.is_empty() else "-"])


func _lost_at(result: BalanceSim.SequenceResult, specs: Array[EncounterSpec]) -> String:
	var parts: PackedStringArray = []
	for index: Variant in result.lost_at.keys():
		parts.append("%s: %d" % [specs[int(index)].title, int(result.lost_at[index])])
	return ", ".join(parts) if not parts.is_empty() else "-"


func _sequence(content: ContentSet, games: int, seed_value: int, lines: PackedStringArray) -> void:
	var key: String = str(args.get("filter", "zone:beefcake"))
	var specs: Array[EncounterSpec] = []
	for spec: EncounterSpec in EncounterCatalog.all(content):
		if spec.sequence == key:
			specs.append(spec)
	if specs.is_empty():
		lines.append("No fights share the sequence key %s." % key)
		return
	# A zone's roamers: three fights in a row (its normal types cycled), no healing.
	var fights: Array[EncounterSpec] = specs
	if key.begins_with("zone:"):
		fights = [] as Array[EncounterSpec]
		for index: int in range(3):
			fights.append(specs[index % specs.size()])
	lines.append("## Sequence %s: %d fights, one HP pool" % [key, fights.size()])
	lines.append("")
	var titles: PackedStringArray = []
	for spec: EncounterSpec in fights:
		titles.append(spec.title)
	lines.append("Fights: " + " -> ".join(titles))
	lines.append("")
	lines.append("| Path | Runs | Cleared | HP left | Lost at |")
	lines.append("|---|---:|---:|---:|---|")
	var runs: int = games * 2
	for path: Affinity.Type in _paths():
		var result: BalanceSim.SequenceResult = BalanceSim.run_sequence(content, _player(content, fights[0], path), fights, runs, seed_value)
		lines.append("| %s | %d | %s | %.1f | %s |" % [Affinity.display_name(path), runs, BalanceSim.percent(result.clear_rate()), result.avg_hp_left(), _lost_at(result, fights)])


func _decks(content: ContentSet, games: int, seed_value: int, lines: PackedStringArray) -> void:
	var level: int = int(args.get("level", 1))
	var decks: Array[Deck] = []
	for path: Affinity.Type in Affinity.colored_types():
		decks.append(ProgressionModel.reference_deck(content, path, level))
	var template: Deck = content.deck(CampaignStart.STARTER_DECK_NAME)
	if template != null and args.has("colorless"):
		decks.append(template)
	lines.append("## Reference decks round robin at level %d (%d games per pairing, both seats Balanced AI, no gear)" % [level, games])
	lines.append("")
	var header: PackedStringArray = ["| Deck |"]
	for deck: Deck in decks:
		header.append(" %s |" % deck.deck_name)
	header.append(" Overall |")
	lines.append("".join(header))
	lines.append("|---|" + "---:|".repeat(decks.size() + 1))
	var totals: Dictionary = {}
	var matrix: Dictionary = {}
	for i: int in range(decks.size()):
		for j: int in range(i + 1, decks.size()):
			var result: BalanceSim.Result = BalanceSim.run_matchup(content, decks[i], decks[j], games, seed_value + (i * 10 + j) * 1000, level)
			matrix["%d:%d" % [i, j]] = result.win_rate()
			matrix["%d:%d" % [j, i]] = 1.0 - result.win_rate()
			totals[i] = float(totals.get(i, 0.0)) + result.win_rate()
			totals[j] = float(totals.get(j, 0.0)) + 1.0 - result.win_rate()
			print("%s vs %s: %s (%.1f turns)" % [decks[i].deck_name, decks[j].deck_name, BalanceSim.percent(result.win_rate()), result.avg_player_turns()])
	for i: int in range(decks.size()):
		var cells: PackedStringArray = ["| %s |" % decks[i].deck_name]
		for j: int in range(decks.size()):
			cells.append(" %s |" % ("-" if i == j else BalanceSim.percent(float(matrix["%d:%d" % [i, j]]))))
		cells.append(" **%s** |" % BalanceSim.percent(float(totals.get(i, 0.0)) / float(maxi(1, decks.size() - 1))))
		lines.append("".join(cells))


func _iron(content: ContentSet, games: int, seed_value: int, lines: PackedStringArray) -> void:
	var specs: Array[EncounterSpec] = EncounterCatalog.filtered(content, str(args.get("filter", "zone:beefcake")))
	lines.append("## Is temporary Iron worth 1 energy? Beefcake's expected player with and without using Iron")
	lines.append("")
	lines.append("| Encounter | L | With Iron | Without Iron | Delta |")
	lines.append("|---|---:|---:|---:|---:|")
	var with_total: float = 0.0
	var without_total: float = 0.0
	for spec: EncounterSpec in specs:
		var player: PlayerSpec = _player(content, spec, Affinity.Type.BEEFCAKE)
		var with_iron: BalanceSim.Result = BalanceSim.run(content, player, spec, games, seed_value)
		var muted: PlayerSpec = player.duplicate_spec()
		muted.use_resources = false
		var without: BalanceSim.Result = BalanceSim.run(content, muted, spec, games, seed_value)
		with_total += with_iron.win_rate()
		without_total += without.win_rate()
		lines.append("| %s | %d | %s | %s | %+d |" % [spec.title, spec.expected_level, BalanceSim.percent(with_iron.win_rate()), BalanceSim.percent(without.win_rate()), roundi((with_iron.win_rate() - without.win_rate()) * 100.0)])
		print("%s: with %s, without %s" % [spec.id, BalanceSim.percent(with_iron.win_rate()), BalanceSim.percent(without.win_rate())])
	var count: int = maxi(1, specs.size())
	lines.append("| **Average** | | **%s** | **%s** | **%+d** |" % [BalanceSim.percent(with_total / count), BalanceSim.percent(without_total / count), roundi((with_total - without_total) / count * 100.0)])


func _one(content: ContentSet, games: int, seed_value: int, lines: PackedStringArray) -> void:
	var spec: EncounterSpec = EncounterCatalog.find(content, str(args.get("id", "tutorial:2")))
	if spec == null:
		lines.append("Unknown encounter id.")
		return
	var row: Dictionary = _run_all(content, spec, games, seed_value)
	lines.append(BalanceSim.table([row]))
	lines.append("")
	for path: Variant in (row["paths"] as Dictionary).keys():
		var result: BalanceSim.Result = (row["paths"] as Dictionary)[path] as BalanceSim.Result
		lines.append("- **%s**: %s, %.1f turns, items used %d, first-player wins %s. %s" % [Affinity.display_name(path as Affinity.Type), BalanceSim.percent(result.win_rate()), result.avg_player_turns(), result.items_used, BalanceSim.percent(result.first_player_win_rate()), BalanceSim.impact_lines(result, 6)])


## One reference deck against another (--a=beefcake --b=refusemancer, --level), with deck A's card impact; --noiron mutes A's resource use.
func _matchup(content: ContentSet, games: int, seed_value: int, lines: PackedStringArray) -> void:
	var level: int = int(args.get("level", 1))
	var deck_a: Deck = ProgressionModel.reference_deck(content, _path_arg("a", Affinity.Type.BEEFCAKE), level)
	var deck_b: Deck = ProgressionModel.reference_deck(content, _path_arg("b", Affinity.Type.REFUSEMANCER), level)
	var encounter: EncounterSpec = EncounterSpec.new()
	encounter.id = "deck:%s" % deck_b.deck_name
	encounter.title = deck_b.deck_name
	encounter.group = "decks"
	encounter.kind = EncounterSpec.Kind.ELITE
	encounter.enemy_name = deck_b.deck_name
	encounter.enemy_hp = ProgressionTable.row(clampi(level, 1, ProgressionTable.MAX_LEVEL)).max_hp
	encounter.enemy_recipe = deck_b.copy_counts()
	encounter.expected_level = level
	var player: PlayerSpec = PlayerSpec.make(deck_a, level)
	player.use_resources = not args.has("noiron")
	var result: BalanceSim.Result = BalanceSim.run(content, player, encounter, games, seed_value)
	lines.append("## %s vs %s at level %d: %s for A (%d games, %.1f turns, first-player wins %s)%s" % [deck_a.deck_name, deck_b.deck_name, level, BalanceSim.percent(result.win_rate()), games, result.avg_player_turns(), BalanceSim.percent(result.first_player_win_rate()), " (A never uses resources)" if args.has("noiron") else ""])
	lines.append("")
	lines.append("| Card (deck A) | Games played | Plays/game | Win rate when played | Lift |")
	lines.append("|---|---:|---:|---:|---:|")
	for row: Dictionary in result.impact():
		lines.append("| %s | %d | %.2f | %s | %+d |" % [str(row["id"]), int(row["games"]), float(row["per_game"]), BalanceSim.percent(float(row["win_rate"])), roundi(float(row["lift"]) * 100.0)])


func _path_arg(key: String, fallback: Affinity.Type) -> Affinity.Type:
	var wanted: String = str(args.get(key, "")).to_lower()
	for path: Affinity.Type in Affinity.colored_types():
		if Affinity.display_name(path).to_lower() == wanted:
			return path
	return fallback
