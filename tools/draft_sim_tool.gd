extends RefCounted
## Draft mode, Phase 1 (Part 3): simulated drafts. A "sensible player" drafts (the pick that fits best, by a plain taste: units on
## curve, some answers), takes equipment and items, builds the default deck and plays the three rivals of the challenge; the
## rivals draft with the same system. Three reports:
##   --what=rivals     the player's win rate against each rival, by Path and personality, and how runs end (3-0 ... 0-2)
##   --what=gear       each piece of equipment's effect on the win rate, to propose bans (--from= / --to= split the pool into small runs)
##   --what=items      the same for items
## Options: --paths=beefcake,gourmand,necrocrat,refusemancer  --seeds=6  --games=4 (per rival and seed)  --level=12  --out=res://...
## One Godot, headless:  Godot --headless --path . -s res://tools/draft_sim.gd -- --what=rivals

const PATHS: Dictionary = {"beefcake": Affinity.Type.BEEFCAKE, "gourmand": Affinity.Type.GOURMAND, "necrocrat": Affinity.Type.NECROCRAT, "refusemancer": Affinity.Type.REFUSEMANCER}

var args: Dictionary = {}
var content: ContentSet
var lines: PackedStringArray = []


func run() -> bool:
	for raw: String in OS.get_cmdline_user_args():
		if raw.begins_with("--") and raw.contains("="):
			args[raw.substr(2, raw.find("=") - 2)] = raw.substr(raw.find("=") + 1)
	content = ContentLibrary.load_all()
	var what: String = str(args.get("what", "rivals"))
	lines.append("# Draft sim: %s (level %d, %d seeds, %d games per rival and seed)" % [what, _level(), _seeds(), _games()])
	lines.append("")
	lines.append("Generated by `tools/draft_sim.gd` on %s. The player is a sensible drafter with the default deck; rivals are `DraftRivals` (skill: %s, HP bonus %d)." % [Time.get_datetime_string_from_system(), str(DraftRules.rivals().get("skill", "elite")), int(DraftRules.rivals().get("hp_bonus", 0))])
	lines.append("")
	match what:
		"gear":
			_gear()
		"items":
			_items()
		_:
			_rivals()
	var out: String = str(args.get("out", "res://docs/design/sim/draft1/%s.md" % what))
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(out.get_base_dir()))
	var file: FileAccess = FileAccess.open(out, FileAccess.WRITE)
	if file == null:
		return false
	file.store_string("\n".join(lines) + "\n")
	file.close()
	print("\n".join(lines))
	return true


func _level() -> int:
	return int(args.get("level", 12))


func _seeds() -> int:
	return int(args.get("seeds", 6))


func _games() -> int:
	return int(args.get("games", 4))


func _path_names() -> Array[String]:
	var result: Array[String] = []
	for word: String in str(args.get("paths", "beefcake,gourmand,necrocrat,refusemancer")).split(",", false):
		if PATHS.has(word):
			result.append(word)
	return result


## A whole draft by the sensible player: cards by fit and a plain taste, the dearest-rarity equipment, the first item.
func _player_draft(zone_id: String, seed_value: int, with_gear: bool = true) -> DraftState:
	var state: DraftState = DraftEngine.start(content, DraftChallenges.zone_id_for(zone_id), [int(PATHS[zone_id])] as Array[int], _level(), seed_value)
	var guard: int = 0
	while state.phase == DraftState.PHASE_PICK and guard < 100:
		guard += 1
		var options: Array = state.offer["options"] as Array
		var choice: int = 0
		match str(state.offer["kind"]):
			DraftEngine.KIND_CARD:
				var picked: Array[CardData] = DraftEngine.picked_cards(content, state)
				var best: float = -1000.0
				for i: int in range(options.size()):
					var card: CardData = content.card(str(options[i]))
					var value: float = _taste(card) + 2.0 * DraftEngine.fit(card, picked, state.paths) + 0.4 * float(int(card.rarity))
					if value > best:
						best = value
						choice = i
			DraftEngine.KIND_EQUIPMENT:
				var top: int = -1
				for i: int in range(options.size()):
					var piece: EquipmentData = content.equipment_piece(str(options[i]))
					if int(piece.rarity) > top:
						top = int(piece.rarity)
						choice = i
		DraftEngine.pick(content, state, choice)
	if not with_gear:
		state.equipment.clear()
		state.items.clear()
	DraftRun.begin(content, state)
	return state


## A plain player's taste: units on curve first, cheap answers second.
func _taste(card: CardData) -> float:
	var cost: int = card.energy_value()
	if card.is_unit():
		return 1.6 + 0.3 * float(card.attack + card.defense) - 0.5 * float(cost)
	return 0.9 - 0.2 * float(cost)


func _spec(state: DraftState, equipment: Array[String], items: Array[String]) -> PlayerSpec:
	var spec: PlayerSpec = PlayerSpec.make(DraftEngine.build_deck(content, state), _level(), "draft")
	spec.equipment_ids = equipment.duplicate()
	for id: String in items:
		spec.items[id] = 1
	return spec


func _encounter(rival: Dictionary, index: int) -> EncounterSpec:
	var spec: EncounterSpec = EncounterSpec.new()
	spec.id = "draft:%d" % index
	spec.title = str(rival["name"])
	spec.kind = EncounterSpec.Kind.ELITE if DraftRun.skill() == AIPlayer.Skill.ELITE else (EncounterSpec.Kind.BOSS if DraftRun.skill() == AIPlayer.Skill.BOSS else EncounterSpec.Kind.NORMAL)
	spec.enemy_name = str(rival["name"])
	spec.enemy_hp = int(rival["hp"])
	spec.enemy_ai_name = str(rival["ai"])
	spec.enemy_recipe = rival["recipe"] as Dictionary
	spec.enemy_sources = DraftRivals.equipment_sources(content, rival)
	return spec


func _rivals() -> void:
	lines.append("| Path | vs the swarming rival | vs the aggressive rival | vs the controlling rival | All fights | Runs won (3 wins before 2 losses) |")
	lines.append("|---|---:|---:|---:|---:|---:|")
	var grand_wins: int = 0
	var grand_games: int = 0
	for zone_id: String in _path_names():
		var wins: Array[int] = [0, 0, 0]
		var games: Array[int] = [0, 0, 0]
		var run_wins: float = 0.0
		for seed_index: int in range(_seeds()):
			var state: DraftState = _player_draft(zone_id, 100 + seed_index * 17)
			var player: PlayerSpec = _spec(state, state.equipment, state.items)
			var rates: Array[float] = []
			for i: int in range(state.rivals.size()):
				var result: BalanceSim.Result = BalanceSim.run(content, player, _encounter(state.rivals[i], i), _games(), 5000 + seed_index * 31 + i)
				wins[i] += result.wins
				games[i] += result.games
				rates.append(result.win_rate())
			run_wins += _run_chance(rates)
		var total_wins: int = wins[0] + wins[1] + wins[2]
		var total_games: int = games[0] + games[1] + games[2]
		grand_wins += total_wins
		grand_games += total_games
		lines.append("| %s | %d%% | %d%% | %d%% | **%d%%** | %d%% |" % [zone_id.capitalize(), _pct(wins[0], games[0]), _pct(wins[1], games[1]), _pct(wins[2], games[2]), _pct(total_wins, total_games), int(round(100.0 * run_wins / float(_seeds())))])
	lines.append("| **All** | | | | **%d%%** | |" % _pct(grand_wins, grand_games))
	lines.append("")
	lines.append("Target: a fair fight, about 50 to 60 % for a sensible player draft.")


## The chance to reach 3 wins before 2 losses over fights with these win rates (the third rival again if a fourth fight is needed).
func _run_chance(rates: Array[float]) -> float:
	return _reach(rates, 0, 0, 0)


func _reach(rates: Array[float], fight: int, wins: int, losses: int) -> float:
	if wins >= DraftRules.wins_to_finish():
		return 1.0
	if losses >= DraftRules.losses_to_finish():
		return 0.0
	var p: float = rates[mini(fight, rates.size() - 1)]
	return p * _reach(rates, fight + 1, wins + 1, losses) + (1.0 - p) * _reach(rates, fight + 1, wins, losses + 1)


func _pct(wins: int, games: int) -> int:
	return int(round(100.0 * float(wins) / float(maxi(1, games))))


## The decks every gear and item variant is measured with: one fixed draft per Path (no gear, no items), its three rivals.
func _baselines() -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for zone_id: String in _path_names():
		var state: DraftState = _player_draft(zone_id, 100, false)
		var base_wins: int = 0
		var base_games: int = 0
		for i: int in range(state.rivals.size()):
			var outcome: BalanceSim.Result = BalanceSim.run(content, _spec(state, [] as Array[String], [] as Array[String]), _encounter(state.rivals[i], i), _games(), 5000 + i)
			base_wins += outcome.wins
			base_games += outcome.games
		result.append({"zone": zone_id, "state": state, "wins": base_wins, "games": base_games})
	return result


func _measure(baselines: Array[Dictionary], equipment: Array[String], items: Array[String]) -> Array[int]:
	var wins: int = 0
	var games: int = 0
	for base: Dictionary in baselines:
		var state: DraftState = base["state"] as DraftState
		for i: int in range(state.rivals.size()):
			var outcome: BalanceSim.Result = BalanceSim.run(content, _spec(state, equipment, items), _encounter(state.rivals[i], i), _games(), 5000 + i)
			wins += outcome.wins
			games += outcome.games
	return [wins, games]


func _gear() -> void:
	var baselines: Array[Dictionary] = _baselines()
	var base_wins: int = 0
	var base_games: int = 0
	for base: Dictionary in baselines:
		base_wins += int(base["wins"])
		base_games += int(base["games"])
	var pool: Array[EquipmentData] = DraftEngine.equipment_pool(content)
	var from: int = int(args.get("from", 0))
	var to: int = mini(int(args.get("to", pool.size())), pool.size())
	lines.append("Bare draft deck (no equipment, no items): **%d%%** over %d games. Pieces %d to %d of %d, one at a time on the same decks and seeds." % [_pct(base_wins, base_games), base_games, from, to - 1, pool.size()])
	lines.append("")
	lines.append("| Piece | Slot | Rarity | Win rate with it | Change |")
	lines.append("|---|---|---|---:|---:|")
	for index: int in range(from, to):
		var piece: EquipmentData = pool[index]
		var got: Array[int] = _measure(baselines, [piece.id] as Array[String], [] as Array[String])
		lines.append("| %s (`%s`) | %s | %s | %d%% | %+d |" % [piece.source_name, piece.id, EquipmentData.slot_name(piece.slot), EquipmentRarity.display_name(int(piece.rarity)), _pct(got[0], got[1]), _pct(got[0], got[1]) - _pct(base_wins, base_games)])
		print("gear %d/%d %s" % [index + 1, to, piece.id])


func _items() -> void:
	var baselines: Array[Dictionary] = _baselines()
	var base_wins: int = 0
	var base_games: int = 0
	for base: Dictionary in baselines:
		base_wins += int(base["wins"])
		base_games += int(base["games"])
	lines.append("Bare draft deck: **%d%%** over %d games. Each item alone, one charge a fight." % [_pct(base_wins, base_games), base_games])
	lines.append("")
	lines.append("| Item | Win rate with it | Change |")
	lines.append("|---|---:|---:|")
	for item: ItemData in DraftEngine.item_pool(content):
		var got: Array[int] = _measure(baselines, [] as Array[String], [item.id] as Array[String])
		lines.append("| %s (`%s`) | %d%% | %+d |" % [item.display_name, item.id, _pct(got[0], got[1]), _pct(got[0], got[1]) - _pct(base_wins, base_games)])
