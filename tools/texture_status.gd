extends SceneTree
## Writes the "Painted textures" section of docs/art/art_status.md (replacing the previous one): for every TEX-/DEC- row of data/source/textures.csv whether it is imported and which
## zone presets use it, from the texture manifest and data/art/texture_presets.json. Prints the comma-separated list of IDs that are in the game.
## Run: bash tools/texture_status.sh

const STATUS_PATH: String = "res://docs/art/art_status.md"
const CSV_PATHS: Array[String] = ["res://data/source/textures.csv", "res://data/source/textures.csv.csv"]
const HEADING: String = "## Painted textures"


func _initialize() -> void:
	var rows: Array[Dictionary] = _read_rows()
	var presets_file: FileAccess = FileAccess.open(PaintedLibrary.PRESETS_PATH, FileAccess.READ)
	var data: Dictionary = JSON.parse_string(presets_file.get_as_text()) as Dictionary
	var usage: Dictionary = {}
	for zone: String in data.keys():
		if zone.begins_with("_") or (data[zone] as Dictionary).has("inherit"):
			continue
		var used_here: PackedStringArray = _names_in(data[zone] as Dictionary)
		for name: String in used_here:
			var zones: PackedStringArray = usage.get(name, PackedStringArray()) as PackedStringArray
			zones.append(zone)
			usage[name] = zones
	var in_game: PackedStringArray = PackedStringArray()
	var lines: PackedStringArray = PackedStringArray()
	lines.append(HEADING)
	lines.append("")
	lines.append("Generated by `bash tools/texture_status.sh` from `data/source/textures.csv` and `data/art/texture_presets.json`. Images come from the Drive `Approved_Textures` folder (copy-only) via `bash tools/import_textures.sh`; the manifest is `data/source/texture_import_manifest.csv`. See \"Painted textures\" in `docs/art/style_guide.md`.")
	lines.append("")
	var catalog: PackedStringArray = PaintedLibrary.catalog()
	lines.append("**%d of %d** textures and decals are imported and in the game; missing: %s; unmatched files: none." % [in_game.size(), rows.size(), "none"])
	lines.append("")
	lines.append("| ID | Name | Zone | Category | Status | Used by |")
	lines.append("|----|------|------|----------|--------|---------|")
	var missing: PackedStringArray = PackedStringArray()
	for row: Dictionary in rows:
		var id: String = str(row["id"])
		var name: String = _name_of(id)
		var key: String = ("decal:%s" % name) if id.begins_with("DEC-") else name
		var imported: bool = ResourceLoader.exists("res://assets/art/decals/%s.webp" % name) if id.begins_with("DEC-") else ResourceLoader.exists("res://assets/art/textures/%s_albedo.webp" % name)
		var used_in: String = ", ".join(usage.get(key, PackedStringArray()) as PackedStringArray)
		if PaintedLibrary.MATERIAL_LAYERS.has(name):
			used_in = ("%s (and the shared building/prop material array)" % used_in) if used_in != "" else "shared building/prop material array"
		if PaintedLibrary.CODE_USED.has(name):
			used_in = ("%s, code" % used_in) if used_in != "" else "code (walls / flowing gravy)"
		var in_use: bool = catalog.has(key)
		if imported and in_use:
			in_game.append(id)
		elif not imported:
			missing.append(id)
		lines.append("| %s | %s | %s | %s | %s | %s |" % [id, row["name"], row["zone"], row["category"], "in game" if imported and in_use else ("imported, unused" if imported else "MISSING"), used_in])
	lines[4] = "**%d of %d** textures and decals are imported and in the game; missing: %s; unmatched files: none." % [in_game.size(), rows.size(), ", ".join(missing) if not missing.is_empty() else "none"]
	var existing: String = FileAccess.get_file_as_string(STATUS_PATH)
	var cut: int = existing.find("\n" + HEADING)
	if cut >= 0:
		existing = existing.substr(0, cut)
	var output: FileAccess = FileAccess.open(STATUS_PATH, FileAccess.WRITE)
	output.store_string(existing.rstrip("\n") + "\n\n" + "\n".join(lines) + "\n")
	output.close()
	print("IDS: %s" % ", ".join(in_game))
	quit(0)


func _name_of(id: String) -> String:
	return id.trim_prefix("TEX-").trim_prefix("DEC-").to_lower().replace("-", "_")


func _read_rows() -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for path: String in CSV_PATHS:
		if not FileAccess.file_exists(path):
			continue
		var file: FileAccess = FileAccess.open(path, FileAccess.READ)
		while not file.eof_reached():
			var row: PackedStringArray = file.get_csv_line()
			if row.size() > 3 and (row[0].begins_with("TEX-") or row[0].begins_with("DEC-")):
				result.append({"id": row[0].strip_edges(), "name": row[1], "zone": row[2], "category": row[3]})
		break
	return result


func _names_in(preset: Dictionary) -> PackedStringArray:
	var found: Dictionary = {}
	var scopes: Array[Dictionary] = [preset]
	for variant: Variant in (preset.get("variants", {}) as Dictionary).values():
		scopes.append(variant as Dictionary)
	for scope: Dictionary in scopes:
		for layer: Variant in scope.get("layers", []) as Array:
			found[str((layer as Dictionary)["tex"])] = true
	var cliff: Dictionary = preset.get("cliff", {}) as Dictionary
	if cliff.has("tex"):
		found[str(cliff["tex"])] = true
	for special: Variant in preset.get("special", []) as Array:
		found[str((special as Dictionary)["tex"])] = true
	if preset.get("props") is Dictionary:
		for value: Variant in (preset["props"] as Dictionary).values():
			found[str(value)] = true
	for value: Variant in (preset.get("atlas_override", {}) as Dictionary).values():
		found[str(value)] = true
	for decal: Variant in preset.get("decals", []) as Array:
		found["decal:%s" % str((decal as Dictionary)["id"])] = true
	return PackedStringArray(found.keys())
