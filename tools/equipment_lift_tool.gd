extends RefCounted
## Nov 26 night (Part C.2): every piece of equipment (and every item) on the reference decks against the zone dungeons' bosses and Primm.
## For each fight the expected player of its level wears the model gear (`ProgressionModel.equipment_for`); a piece is swapped into its own
## slot (or added when the slot is free) and measured against the same decks and seeds. Items: the model items plus one charge of the item.
##   Godot --headless --path . -s res://tools/equipment_lift.gd -- [--from=0] [--to=40] [--games=2] [--items=1] [--out=res://docs/design/sim/nov26n/equipment_lift_<from>.md]
## Two Paths per fight (rotating), so every piece meets all four Paths over the five fights.

const BOSS_DUNGEONS: Array[String] = ["D-HOG", "D-HFA", "D-TTK", "D-ROT", "D-PC"]
const PATHS: Array[Affinity.Type] = [Affinity.Type.BEEFCAKE, Affinity.Type.NECROCRAT, Affinity.Type.GOURMAND, Affinity.Type.REFUSEMANCER]

var args: Dictionary = {}
var content: ContentSet


func run() -> bool:
	for arg: String in OS.get_cmdline_user_args():
		if arg.begins_with("--"):
			var parts: PackedStringArray = arg.substr(2).split("=", true, 1)
			args[parts[0]] = parts[1] if parts.size() > 1 else "true"
	content = ContentLibrary.load_all()
	var games: int = int(args.get("games", 2))
	var fights: Array[EncounterSpec] = []
	for spec: EncounterSpec in EncounterCatalog.dungeons():
		if spec.kind == EncounterSpec.Kind.BOSS and BOSS_DUNGEONS.has(spec.id.get_slice(":", 0)):
			if spec.id.begins_with("D-PC") and not spec.id.ends_with("phase1"):
				continue  # Primm: his first phase stands for the castle (the phases are one fight in the game)
			fights.append(spec)
	var variants: Array[Dictionary] = [{"label": "model gear and items", "id": "", "kind": "base"}]
	var ids: Array = content.equipment.keys() + content.zone_equipment.keys()
	ids.sort()
	var pieces: Array[String] = []
	for id: Variant in ids:
		if not pieces.has(str(id)):
			pieces.append(str(id))
	var from: int = int(args.get("from", 0))
	var to: int = mini(int(args.get("to", pieces.size())), pieces.size())
	for index: int in range(from, to):
		variants.append({"label": pieces[index], "id": pieces[index], "kind": "gear"})
	if str(args.get("items", "0")) == "1":
		var item_ids: Array = content.items.keys()
		item_ids.sort()
		for id: Variant in item_ids:
			variants.append({"label": "item: %s" % str(id), "id": str(id), "kind": "item"})
	var lines: PackedStringArray = []
	var titles: PackedStringArray = []
	for spec: EncounterSpec in fights:
		titles.append("%s (L%d)" % [spec.enemy_name.get_slice(",", 0), spec.expected_level])
	lines.append("# Equipment and items against the zone bosses and Primm (Nov 26 night, Part C)")
	lines.append("")
	lines.append("Generated by `tools/equipment_lift.gd`. Fights: %s. Two reference Paths per fight (rotating), %d games each; the piece goes into its own slot of the model gear. Pieces %d to %d of %d." % [", ".join(titles), games, from, to - 1, pieces.size()])
	lines.append("")
	lines.append("| Variant | Slot | Rarity | Won | Change vs model |")
	lines.append("|---|---|---|---:|---:|")
	var base_rate: float = -1.0
	for variant: Dictionary in variants:
		var wins: int = 0
		var total: int = 0
		for fight_index: int in range(fights.size()):
			var spec: EncounterSpec = fights[fight_index]
			for k: int in range(2):
				var path: Affinity.Type = PATHS[(fight_index + k * 2) % PATHS.size()]
				var player: PlayerSpec = ProgressionModel.player_for(content, spec, path)
				match str(variant["kind"]):
					"gear":
						player.equipment_ids = _swap(player.equipment_ids, str(variant["id"]))
					"item":
						player.items[str(variant["id"])] = int(player.items.get(str(variant["id"]), 0)) + 1
				var result: BalanceSim.Result = BalanceSim.run(content, player, spec, games, 9700 + fight_index * 101 + k * 7)
				wins += result.wins
				total += result.games
		var rate: float = float(wins) / float(maxi(1, total))
		if base_rate < 0.0:
			base_rate = rate
		var piece: EquipmentData = content.equipment_piece(str(variant["id"])) if str(variant["kind"]) == "gear" else null
		var line: String = "| %s | %s | %s | %d/%d | %+d |" % [str(variant["label"]), EquipmentData.slot_name(piece.slot) if piece != null else "-",
			EquipmentRarity.display_name(int(piece.rarity)) if piece != null else "-", wins, total, roundi((rate - base_rate) * 100.0)]
		lines.append(line)
		print(line)
		_flush(lines)
	return true


## The model gear with `id` in its own slot: the piece already in that slot goes out.
func _swap(worn: Array[String], id: String) -> Array[String]:
	var piece: EquipmentData = content.equipment_piece(id)
	var result: Array[String] = []
	for other: String in worn:
		var current: EquipmentData = content.equipment_piece(other)
		if current != null and piece != null and current.slot == piece.slot:
			continue
		result.append(other)
	if not result.has(id):
		result.append(id)
	return result


func _flush(lines: PackedStringArray) -> void:
	var out: String = str(args.get("out", "res://docs/design/sim/nov26n/equipment_lift.md"))
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(out).get_base_dir())
	var file: FileAccess = FileAccess.open(out, FileAccess.WRITE)
	file.store_string("\n".join(lines) + "\n")
	file.close()
