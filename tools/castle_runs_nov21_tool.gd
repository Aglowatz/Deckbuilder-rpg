extends RefCounted
## Fable Nov 21 castle (Part 6): whole runs through the new Primm's Castle along named routes, run by `tools/castle_runs_nov21.gd`.
##   Godot --headless --path . -s res://tools/castle_runs_nov21.gd -- [--runs=6] [--only=A] [--seed=7000] [--out=res://docs/design/sim/nov21c/castle_runs.md]
## A run is one walk from the gate to the end of Primm's third phase with one HP pool: the route's fights in order (each with its own
## rules and script: the Mimic, Hold the Line, the Filing Deadline, the statues), the Safe Room (a full heal), the Garden (the paid
## heal: +6 HP), then Primm with the leaders the route has won (all four zones count as freed, so every ally room has its leader).
## The hero is the expected player of the castle's level (reference deck, gear, items) played by the planning AI. Not modelled: the
## choice rooms' boons and curses (the walker takes nothing), treasure, the Mimic's hoard, card picks on the way. Measures; changes nothing.

const GARDEN_HEAL: int = 6
## Label, what the route is, the rooms in order (dungeon list numbers).
const ROUTES: Array = [
	["A", "all four allies (the kettle: heal 6 for a cost; one treasure)", [2, 5, 8, 11, 14, 18]],
	["B", "three allies (Chef, Flex, Agnes), the kettle", [2, 4, 8, 11, 15, 19]],
	["C", "one ally (Flex) and the Safe Room", [3, 5, 8, 12, 16, 20]],
	["D", "no ally: the middle road with the Safe Room", [3, 6, 9, 12, 16, 19]],
	["E", "no ally: the quiet south (the Garden, treasure, one fight less)", [3, 7, 10, 13, 17, 21]],
]
const SAFE_ROOM: int = 16
const GARDEN: int = 7
## Fable Nov 22 night: the Archivists' Kettle (heal 6 for a cost) after the fight of room 11; `--kettle=0` walks past it.
const KETTLE: int = CastleAllies.REST_ROOM

var args: Dictionary = {}


func run() -> bool:
	for arg: String in OS.get_cmdline_user_args():
		if arg.begins_with("--"):
			var parts: PackedStringArray = arg.substr(2).split("=", true, 1)
			args[parts[0]] = parts[1] if parts.size() > 1 else "true"
	var runs: int = int(args.get("runs", 6))
	var seed_value: int = int(args.get("seed", 7000))
	var out_path: String = str(args.get("out", "res://docs/design/sim/nov21c/castle_runs.md"))
	var content: ContentSet = ContentLibrary.load_all()
	var started: int = Time.get_ticks_msec()
	var lines: PackedStringArray = []
	lines.append("# Whole runs through Primm's Castle (%d runs per Path and route, seed %d)" % [runs, seed_value])
	lines.append("")
	lines.append("Generated by `tools/castle_runs_nov21.gd` on %s. One HP pool from the gate to the end of Primm's third phase; see the tool's header for what is and is not modelled." % Time.get_datetime_string_from_system())
	lines.append("")
	lines.append("| Route | Rooms | Fights before Primm | Allies | Reach Primm | Beat Primm (of all runs) | HP at his door | Most lost at |")
	lines.append("|---|---|---:|---:|---:|---:|---:|---|")
	for route: Array in ROUTES:
		if args.has("only") and str(args["only"]) != str(route[0]):
			continue
		lines.append(_route(content, route, runs, seed_value))
		print(lines[lines.size() - 1])
	lines.append("")
	lines.append("Took %d s." % int((Time.get_ticks_msec() - started) / 1000.0))
	var file: FileAccess = FileAccess.open(out_path, FileAccess.WRITE)
	if file != null:
		file.store_string("\n".join(lines) + "\n")
		file.close()
	return true


func _route(content: ContentSet, route: Array, runs: int, seed_value: int) -> String:
	var rooms: Array = route[2] as Array
	var allies: Array[String] = []
	for number: Variant in rooms:
		var zone_id: String = CastleAllies.zone_of_room(CastleAllies.DUNGEON_KEY, int(number))
		if not zone_id.is_empty():
			allies.append(zone_id)
	EncounterCatalog.primm_allies = allies
	var by_id: Dictionary = {}
	for spec: EncounterSpec in EncounterCatalog.all(content):
		by_id[spec.id] = spec
	# the steps of the walk: a fight spec, or a heal
	var steps: Array = []
	var names: PackedStringArray = []
	var fights: int = 0
	var plan: DungeonCatalog.Blueprint = DungeonCatalog.find("D-PC")
	for number: Variant in rooms:
		names.append(plan.node(int(number)).node_name.split(":")[0])
		if int(number) == SAFE_ROOM:
			steps.append("full")
		elif int(number) == GARDEN:
			steps.append("garden")
		elif by_id.has("D-PC:%d" % int(number)):
			steps.append(by_id["D-PC:%d" % int(number)])
			fights += 1
			if int(number) == KETTLE and str(args.get("kettle", "1")) != "0":
				steps.append("kettle")
	var door: int = steps.size()
	for phase: int in range(1, PrimmBoss.PHASES + 1):
		steps.append(by_id["D-PC:22:phase%d" % phase])
	var total: int = 0
	var reached: int = 0
	var cleared: int = 0
	var door_hp: int = 0
	var lost_at: Dictionary = {}
	for path: Affinity.Type in Affinity.colored_types():
		if args.has("path") and Affinity.display_name(path).to_lower() != str(args["path"]):
			continue
		var player: PlayerSpec = ProgressionModel.player_for(content, by_id["D-PC:22:phase1"] as EncounterSpec, path)
		for run_index: int in range(runs):
			total += 1
			var hp: int = 0
			var max_hp: int = 0
			var items: Dictionary = player.items.duplicate()
			var alive: bool = true
			for index: int in range(steps.size()):
				if index == door and alive:
					reached += 1
					door_hp += hp
				var step: Variant = steps[index]
				if step is String:
					if str(step) == "full":
						hp = 0  # 0 = full HP at the next fight
					elif hp > 0 and max_hp > 0:
						hp = mini(max_hp, hp + GARDEN_HEAL)
					continue
				var encounter: EncounterSpec = step as EncounterSpec
				var scratch: BalanceSim.Result = BalanceSim.Result.new()
				scratch.encounter = encounter
				var first: int = encounter.first_player if encounter.first_player >= 0 else (run_index + index) % 2
				var game: GameState = BalanceSim.play_game(content, player, encounter, seed_value + int(path) * 100000 + run_index * 31 + index, first, hp, items, scratch)
				max_hp = maxi(max_hp, game.players[0].max_hp)
				if game.winner != 0:
					alive = false
					lost_at[encounter.title] = int(lost_at.get(encounter.title, 0)) + 1
					break
				hp = game.players[0].hp
			if alive:
				cleared += 1
	var worst: String = "-"
	var most: int = 0
	for title: Variant in lost_at.keys():
		if int(lost_at[title]) > most:
			most = int(lost_at[title])
			worst = "%s (%d)" % [str(title), most]
	return "| %s: %s | %s | %d | %d | %s | **%s** | %.1f | %s |" % [str(route[0]), str(route[1]), ", ".join(names), fights, allies.size(),
		BalanceSim.percent(float(reached) / float(maxi(1, total))), BalanceSim.percent(float(cleared) / float(maxi(1, total))),
		float(door_hp) / float(maxi(1, reached)), worst]
