extends RefCounted
## Fable Nov 21 review (Part 3.1): whole dungeon runs with the heal rooms of Nov 21, run by `tools/dungeon_runs_nov21.gd`.
##   Godot --headless --path . -s res://tools/dungeon_runs_nov21.gd -- [--only=D-HOG] [--runs=12] [--starter_runs=8] [--out=res://docs/design/sim/nov21r/dungeon_runs.md]
## For each main-zone dungeon (and the Lab): every fight of the dungeon in node order with one HP pool, as in the game. At the heal room
## the same run is continued four ways from the same HP, with the same seeds:
##   full      the room as it was before Nov 21 (a full heal) - the baseline the last sim pass was tuned on
##   heal5     today's paid choice: 5 HP for gold (no drawback)
##   drawback  today's free choice: 5 HP and the room's drawback in the next fight
##   none      walk on
## Two decks per Path: the expected player's reference deck at the dungeon's level ("a typical deck") and the bare starter deck with
## the same level and gear. Measures; changes nothing.

const ROOMS: Dictionary = {"D-HOG": ["beefcake", 10], "D-TTK": ["gourmand", 9], "D-HFA": ["necrocrat", 10], "D-ROT": ["refusemancer", 9], "D-LAB": ["D-LAB", 9]}
const POLICIES: Array[String] = ["full", "heal5", "drawback", "none"]

var args: Dictionary = {}


func run() -> bool:
	for arg: String in OS.get_cmdline_user_args():
		if arg.begins_with("--"):
			var parts: PackedStringArray = arg.substr(2).split("=", true, 1)
			args[parts[0]] = parts[1] if parts.size() > 1 else "true"
	var runs: int = int(args.get("runs", 12))
	var starter_runs: int = int(args.get("starter_runs", 8))
	var out_path: String = str(args.get("out", "res://docs/design/sim/nov21r/dungeon_runs.md"))
	var content: ContentSet = ContentLibrary.load_all()
	var started: int = Time.get_ticks_msec()
	var lines: PackedStringArray = []
	lines.append("# Dungeon runs with the Nov 21 heal rooms (%d runs per Path with the reference deck, %d with the starter deck)" % [runs, starter_runs])
	lines.append("")
	lines.append("Generated by `tools/dungeon_runs_nov21.gd` on %s. One HP pool per run, every fight in node order; the hero's seat is the planning AI at Elite skill. `full` = the room before Nov 21, `heal5` = 5 HP for gold, `drawback` = 5 HP and the room's drawback in the next fight, `none` = walk on. HP = HP left after the boss, in the runs that cleared." % Time.get_datetime_string_from_system())
	lines.append("")
	var all_specs: Array[EncounterSpec] = EncounterCatalog.all(content)
	for dungeon_id: Variant in ROOMS.keys():
		if args.has("only") and str(args["only"]) != str(dungeon_id):
			continue
		var key: String = str((ROOMS[dungeon_id] as Array)[0])
		var room: int = int((ROOMS[dungeon_id] as Array)[1])
		var fights: Array[EncounterSpec] = []
		for spec: EncounterSpec in all_specs:
			if spec.group == "dungeon:%s" % dungeon_id or spec.group == "postgame:%s" % dungeon_id:
				fights.append(spec)
		fights.sort_custom(func(a: EncounterSpec, b: EncounterSpec) -> bool: return a.node_number < b.node_number)
		if fights.is_empty():
			lines.append("## %s: no fights found" % dungeon_id)
			continue
		var drawback: ModifierSource = _drawback(key, str(dungeon_id), room)
		var titles: PackedStringArray = []
		for spec: EncounterSpec in fights:
			titles.append("%s%d %s" % ["[room] " if _first_after(fights, room) == spec else "", spec.node_number, spec.title])
		lines.append("## %s (level %d): %d fights, the heal room is node %d" % [dungeon_id, fights[0].expected_level, fights.size(), room])
		lines.append("")
		lines.append("Fights: " + " -> ".join(titles))
		lines.append("")
		lines.append("The drawback: %s" % (("%s (%s)" % [drawback.source_name, "on the enemy" if drawback.for_enemy else "on you"]) if drawback != null else "none found"))
		lines.append("")
		lines.append("| Path | Deck | Runs | Reach the room | HP there | full: clear / HP | heal5: clear / HP | drawback: clear / HP | none: clear / HP | Most lost at |")
		lines.append("|---|---|---:|---:|---:|---:|---:|---:|---:|---|")
		for deck_kind: String in ["reference", "starter"]:
			var count: int = runs if deck_kind == "reference" else starter_runs
			if count <= 0:
				continue
			var totals: Dictionary = {}
			for path: Affinity.Type in [Affinity.Type.BEEFCAKE, Affinity.Type.NECROCRAT, Affinity.Type.GOURMAND, Affinity.Type.REFUSEMANCER]:
				if args.has("path") and Affinity.display_name(path).to_lower() != str(args["path"]).to_lower():
					continue
				# the expected player of each fight (a boss or an elite is met a level or two higher than the first room, as in the game)
				var seats: Array[PlayerSpec] = []
				for spec: EncounterSpec in fights:
					var seat: PlayerSpec = ProgressionModel.player_for(content, spec, path)
					if deck_kind == "starter":
						seat.deck = CampaignStart.starter_deck_sized(content, path, 0)
					seats.append(seat)
				var row: Dictionary = _runs(content, seats, fights, room, drawback, count, 9000 + int(path) * 1000)
				lines.append(_row_text(Affinity.display_name(path), deck_kind, row, fights))
				print(lines[lines.size() - 1])
				for stat: Variant in row.keys():
					if row[stat] is int or row[stat] is float:
						totals[stat] = float(totals.get(stat, 0.0)) + float(row[stat])
					elif row[stat] is Dictionary:
						var merged: Dictionary = totals.get(stat, {}) as Dictionary
						for inner: Variant in (row[stat] as Dictionary).keys():
							merged[inner] = float(merged.get(inner, 0.0)) + float((row[stat] as Dictionary)[inner])
						totals[stat] = merged
			if not totals.is_empty():
				lines.append(_row_text("**all**", deck_kind, totals, fights))
		lines.append("")
		_flush(out_path, lines)
	lines.append("Simulated in %.0f s." % (float(Time.get_ticks_msec() - started) / 1000.0))
	_flush(out_path, lines)
	print("Wrote %s" % out_path)
	return true


func _flush(out_path: String, lines: PackedStringArray) -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(out_path).get_base_dir())
	var file: FileAccess = FileAccess.open(out_path, FileAccess.WRITE)
	if file != null:
		file.store_string("\n".join(lines) + "\n")
		file.close()


func _first_after(fights: Array[EncounterSpec], room: int) -> EncounterSpec:
	for spec: EncounterSpec in fights:
		if spec.node_number > room:
			return spec
	return null


## The heal room's free choice: the boon / curse it puts on the next fight.
func _drawback(key: String, dungeon_id: String, room: int) -> ModifierSource:
	var def: MainDungeonDef = MainDungeons.def(key)
	var plan: DungeonCatalog.Blueprint = DungeonCatalog.find(dungeon_id)
	if def == null or plan == null:
		return null
	var event: DungeonEvent = def.event(DungeonBuilder.event_id_of(plan, room))
	if event == null:
		return null
	for choice: DungeonEvent.Choice in event.choices:
		if choice.gold_cost() > 0:
			continue
		for outcome: DungeonEvent.Outcome in choice.outcomes:
			if outcome.kind == DungeonEvent.OutcomeKind.BOON and outcome.boon != null:
				return outcome.boon
	return null


func _play(content: ContentSet, player: PlayerSpec, spec: EncounterSpec, seed_value: int, first: int, hp: int, items: Dictionary) -> GameState:
	var scratch: BalanceSim.Result = BalanceSim.Result.new()
	scratch.encounter = spec
	return BalanceSim.play_game(content, player, spec, seed_value, first, hp, items, scratch)


func _runs(content: ContentSet, seats: Array[PlayerSpec], fights: Array[EncounterSpec], room: int, drawback: ModifierSource, count: int, base_seed: int) -> Dictionary:
	var row: Dictionary = {"runs": count, "reached": 0, "hp_there": 0, "lost_at": {}}
	for policy: String in POLICIES:
		row["clear_" + policy] = 0
		row["hp_" + policy] = 0
	for run_index: int in range(count):
		var hp: int = 0
		var max_hp: int = 0
		var items: Dictionary = seats[seats.size() - 1].items.duplicate()  # the consumables of the whole run: what the boss's level carries
		var alive: bool = true
		var split: int = fights.size()
		for index: int in range(fights.size()):
			if fights[index].node_number > room:
				split = index
				break
			var first: int = fights[index].first_player if fights[index].first_player >= 0 else (run_index + index) % 2
			var game: GameState = _play(content, seats[index], fights[index], base_seed + run_index * 31 + index, first, hp, items)
			max_hp = maxi(max_hp, game.players[0].max_hp)
			if game.winner != 0:
				alive = false
				(row["lost_at"] as Dictionary)[index] = int((row["lost_at"] as Dictionary).get(index, 0)) + 1
				break
			hp = game.players[0].hp
		if not alive:
			continue
		row["reached"] = int(row["reached"]) + 1
		row["hp_there"] = int(row["hp_there"]) + hp
		for policy: String in POLICIES:
			var hp_now: int = hp
			match policy:
				"full":
					hp_now = 0
				"heal5", "drawback":
					hp_now = mini(maxi(max_hp, hp), hp + 5) if max_hp > 0 else hp + 5
			var policy_items: Dictionary = items.duplicate()
			var survived: bool = true
			for index: int in range(split, fights.size()):
				var seat: PlayerSpec = seats[index]
				var spec: EncounterSpec = fights[index]
				var added_to_enemy: bool = false
				if policy == "drawback" and index == split and drawback != null:
					if drawback.for_enemy:
						spec.enemy_sources.append(drawback)
						added_to_enemy = true
					else:
						seat = seats[index].duplicate_spec()
						seat.extra_sources.append(drawback)
				var first: int = spec.first_player if spec.first_player >= 0 else (run_index + index) % 2
				var game: GameState = _play(content, seat, spec, base_seed + run_index * 31 + index, first, hp_now, policy_items)
				if added_to_enemy:
					spec.enemy_sources.erase(drawback)
				if game.winner != 0:
					survived = false
					if policy == "heal5":
						(row["lost_at"] as Dictionary)[index] = int((row["lost_at"] as Dictionary).get(index, 0)) + 1
					break
				hp_now = game.players[0].hp
			if survived:
				row["clear_" + policy] = int(row["clear_" + policy]) + 1
				row["hp_" + policy] = int(row["hp_" + policy]) + hp_now
	return row


func _row_text(path_name: String, deck_kind: String, row: Dictionary, fights: Array[EncounterSpec]) -> String:
	var runs: float = maxf(1.0, float(row["runs"]))
	var cells: PackedStringArray = []
	for policy: String in POLICIES:
		var cleared: float = float(row["clear_" + policy])
		cells.append("%d%% / %.1f" % [roundi(100.0 * cleared / runs), float(row["hp_" + policy]) / maxf(1.0, cleared)])
	var worst: String = "-"
	var worst_count: float = 0.0
	for index: Variant in (row["lost_at"] as Dictionary).keys():
		if float((row["lost_at"] as Dictionary)[index]) > worst_count:
			worst_count = float((row["lost_at"] as Dictionary)[index])
			worst = "%s (%d)" % [fights[int(index)].title, int(worst_count)]
	return "| %s | %s | %d | %d%% | %.1f | %s | %s | %s | %s | %s |" % [path_name, deck_kind, int(runs), roundi(100.0 * float(row["reached"]) / runs),
		float(row["hp_there"]) / maxf(1.0, float(row["reached"])), cells[0], cells[1], cells[2], cells[3], worst]
