extends RefCounted
## Fable Nov 24 (Part 4): the Shuffled Halls' hand-made encounters against simulated player drafts.
## A "sensible player" drafts a deck in each of the given Path sets (single Paths and pairs), with the drafted equipment and
## items, and then:
##   --what=rooms   plays every fight room alone at full HP (the win rate of each encounter by the player's Paths)
##   --what=runs    walks whole routes on ONE pool of HP (the heal rooms heal; the card picks after a fight are not modelled,
##                  so a real run is a little easier than its number here)
## Options: --paths=beefcake,gourmand,necrocrat,refusemancer,beefcake+necrocrat,gourmand+refusemancer   --seeds=1 (drafts per
## Path set)  --seed_from=0  --games=4 (per room and draft; runs per route and draft)  --level=16  --rooms=2,3,5 (only these)
## --routes=careful,middle  --hp=<offset added to every dealer's hp_vs_player>  --out=res://docs/design/sim/nov24/<name>.md
## One Godot, headless:  Godot --headless --path . -s res://tools/halls_sim.gd -- --what=rooms --rooms=2,3
## A batch of at most 30 variants (rooms x drafts) in a fresh process, 20 minutes at most: `bash tools/run_halls_sims.sh`.

const PATHS: Dictionary = {"beefcake": Affinity.Type.BEEFCAKE, "gourmand": Affinity.Type.GOURMAND, "necrocrat": Affinity.Type.NECROCRAT, "refusemancer": Affinity.Type.REFUSEMANCER}
const DUNGEON: String = DraftArena.HALLS_DUNGEON
## The fight rooms in map order, and the routes a run can take (room numbers; a negative number is a heal room: HP healed).
const FIGHT_ROOMS: Array[int] = [2, 3, 5, 7, 8, 10, 12, 14, 15, 19]
const ROUTES: Dictionary = {
	"careful": {"about": "the fewest fights: a gate, the House Kettle (heal 6), the Lucky Stall, the Prize Tent, the Quiet Lounge (heal 8), Octavia", "steps": [3, -6, -8, 19]},
	"middle": {"about": "four fights: Maurice, Madame Darjeeling, the Lucky Stall, Professor Fineprint, the Quiet Lounge (heal 8), Octavia", "steps": [2, 5, 12, -8, 19]},
	"champions": {"about": "four fights with a champion: Tilda Tinsel, the House Kettle (heal 6), Dizzy Lizzie, Dex Shufflewick, the Dessert Cart, the Counting Halls passed by, Octavia", "steps": [3, -6, 10, 14, 19]},
	"greedy": {"about": "every table for the picks, no heal: Maurice, Madame Darjeeling, Trey Pickett, Professor Fineprint, Penny Sleeves, Octavia", "steps": [2, 5, 8, 12, 15, 19]},
	"cash_out": {"about": "a champion's run that ends at the Counting Halls: Tilda Tinsel, the House Kettle (heal 6), Dizzy Lizzie, Dex Shufflewick, the Dessert Cart, then the cashier (no boss)", "steps": [3, -6, 10, 14]},
}

var args: Dictionary = {}
var content: ContentSet
var lines: PackedStringArray = []


func run() -> bool:
	for raw: String in OS.get_cmdline_user_args():
		if raw.begins_with("--") and raw.contains("="):
			args[raw.substr(2, raw.find("=") - 2)] = raw.substr(raw.find("=") + 1)
	content = ContentLibrary.load_all()
	var what: String = str(args.get("what", "rooms"))
	lines.append("# The Shuffled Halls sim: %s (level %d, %d draft%s per Path set, %d games)" % [what, _level(), _seeds(), "" if _seeds() == 1 else "s", _games()])
	lines.append("")
	lines.append("Generated by `tools/halls_sim.gd` on %s. The player is a sensible drafter with the default deck, the drafted equipment and items; the dealers are the hand-made encounters of D-SHUFFLE (HP = the player's base HP %d plus each dealer's `hp_vs_player`%s)." % [Time.get_datetime_string_from_system(), _base_hp(), "" if _hp_shift() == 0 else " %+d" % _hp_shift()])
	lines.append("")
	if what == "runs":
		_runs()
	else:
		_rooms()
	var out: String = str(args.get("out", "res://docs/design/sim/nov24/halls_%s.md" % what))
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(out.get_base_dir()))
	var file: FileAccess = FileAccess.open(out, FileAccess.WRITE)
	if file == null:
		return false
	file.store_string("\n".join(lines) + "\n")
	file.close()
	print("\n".join(lines))
	return true


func _level() -> int:
	return int(args.get("level", 16))


func _seeds() -> int:
	return int(args.get("seeds", 1))


func _games() -> int:
	return int(args.get("games", 4))


func _hp_shift() -> int:
	return int(args.get("hp", 0))


func _base_hp() -> int:
	return ProgressionTable.row(clampi(_level(), 1, ProgressionTable.MAX_LEVEL)).max_hp


## The Path sets to draft: "beefcake", "beefcake+necrocrat"...
func _path_sets() -> Array[String]:
	var result: Array[String] = []
	for word: String in str(args.get("paths", "beefcake,gourmand,necrocrat,refusemancer,beefcake+necrocrat,gourmand+refusemancer")).split(",", false):
		var ok: bool = true
		for part: String in word.split("+", false):
			ok = ok and PATHS.has(part)
		if ok:
			result.append(word)
	return result


func _paths_of(word: String) -> Array[int]:
	var result: Array[int] = []
	for part: String in word.split("+", false):
		result.append(int(PATHS[part]))
	return result


func _rooms_asked() -> Array[int]:
	if not args.has("rooms"):
		return FIGHT_ROOMS
	var result: Array[int] = []
	for word: String in str(args["rooms"]).split(",", false):
		if FIGHT_ROOMS.has(int(word)):
			result.append(int(word))
	return result


## A whole draft by the sensible player (the same picker as tools/draft_sim_tool.gd): cards by fit and a plain taste, the
## rarest equipment, the first item; the default deck.
func _player_draft(word: String, seed_value: int) -> DraftState:
	var paths: Array[int] = _paths_of(word)
	var state: DraftState = DraftEngine.start(content, DraftArena.HALLS_ID, paths, _level(), seed_value, paths.size() >= 2, false)
	state.max_paths = 2
	var guard: int = 0
	while state.phase == DraftState.PHASE_PICK and guard < 100:
		guard += 1
		var options: Array = state.offer["options"] as Array
		var choice: int = 0
		match str(state.offer["kind"]):
			DraftEngine.KIND_CARD:
				var picked: Array[CardData] = DraftEngine.picked_cards(content, state)
				var best: float = -1000.0
				for i: int in range(options.size()):
					var card: CardData = content.card(str(options[i]))
					var value: float = _taste(card) + 2.0 * DraftEngine.fit(card, picked, state.paths) + 0.4 * float(int(card.rarity))
					if value > best:
						best = value
						choice = i
			DraftEngine.KIND_EQUIPMENT:
				var top: int = -1
				for i: int in range(options.size()):
					var piece: EquipmentData = content.equipment_piece(str(options[i]))
					if int(piece.rarity) > top:
						top = int(piece.rarity)
						choice = i
		DraftEngine.pick(content, state, choice)
	DraftRun.begin(content, state)
	return state


func _taste(card: CardData) -> float:
	var cost: int = card.energy_value()
	if card.is_unit():
		return 1.6 + 0.3 * float(card.attack + card.defense) - 0.5 * float(cost)
	return 0.9 - 0.2 * float(cost)


func _spec(state: DraftState, word: String) -> PlayerSpec:
	var spec: PlayerSpec = PlayerSpec.make(DraftEngine.build_deck(content, state), _level(), "draft %s" % word)
	spec.equipment_ids = state.equipment.duplicate()
	for id: String in state.items:
		spec.items[id] = 1
	return spec


## The fight of a room as the game builds it: the dealer's exact deck, HP from the player's base HP, its rules and scripted
## moments on its seat (and on the player's), its fixed equipment, its skill.
func _encounter(room: int) -> EncounterSpec:
	var plan: DungeonCatalog.Blueprint = MainDungeons.blueprint(DUNGEON)
	var def: MainDungeonDef = MainDungeons.def(DUNGEON)
	var node: DungeonCatalog.BlueprintNode = plan.node(room)
	var enemy_name: String = DungeonBuilder.foe_name_of(plan, node)
	var fighter: MainDungeonDef.Foe = def.foe(enemy_name)
	var spec: EncounterSpec = EncounterSpec.new()
	spec.id = "halls:%d" % room
	spec.title = "%s (%s)" % [enemy_name, node.node_name]
	spec.enemy_name = enemy_name
	spec.enemy_hp = maxi(8, _base_hp() + fighter.hp_vs_player + _hp_shift()) if fighter.has_hp_vs_player else fighter.hp
	spec.enemy_ai_name = fighter.ai_name
	spec.enemy_recipe = fighter.recipe
	match MainDungeons.skill_of(DUNGEON, enemy_name, AIPlayer.Skill.NORMAL):
		AIPlayer.Skill.BOSS:
			spec.kind = EncounterSpec.Kind.BOSS
		AIPlayer.Skill.ELITE:
			spec.kind = EncounterSpec.Kind.ELITE
		_:
			spec.kind = EncounterSpec.Kind.NORMAL
	var enemy_rules: ModifierSource = EncounterModifiers.enemy_source(enemy_name)
	if enemy_rules != null:
		spec.enemy_sources.append(enemy_rules)
	for piece: EquipmentData in MainDungeons.equipment_of(content, DUNGEON, enemy_name):
		spec.enemy_sources.append(piece)
	var player_rules: ModifierSource = EncounterModifiers.player_source(enemy_name)
	if player_rules != null:
		spec.player_sources.append(player_rules)
	return spec


func _pct(wins: int, games: int) -> int:
	return int(round(100.0 * float(wins) / float(maxi(1, games))))


# ---- every room alone, at full HP -------------------------------------------------------------------------------------------------


func _rooms() -> void:
	var sets: Array[String] = _path_sets()
	var rooms: Array[int] = _rooms_asked()
	var drafts: Dictionary = {}
	for word: String in sets:
		var made: Array[PlayerSpec] = []
		for seed_index: int in range(int(args.get("seed_from", 0)), int(args.get("seed_from", 0)) + _seeds()):
			made.append(_spec(_player_draft(word, 300 + seed_index * 19 + sets.find(word) * 7), word))
		drafts[word] = made
	var header: PackedStringArray = ["Room", "Dealer", "Paths", "HP", "Play"]
	for word: String in sets:
		header.append(word.replace("+", " + ").capitalize())
	header.append("All")
	lines.append("| %s |" % " | ".join(header))
	lines.append("|%s" % "---|".repeat(header.size()))
	for room: int in rooms:
		var encounter: EncounterSpec = _encounter(room)
		var fighter: MainDungeonDef.Foe = MainDungeons.def(DUNGEON).foe(encounter.enemy_name)
		var row: PackedStringArray = [str(room), encounter.title, fighter.paths_text, str(encounter.enemy_hp), EncounterSpec.kind_name(encounter.kind).to_lower()]
		var all_wins: int = 0
		var all_games: int = 0
		for word: String in sets:
			var wins: int = 0
			var games: int = 0
			var index: int = 0
			for player: PlayerSpec in drafts[word] as Array[PlayerSpec]:
				var started: int = Time.get_ticks_msec()
				var result: BalanceSim.Result = BalanceSim.run(content, player, encounter, _games(), 6100 + room * 37 + index * 11)
				wins += result.wins
				games += result.games
				index += 1
				print("room %d %s vs %s: %d/%d in %.1f s" % [room, encounter.enemy_name, word, result.wins, result.games, float(Time.get_ticks_msec() - started) / 1000.0])
			row.append("%d%%" % _pct(wins, games))
			all_wins += wins
			all_games += games
		row.append("**%d%%** (%d)" % [_pct(all_wins, all_games), all_games])
		lines.append("| %s |" % " | ".join(row))
	lines.append("")
	lines.append("Each room alone at full HP. Aim: a regular table about 65 to 80 %, a champion about 55 to 65 %, Octavia about 45 to 55 % (a run strings several together on one pool of HP).")


# ---- whole runs on one pool of HP -------------------------------------------------------------------------------------------------


func _runs() -> void:
	var sets: Array[String] = _path_sets()
	var routes: Array[String] = []
	for word: String in str(args.get("routes", "careful,middle,champions,greedy")).split(",", false):
		if ROUTES.has(word):
			routes.append(word)
	var header: PackedStringArray = ["Route"]
	for word: String in sets:
		header.append(word.replace("+", " + ").capitalize())
	header.append("All")
	header.append("Where the runs ended")
	lines.append("| %s |" % " | ".join(header))
	lines.append("|%s" % "---|".repeat(header.size()))
	for route: String in routes:
		var steps: Array = (ROUTES[route] as Dictionary)["steps"] as Array
		var row: PackedStringArray = ["**%s**: %s" % [route, str((ROUTES[route] as Dictionary)["about"])]]
		var all_clear: int = 0
		var all_runs: int = 0
		var ended: Dictionary = {}
		for word: String in sets:
			var cleared: int = 0
			var runs: int = 0
			for seed_index: int in range(int(args.get("seed_from", 0)), int(args.get("seed_from", 0)) + _seeds()):
				var player: PlayerSpec = _spec(_player_draft(word, 300 + seed_index * 19 + sets.find(word) * 7), word)
				for run_index: int in range(_games()):
					var lost_at: int = _walk(player, steps, 9100 + run_index * 31 + seed_index * 101 + routes.find(route) * 7)
					runs += 1
					if lost_at == 0:
						cleared += 1
					else:
						ended[lost_at] = int(ended.get(lost_at, 0)) + 1
				print("route %s %s seed %d: %d/%d so far" % [route, word, seed_index, cleared, runs])
			row.append("%d of %d" % [cleared, runs])
			all_clear += cleared
			all_runs += runs
		row.append("**%d%%** (%d of %d)" % [_pct(all_clear, all_runs), all_clear, all_runs])
		var where: PackedStringArray = []
		var rooms: Array = ended.keys()
		rooms.sort()
		for room: Variant in rooms:
			where.append("%s (%d)" % [_encounter(int(room)).enemy_name, int(ended[room])])
		row.append(", ".join(where) if not where.is_empty() else "-")
		lines.append("| %s |" % " | ".join(row))
	lines.append("")
	lines.append("One pool of HP; a heal room heals its amount (up to the maximum). The pick of three after each fight is not modelled, so a real run is a little easier than its number here.")


## One run along `steps` (room numbers; negative = a heal of that many HP). Returns 0 when every fight was won, else the room the
## run ended in.
func _walk(player: PlayerSpec, steps: Array, seed_value: int) -> int:
	var hp: int = 0  # 0 = full
	var max_hp: int = 0
	var items: Dictionary = player.items.duplicate()
	var index: int = 0
	for step: Variant in steps:
		index += 1
		if int(step) < 0:
			if hp > 0 and max_hp > 0:
				hp = mini(max_hp, hp - int(step))
			continue
		var scratch: BalanceSim.Result = BalanceSim.Result.new()
		var encounter: EncounterSpec = _encounter(int(step))
		scratch.encounter = encounter
		var game: GameState = BalanceSim.play_game(content, player, encounter, seed_value + index, (seed_value + index) % 2, hp, items, scratch)
		if game.winner != 0:
			return int(step)
		max_hp = maxi(max_hp, game.players[0].max_hp)
		hp = maxi(1, game.players[0].hp)
	return 0
