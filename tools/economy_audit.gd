extends SceneTree
## Rebalance Part F: the gold economy at a glance. Sums every gold source the data defines (level track, quests, dungeon nodes and
## first clears, zone and town roamers, hidden chests) and prints it next to the prices (cards by rarity, packs, gear, items, the
## Alchemist). Run: Godot --headless --path . -s res://tools/economy_audit.gd [-- --out=res://docs/design/sim/economy.md]

func _initialize() -> void:
	var lines: PackedStringArray = ["# Economy audit (Rebalance Part F)", "", "Generated by `tools/economy_audit.gd` on %s." % Time.get_datetime_string_from_system(), ""]
	lines.append("## Gold sources")
	lines.append("")
	lines.append("| Source | Count | Gold each | Total |")
	lines.append("|---|---:|---|---:|")
	var grand: int = 0
	var level_gold: int = 0
	var track: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://data/progression/level_track.json"))
	var level_rows: Array = (track as Dictionary).get("levels", []) as Array if track is Dictionary else []
	var by_band: Dictionary = {}
	for row: Variant in level_rows:
		var level: int = int((row as Dictionary).get("level", 0))
		for grant: Variant in (row as Dictionary).get("grants", []) as Array:
			if str((grant as Dictionary).get("kind", "")) == "gold":
				var amount: int = int((grant as Dictionary).get("amount", 0))
				level_gold += amount
				var band: String = _band(level)
				by_band[band] = int(by_band.get(band, 0)) + amount
	lines.append("| Level-up rewards (L2-30) | %d levels | see bands below | %d |" % [level_rows.size(), level_gold])
	grand += level_gold
	var quest_total: int = 0
	var quest_count: int = 0
	var quests: Array[QuestData] = QuestDefinitions.build_all()
	quests.append_array(ZoneQuestDefinitions.build_all())
	var seen: Dictionary = {}
	for quest: QuestData in quests:
		if quest == null or seen.has(quest.id):
			continue
		seen[quest.id] = true
		if quest.reward_gold > 0:
			quest_total += quest.reward_gold
			quest_count += 1
	lines.append("| Quests | %d | 30-300 | %d |" % [quest_count, quest_total])
	grand += quest_total
	var node_total: int = 0
	var node_count: int = 0
	var clear_total: int = 0
	for blueprint: DungeonCatalog.Blueprint in DungeonCatalog.all():
		if blueprint.id != DungeonCatalog.TUTORIAL_ID:
			clear_total += DungeonBuilder.build_def(blueprint).reward_gold
		for node: DungeonCatalog.BlueprintNode in blueprint.nodes:
			var kind: DungeonMap.Kind = DungeonBuilder.kind_of(node.type)
			var difficulty: int = -1
			if kind == DungeonMap.Kind.BOSS:
				difficulty = DungeonMap.Difficulty.BOSS
			elif kind == DungeonMap.Kind.ELITE:
				difficulty = DungeonMap.Difficulty.ELITE
			elif kind == DungeonMap.Kind.BATTLE:
				difficulty = DungeonMap.Difficulty.NORMAL
			if difficulty >= 0:
				node_total += EncounterRewards.gold_for(difficulty as DungeonMap.Difficulty) / 2
				node_count += 1
	lines.append("| Dungeon nodes (one clear each) | %d | 20-100 | %d |" % [node_count, node_total])
	lines.append("| Dungeon first clears | %d | 30-500 | %d |" % [DungeonCatalog.all().size(), clear_total])
	grand += node_total + clear_total
	lines.append("| **Total, one of everything** | | | **%d** |" % grand)
	lines.append("")
	lines.append("Level-up gold by band: " + ", ".join(PackedStringArray(by_band.keys().map(func(k: Variant) -> String: return "%s %d" % [str(k), int(by_band[k])]))))
	lines.append("")
	lines.append("## Prices")
	lines.append("")
	lines.append("- Cards (`CardPricing`): Common 15, Uncommon 35, Epic 80, Legendary 160, +5 per energy of cost.")
	lines.append("- Alchemist: %d gold + all essence of two Paths (min %d each); essence per over-cap copy 1/2/4/8 by rarity." % [Alchemy.GOLD_COST, Alchemy.MIN_ESSENCE_PER_PATH])
	var text: String = "\n".join(lines) + "\n"
	print(text)
	var out: String = "res://docs/design/sim/economy.md"
	for arg: String in OS.get_cmdline_user_args():
		if arg.begins_with("--out="):
			out = arg.substr(6)
	var file: FileAccess = FileAccess.open(out, FileAccess.WRITE)
	if file != null:
		file.store_string(text)
	quit(0)


func _band(level: int) -> String:
	if level <= 5:
		return "L2-5"
	if level <= 10:
		return "L6-10"
	if level <= 20:
		return "L11-20"
	return "L21-30"
