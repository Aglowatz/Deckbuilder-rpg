extends SceneTree
## Nov 26 night (Part C.1): every piece of equipment and every item - where it is found, its rarity, its effect, its text as the game shows
## it (`GearText.tooltip`: name, slot and rarity, effect, flavour) - with flags for text that may be wrong or unclear: no effect line,
## no final full stop, a number in the modifiers the words do not mention, a very long line. Headless:
##   Godot --headless --path . -s res://tools/equipment_inventory.gd -- [--out=res://docs/design/sim/nov26n/equipment_inventory.md]


func _initialize() -> void:
	process_frame.connect(_run, CONNECT_ONE_SHOT)


func _run() -> void:
	var args: Dictionary = {}
	for arg: String in OS.get_cmdline_user_args():
		if arg.begins_with("--"):
			var parts: PackedStringArray = arg.substr(2).split("=", true, 1)
			args[parts[0]] = parts[1] if parts.size() > 1 else "true"
	var content: ContentSet = ContentLibrary.load_all()
	var quests: Array[QuestData] = QuestDefinitions.build_all()
	var draft_pool: Dictionary = {}
	for piece: EquipmentData in DraftEngine.equipment_pool(content):
		draft_pool[piece.id] = true
	var lines: PackedStringArray = []
	lines.append("# Equipment and items: the inventory (Nov 26 night, Part C)")
	lines.append("")
	lines.append("Generated by `tools/equipment_inventory.gd`. \"Found\" is the Collection Book's source hint (`GearCatalog.source_hint`); \"Draft\" marks the draft pool. Flags: NO-EFFECT (empty description), NO-STOP (no final full stop), NUMBERS (a modifier value the words do not mention), LONG (over 150 characters).")
	lines.append("")
	lines.append("| Piece | Slot | Rarity | Found | Draft | Effect (as shown) | Flags |")
	lines.append("|---|---|---|---|---|---|---|")
	var flagged: int = 0
	for piece: EquipmentData in GearCatalog.all_pieces(content):
		var flags: PackedStringArray = _flags(piece.description)
		for modifier: Modifier in piece.modifiers:
			for value: int in [modifier.value, modifier.value2]:
				if absi(value) >= 2 and absi(value) <= 20 and not piece.description.contains(str(absi(value))) and _numeric_kind(modifier.kind):
					if not flags.has("NUMBERS"):
						flags.append("NUMBERS")
		if not flags.is_empty():
			flagged += 1
		lines.append("| %s (`%s`) | %s | %s | %s | %s | %s | %s |" % [piece.source_name, piece.id, EquipmentData.slot_name(piece.slot), EquipmentRarity.display_name(int(piece.rarity)),
			GearCatalog.source_hint(piece, content, quests), "yes" if draft_pool.has(piece.id) else "", piece.description.replace("|", "/"), ", ".join(flags)])
	lines.append("")
	lines.append("## Items")
	lines.append("")
	lines.append("| Item | Uses | Effect (as shown) | Draft | Flags |")
	lines.append("|---|---:|---|---|---|")
	var item_pool: Dictionary = {}
	for item: ItemData in DraftEngine.item_pool(content):
		item_pool[item.id] = true
	var ids: Array = content.items.keys()
	ids.sort()
	for id: Variant in ids:
		var item: ItemData = content.items[id] as ItemData
		var flags: PackedStringArray = _flags(item.description)
		if item.effect != null and absi(item.effect.amount) >= 2 and not item.description.contains(str(absi(item.effect.amount))) and item.effect.op != CardEnums.EffectOp.CREATE_RESOURCE and item.effect.op != CardEnums.EffectOp.ADD_ENERGY:
			flags.append("NUMBERS")
		if not flags.is_empty():
			flagged += 1
		lines.append("| %s (`%s`) | %d | %s | %s | %s |" % [item.display_name, item.id, item.uses, item.description.replace("|", "/"), "yes" if item_pool.has(item.id) else "", ", ".join(flags)])
	lines.append("")
	lines.append("%d entries flagged." % flagged)
	var out: String = str(args.get("out", "res://docs/design/sim/nov26n/equipment_inventory.md"))
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(out).get_base_dir())
	var file: FileAccess = FileAccess.open(out, FileAccess.WRITE)
	file.store_string("\n".join(lines) + "\n")
	file.close()
	print("Wrote %s (%d flagged)" % [out, flagged])
	quit(0)


func _numeric_kind(kind: Modifier.Kind) -> bool:
	return kind in [Modifier.Kind.MAX_HP, Modifier.Kind.STARTING_HP, Modifier.Kind.STAT_CHANGE, Modifier.Kind.EXTRA_DRAWS, Modifier.Kind.OPENING_HAND_SIZE,
		Modifier.Kind.FIRST_TURN_EXTRA_DRAW, Modifier.Kind.STARTING_RESOURCES, Modifier.Kind.COST_CHANGE]


func _flags(words: String) -> PackedStringArray:
	var flags: PackedStringArray = []
	var text: String = words.strip_edges()
	if text.is_empty():
		flags.append("NO-EFFECT")
		return flags
	if not (text.ends_with(".") or text.ends_with("!") or text.ends_with("?") or text.ends_with(")") or text.ends_with("\"")):
		flags.append("NO-STOP")
	if text.length() > 150:
		flags.append("LONG")
	return flags
