extends "res://tools/economy_model_tool.gd"
## Overnight Nov 4-5, Part 3: the early-game fun check, per Path. Walks the economy model's timeline (`_build_timeline`) the way a new save of
## that Path plays it - the cave, Crosspath's first shops, the gatekeeper of the player's OWN Path zone (PathDirection), the armory if the level
## is there, that zone's arrival (roamers, side quests, chests) and its main dungeon - as the no-grind player of the gold study, and records the
## gold on hand at every shop stop and what it buys there. Then simulates the zone's main dungeon (a main route, one HP pool, no healing between
## fights) with the starter deck plus two Commons bought at the first shop, at the level the walk reaches. Writes docs/balance/early_game_nov5.md.
##   Godot --headless --path . -s res://tools/early_game_study.gd [-- --runs=60 --out=res://docs/balance/early_game_nov5.md]

const COMMON_PRICE_SAMPLE: int = 100
## A normal early player at each shop stop: the first shop buys two Commons of their Path (if the purse allows), later stops one item charge.
const FIRST_SHOP_CARDS: int = 2
const ITEM_PER_LATER_STOP: String = "healing_salve"

var _runs: int = 60
var _md: PackedStringArray = []


func run() -> bool:
	var out: String = "res://docs/balance/early_game_nov5.md"
	for arg: String in OS.get_cmdline_user_args():
		if arg.begins_with("--out="):
			out = arg.substr(6)
		elif arg.begins_with("--runs="):
			_runs = int(arg.substr(7))
	_content = ContentLibrary.load_all()
	for quest: QuestData in QuestCatalog.all():
		_quests[quest.id] = quest
	var profile: Profile = Profile.new()
	profile.name = "no-grind"
	profile.takes = {"clear_bonus": 1.0, "main": 1.0, "roamer": 1.0, "chest": 0.5, "side_quest": 0.67, "side_dungeon": 0.0, "dungeon_side": 0.5, "minigame": 1.0, "arena": 0.0, "feat": 0.75, "secret": 0.5}
	_md.append("# Early-game fun check (Overnight Nov 4-5, Part 3)")
	_md.append("")
	_md.append("Generated by `tools/early_game_study.gd` on %s. Prices: cards %s, items %d-%d, General Pack %d, Path Pack %d. Gold from the game's" % [Time.get_datetime_string_from_system(), str(Economy.CARD_PRICE), Economy.ITEM_PRICE_MIN, Economy.ITEM_PRICE_REGULAR_MAX, PackCatalog.find("general_1").price, PackCatalog.find("path_beefcake").price])
	_md.append("own tables (the economy model's timeline, the no-grind player of `docs/balance/gold_economy_nov3.md`: every story step and roamer once, half")
	_md.append("the chests, two thirds of the side quests). The player goes to their OWN Path's zone first (Maren's Path direction).")
	_md.append("")
	_md.append("Spending: at the first shop two Commons of the player's Path (%d each), at each later shop one %s. The dungeon sim plays the zone's main" % [Economy.card_price(CardEnums.Rarity.COMMON), _content.item(ITEM_PER_LATER_STOP).display_name])
	_md.append("dungeon along one route (fights only, one HP pool, no healing) with the Path's starter deck plus those two Commons, the level the walk")
	_md.append("reaches, and the model's equipment and items for that level; %d runs per Path." % _runs)
	_md.append("")
	var summary: PackedStringArray = []
	for path: Affinity.Type in Affinity.colored_types():
		summary.append(_study_path(path, profile))
		print("early_game_study: %s done" % Affinity.display_name(path))
		var partial: FileAccess = FileAccess.open(out, FileAccess.WRITE)
		partial.store_string("\n".join(_md) + "\n")
		partial.close()
	_md.append("## Summary")
	_md.append("")
	_md.append("| Path | Gold at the first shop | Affords there (Commons / items / General Packs) | Level at the dungeon | First dungeon cleared | HP left | Lost most at |")
	_md.append("|---|---:|---|---:|---:|---:|---|")
	_md.append_array(summary)
	_md.append("")
	var file: FileAccess = FileAccess.open(out, FileAccess.WRITE)
	file.store_string("\n".join(_md) + "\n")
	file.close()
	print("early_game_study: wrote %s" % out)
	return true


func _study_path(path: Affinity.Type, profile: Profile) -> String:
	var zone_id: String = PathDirection.zone_of(path)
	var steps: Array[Step] = _build_timeline()
	var gold: int = 0
	var xp: int = 0
	var level: int = 1
	var counters: Dictionary = {}
	var first_shop_gold: int = -1
	var first_shop_affords: String = ""
	var bought: Array[CardData] = _first_shop_cards(path)
	var shop_rows: PackedStringArray = []
	var reached_dungeon: bool = false
	_md.append("## %s (home zone: %s)" % [Affinity.display_name(path), str(ZONE_NAMES.get(zone_id, zone_id))])
	_md.append("")
	_md.append("| Stop | Level | Gold on arrival | After the stop's quests and fights | Affords then: Commons / items / General Packs | Bought | Gold after |")
	_md.append("|---|---:|---:|---:|---|---|---:|")
	var shop_index: int = 0
	for step: Step in steps:
		if not _early_step(step, zone_id, level):
			continue
		var arrival: int = gold
		for event: Event in step.events:
			var count: int = int(counters.get(event.tag, 0))
			counters[event.tag] = count + 1
			if _takes(profile, event.tag, count):
				gold += event.gold
				xp += event.xp
		var new_level: int = ProgressionTable.level_for_xp(xp)
		for gained: int in range(level + 1, new_level + 1):
			for grant: Variant in LevelTrack.level_entry(gained).get("grants", []) as Array:
				if str((grant as Dictionary).get("kind", "")) == "gold":
					gold += int((grant as Dictionary).get("amount", 0))
		level = new_level
		if step.label.contains("main dungeon"):
			reached_dungeon = true
		if not step.shop:
			continue
		var affords: String = "%d / %d / %d" % [gold / Economy.card_price(CardEnums.Rarity.COMMON), gold / 70, gold / PackCatalog.find("general_1").price]
		var spent: int = 0
		var what: String = ""
		if shop_index == 0:
			first_shop_gold = arrival
			first_shop_affords = "%d / %d / %d" % [arrival / Economy.card_price(CardEnums.Rarity.COMMON), arrival / 70, arrival / PackCatalog.find("general_1").price]
			var names: PackedStringArray = []
			for card: CardData in bought:
				if gold - spent >= Economy.card_price(card.rarity):
					spent += Economy.card_price(card.rarity)
					names.append(card.display_name)
			what = ", ".join(names) if not names.is_empty() else "nothing (short)"
		else:
			var price: int = Economy.item_price(ITEM_PER_LATER_STOP)
			if gold >= price:
				spent = price
				what = _content.item(ITEM_PER_LATER_STOP).display_name
			else:
				what = "nothing (short)"
		_md.append("| %s | %d | %d | %d | %s | %s | %d |" % [step.label, level, arrival, gold, affords, what, gold - spent])
		gold -= spent
		shop_index += 1
		if reached_dungeon:
			break
	_md.append("")
	var result: Dictionary = _simulate_dungeon(path, zone_id, level, bought)
	_md.append("First dungeon (%s), level %d: **%s cleared** over %d runs, %.1f HP left on average. Route: %s." % [str(result["name"]), level, BalanceSim.percent(float(result["rate"])), _runs, float(result["hp"]), str(result["route"])])
	if float(result["bare_rate"]) >= 0.0:
		_md.append("Bare starter deck (no buys) for comparison: %s cleared." % BalanceSim.percent(float(result["bare_rate"])))
	_md.append("")
	return "| %s | %d | %s | %d | %s | %.1f | %s |" % [Affinity.display_name(path), first_shop_gold, first_shop_affords, level, BalanceSim.percent(float(result["rate"])), float(result["hp"]), str(result["lost_at"])]


## The steps of the early game for a player of `zone_id`'s Path: Crosspath before any gatekeeper, the own gatekeeper, the armory once level 5 is
## there, the own zone's arrival and its main dungeon.
func _early_step(step: Step, zone_id: String, level: int) -> bool:
	if step.label.begins_with("Forgotten Cave") or step.label.begins_with("Crosspath arrival") or step.label.begins_with("Store room"):
		return true
	if step.label.begins_with("Level 5"):
		return level >= 5
	if step.label.begins_with("Crosspath: gatekeeper"):
		return step.label.contains(str({"beefcake": "Brick Bronson", "necrocrat": "Prudence Pallor", "gourmand": "Chef Gravois", "refusemancer": "Moss Mulligan"}.get(zone_id, "?")))
	if step.zone != zone_id:
		return false
	return step.label.contains("arrival") or step.label.contains("main dungeon")


## Two Commons of the Path a player would pick up at Sable's first shelf: units costing 2-3 that are not in the starter deck, by id.
func _first_shop_cards(path: Affinity.Type) -> Array[CardData]:
	var starter: Deck = CampaignStart.starter_deck_sized(_content, path, 0)
	var in_starter: Dictionary = {}
	for card: CardData in starter.cards:
		in_starter[card.id] = true
	var pool: Array[CardData] = []
	for value: Variant in _content.cards.values():
		var card: CardData = value as CardData
		var cost: int = card.generic_cost + card.colored_pips.size()
		if card.color == path and not card.is_multipath() and not card.is_basic and not card.is_token and card.rarity == CardEnums.Rarity.COMMON and card.type == CardEnums.CardType.UNIT and cost >= 2 and cost <= 3 and not in_starter.has(card.id) and CardAvailability.allowed(card, {}):
			pool.append(card)
	pool.sort_custom(func(a: CardData, b: CardData) -> bool: return a.id < b.id)
	return pool.slice(0, FIRST_SHOP_CARDS)


func _simulate_dungeon(path: Affinity.Type, zone_id: String, level: int, bought: Array[CardData]) -> Dictionary:
	var blueprint: DungeonCatalog.Blueprint = DungeonCatalog.main_for_zone(zone_id)
	var map: DungeonMap = MainDungeons.build_map(zone_id)
	var specs: Array[EncounterSpec] = []
	var by_number: Dictionary = {}
	for spec: EncounterSpec in EncounterCatalog.all(_content):
		if spec.group == "dungeon:%s" % blueprint.id:
			by_number[spec.node_number] = spec
	# one route: from the start, always the first way on, to the boss
	var route: PackedStringArray = []
	var node: DungeonMap.MapNode = map.nodes[0]
	var guard: int = 0
	while node != null and guard < 40:
		guard += 1
		if by_number.has(node.number) and node.kind in [DungeonMap.Kind.BATTLE, DungeonMap.Kind.ELITE, DungeonMap.Kind.BOSS]:
			specs.append(by_number[node.number] as EncounterSpec)
			route.append(node.title)
		if node.next.is_empty():
			break
		node = map.nodes[node.next[0]] if node.next[0] < map.nodes.size() else null
	# the game eases a zone played before its designed place, and the first zone a little more (ZoneOrderEase); --no_ease measures without it
	var factor: float = 1.0 if OS.get_cmdline_user_args().has("--no_ease") else ZoneOrderEase.hp_factor(zone_id, 0)
	for spec: EncounterSpec in specs:
		spec.enemy_hp = maxi(4, roundi(float(spec.enemy_hp) * factor))
	_md.append("Foe HP factor in this run (ZoneOrderEase, first zone, %d places early): %.2f." % [ZoneOrderEase.places_early(zone_id, 0), factor])
	var deck: Deck = CampaignStart.starter_deck_sized(_content, path, 0)
	var with_buys: Deck = Deck.new()
	with_buys.deck_name = deck.deck_name
	with_buys.cards = deck.cards.duplicate()
	for card: CardData in bought:
		with_buys.cards.append(card)
	var player: PlayerSpec = PlayerSpec.make(with_buys, level, "%s L%d +2" % [Affinity.display_name(path), level])
	player.equipment_ids = ProgressionModel.equipment_for(level)
	player.items = ProgressionModel.items_for(level)
	var result: BalanceSim.SequenceResult = BalanceSim.run_sequence(_content, player, specs, _runs, 4200 + int(path) * 97)
	var bare: PlayerSpec = PlayerSpec.make(deck, level, "%s L%d starter" % [Affinity.display_name(path), level])
	bare.equipment_ids = player.equipment_ids
	bare.items = player.items
	# --bare also plays the bare starter deck (half the runs) for comparison
	var bare_result: BalanceSim.SequenceResult = BalanceSim.run_sequence(_content, bare, specs, maxi(4, _runs / 2), 4200 + int(path) * 97) if OS.get_cmdline_user_args().has("--bare") else null
	var lost: String = "-"
	var worst: int = 0
	for index: Variant in result.lost_at.keys():
		if int(result.lost_at[index]) > worst:
			worst = int(result.lost_at[index])
			lost = specs[int(index)].title
	return {"name": blueprint.dungeon_name, "rate": result.clear_rate(), "hp": result.avg_hp_left(), "route": " -> ".join(route), "bare_rate": bare_result.clear_rate() if bare_result != null else -1.0, "lost_at": lost}
