extends RefCounted
## Nov 26 night (Part A2): the work of tools/deck_puzzle_sim.gd (see there for the flags). Also used by the tests
## (`play`, `deck_for`) so the sim and the recorded winning lines go through one code path.

const LINES_FILE: String = "res://data/arena/deck_puzzle_lines.json"
const PATHS: Array[Affinity.Type] = [Affinity.Type.BEEFCAKE, Affinity.Type.NECROCRAT, Affinity.Type.GOURMAND, Affinity.Type.REFUSEMANCER]
const MAX_STEPS: int = 4000

var args: Dictionary = {}


func run() -> bool:
	for arg: String in OS.get_cmdline_user_args():
		if arg.begins_with("--"):
			var parts: PackedStringArray = arg.substr(2).split("=", true, 1)
			args[parts[0]] = parts[1] if parts.size() > 1 else "true"
	var games: int = int(args.get("games", 12))
	var base_seed: int = int(args.get("seed", 8100))
	var kinds: PackedStringArray = str(args.get("decks", "exploit,late,reference")).split(",")
	var out_path: String = str(args.get("out", "res://docs/design/sim/nov26n/puzzles.md"))
	var record: bool = str(args.get("record", "0")) == "1"
	var content: ContentSet = ContentLibrary.load_all()
	var started: int = Time.get_ticks_msec()
	var lines: PackedStringArray = []
	lines.append("# Octavia's deck-building puzzles, simulated (%d games per deck, seeds %d+)" % [games, base_seed])
	lines.append("")
	lines.append("Generated by `tools/deck_puzzle_sim.gd` on %s. The opponent plays at Boss skill and deterministically, exactly as the game builds the bout; the player's deck is played by the planning AI at Elite skill with the gear and items of its level (`ProgressionModel`). Reference decks are each Path's expected deck at the puzzle's level." % Time.get_datetime_string_from_system())
	lines.append("")
	lines.append("| Puzzle | Deck | Kind | L | Won | Turns (wins) | HP left (wins) | Foe HP left (losses) |")
	lines.append("|---|---|---|---:|---:|---:|---:|---:|")
	var recorded: Dictionary = _load_lines()
	for id: String in DeckPuzzles.ids():
		if args.has("only") and not str(args["only"]).split(",").has(id):
			continue
		var level: int = DeckPuzzles.level_of(id)
		var decks: Array[Dictionary] = []
		for spec: Variant in DeckPuzzles.row(id).get("sim_decks", []) as Array:
			decks.append(spec as Dictionary)
		for path: Affinity.Type in PATHS:
			decks.append({"label": "Reference: %s L%d" % [Affinity.display_name(path), level], "kind": "reference", "level": level, "path": int(path)})
		var got_line: bool = false
		for spec: Dictionary in decks:
			if not kinds.has(str(spec.get("kind", ""))):
				continue
			var wins: int = 0
			var turns: int = 0
			var hp_left: int = 0
			var foe_left: int = 0
			for index: int in range(games):
				var seed_value: int = base_seed + index
				var log: Array[String] = []
				var game: GameState = play(content, id, spec, seed_value, log)
				if args.has("trace") and index == 0 and str(spec.get("label", "")).contains(str(args["trace"])):
					print("
".join(log))
				if game.winner == 0 or DeckPuzzles.find(id).player_won(game):
					wins += 1
					turns += (game.turn + 1) / 2
					hp_left += game.players[0].hp
					if record and not got_line and str(spec.get("kind", "")) == "exploit":
						got_line = true
						recorded[id] = {"deck": str(spec.get("label", "")), "seed": seed_value, "turns": (game.turn + 1) / 2, "moves": log}
				else:
					foe_left += game.players[1].hp
			var row: String = "| %s | %s | %s | %d | **%d/%d** | %s | %s | %s |" % [DeckPuzzles.row(id).get("title", id), str(spec.get("label", "")), str(spec.get("kind", "")),
				int(spec.get("level", level)), wins, games, "%.1f" % (float(turns) / wins) if wins > 0 else "-", "%.1f" % (float(hp_left) / wins) if wins > 0 else "-",
				"%.1f" % (float(foe_left) / (games - wins)) if wins < games else "-"]
			lines.append(row)
			print(row)
			_flush(out_path, lines)
	lines.append("")
	lines.append("Simulated in %.0f s." % (float(Time.get_ticks_msec() - started) / 1000.0))
	_flush(out_path, lines)
	if record:
		var file: FileAccess = FileAccess.open(LINES_FILE, FileAccess.WRITE)
		file.store_string(JSON.stringify({"_about": "Nov 26 night: one recorded winning line per deck-building puzzle (tools/deck_puzzle_sim.gd --record=1). The opponent is deterministic and the player always goes first, so the deck and the seed (the player's shuffle) replay the same game.", "lines": recorded}, "\t") + "\n")
		file.close()
	print("Wrote %s" % out_path)
	return true


## The player's deck for a sim spec: a reference deck ("path") or a recipe ("cards").
static func deck_for(content: ContentSet, spec: Dictionary) -> Deck:
	if spec.has("path"):
		return ProgressionModel.reference_deck(content, int(spec["path"]) as Affinity.Type, int(spec.get("level", 14)))
	return ZoneDecks.from_recipe(content, str(spec.get("label", "Puzzle deck")), spec.get("cards", {}) as Dictionary)


## Plays one bout of puzzle `id` with the deck of `spec` and the player's shuffle `seed_value`; appends a readable line per move of the
## player's (and every scripted moment) to `log`. Returns the finished game.
static func play(content: ContentSet, id: String, spec: Dictionary, seed_value: int, log: Array[String] = []) -> GameState:
	var encounter: ArenaEncounter = DeckPuzzles.find(id)
	var level: int = int(spec.get("level", DeckPuzzles.level_of(id)))
	var player: PlayerSpec = PlayerSpec.make(deck_for(content, spec), level, str(spec.get("label", "")))
	player.equipment_ids = ProgressionModel.equipment_for(level)
	if spec.has("equipment"):
		player.equipment_ids.assign(spec["equipment"] as Array)  # a deck may carry the gear a player would pick for this bout
	player.items = ProgressionModel.items_for(level)
	player.ai_name = str(spec.get("ai", "Balanced"))
	var profile: PlayerProfile = player.profile(content)
	var game: GameState = ArenaScenario.build_game(content, encounter, profile, player.deck, seed_value)
	game.options.record_events = false
	var me: AIPlayer = AIPlayer.for_foe(ZoneDecks.personality(content, player.ai_name), AIPlayer.Skill.ELITE)
	me.deterministic = true
	var foe: AIPlayer = AIPlayer.for_foe(ZoneDecks.personality(content, encounter.enemy_ai), AIPlayer.Skill.BOSS, encounter.enemy_name)
	foe.deterministic = true
	var ais: Array[AIPlayer] = [me, foe]
	var items: Dictionary = player.items.duplicate()
	var item_turn: int = -1
	var used_this_turn: Dictionary = {}
	var steps: int = 0
	var fired_seen: int = 0
	var board_turn: int = -1
	while not game.is_over() and steps < MAX_STEPS:
		steps += 1
		if game.turn != board_turn and game.active == 0:
			board_turn = game.turn
			log.append("turn %d begins: you %d HP, %s %d HP; her side: %s; your side: %s" % [(game.turn + 1) / 2, game.players[0].hp, encounter.enemy_name, game.players[1].hp, _board(game, 1), _board(game, 0)])
		var who: int = game.awaiting_player()
		if who == 0 and not items.is_empty() and game.stage == GameState.Stage.PLAYING and game.in_main_phase():
			if item_turn != game.turn:
				item_turn = game.turn
				used_this_turn.clear()
			if SimItemPolicy.act(game, 0, items, content, used_this_turn):
				log.append("turn %d: you use an item" % ((game.turn + 1) / 2))
				continue
		var action: GameAction = ais[who].choose_action(game)
		var words: String = describe(game, action)
		if not game.apply_action(action):
			if not game.apply_action(GameAction.pass_phase(who)):
				break
		elif not words.is_empty():
			log.append("turn %d, %s: %s" % [(game.turn + 1) / 2, "you" if who == 0 else encounter.enemy_name, words])
		var fired: int = _fired_count(game)
		if fired > fired_seen:
			fired_seen = fired
			log.append("turn %d: a scripted moment fires (%d so far)" % [(game.turn + 1) / 2, fired])
	log.append("result: %s (turn %d, your HP %d, %s HP %d)" % ["WIN" if encounter.player_won(game) else "loss", (game.turn + 1) / 2, game.players[0].hp, encounter.enemy_name, game.players[1].hp])
	return game


static func _board(game: GameState, seat: int) -> String:
	var parts: PackedStringArray = []
	for card: CardInstance in game.players[seat].field:
		if card.data.is_unit():
			parts.append("%s %d/%d" % [card.data.display_name, game.get_attack(card), game.get_defense(card)])
	return "nothing" if parts.is_empty() else ", ".join(parts)


static func _fired_count(game: GameState) -> int:
	var count: int = 0
	for run: Variant in game.script_runs:
		count += (run as EncounterScripts.Run).fired.size()
	return count


## One move in words ("plays Hazmat Intern", "attacks with Notary Wraith, Soul Collector"); "" for a pass or a mulligan.
static func describe(game: GameState, action: GameAction) -> String:
	match action.type:
		GameAction.Type.PLAY, GameAction.Type.PLAY_INFRASTRUCTURE:
			var card: CardInstance = game.find_card(action.card_uid)
			if card == null:
				return ""
			if card.data.is_infrastructure():
				return ""  # Infrastructure plays are left out of the line (every turn has one)
			var target: CardInstance = game.find_card(action.target) if action.target > 0 else null
			return "plays %s%s" % [card.data.display_name, " on %s" % target.data.display_name if target != null else ""]
		GameAction.Type.ACTIVATE, GameAction.Type.ACTIVATE_ABILITY:
			var source: CardInstance = game.find_card(action.card_uid)
			return "uses %s" % source.data.display_name if source != null else ""
		GameAction.Type.USE_RESOURCE:
			return "uses a resource"
		GameAction.Type.DECLARE_ATTACKERS:
			var names: PackedStringArray = []
			for uid: int in action.uids:
				var unit: CardInstance = game.find_card(uid)
				if unit != null:
					names.append(unit.data.display_name)
			return "attacks with %s" % ", ".join(names) if not names.is_empty() else ""
		GameAction.Type.DECLARE_BLOCKERS:
			if action.blocks.is_empty():
				return ""
			var pairs: PackedStringArray = []
			for blocker: Variant in action.blocks.keys():
				var a: CardInstance = game.find_card(int(blocker))
				var b: CardInstance = game.find_card(int(action.blocks[blocker]))
				if a != null and b != null:
					pairs.append("%s blocks %s" % [b.data.display_name, a.data.display_name])  # blocks: attacker uid -> blocker uid
			return ", ".join(pairs)
	return ""


static func _load_lines() -> Dictionary:
	if not FileAccess.file_exists(LINES_FILE):
		return {}
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(LINES_FILE))
	if parsed is Dictionary:
		return ((parsed as Dictionary).get("lines", {}) as Dictionary).duplicate(true)
	return {}


func _flush(out_path: String, lines: PackedStringArray) -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(out_path).get_base_dir())
	var file: FileAccess = FileAccess.open(out_path, FileAccess.WRITE)
	if file != null:
		file.store_string("\n".join(lines) + "\n")
		file.close()
